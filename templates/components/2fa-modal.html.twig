<!-- 2FA Modal -->
<div id="2faModal" class="modal-overlay" style="display: none;">
    <div class="modal-backdrop" onclick="close2FAModal()"></div>
    <div class="modal-container">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header">
                <div class="modal-icon modal-icon-enable">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <h3 class="modal-title">
                    {% if isEnabled %}
                        Double authentification activée
                    {% else %}
                        Activer la double authentification
                    {% endif %}
                </h3>
                <button class="modal-close" onclick="close2FAModal()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            
            <!-- Body -->
            <div class="modal-body">
                {% if isEnabled %}
                    <!-- Enabled State -->
                    <div class="modal-status modal-status-success">
                        <div class="status-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                        </div>
                        <p>Votre compte est protégé par la double authentification. Vous devrez entrer un code à chaque connexion.</p>
                    </div>
                    
                    <form method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir désactiver la double authentification?');" class="modal-form">
                        <input type="hidden" name="disable_2fa" value="1">
                        <button type="submit" class="modal-btn modal-btn-danger">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                            </svg>
                            Désactiver la 2FA
                        </button>
                    </form>
                {% else %}
                    <!-- Disabled State - Show Setup -->
                    <p class="modal-description">
                        Scannez le code QR ci-dessous avec votre application Google Authenticator, puis entrez le code à 6 chiffres pour activer la double authentification.
                    </p>
                    
                    {% if qrCodeImage %}
                    <div class="qr-container">
                        <img src="data:image/svg+xml;base64,{{ qrCodeImage }}" 
                             alt="QR Code" 
                             class="qr-code">
                    </div>
                    {% endif %}
                    
                    {% if secret %}
                    <div class="secret-container">
                        <span class="secret-label">Code manuel</span>
                        <code class="secret-code">{{ secret }}</code>
                    </div>
                    {% endif %}
                    
                    <form method="post" class="modal-form" id="activate2FAForm">
                        <div class="form-group">
                            <label for="verification_code">Code de vérification</label>
                            <input type="text" 
                                   name="verification_code" 
                                   id="verification_code"
                                   required
                                   maxlength="6"
                                   pattern="[0-9]*"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   class="form-input"
                                   placeholder="000000"
                                   autofocus>
                        </div>
                        <button type="submit" class="modal-btn modal-btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                <path d="M9 12l2 2 4-4"></path>
                            </svg>
                            Activer la 2FA
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<style>
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
}

.modal-container {
    position: relative;
    width: 100%;
    max-width: 440px;
    padding: 20px;
    animation: slideUp 0.3s ease;
}

@keyframes slideUp {
    from { 
        opacity: 0;
        transform: translateY(20px);
    }
    to { 
        opacity: 1;
        transform: translateY(0);
    }
}

.modal-content {
    background: white;
    border-radius: 16px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    overflow: hidden;
}

.modal-header {
    display: flex;
    align-items: center;
    padding: 24px 24px 16px;
    position: relative;
}

.modal-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 16px;
    flex-shrink: 0;
}

.modal-icon-enable {
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    color: #16a34a;
}

.modal-title {
    font-size: 18px;
    font-weight: 600;
    color: #1f2937;
    margin: 0;
    flex: 1;
}

.modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border: none;
    background: #f3f4f6;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6b7280;
    transition: all 0.2s;
}

.modal-close:hover {
    background: #e5e7eb;
    color: #1f2937;
}

.modal-body {
    padding: 8px 24px 24px;
}

.modal-description {
    font-size: 14px;
    color: #6b7280;
    line-height: 1.6;
    margin: 0 0 24px 0;
}

.modal-status {
    text-align: center;
    padding: 24px;
}

.modal-status-success {
    background: #f0fdf4;
    border-radius: 12px;
    margin-bottom: 20px;
}

.status-icon {
    width: 64px;
    height: 64px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    color: #16a34a;
}

.modal-status p {
    font-size: 14px;
    color: #166534;
    margin: 0;
    line-height: 1.6;
}

.qr-container {
    background: #f9fafb;
    border-radius: 12px;
    padding: 24px;
    text-align: center;
    margin-bottom: 20px;
}

.qr-code {
    width: 180px;
    height: 180px;
}

.secret-container {
    background: #f9fafb;
    border-radius: 8px;
    padding: 12px;
    text-align: center;
    margin-bottom: 20px;
}

.secret-label {
    display: block;
    font-size: 12px;
    color: #6b7280;
    margin-bottom: 4px;
}

.secret-code {
    font-family: monospace;
    font-size: 14px;
    color: #16563f;
    letter-spacing: 2px;
}

.modal-form {
    margin-top: 8px;
}

.form-group {
    margin-bottom: 16px;
}

.form-group label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: #374151;
    margin-bottom: 8px;
}

.form-input {
    width: 100%;
    padding: 14px 16px;
    border: 2px solid #e5e7eb;
    border-radius: 10px;
    font-size: 24px;
    text-align: center;
    letter-spacing: 8px;
    font-weight: 600;
    color: #1f2937;
    transition: all 0.2s;
    box-sizing: border-box;
}

.form-input:focus {
    outline: none;
    border-color: #16563f;
    box-shadow: 0 0 0 4px rgba(22, 86, 63, 0.1);
}

.form-input::placeholder {
    letter-spacing: 8px;
    color: #d1d5db;
}

.modal-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 24px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
}

.modal-btn-primary {
    background: linear-gradient(135deg, #16563f 0%, #1e6b47 100%);
    color: white;
}

.modal-btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(22, 86, 63, 0.25);
}

.modal-btn-danger {
    background: white;
    color: #dc2626;
    border: 1px solid #e5e7eb;
}

.modal-btn-danger:hover {
    background: #fef2f2;
    border-color: #fca5a5;
}
</style>

<script>
function open2FAModal() {
    document.getElementById('2faModal').style.display = 'flex';
    document.body.style.overflow = 'hidden';
}

function close2FAModal() {
    document.getElementById('2faModal').style.display = 'none';
    document.body.style.overflow = 'auto';
}

// Close on escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        close2FAModal();
    }
});
</script>
