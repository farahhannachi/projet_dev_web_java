{# AFK (Away From Keyboard) Warning Modal #}
<div id="afk-modal" class="afk-modal" style="display: none;">
    <div class="afk-modal-content">
        <div class="afk-modal-header">
            <i class="fas fa-exclamation-triangle afk-icon"></i>
            <h3>Inactivité détectée</h3>
        </div>
        <div class="afk-modal-body">
            <p>Vous êtes inactif depuis <span id="afk-inactive-time">10</span> minutes.</p>
            <p class="afk-warning">Êtes-vous toujours là?</p>
            <p class="afk-countdown">Vous serez déconecté automatiquement dans <span id="afk-countdown">60</span> secondes.</p>
        </div>
        <div class="afk-modal-footer">
            <button type="button" id="afk-stay-connected" class="btn btn-primary">
                <i class="fas fa-check"></i> Oui, je suis là
            </button>
            <a href="{{ path('app_logout') }}" class="btn btn-secondary">
                <i class="fas fa-sign-out-alt"></i> Se déconnecter
            </a>
        </div>
    </div>
</div>

<style>
/* AFK Modal Styles */
.afk-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: afk-fade-in 0.3s ease;
}

@keyframes afk-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
}

.afk-modal-content {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    max-width: 450px;
    width: 90%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    animation: afk-slide-up 0.3s ease;
}

@keyframes afk-slide-up {
    from { 
        opacity: 0;
        transform: translateY(20px);
    }
    to { 
        opacity: 1;
        transform: translateY(0);
    }
}

.afk-modal-header {
    margin-bottom: 1.5rem;
}

.afk-icon {
    font-size: 3rem;
    color: #ffc107;
    margin-bottom: 1rem;
    animation: afk-pulse 1.5s infinite;
}

@keyframes afk-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
}

.afk-modal-header h3 {
    color: #333;
    font-size: 1.5rem;
    margin: 0;
}

.afk-modal-body {
    margin-bottom: 1.5rem;
}

.afk-modal-body p {
    color: #666;
    margin: 0.5rem 0;
}

.afk-warning {
    font-size: 1.1rem;
    font-weight: 600;
    color: #333;
}

.afk-countdown {
    color: #dc3545 !important;
    font-weight: 600;
}

.afk-modal-footer {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
}

.afk-modal-footer .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    border: none;
    transition: all 0.3s ease;
}

.afk-modal-footer .btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}

.afk-modal-footer .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
}

.afk-modal-footer .btn-secondary {
    background: #6c757d;
    color: white;
}

.afk-modal-footer .btn-secondary:hover {
    background: #5a6268;
}
</style>
