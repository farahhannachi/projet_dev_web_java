{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}Nouveau Client{% endblock %}
{% block page_subtitle %}Ajouter un nouveau client{% endblock %}

{% block main %}
<div style="padding: 2rem;">
    <div style="background: white; padding: 2.5rem; border-radius: 20px; box-shadow: var(--shadow-lg); max-width: 700px; margin: 0 auto; position: relative; overflow: hidden;">
        <div style="position: absolute; top: 0; left: 0; right: 0; height: 5px; background: linear-gradient(90deg, var(--primary-color), var(--secondary-color), var(--warning-color));"></div>
        
        <div style="text-align: center; margin-bottom: 2.5rem;">
            <div style="width: 80px; height: 80px; background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; box-shadow: var(--shadow-md);">
                <i class="fas fa-user-plus" style="font-size: 2rem; color: white;"></i>
            </div>
            <h2 style="color: var(--primary-color); margin-bottom: 0.5rem; font-size: 1.75rem; font-weight: 700;">
                Ajouter un Nouveau Client
            </h2>
            <p style="color: var(--text-muted); font-size: 1rem;">
                Remplissez les informations pour créer un nouveau compte client
            </p>
        </div>

        {% for message in app.flashes('error') %}
            <div style="background: linear-gradient(135deg, #f8d7da, #f5c6cb); color: #721c24; padding: 1rem 1.5rem; border-radius: 12px; margin-bottom: 1.5rem; border-left: 4px solid var(--danger-color); box-shadow: var(--shadow-sm); animation: slideInRight 0.5s ease;">
                <i class="fas fa-exclamation-triangle"></i> {{ message }}
            </div>
        {% endfor %}
        
        <form method="post" style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div class="form-grid">
                <div class="form-group">
                    <label for="nom" style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--dark-color);">
                        <i class="fas fa-user" style="color: var(--primary-color);"></i> Nom *
                    </label>
                    <input type="text" id="nom" name="nom" class="form-control" placeholder="Entrez le nom du client">
                </div>

                <div class="form-group">
                    <label for="prenom" style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--dark-color);">
                        <i class="fas fa-user" style="color: var(--primary-color);"></i> Prénom *
                    </label>
                    <input type="text" id="prenom" name="prenom" class="form-control" placeholder="Entrez le prénom du client">
                </div>
            </div>

            <div class="form-group">
                <label for="email" style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--dark-color);">
                    <i class="fas fa-envelope" style="color: var(--primary-color);"></i> Email *
                </label>
                <input type="text" id="email" name="email" class="form-control" placeholder="client@exemple.com">
            </div>

            <div class="form-group">
                <label for="telephone" style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--dark-color);">
                    <i class="fas fa-mobile-alt" style="color: var(--primary-color);"></i> 📱 Téléphone (pour SMS)
                </label>
                <input type="tel" id="telephone" name="telephone" class="form-control" placeholder="+21626581955">
                <small style="color: var(--text-muted); display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem;">
                    <i class="fas fa-info-circle"></i> Format international avec + (ex: +21626581955). Nécessaire pour recevoir les SMS.
                </small>
            </div>

            <div class="form-group">
                <label for="mot_de_passe" style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--dark-color);">
                    <i class="fas fa-lock" style="color: var(--primary-color);"></i> Mot de passe *
                </label>
                <input type="password" id="mot_de_passe" name="mot_de_passe" class="form-control" placeholder="••••••••">
                <small style="color: var(--text-muted); display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem;">
                    <i class="fas fa-info-circle"></i> Minimum 6 caractères pour la sécurité
                </small>
            </div>

            <div class="form-group">
                <label for="role" style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--dark-color);">
                    <i class="fas fa-user-tag" style="color: var(--primary-color);"></i> Rôle *
                </label>
                <select id="role" name="role" class="form-control">
                    <option value="ROLE_USER">Client</option>
                    <option value="ROLE_ADMIN">Administrateur</option>
                </select>
            </div>

            <div class="form-group">
                <label for="etat_compte" style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--dark-color);">
                    <i class="fas fa-toggle-on" style="color: var(--primary-color);"></i> État du compte *
                </label>
                <select id="etat_compte" name="etat_compte" class="form-control">
                    <option value="actif">✅ Actif</option>
                    <option value="bloque">🚫 Bloqué</option>
                </select>
            </div>

            <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
                <a href="{{ path('admin_clients') }}" 
                   class="btn-outline" 
                   style="padding: 0.875rem 1.75rem;">
                    <i class="fas fa-arrow-left"></i> Annuler
                </a>
                <button type="submit" 
                        class="btn-primary" 
                        style="padding: 0.875rem 1.75rem;">
                    <i class="fas fa-save"></i> Créer le Client
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
