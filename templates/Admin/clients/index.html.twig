{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}Gestion des Clients{% endblock %}
{% block page_subtitle %}Tous les clients inscrits{% endblock %}

{% block main %}
<div style="padding: 2rem;">
    {% for message in app.flashes('success') %}
        <div class="alert-success">
            <i class="fas fa-check-circle"></i> {{ message }}
        </div>
    {% endfor %}

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <h2 style="margin: 0; color: var(--primary-color); font-size: 1.75rem; font-weight: 600;">
            <i class="fas fa-users"></i> Liste des Clients
        </h2>
        <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
            <!-- Bouton Ajouter Client -->
            <a href="{{ path('admin_client_new') }}" class="btn-primary">
                <i class="fas fa-user-plus"></i> Ajouter un Client
            </a>
            
            <!-- Bouton Tri Alpha -->
            <a href="{{ path('admin_clients', {search: search, sort: (sort == 'alpha') ? '' : 'alpha'}) }}" 
               class="btn-outline"
               style="background: linear-gradient(135deg, #6c757d, #5a6268);">
                <i class="fas fa-sort-alpha-{{ (sort == 'alpha') ? 'down' : 'up' }}"></i> 
                TRI
            </a>
            
            <!-- Barre de recherche avancée -->
            <form method="get" class="search-advanced" style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                <input type="text" 
                       name="search" 
                       value="{{ search }}" 
                       placeholder="Rechercher par email, nom, prénom..." 
                       class="search-input"
                       style="padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem; min-width: 250px;">
                
                <select name="role" class="filter-select" style="padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem; background: white; min-width: 150px;">
                    <option value="">Tous les rôles</option>
                    <option value="client" {% if app.request.query.get('role') == 'client' %}selected{% endif %}>Client</option>
                    <option value="admin" {% if app.request.query.get('role') == 'admin' %}selected{% endif %}>Administrateur</option>
                </select>
                
                <select name="status" class="filter-select" style="padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem; background: white; min-width: 150px;">
                    <option value="">Tous les statuts</option>
                    <option value="actif" {% if app.request.query.get('status') == 'actif' %}selected{% endif %}>Actif</option>
                    <option value="bloque" {% if app.request.query.get('status') == 'bloque' %}selected{% endif %}>Bloqué</option>
                </select>
                
                <input type="date" 
                       name="date_from" 
                       value="{{ app.request.query.get('date_from') }}" 
                       class="date-input"
                       placeholder="Date début"
                       title="Date de création minimale"
                       style="padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem; width: 130px;">
                
                <input type="date" 
                       name="date_to" 
                       value="{{ app.request.query.get('date_to') }}" 
                       class="date-input"
                       placeholder="Date fin"
                       title="Date de création maximale"
                       style="padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem; width: 130px;">
                
                <button type="submit" class="btn-primary" style="padding: 0.75rem 1rem;">
                    <i class="fas fa-search"></i> Rechercher
                </button>
                
                {% if search or app.request.query.get('role') or app.request.query.get('status') or app.request.query.get('date_from') or app.request.query.get('date_to') %}
                    <a href="{{ path('admin_clients') }}" 
                       class="btn-outline"
                       style="background-color: var(--text-muted); color: white; border-color: var(--text-muted); padding: 0.75rem 1rem;">
                        <i class="fas fa-times"></i> Effacer
                    </a>
                {% endif %}
            </form>
            
            <!-- Bouton PDF -->
            <a href="{{ path('admin_download_pdf') }}" 
               class="btn-danger"
               style="background: linear-gradient(135deg, var(--danger-color), #c82333);">
                <i class="fas fa-file-pdf"></i> Télécharger PDF
            </a>
        </div>
    </div>

    <!-- Résultats de recherche -->
    {% if search %}
        <div style="background: linear-gradient(135deg, #e3f2fd, #bbdefb); padding: 1rem 1.5rem; border-radius: 12px; margin-bottom: 1.5rem; border-left: 4px solid var(--info-color); box-shadow: var(--shadow-sm);">
            <i class="fas fa-info-circle" style="color: var(--info-color); margin-right: 0.5rem;"></i>
            <span style="color: var(--info-color); font-weight: 500;">
                {% if clients|length > 0 %}
                    {{ clients|length }} résultat(s) trouvé(s) pour "{{ search }}"
                {% else %}
                    Aucun résultat trouvé pour "{{ search }}"
                {% endif %}
            </span>
        </div>
    {% endif %}

    <!-- Statistiques des clients -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
        <!-- Total clients -->
        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 1.5rem; border-radius: 12px; color: white; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div>
                    <p style="margin: 0; font-size: 0.875rem; opacity: 0.9;">Total Clients</p>
                    <h3 style="margin: 0.5rem 0 0 0; font-size: 2rem; font-weight: 700;">{{ clients|length }}</h3>
                </div>
                <i class="fas fa-users" style="font-size: 2.5rem; opacity: 0.3;"></i>
            </div>
        </div>
        
        <!-- Clients actifs -->
        <div style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); padding: 1.5rem; border-radius: 12px; color: white; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div>
                    <p style="margin: 0; font-size: 0.875rem; opacity: 0.9;">Clients Actifs</p>
                    <h3 style="margin: 0.5rem 0 0 0; font-size: 2rem; font-weight: 700;">
                        {% set activeCount = 0 %}
                        {% for client in clients %}
                            {% if client.etatCompte == 'actif' %}
                                {% set activeCount = activeCount + 1 %}
                            {% endif %}
                        {% endfor %}
                        {{ activeCount }}
                    </h3>
                </div>
                <i class="fas fa-user-check" style="font-size: 2.5rem; opacity: 0.3;"></i>
            </div>
        </div>
        
        <!-- Clients inactifs -->
        <div style="background: linear-gradient(135deg, #fc4a1a 0%, #f7b733 100%); padding: 1.5rem; border-radius: 12px; color: white; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div>
                    <p style="margin: 0; font-size: 0.875rem; opacity: 0.9;">Clients Bloqués</p>
                    <h3 style="margin: 0.5rem 0 0 0; font-size: 2rem; font-weight: 700;">
                        {% set inactiveCount = 0 %}
                        {% for client in clients %}
                            {% if client.etatCompte != 'actif' %}
                                {% set inactiveCount = inactiveCount + 1 %}
                            {% endif %}
                        {% endfor %}
                        {{ inactiveCount }}
                    </h3>
                </div>
                <i class="fas fa-user-slash" style="font-size: 2.5rem; opacity: 0.3;"></i>
            </div>
        </div>
    </div>

    <!-- Tableau des clients -->
    {% if clients|length > 0 %}
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th><i class="fas fa-hashtag"></i> ID</th>
                        <th><i class="fas fa-user"></i> Nom</th>
                        <th><i class="fas fa-user"></i> Prénom</th>
                        <th><i class="fas fa-envelope"></i> Email</th>
                        <th><i class="fas fa-user-tag"></i> Rôle</th>
                        <th><i class="fas fa-toggle-on"></i> État</th>
                        <th><i class="fas fa-calendar"></i> Date Création</th>
                        <th><i class="fas fa-cogs"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for client in clients %}
                    <tr>
                        <td><strong>{{ client.id }}</strong></td>
                        <td>{{ client.nom }}</td>
                        <td>{{ client.prenom }}</td>
                        <td><i class="fas fa-envelope" style="color: var(--text-muted); margin-right: 0.5rem;"></i> {{ client.email }}</td>
                        <td>
                            <span class="status-badge status-success">
                                {{ 'ROLE_ADMIN' in client.roles ? 'Administrateur' : 'Client' }}
                            </span>
                        </td>
                        <td>
                            {% if client.etatCompte == 'actif' %}
                                <span class="status-badge status-success">
                                    <i class="fas fa-check-circle"></i> Actif
                                </span>
                            {% else %}
                                <span class="status-badge status-danger">
                                    <i class="fas fa-times-circle"></i> Bloqué
                                </span>
                            {% endif %}
                        </td>
                        <td>{{ client.dateCreation ? client.dateCreation|date('d/m/Y') : '-' }}</td>
                        <td>
                            <div class="actions-container">
                                <a href="{{ path('admin_client_edit', {id: client.id}) }}" class="btn btn-outline">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                <form method="post" action="{{ path('admin_client_toggle_status', {id: client.id}) }}" class="action-form">
                                    <button type="submit" class="btn btn-warning">
                                        <i class="fas fa-toggle-{{ client.etatCompte == 'actif' ? 'off' : 'on' }}"></i> 
                                        {{ client.etatCompte == 'actif' ? 'Bloquer' : 'Activer' }}
                                    </button>
                                </form>
                                <form method="post" action="{{ path('admin_client_delete', {id: client.id}) }}" class="action-form" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce client ?');">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="fas fa-trash"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="empty-state">
            <i class="fas fa-users-slash"></i>
            <h3>Aucun client trouvé</h3>
            <p>Aucun client n'est encore inscrit ou ne correspond à votre recherche.</p>
            <a href="{{ path('admin_client_new') }}" class="btn-primary">
                <i class="fas fa-user-plus"></i> Ajouter un Client
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
