{% extends 'admin/_base.html.twig' %}

{% block page_title %}Modifier un Client{% endblock %}
{% block page_subtitle %}Modifier les informations du client{% endblock %}

{% block main %}
<div class="page-content">
    <div class="stat-card" style="max-width: 600px; margin: 0 auto;">
        <h3 style="margin-bottom: 1.5rem;">Modifier le client : {{ client.nom }} {{ client.prenom }}</h3>
        
        <form method="post" style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div>
                <label for="nom" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text-main);">
                    Nom *
                </label>
                <input type="text" 
                       id="nom" 
                       name="nom" 
                       value="{{ client.nom }}" 
                       required
                       style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 0.25rem; font-size: 1rem;">
            </div>

            <div>
                <label for="prenom" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text-main);">
                    Prénom *
                </label>
                <input type="text" 
                       id="prenom" 
                       name="prenom" 
                       value="{{ client.prenom }}" 
                       required
                       style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 0.25rem; font-size: 1rem;">
            </div>

            <div>
                <label for="email" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text-main);">
                    Email *
                </label>
                <input type="email" 
                       id="email" 
                       name="email" 
                       value="{{ client.email }}" 
                       required
                       style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 0.25rem; font-size: 1rem;">
            </div>

            <div>
                <label for="mot_de_passe" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text-main);">
                    Nouveau mot de passe (laisser vide pour ne pas changer)
                </label>
                <input type="password" 
                       id="mot_de_passe" 
                       name="mot_de_passe" 
                       placeholder="Entrez un nouveau mot de passe si souhaité"
                       style="width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 0.25rem; font-size: 1rem;">
                <small style="color: var(--muted-foreground); display: block; margin-top: 0.25rem;">
                    Si vous ne souhaitez pas modifier le mot de passe, laissez ce champ vide.
                </small>
            </div>

            <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1rem;">
                <a href="{{ path('admin_dashboard') }}" 
                   class="btn btn-outline" 
                   style="background-color: transparent; border: 1px solid var(--primary-color); color: var(--primary-color); padding: 0.75rem 1.5rem; border-radius: 0.25rem; text-decoration: none; font-weight: 500;">
                    Annuler
                </a>
                <button type="submit" 
                        class="btn btn-primary" 
                        style="background-color: var(--primary-color); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 0.25rem; font-weight: 500; cursor: pointer;">
                    Enregistrer les modifications
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
