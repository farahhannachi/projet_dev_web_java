{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}Modifier Stock{% endblock %}
{% block page_subtitle %}Modifier les informations du stock{% endblock %}

{% block main %}
<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-edit"></i> Formulaire de Modification</h3>
    </div>
    <div class="card-body">
        <form method="post" class="admin-form" novalidate>
            <div class="form-row">
                <div class="form-group">
                    <label for="seuil_alerte" class="form-label">
                        <i class="fas fa-exclamation-triangle"></i> Seuil d'Alerte *
                    </label>
                    <input type="number" 
                           id="seuil_alerte" 
                           name="seuil_alerte" 
                           value="{{ stock.seuilAlerte }}" 
                           min="0"
                           required
                           class="form-control"
                           placeholder="Entrez le seuil d'alerte">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="date_expiration" class="form-label">
                        <i class="fas fa-calendar-alt"></i> Date d'Expiration
                    </label>
                    <input type="date" 
                           id="date_expiration" 
                           name="date_expiration" 
                           value="{{ stock.dateExpiration ? stock.dateExpiration|date('Y-m-d') : '' }}" 
                           class="form-control"
                           min="{{ 'now'|date('Y-m-d') }}">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="etat_stock" class="form-label">
                        <i class="fas fa-toggle-on"></i> État du Stock *
                    </label>
                    <select id="etat_stock" 
                            name="etat_stock" 
                            required
                            class="form-control">
                        <option value="disponible" {{ stock.etatStock == 'disponible' ? 'selected' : '' }}>Disponible</option>
                        <option value="rupture" {{ stock.etatStock == 'rupture' ? 'selected' : '' }}>En rupture</option>
                        <option value="alerte" {{ stock.etatStock == 'alerte' ? 'selected' : '' }}>Alerte</option>
                    </select>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Enregistrer les Modifications
                </button>
                <a href="{{ path('admin_stocks') }}" class="btn btn-outline">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
                <form method="post" action="{{ path('admin_stock_delete', {id: stock.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce stock ?');">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Supprimer
                    </button>
                </form>
            </div>
        </form>
    </div>
</div>
{% endblock %}
