{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}Modifier Promotion{% endblock %}
{% block page_subtitle %}Modifier les informations de la promotion{% endblock %}

{% block main %}
<div style="padding: 2rem;">
    {% for message in app.flashes('success') %}
        <div class="alert-success">
            <i class="fas fa-check-circle"></i> {{ message }}
        </div>
    {% endfor %}

    <div style="background: white; border-radius: 12px; box-shadow: var(--shadow-md); padding: 2rem; max-width: 800px; margin: 0 auto;">
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('promotion' ~ promotion.id) }}">
            
            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--dark-color);">Titre de la promotion</label>
                <input type="text" name="titre" value="{{ promotion.titre }}" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem;">
            </div>
            
            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--dark-color);">Description</label>
                <textarea name="description" rows="3" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem; resize: vertical;">{{ promotion.description }}</textarea>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--dark-color);">Valeur de réduction</label>
                    <input type="number" name="valeur_reduction" step="0.01" min="0" value="{{ promotion.valeurReduction }}" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem;">
                </div>
                
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--dark-color);">Statut</label>
                    <select name="statut" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem;">
                        <option value="active" {{ promotion.statut == 'active' ? 'selected' : '' }}>Active</option>
                        <option value="inactive" {{ promotion.statut == 'inactive' ? 'selected' : '' }}>Inactive</option>
                    </select>
                </div>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--dark-color);">Date de début</label>
                    <input type="date" name="date_debut" value="{{ promotion.dateDebut ? promotion.dateDebut|date('Y-m-d') : '' }}" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem;">
                </div>
                
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--dark-color);">Date de fin</label>
                    <input type="date" name="date_fin" value="{{ promotion.dateFin ? promotion.dateFin|date('Y-m-d') : '' }}" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem;">
                </div>
            </div>
            
            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--dark-color);">Produit (optionnel)</label>
                <select name="id_produit" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem;">
                    <option value="">Aucun produit</option>
                    {% for produit in produits %}
                        <option value="{{ produit.id }}" {{ promotion.produit and promotion.produit.id == produit.id ? 'selected' : '' }}>{{ produit.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            
            <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--border-color);">
                <a href="{{ path('admin_promotions') }}" class="btn btn-outline">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Mettre à jour
                </button>
            </div>
        </form>
    </div>
</div>

<style>
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: var(--transition);
    border: 1px solid transparent;
}
.btn-primary {
    background: var(--primary-color);
    color: white;
    border-color: var(--primary-color);
}
.btn-primary:hover {
    background: var(--primary-dark);
    border-color: var(--primary-dark);
}
.btn-outline {
    background: white;
    color: var(--primary-color);
    border-color: var(--primary-color);
}
.btn-outline:hover {
    background: var(--primary-color);
    color: white;
}
.alert-success {
    background: var(--secondary-color);
    color: white;
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
</style>
{% endblock %}
                        <th style="text-align: right; padding: 0.75rem;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for promo in promotions %}
                    <tr style="border-bottom: 1px solid var(--border);">
                        <td style="padding: 0.75rem;">{{ promo.description }}</td>
                        <td style="padding: 0.75rem;">{{ promo.reduction }}</td>
                        <td style="padding: 0.75rem;">{{ promo.dateDebut|date('d/m/Y') }}</td>
                        <td style="padding: 0.75rem;">{{ promo.dateFin|date('d/m/Y') }}</td>
                        <td style="padding: 0.75rem; text-align: right;">
                            <a href="{{ path('app_admin_promotion_edit', {id: promo.idPromotion}) }}" class="btn btn-sm btn-outline">Modifier</a>
                            <form method="post" action="{{ path('app_admin_promotion_delete', {id: promo.idPromotion}) }}" style="display: inline;" onsubmit="return confirm('Supprimer cette promotion ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ promo.idPromotion) }}">
                                <button type="submit" class="btn btn-sm" style="color: var(--destructive);">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p style="color: var(--muted-foreground);">Aucune promotion. <a href="{{ path('app_admin_promotion_new') }}">Ajouter une promotion</a></p>
        {% endif %}
    </div>
</div>
{% endblock %}
