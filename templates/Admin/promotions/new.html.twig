{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}Nouvelle Promotion{% endblock %}
{% block page_subtitle %}Créer une nouvelle promotion{% endblock %}

{% block main %}
<div style="padding: 2rem;">
    {% for message in app.flashes('success') %}
        <div class="alert-success">
            <i class="fas fa-check-circle"></i> {{ message }}
        </div>
    {% endfor %}

    <div style="background: white; border-radius: 12px; box-shadow: var(--shadow-md); padding: 2rem; max-width: 800px; margin: 0 auto;">
        <form method="post">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--dark-color);">Titre de la promotion</label>
                    <input type="text" name="titre" placeholder="Ex: Soldes d'été" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem;">
                </div>
                
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--dark-color);">Description</label>
                    <textarea name="description" rows="3" placeholder="Description détaillée de la promotion" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem; resize: vertical;"></textarea>
                </div>
            </div>
            
            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--dark-color);">Valeur de réduction (%)</label>
                <input type="number" name="valeur_reduction" step="0.01" min="0" max="100" placeholder="20" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem;">
            </div>

            <div style="margin-bottom: 1.5rem;">
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--dark-color);">Statut</label>
                    <select name="statut" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem;">
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--dark-color);">Date de début</label>
                    <input type="date" name="date_debut" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem;">
                </div>
                
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--dark-color);">Date de fin</label>
                    <input type="date" name="date_fin" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem;">
                </div>
            </div>
            
            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--dark-color);">Produit (optionnel)</label>
                <select name="id_produit" style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.875rem;">
                    <option value="">Sélectionner un produit</option>
                    {% for produit in produits %}
                        <option value="{{ produit.id }}">{{ produit.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            
            <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--border-color);">
                <a href="{{ path('admin_promotions') }}" class="btn btn-outline">
                    <i class="fas fa-arrow-left"></i> Annuler
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Créer la Promotion
                </button>
            </div>
        </form>
    </div>
</div>

<style>
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: var(--transition);
    border: 1px solid transparent;
}
.btn-primary {
    background: var(--primary-color);
    color: white;
    border-color: var(--primary-color);
}
.btn-primary:hover {
    background: var(--primary-dark);
    border-color: var(--primary-dark);
}
.btn-outline {
    background: white;
    color: var(--primary-color);
    border-color: var(--primary-color);
}
.btn-outline:hover {
    background: var(--primary-color);
    color: white;
}
.alert-success {
    background: var(--secondary-color);
    color: white;
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
</style>
{% endblock %}
