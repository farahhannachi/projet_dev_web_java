{% extends 'admin/_base_modern.html.twig' %}

{% block title %}Ticket #{{ question.id }} - {{ question.objet }} - Admin{% endblock %}

{% block page_title %}Ticket #{{ question.id }}{% endblock %}
{% block page_subtitle %}{{ question.objet }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .ticket-container {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
        }
        .ticket-main {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        .ticket-sidebar {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        .card {
            background: white;
            border-radius: 8px;
            padding: 25px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .card h3 {
            margin: 0 0 20px 0;
            padding-bottom: 15px;
            border-bottom: 2px solid #f0f0f0;
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #f5f5f5;
        }
        .info-row:last-child {
            border-bottom: none;
        }
        .info-label {
            font-weight: 600;
            color: #666;
        }
        .badge {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: 600;
            display: inline-block;
        }
        .badge-ouvert { background: #E8F5E9; color: #388E3C; }
        .badge-en_cours { background: #FFF9C4; color: #F57F17; }
        .badge-resolu { background: #C8E6C9; color: #2E7D32; }
        .badge-ferme { background: #BDBDBD; color: #424242; }
        .badge-haute { background: #FFCDD2; color: #C62828; }
        .badge-normale { background: #FFE0B2; color: #E65100; }
        .badge-basse { background: #F5F5F5; color: #616161; }
        .response-item {
            background: #f9f9f9;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 15px;
            border-left: 4px solid #e0e0e0;
        }
        .response-item.agent {
            background: #E3F2FD;
            border-left-color: #1976D2;
        }
        .response-item.client {
            background: #FFF9C4;
            border-left-color: #F57F17;
        }
        .response-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(0,0,0,0.1);
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #333;
        }
        .form-control {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 15px;
        }
        .form-control:focus {
            outline: none;
            border-color: #16563f;
            box-shadow: 0 0 0 3px rgba(22, 86, 63, 0.1);
        }
        .form-select {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            background: white;
            cursor: pointer;
        }
        textarea.form-control {
            min-height: 120px;
            resize: vertical;
        }
        .btn-primary {
            background: linear-gradient(135deg, #16563f, #0f3d2a);
            color: white;
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(22, 86, 63, 0.2);
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #1e6b47, #16563f);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(22, 86, 63, 0.3);
        }
        .btn-back {
            background: #e0e0e0;
            color: #333;
            padding: 10px 20px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 20px;
        }
        .btn-back:hover {
            background: #d0d0d0;
            color: #333;
        }
        .btn-edit {
            background: linear-gradient(135deg, #16563f, #0f3d2a);
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
            margin-left: 10px;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(22, 86, 63, 0.2);
        }
        .btn-edit:hover {
            background: linear-gradient(135deg, #1e6b47, #16563f);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(22, 86, 63, 0.3);
        }
        .btn-delete {
            background: #dc3545;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            margin-left: 10px;
        }
        .btn-delete:hover {
            background: #c82333;
        }
        .btn-pdf {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(231, 76, 60, 0.2);
        }
        .btn-pdf:hover {
            background: linear-gradient(135deg, #c0392b, #a93226);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(231, 76, 60, 0.3);
        }
        .action-buttons {
            display: flex;
            gap: 10px;
            align-items: center;
            margin-bottom: 20px;
        }
        .action-badge {
            background: #FFF9C4;
            padding: 12px 15px;
            border-radius: 6px;
            margin-top: 10px;
            border-left: 3px solid #F57F17;
        }
        .file-link {
            display: inline-block;
            background: #f5f5f5;
            padding: 8px 15px;
            border-radius: 6px;
            margin-top: 10px;
            text-decoration: none;
            color: #16563f;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .file-link:hover {
            background: #e0e0e0;
            color: #0f3d2a;
        }
    </style>
{% endblock %}

{% block main %}
<div class="main-content">
    <div class="action-buttons">
        <a href="{{ path('app_question_index') }}" class="btn-back">← Retour à la liste</a>
        <a href="{{ path('app_question_edit', {id: question.id}) }}" class="btn-edit">✏️ Modifier</a>
        <form method="post" action="{{ path('app_question_delete', {id: question.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce ticket ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ question.id) }}">
            <button type="submit" class="btn-delete">🗑️ Supprimer</button>
        </form>
        <a href="{{ path('app_question_export_pdf', {id: question.id}) }}" class="btn-pdf" title="Exporter en PDF">📄 Exporter PDF</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger" style="background: #f8d7da; color: #721c24; padding: 15px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #dc3545;">
            ⚠️ {{ message }}
        </div>
    {% endfor %}
    
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning" style="background: #fff3cd; color: #856404; padding: 15px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #ffc107;">
            ⚠️ {{ message }}
        </div>
    {% endfor %}

    <div class="ticket-container">
        {# Colonne principale #}
        <div class="ticket-main">
            {# Description du ticket #}
            <div class="card">
                <h3>Description du problème</h3>
                <p style="color: #333; line-height: 1.7; white-space: pre-wrap;">{{ question.description }}</p>
                {% if question.fileName %}
                    <a href="{{ question.filePath }}" target="_blank" class="file-link">
                        📎 {{ question.fileName }}
                    </a>
                {% endif %}
            </div>

            {# Réponses #}
            <div class="card">
                <h3>Conversation ({{ reponses|length }} réponses)</h3>
                
                {% if reponses is empty %}
                    <p style="text-align: center; color: #999; padding: 40px 0;">
                        Aucune réponse pour le moment
                    </p>
                {% else %}
                    {% for reponse in reponses %}
                        <div class="response-item {{ reponse.auteurType }}">
                            <div class="response-header">
                                <div>
                                    <strong>
                                        {% if reponse.utilisateur %}
                                            {% if reponse.auteurType == 'agent' %}
                                                👨‍💼 {{ reponse.utilisateur.nom }} {{ reponse.utilisateur.prenom }} (Support)
                                            {% else %}
                                                👤 {{ reponse.utilisateur.nom }} {{ reponse.utilisateur.prenom }} (Client)
                                            {% endif %}
                                        {% else %}
                                            🤖 Système automatique
                                        {% endif %}
                                    </strong>
                                    {% if reponse.reponseRole != 'question' %}
                                        <span class="badge" style="background: #E0E0E0; color: #666; margin-left: 8px;">
                                            {{ reponse.reponseRole|replace({'_': ' '})|capitalize }}
                                        </span>
                                    {% endif %}
                                </div>
                                <small style="color: #999;">{{ reponse.createdAt|date('d/m/Y à H:i') }}</small>
                            </div>
                            
                            <p style="margin: 0; line-height: 1.6; white-space: pre-wrap;">{{ reponse.reponseText }}</p>

                            {% if reponse.actionType != 'aucune' %}
                                <div class="action-badge">
                                    <strong>⚡ Action prise:</strong> {{ reponse.actionType|replace({'_': ' '})|capitalize }}
                                </div>
                            {% endif %}

                            {% if reponse.fileName %}
                                <a href="{{ reponse.filePath }}" target="_blank" class="file-link">
                                    📎 {{ reponse.fileName }}
                                </a>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

            {# Formulaire de réponse #}
            {% if question.statut != 'ferme' %}
                <div class="card">
                    <h3>Ajouter une réponse</h3>
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                        {{ form_errors(form) }}
                        <div class="form-group">
                            {{ form_label(form.reponseText, 'Votre réponse') }}
                            {{ form_widget(form.reponseText, {'attr': {'class': 'form-control', 'placeholder': 'Tapez votre réponse au client...'}}) }}
                            {{ form_errors(form.reponseText) }}
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px;">
                            <div class="form-group">
                                {{ form_label(form.reponseRole, 'Type de réponse') }}
                                {{ form_widget(form.reponseRole, {'attr': {'class': 'form-select'}}) }}
                                {{ form_errors(form.reponseRole) }}
                            </div>

                            <div class="form-group">
                                {{ form_label(form.actionType, 'Action') }}
                                {{ form_widget(form.actionType, {'attr': {'class': 'form-select'}}) }}
                                {{ form_errors(form.actionType) }}
                            </div>

                            <div class="form-group">
                                {{ form_label(form.impactStatut, 'Impact sur statut') }}
                                {{ form_widget(form.impactStatut, {'attr': {'class': 'form-select'}}) }}
                                {{ form_errors(form.impactStatut) }}
                                <small style="color: #666; font-size: 0.85em;">Changera le statut du ticket automatiquement</small>
                            </div>
                        </div>

                        <div class="form-group">
                            {{ form_label(form.fichier, 'Pièce jointe (optionnelle)') }}
                            {{ form_widget(form.fichier, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.fichier) }}
                        </div>

                        <button type="submit" class="btn-primary">📤 Envoyer la réponse</button>
                    {{ form_end(form) }}
                </div>
            {% else %}
                <div class="card" style="background: #FFF3E0; text-align: center;">
                    ⚠️ Ce ticket est fermé
                </div>
            {% endif %}
        </div>

        {# Sidebar #}
        <div class="ticket-sidebar">
            {# Informations du ticket #}
            <div class="card">
                <h3>Informations</h3>
                <div class="info-row">
                    <span class="info-label">Ticket ID</span>
                    <strong>#{{ question.id }}</strong>
                </div>
                <div class="info-row">
                    <span class="info-label">Type</span>
                    <span>{{ question.typeTicket|capitalize }}</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Priorité</span>
                    <span class="badge badge-{{ question.priorite }}">
                        {{ question.priorite|capitalize }}
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Statut</span>
                    <span class="badge badge-{{ question.statut }}">
                        {% if question.statut == 'ouvert' %}Ouvert
                        {% elseif question.statut == 'en_cours' %}En cours
                        {% elseif question.statut == 'resolu' %}Résolu
                        {% else %}Fermé{% endif %}
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Créé le</span>
                    <span>{{ question.createdAt|date('d/m/Y à H:i') }}</span>
                </div>
            </div>

            {# Informations client #}
            <div class="card">
                <h3>Client</h3>
                <div class="info-row">
                    <span class="info-label">Nom</span>
                    <span>{{ question.utilisateur.nom }} {{ question.utilisateur.prenom }}</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Email</span>
                    <span>{{ question.utilisateur.email }}</span>
                </div>
                {% if question.utilisateur.telephone %}
                    <div class="info-row">
                        <span class="info-label">Téléphone</span>
                        <span>{{ question.utilisateur.telephone }}</span>
                    </div>
                {% endif %}
            </div>

            {# Changer le statut et la priorité #}
            <div class="card">
                <h3>Modifier le ticket</h3>
                <form method="post" action="{{ path('app_question_update_statut', {id: question.id}) }}">
                    <div class="form-group">
                        <label for="statut">Statut</label>
                        <select name="statut" id="statut" class="form-select">
                            <option value="ouvert" {% if question.statut == 'ouvert' %}selected{% endif %}>Ouvert</option>
                            <option value="en_cours" {% if question.statut == 'en_cours' %}selected{% endif %}>En cours</option>
                            <option value="resolu" {% if question.statut == 'resolu' %}selected{% endif %}>Résolu</option>
                            <option value="ferme" {% if question.statut == 'ferme' %}selected{% endif %}>Fermé</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="priorite">Priorité</label>
                        <select name="priorite" id="priorite" class="form-select">
                            <option value="basse" {% if question.priorite == 'basse' %}selected{% endif %}>Basse</option>
                            <option value="normale" {% if question.priorite == 'normale' %}selected{% endif %}>Normale</option>
                            <option value="haute" {% if question.priorite == 'haute' %}selected{% endif %}>Haute</option>
                        </select>
                    </div>
                    <button type="submit" class="btn-primary" style="width: 100%;">💾 Enregistrer les modifications</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
