{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}Gestion des Dépôts{% endblock %}
{% block page_subtitle %}Liste de tous les dépôts{% endblock %}

{% block main %}
<div style="padding: 2rem;">
    {% for message in app.flashes('success') %}
        <div class="alert-success">
            <i class="fas fa-check-circle"></i> {{ message }}
        </div>
    {% endfor %}

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <h2 style="margin: 0; color: var(--primary-color); font-size: 1.75rem; font-weight: 600;">
            <i class="fas fa-warehouse"></i> Gestion des Dépôts
        </h2>
        <a href="{{ path('admin_depot_new') }}" class="btn-primary">
            <i class="fas fa-plus-circle"></i> Nouveau Dépôt
        </a>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th><i class="fas fa-hashtag"></i> ID</th>
                    <th><i class="fas fa-building"></i> Nom du Dépôt</th>
                    <th><i class="fas fa-map-marker-alt"></i> Adresse</th>
                    <th><i class="fas fa-boxes"></i> Capacité</th>
                    <th><i class="fas fa-user-tie"></i> Responsable</th>
                    <th><i class="fas fa-calendar"></i> Date de Création</th>
                    <th><i class="fas fa-cogs"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for depot in depots %}
                <tr>
                    <td><strong>{{ depot.id }}</strong></td>
                    <td>{{ depot.nomDepot }}</td>
                    <td><i class="fas fa-map-marker-alt" style="color: var(--text-muted); margin-right: 0.5rem;"></i> {{ depot.adresseDepot }}</td>
                    <td>{{ depot.capaciteDepot }}</td>
                    <td><i class="fas fa-user-tie" style="color: var(--text-muted); margin-right: 0.5rem;"></i> {{ depot.responsableDepot }}</td>
                    <td>{{ depot.dateCreation ? depot.dateCreation|date('d/m/Y') : '' }}</td>
                    <td>
                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                            <a href="{{ path('admin_depot_edit', {id: depot.id}) }}" class="btn-outline" style="padding: 0.5rem 1rem; font-size: 0.875rem;">
                                <i class="fas fa-edit"></i> Modifier
                            </a>
                            <form method="post" action="{{ path('admin_depot_delete', {id: depot.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce dépôt ?');">
                                <button type="submit" class="btn-danger" style="padding: 0.5rem 1rem; font-size: 0.875rem;">
                                    <i class="fas fa-trash"></i> Supprimer
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
