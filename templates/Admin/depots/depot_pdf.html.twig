<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        /* Police sûre pour wkhtmltopdf */
        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            font-size: 14px;
            margin: 0;
            padding: 0;
            line-height: 1.4;
        }

        .container {
            padding: 30px;
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
        }

        .info-table, .stocks-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        .info-table td, .stocks-table th, .stocks-table td {
            border: 1px solid #ccc;
            padding: 8px;
        }

        .info-table .label {
            font-weight: bold;
            background-color: #f5f5f5;
            width: 30%;
        }

        .stocks-table th {
            background-color: #eee;
        }

        .footer {
            position: fixed;
            bottom: 10px;
            width: 100%;
            text-align: center;
            font-size: 12px;
            color: gray;
        }
    </style>
</head>
<body>
<div class="container">

    <h1>Fiche Dépôt</h1>

    <table class="info-table">
        <tr>
            <td class="label">ID Dépôt</td>
            <td>{{ depot.id }}</td>
        </tr>
        <tr>
            <td class="label">Nom</td>
            <td>{{ depot.nomDepot }}</td>
        </tr>
        <tr>
            <td class="label">Adresse</td>
            <td>{{ depot.adresseDepot }}</td>
        </tr>
        <tr>
            <td class="label">Ville</td>
            <td>{{ depot.ville ?? 'Non spécifiée' }}</td>
        </tr>
        <tr>
            <td class="label">Capacité</td>
            <td>{{ depot.capaciteDepot }}</td>
        </tr>
        <tr>
            <td class="label">Responsable</td>
            <td>{{ depot.responsableDepot }}</td>
        </tr>
        <tr>
            <td class="label">Date de création</td>
            <td>{{ depot.dateCreation ? depot.dateCreation|date('d/m/Y') : 'Non définie' }}</td>
        </tr>
    </table>

    <h2>Stocks associés</h2>

    {% if depot.stocks|length > 0 %}
        <table class="stocks-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Information Stock</th>
                </tr>
            </thead>
            <tbody>
                {% for stock in depot.stocks %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>{{ stock }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>Aucun stock associé à ce dépôt.</p>
    {% endif %}

</div>

<div class="footer">
    Généré le {{ "now"|date("d/m/Y H:i") }}
</div>

</body>
</html>
