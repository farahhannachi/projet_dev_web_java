<table class="data-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Numéro</th>
            <th>Patient</th>
            <th>Date Ordonnance</th>
            <th>Date Expiration</th>
            <th>Statut</th>
            <th>Signature</th>
            <th>Traitements</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for ordonnance in ordonnances %}
        <tr>
            <td>{{ ordonnance.id }}</td>
            <td><strong>{{ ordonnance.numeroOrdonnance }}</strong></td>
            <td>{{ ordonnance.utilisateur.nom }} {{ ordonnance.utilisateur.prenom }}</td>
            <td>{{ ordonnance.dateOrdonnance|date('d/m/Y') }}</td>
            <td>{{ ordonnance.dateExpiration|date('d/m/Y') }}</td>
            <td>
                <span class="badge badge-{{ ordonnance.statut == 'validé' ? 'success' : (ordonnance.statut == 'rejeté' ? 'danger' : 'warning') }}">
                    {{ ordonnance.statut }}
                </span>
            </td>
            <td>
                {% if ordonnance.signaturePatient or ordonnance.signatureMedecin %}
                    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                        <!-- Signature Patient -->
                        {% if ordonnance.signaturePatient %}
                            <div style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); padding: 0.5rem 0.75rem; border-radius: 6px; border-left: 3px solid #3b82f6;">
                                <div style="display: flex; align-items: center; gap: 0.25rem; margin-bottom: 0.25rem;">
                                    <span style="font-size: 0.875rem;">👤</span>
                                    <span style="font-size: 0.75rem; font-weight: 600; color: #1e40af;">Patient</span>
                                </div>
                                <div style="font-size: 0.7rem; color: #1e3a8a;">
                                    ✓ Signé le {{ ordonnance.signaturePatientDate|date('d/m/Y H:i') }}
                                </div>
                            </div>
                        {% else %}
                            <div style="background: #fef3c7; padding: 0.5rem 0.75rem; border-radius: 6px; border-left: 3px solid #f59e0b;">
                                <div style="display: flex; align-items: center; gap: 0.25rem;">
                                    <span style="font-size: 0.875rem;">👤</span>
                                    <span style="font-size: 0.75rem; font-weight: 600; color: #92400e;">Patient: Non signé</span>
                                </div>
                            </div>
                        {% endif %}
                        
                        <!-- Signature Médecin -->
                        {% if ordonnance.signatureMedecin %}
                            <div style="background: linear-gradient(135deg, #d1fae5, #a7f3d0); padding: 0.5rem 0.75rem; border-radius: 6px; border-left: 3px solid #10b981;">
                                <div style="display: flex; align-items: center; gap: 0.25rem; margin-bottom: 0.25rem;">
                                    <span style="font-size: 0.875rem;">👨‍⚕️</span>
                                    <span style="font-size: 0.75rem; font-weight: 600; color: #065f46;">Médecin</span>
                                </div>
                                <div style="font-size: 0.7rem; color: #064e3b;">
                                    {{ ordonnance.signatureMedecin }}
                                </div>
                                {% if ordonnance.signatureDate %}
                                    <div style="font-size: 0.7rem; color: #064e3b;">
                                        ✓ {{ ordonnance.signatureDate|date('d/m/Y H:i') }}
                                    </div>
                                {% endif %}
                            </div>
                        {% else %}
                            <button class="btn-sm btn-signature" onclick="openSignatureAdminModal({{ ordonnance.id }}, '{{ ordonnance.numeroOrdonnance }}')" style="background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; padding: 0.5rem 0.75rem; border-radius: 6px; cursor: pointer; font-size: 0.75rem; display: flex; align-items: center; gap: 0.25rem; justify-content: center;">
                                <i class="fas fa-signature"></i> Signer (Admin)
                            </button>
                        {% endif %}
                    </div>
                {% else %}
                    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                        <div style="background: #fef3c7; padding: 0.5rem 0.75rem; border-radius: 6px; text-align: center;">
                            <span style="font-size: 0.75rem; color: #92400e;">Aucune signature</span>
                        </div>
                    </div>
                {% endif %}
            </td>
            <td>
                {% set traitements = traitementsByOrdonnance[ordonnance.id] %}
                {% if traitements is not empty %}
                    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                        {% for traitement in traitements %}
                            <div style="background: #f3f4f6; padding: 0.5rem 0.75rem; border-radius: 6px; font-size: 0.875rem;">
                                {% if traitement.produit %}
                                    <div style="font-weight: 600; color: #16563f; margin-bottom: 0.25rem;">
                                        💊 {{ traitement.produit.nom }}
                                    </div>
                                    <div style="color: #6b7280; font-size: 0.75rem;">
                                        {{ traitement.produit.categorie }}
                                    </div>
                                {% else %}
                                    <div style="color: #6b7280;">
                                        Traitement #{{ traitement.id }}
                                    </div>
                                {% endif %}
                                <div style="margin-top: 0.25rem;">
                                    <span class="badge badge-{{ traitement.status == 'validé' or traitement.status == 'actif' ? 'success' : (traitement.status == 'rejeté' ? 'danger' : 'warning') }}" style="font-size: 0.7rem;">
                                        {{ traitement.status }}
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <span style="color: #9ca3af; font-size: 0.875rem;">Aucun traitement</span>
                {% endif %}
            </td>
            <td>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <a href="{{ path('admin_ordonnance_edit', {id: ordonnance.id}) }}" class="btn-sm btn-primary">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    
                    {% if not ordonnance.signatureMedecin %}
                        <button class="btn-sm" onclick="openSignatureAdminModal({{ ordonnance.id }}, '{{ ordonnance.numeroOrdonnance }}')" style="background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; border: none; padding: 0.5rem 0.75rem; border-radius: 6px; cursor: pointer; font-size: 0.875rem; display: flex; align-items: center; gap: 0.5rem; box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3); transition: all 0.3s;">
                            <i class="fas fa-signature"></i> Signer
                        </button>
                    {% endif %}
                    
                    <a href="{{ path('admin_audit_history', {entityType: 'Ordonnance', entityId: ordonnance.id}) }}" class="btn-audit" title="Voir l'historique des modifications">
                        <span class="btn-audit-icon">📊</span>
                        <span class="btn-audit-text">Historique</span>
                        <span class="btn-audit-shine"></span>
                    </a>
                    <form method="post" action="{{ path('admin_ordonnance_delete', {id: ordonnance.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette ordonnance ?');">
                        <button type="submit" class="btn-sm btn-danger">
                            <i class="fas fa-trash"></i> Supprimer
                        </button>
                    </form>
                </div>
            </td>
        </tr>
        {% else %}
        <tr>
            <td colspan="9" style="text-align: center; padding: 2rem;">
                Aucune ordonnance trouvée
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<!-- Modale Signature Admin -->
<div id="signatureAdminModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center;">
    <div style="background: white; border-radius: 20px; padding: 2rem; max-width: 500px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h2 style="font-size: 1.5rem; font-weight: 700; color: #1f2937; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 2rem;">👨‍⚕️</span> Signature Médecin
            </h2>
            <button onclick="closeSignatureAdminModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #9ca3af;">
                ✕
            </button>
        </div>
        
        <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(5, 150, 105, 0.1) 100%); padding: 1rem; border-radius: 12px; margin-bottom: 1.5rem;">
            <p style="margin: 0; font-size: 0.875rem; color: #374151;">
                <strong>Ordonnance:</strong> <span id="modalAdminOrdonnanceNumero"></span>
            </p>
        </div>

        <div style="margin-bottom: 1.5rem;">
            <label style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem;">
                Nom du médecin signataire
            </label>
            <input type="text" id="adminSignerName" placeholder="Dr. Jean Dupont" style="width: 100%; padding: 0.75rem; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 0.875rem;">
        </div>

        <div style="background: #d1fae5; border-left: 4px solid #10b981; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
            <p style="margin: 0; color: #065f46; font-size: 0.875rem;">
                <i class="fas fa-check-circle"></i> Signature électronique instantanée avec code de vérification
            </p>
        </div>

        <div style="display: flex; gap: 1rem; justify-content: flex-end;">
            <button onclick="closeSignatureAdminModal()" style="padding: 0.75rem 1.5rem; background: #6b7280; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                Annuler
            </button>
            <button onclick="submitAdminSignature()" id="btnSubmitAdminSignature" style="padding: 0.75rem 1.5rem; background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-signature"></i>
                <span id="btnAdminSignatureText">Signer maintenant</span>
                <div id="adminSignatureSpinner" style="display: none; width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
            </button>
        </div>
    </div>
</div>

<script>
let currentAdminOrdonnanceId = null;

function openSignatureAdminModal(ordonnanceId, numeroOrdonnance) {
    currentAdminOrdonnanceId = ordonnanceId;
    document.getElementById('modalAdminOrdonnanceNumero').textContent = numeroOrdonnance;
    document.getElementById('signatureAdminModal').style.display = 'flex';
}

function closeSignatureAdminModal() {
    document.getElementById('signatureAdminModal').style.display = 'none';
    document.getElementById('adminSignerName').value = '';
    currentAdminOrdonnanceId = null;
}

async function submitAdminSignature() {
    const nomMedecin = document.getElementById('adminSignerName').value.trim();
    
    if (!nomMedecin) {
        alert('Veuillez entrer le nom du médecin');
        return;
    }
    
    if (!currentAdminOrdonnanceId) {
        alert('Erreur: ID ordonnance manquant');
        return;
    }
    
    const btn = document.getElementById('btnSubmitAdminSignature');
    const btnText = document.getElementById('btnAdminSignatureText');
    const spinner = document.getElementById('adminSignatureSpinner');
    
    btn.disabled = true;
    btnText.textContent = 'Signature en cours...';
    spinner.style.display = 'block';
    
    try {
        const response = await fetch(`/admin/ordonnance/${currentAdminOrdonnanceId}/signer-admin`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                nom_medecin: nomMedecin
            })
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert('✅ ' + data.message + '\n\nCode de vérification: ' + data.code);
            closeSignatureAdminModal();
            location.reload();
        } else {
            alert('Erreur: ' + data.message);
        }
    } catch (error) {
        alert('Erreur: ' + error.message);
    } finally {
        btn.disabled = false;
        btnText.textContent = 'Signer maintenant';
        spinner.style.display = 'none';
    }
}
</script>


<style>
.btn-audit {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.875rem;
    border: none;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
}

.btn-audit::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s;
}

.btn-audit:hover::before {
    left: 100%;
}

.btn-audit:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
}

.btn-audit:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.3);
}

.btn-audit-icon {
    font-size: 1.25rem;
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.1);
    }
}

.btn-audit-text {
    position: relative;
    z-index: 1;
}

.btn-audit-shine {
    position: absolute;
    top: -50%;
    right: -50%;
    width: 20px;
    height: 200%;
    background: rgba(255, 255, 255, 0.3);
    transform: rotate(45deg);
    animation: shine 3s ease-in-out infinite;
}

@keyframes shine {
    0% {
        right: -50%;
    }
    20% {
        right: 150%;
    }
    100% {
        right: 150%;
    }
}
</style>
