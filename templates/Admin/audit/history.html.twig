{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}📊 Historique des Modifications{% endblock %}
{% block page_subtitle %}{{ entityType }} #{{ entityId }}{% endblock %}

{% block main %}
<div style="padding: 2rem;">
    <div style="margin-bottom: 2rem;">
        <button onclick="window.history.back()" class="btn-primary" style="background: #6b7280;">
            <i class="fas fa-arrow-left"></i> Retour
        </button>
    </div>

    {% if history is empty %}
        <div style="background: white; padding: 3rem; border-radius: 12px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="font-size: 4rem; margin-bottom: 1rem;">📋</div>
            <h3 style="color: #6b7280; font-size: 1.25rem; margin: 0;">Aucun historique disponible</h3>
            <p style="color: #9ca3af; margin-top: 0.5rem;">Les modifications futures seront enregistrées ici</p>
        </div>
    {% else %}
        <div style="background: white; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); overflow: hidden;">
            <div style="padding: 1.5rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <h2 style="margin: 0; font-size: 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
                    <span style="font-size: 2rem;">📊</span>
                    Historique complet - {{ history|length }} modification(s)
                </h2>
            </div>

            <div style="padding: 2rem;">
                {% for log in history %}
                    <div style="border-left: 4px solid {{ log.action == 'create' ? '#10b981' : (log.action == 'delete' ? '#ef4444' : '#3b82f6') }}; padding: 1.5rem; margin-bottom: 1.5rem; background: #f9fafb; border-radius: 8px;">
                        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1rem;">
                            <div>
                                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                                    <span style="padding: 0.25rem 0.75rem; background: {{ log.action == 'create' ? '#d1fae5' : (log.action == 'delete' ? '#fee2e2' : '#dbeafe') }}; color: {{ log.action == 'create' ? '#065f46' : (log.action == 'delete' ? '#991b1b' : '#1e40af') }}; border-radius: 6px; font-weight: 600; font-size: 0.875rem;">
                                        {% if log.action == 'create' %}
                                            ✨ CRÉATION
                                        {% elseif log.action == 'update' %}
                                            ✏️ MODIFICATION
                                        {% elseif log.action == 'delete' %}
                                            🗑️ SUPPRESSION
                                        {% endif %}
                                    </span>
                                    <span style="color: #6b7280; font-size: 0.875rem;">
                                        <i class="fas fa-clock"></i> {{ log.createdAt|date('d/m/Y à H:i:s') }}
                                    </span>
                                </div>
                                <div style="color: #374151; font-size: 0.875rem;">
                                    <i class="fas fa-user"></i> 
                                    <strong>{{ log.userName ?? 'Système' }}</strong>
                                    {% if log.ipAddress %}
                                        <span style="color: #9ca3af; margin-left: 0.5rem;">
                                            ({{ log.ipAddress }})
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        {% if log.changedFields and log.changedFields is not empty %}
                            <div style="margin-top: 1rem;">
                                <h4 style="font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.75rem;">
                                    📝 Champs modifiés ({{ log.changedFields|length }}) :
                                </h4>
                                <div style="display: grid; gap: 0.75rem;">
                                    {% for change in log.changedFields %}
                                        <div style="background: white; padding: 1rem; border-radius: 6px; border: 1px solid #e5e7eb;">
                                            <div style="font-weight: 600; color: #16563f; margin-bottom: 0.5rem; font-size: 0.875rem;">
                                                🔹 {{ change.field }}
                                            </div>
                                            <div style="display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center;">
                                                <div>
                                                    <div style="font-size: 0.75rem; color: #6b7280; margin-bottom: 0.25rem;">Ancienne valeur</div>
                                                    <div style="padding: 0.5rem; background: #fef2f2; border-radius: 4px; color: #991b1b; font-family: monospace; font-size: 0.875rem; word-break: break-all;">
                                                        {{ change.old is null ? '(vide)' : (change.old is iterable ? change.old|json_encode : change.old) }}
                                                    </div>
                                                </div>
                                                <div style="color: #9ca3af; font-size: 1.5rem;">→</div>
                                                <div>
                                                    <div style="font-size: 0.75rem; color: #6b7280; margin-bottom: 0.25rem;">Nouvelle valeur</div>
                                                    <div style="padding: 0.5rem; background: #d1fae5; border-radius: 4px; color: #065f46; font-family: monospace; font-size: 0.875rem; word-break: break-all;">
                                                        {{ change.new is null ? '(vide)' : (change.new is iterable ? change.new|json_encode : change.new) }}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% elseif log.action == 'update' and log.oldValues and log.newValues %}
                            {% set hasChanges = false %}
                            {% for field, newValue in log.newValues %}
                                {% set oldValue = log.oldValues[field] ?? null %}
                                {% if oldValue != newValue %}
                                    {% set hasChanges = true %}
                                {% endif %}
                            {% endfor %}
                            
                            {% if hasChanges %}
                                <div style="margin-top: 1rem;">
                                    <h4 style="font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.75rem;">
                                        📝 Champs modifiés :
                                    </h4>
                                    <div style="display: grid; gap: 0.75rem;">
                                        {% for field, newValue in log.newValues %}
                                            {% set oldValue = log.oldValues[field] ?? null %}
                                            {% if oldValue != newValue %}
                                                <div style="background: white; padding: 1rem; border-radius: 6px; border: 1px solid #e5e7eb;">
                                                    <div style="font-weight: 600; color: #16563f; margin-bottom: 0.5rem; font-size: 0.875rem;">
                                                        🔹 {{ field }}
                                                    </div>
                                                    
                                                    {% if oldValue is not null and oldValue != '' %}
                                                        {# Afficher ancienne et nouvelle valeur #}
                                                        <div style="display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center;">
                                                            <div>
                                                                <div style="font-size: 0.75rem; color: #6b7280; margin-bottom: 0.25rem;">Ancienne valeur</div>
                                                                <div style="padding: 0.5rem; background: #fef2f2; border-radius: 4px; color: #991b1b; font-size: 0.875rem; word-break: break-all;">
                                                                    {% if oldValue is iterable %}
                                                                        <pre style="margin: 0; font-family: monospace; white-space: pre-wrap;">{{ oldValue|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                                                                    {% else %}
                                                                        {{ oldValue }}
                                                                    {% endif %}
                                                                </div>
                                                            </div>
                                                            <div style="color: #9ca3af; font-size: 1.5rem;">→</div>
                                                            <div>
                                                                <div style="font-size: 0.75rem; color: #6b7280; margin-bottom: 0.25rem;">Nouvelle valeur</div>
                                                                <div style="padding: 0.5rem; background: #d1fae5; border-radius: 4px; color: #065f46; font-size: 0.875rem; word-break: break-all;">
                                                                    {% if newValue is null or newValue == '' %}
                                                                        <em style="color: #9ca3af;">(vide)</em>
                                                                    {% elseif newValue is iterable %}
                                                                        <pre style="margin: 0; font-family: monospace; white-space: pre-wrap;">{{ newValue|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                                                                    {% else %}
                                                                        {{ newValue }}
                                                                    {% endif %}
                                                                </div>
                                                            </div>
                                                        </div>
                                                    {% else %}
                                                        {# Afficher seulement la nouvelle valeur #}
                                                        <div>
                                                            <div style="font-size: 0.75rem; color: #6b7280; margin-bottom: 0.25rem;">Valeur ajoutée</div>
                                                            <div style="padding: 0.5rem; background: #d1fae5; border-radius: 4px; color: #065f46; font-size: 0.875rem; word-break: break-all;">
                                                                {% if newValue is null or newValue == '' %}
                                                                    <em style="color: #9ca3af;">(vide)</em>
                                                                {% elseif newValue is iterable %}
                                                                    <pre style="margin: 0; font-family: monospace; white-space: pre-wrap;">{{ newValue|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                                                                {% else %}
                                                                    {{ newValue }}
                                                                {% endif %}
                                                            </div>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% else %}
                                <div style="margin-top: 1rem;">
                                    <div style="background: #fffbeb; border: 1px solid #fbbf24; padding: 1rem; border-radius: 6px;">
                                        <p style="margin: 0; color: #92400e; font-size: 0.875rem;">
                                            ⚠️ Aucun changement détecté dans les valeurs.
                                            <br>
                                            <strong>Raison possible :</strong> La modification n'a pas changé les données, ou il s'agit d'une action système automatique.
                                        </p>
                                    </div>
                                </div>
                            {% endif %}
                        {% elseif log.action == 'update' and log.newValues %}
                            <div style="margin-top: 1rem;">
                                <h4 style="font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.75rem;">
                                    📝 État après modification :
                                </h4>
                                <div style="background: #fffbeb; border: 1px solid #fbbf24; padding: 1rem; border-radius: 6px; margin-bottom: 1rem;">
                                    <p style="margin: 0; color: #92400e; font-size: 0.875rem;">
                                        ⚠️ Les anciennes valeurs ne sont pas disponibles. Affichage de l'état actuel uniquement.
                                    </p>
                                </div>
                                <div style="display: grid; gap: 0.5rem;">
                                    {% for field, value in log.newValues %}
                                        <div style="background: white; padding: 0.75rem; border-radius: 6px; border: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center;">
                                            <span style="font-weight: 600; color: #374151; font-size: 0.875rem;">{{ field }}</span>
                                            <span style="color: #6b7280; font-size: 0.875rem; font-family: monospace;">
                                                {% if value is null %}
                                                    <em style="color: #9ca3af;">(vide)</em>
                                                {% elseif value is iterable %}
                                                    {{ value|json_encode }}
                                                {% else %}
                                                    {{ value }}
                                                {% endif %}
                                            </span>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% elseif log.action == 'update' %}
                            <div style="margin-top: 1rem;">
                                <div style="background: #fffbeb; border: 1px solid #fbbf24; padding: 1rem; border-radius: 6px;">
                                    <p style="margin: 0; color: #92400e; font-size: 0.875rem;">
                                        ⚠️ Aucun détail disponible pour cette modification.
                                    </p>
                                </div>
                            </div>
                        {% elseif log.action == 'create' and log.newValues %}
                            <div style="margin-top: 1rem;">
                                <h4 style="font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.75rem;">
                                    ✨ Valeurs initiales :
                                </h4>
                                <div style="background: white; padding: 1rem; border-radius: 6px; border: 1px solid #e5e7eb;">
                                    <pre style="margin: 0; font-size: 0.75rem; color: #374151; white-space: pre-wrap; word-break: break-all;">{{ log.newValues|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                                </div>
                            </div>
                        {% elseif log.action == 'delete' and log.oldValues %}
                            <div style="margin-top: 1rem;">
                                <h4 style="font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.75rem;">
                                    🗑️ Valeurs supprimées :
                                </h4>
                                <div style="background: white; padding: 1rem; border-radius: 6px; border: 1px solid #e5e7eb;">
                                    <pre style="margin: 0; font-size: 0.75rem; color: #374151; white-space: pre-wrap; word-break: break-all;">{{ log.oldValues|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
