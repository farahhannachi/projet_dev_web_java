{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}Coupons{% endblock %}
{% block page_subtitle %}Gestion des codes promotionnels{% endblock %}

{% block main %}
<div style="padding:1rem 1rem 2rem">
    {% for message in app.flashes('success') %}<div class="alert-success">{{ message }}</div>{% endfor %}

    <div class="page-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;gap:.8rem;flex-wrap:wrap">
        <h2 style="margin:0">Liste coupons</h2>
        <a href="{{ path('admin_coupon_new') }}" class="btn-primary"><i class="fas fa-plus"></i> Nouveau coupon</a>
    </div>

    <form method="get" id="couponFilterForm" style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:.6rem;margin-bottom:1rem">
        <input class="form-control" name="search" value="{{ filters.search }}" placeholder="Code coupon...">
        <select class="form-control" name="active">
            <option value="all" {% if filters.active == 'all' %}selected{% endif %}>Tous</option>
            <option value="1" {% if filters.active == '1' %}selected{% endif %}>Actifs</option>
            <option value="0" {% if filters.active == '0' %}selected{% endif %}>Inactifs</option>
        </select>
        <select class="form-control" name="sort">
            <option value="date_desc" {% if filters.sort == 'date_desc' %}selected{% endif %}>Expiration desc</option>
            <option value="date_asc" {% if filters.sort == 'date_asc' %}selected{% endif %}>Expiration asc</option>
            <option value="usage_desc" {% if filters.sort == 'usage_desc' %}selected{% endif %}>Usage desc</option>
            <option value="value_desc" {% if filters.sort == 'value_desc' %}selected{% endif %}>Valeur desc</option>
            <option value="code_asc" {% if filters.sort == 'code_asc' %}selected{% endif %}>Code A-Z</option>
        </select>
    </form>

    <div class="table-container">
        <table class="data-table">
            <thead><tr><th>Code</th><th>Type</th><th>Valeur</th><th>Min panier</th><th>Usage</th><th>Expiration</th><th>Actif</th><th>Actions</th></tr></thead>
            <tbody>
            {% for coupon in coupons %}
                <tr>
                    <td><strong>{{ coupon.code }}</strong></td>
                    <td>{{ coupon.type == 'percentage' ? 'Pourcentage' : 'Fixe' }}</td>
                    <td>{{ coupon.type == 'percentage' ? coupon.valeur ~ '%' : coupon.valeur|number_format(2, ',', ' ') ~ ' DT' }}</td>
                    <td>{{ coupon.montantMinimumPanier|number_format(2, ',', ' ') }} DT</td>
                    <td>{{ coupon.usageCount }}/{{ coupon.usageMax }}</td>
                    <td>{{ coupon.dateExpiration ? coupon.dateExpiration|date('d/m/Y H:i') : '-' }}</td>
                    <td>{{ coupon.actif ? 'Oui' : 'Non' }}</td>
                    <td>
                        <div class="actions-container">
                            <a class="btn-outline" href="{{ path('admin_coupon_edit', {id: coupon.id}) }}"><i class="fas fa-edit"></i></a>
                            <form action="{{ path('admin_coupon_delete', {id: coupon.id}) }}" method="post" onsubmit="return confirm('Supprimer ce coupon ?')">
                                <button class="btn-danger" type="submit"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" style="text-align:center">Aucun coupon</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(() => {
  const form = document.getElementById('couponFilterForm');
  if (!form) return;
  let timer = null;
  form.querySelectorAll('input,select').forEach(el => {
    el.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => form.submit(), 250);
    });
    el.addEventListener('change', () => form.submit());
  });
})();
</script>
{% endblock %}

