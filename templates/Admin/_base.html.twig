<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin - CuraVita{% endblock %}</title>
    <link rel="icon" href="{{ asset('admin/images/curavita-logo.png') }}" type="image/x-icon">
    <link rel="stylesheet" href="{{ asset('admin/css/styles.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <div class="dashboard-wrap">
        <aside class="sidebar-wrap expanded" id="sidebarWrap">
            <nav class="sidebar">
                <div class="sidebar-header">
                    <img src="{{ asset('admin/images/curavita-logo.png') }}" alt="Curavita Logo" class="sidebar-logo">
                    <div class="sidebar-brand-text">
                        <span class="sidebar-brand-title">CURAVITA</span>
                        <span class="sidebar-brand-sub">Admin Portal</span>
                    </div>
                </div>
                <div class="sidebar-content">
                    <div class="sidebar-group">
                        <div class="sidebar-group-label">Menu</div>
                        <ul class="sidebar-menu">
                            <li><a href="{{ path('admin_dashboard') }}" class="nav-link {{ app.request.get('_route') == 'admin_dashboard' ? 'active' : '' }}">Dashboard</a></li>
                            <li><a href="{{ path('admin_clients') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_client' ? 'active' : '' }}">Clients</a></li>
                            <li><a href="{{ path('admin_produits') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_produit' ? 'active' : '' }}">Produits</a></li>
                            <li><a href="{{ path('admin_promotions') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_promotion' ? 'active' : '' }}" onclick="window.location.href='{{ path('admin_promotions') }}'; return false;">Promotions</a></li>
                            <li><a href="{{ path('admin_commandes') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_commande' ? 'active' : '' }}">Commandes</a></li>
                            <li><a href="{{ path('admin_coupons') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_coupon' ? 'active' : '' }}">Coupons</a></li>
                            <li><a href="{{ path('admin_depots') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_depot' ? 'active' : '' }}">Dépôts</a></li>
                            <li><a href="{{ path('admin_stocks') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_stock' ? 'active' : '' }}">Stocks</a></li>
                        </ul>
                    </div>
                </div>
                <div class="sidebar-footer">
                    <div class="sidebar-footer-inner">
                        <div class="sidebar-footer-user flex-1 min-w-0">
                            <p>Admin</p>
                            <p>{{ app.session.get('email', '') }}</p>
                        </div>
                        <a href="{{ path('app_logout') }}" class="sidebar-footer-logout" aria-label="Déconnexion">Déconnexion</a>
                    </div>
                </div>
            </nav>
        </aside>

        <div class="main-col">
            <header>
                <div class="header-left">
                    <h1 class="header-title">{% block page_title %}Dashboard{% endblock %}</h1>
                    <p class="header-subtitle">{% block page_subtitle %}Bienvenue sur l'administration{% endblock %}</p>
                </div>
                <div class="header-right">
                    <a href="{{ path('app_home') }}" class="btn btn-outline btn-sm">Voir le site</a>
                </div>
            </header>

            <main>
                {% block main %}{% endblock %}
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="{{ asset('admin/js/app.js') }}"></script>
    {% block javascripts %}{% endblock %}
    
    {# AFK (Away From Keyboard) Detection for Admin #}
    {% include 'components/afk-modal.html.twig' %}
    {% include 'components/afk-info-icon.html.twig' %}
    <script>
        (function() {
            const INACTIVE_TIMEOUT = 10 * 60 * 1000;
            const WARNING_COUNTDOWN = 60;
            const WARNING_CHECK_INTERVAL = 1000;
            
            let inactivityTimer = null;
            let warningTimer = null;
            let countdownInterval = null;
            let warningShown = false;
            let lastActivity = Date.now();
            
            const modal = document.getElementById('afk-modal');
            const countdownEl = document.getElementById('afk-countdown');
            const stayConnectedBtn = document.getElementById('afk-stay-connected');
            
            function resetInactivityTimer() {
                lastActivity = Date.now();
                
                if (warningShown) {
                    hideWarning();
                }
                
                if (inactivityTimer) clearTimeout(inactivityTimer);
                if (warningTimer) clearTimeout(warningTimer);
                if (countdownInterval) clearInterval(countdownInterval);
                
                inactivityTimer = setTimeout(showWarning, INACTIVE_TIMEOUT);
            }
            
            function showWarning() {
                warningShown = true;
                
                if (modal) {
                    modal.style.display = 'flex';
                    
                    let remaining = WARNING_COUNTDOWN;
                    if (countdownEl) countdownEl.textContent = remaining;
                    
                    countdownInterval = setInterval(function() {
                        remaining--;
                        if (countdownEl) countdownEl.textContent = remaining;
                        
                        if (remaining <= 0) {
                            clearInterval(countdownInterval);
                            performLogout();
                        }
                    }, WARNING_CHECK_INTERVAL);
                }
            }
            
            function hideWarning() {
                warningShown = false;
                
                if (countdownInterval) {
                    clearInterval(countdownInterval);
                    countdownInterval = null;
                }
                
                if (modal) modal.style.display = 'none';
                
                resetInactivityTimer();
            }
            
            function performLogout() {
                window.location.href = '{{ path("app_logout") }}';
            }
            
            const activityEvents = ['mousemove', 'mousedown', 'keypress', 'scroll', 'touchstart', 'touchmove'];
            
            activityEvents.forEach(function(event) {
                document.addEventListener(event, resetInactivityTimer, { passive: true });
            });
            
            if (stayConnectedBtn) {
                stayConnectedBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    hideWarning();
                });
            }
            
            resetInactivityTimer();
            
        })();
    </script>
</body>
</html>


