{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}{{ stock is null ? 'Ajouter' : 'Modifier' }} un Stock{% endblock %}
{% block page_subtitle %}{{ stock is null ? 'Créer un nouveau stock' : 'Modifier les informations du stock' }}{% endblock %}

{% block main %}
<div style="padding: 2rem;">
    <div class="form-container">
        <h1><i class="fas fa-boxes"></i> {{ stock is null ? 'Ajouter' : 'Modifier' }} un Stock</h1>
        
        {{ form_start(form, { attr: { novalidate: 'novalidate', class: 'modern-form' } }) }}
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.depot) }}
                    {{ form_widget(form.depot) }}
                    {{ form_errors(form.depot) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.produit) }}
                    {{ form_widget(form.produit) }}
                    {{ form_errors(form.produit) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.quantite) }}
                    {{ form_widget(form.quantite) }}
                    {{ form_errors(form.quantite) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.seuilAlerte) }}
                    {{ form_widget(form.seuilAlerte) }}
                    {{ form_errors(form.seuilAlerte) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.seuilCritique) }}
                    {{ form_widget(form.seuilCritique) }}
                    {{ form_errors(form.seuilCritique) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.dateEntree) }}
                    {{ form_widget(form.dateEntree) }}
                    {{ form_errors(form.dateEntree) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.dateExpiration) }}
                    {{ form_widget(form.dateExpiration) }}
                    {{ form_errors(form.dateExpiration) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.etatStock) }}
                    {{ form_widget(form.etatStock) }}
                    {{ form_errors(form.etatStock) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.emplacement) }}
                    {{ form_widget(form.emplacement) }}
                    {{ form_errors(form.emplacement) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.batchNumber) }}
                    {{ form_widget(form.batchNumber) }}
                    {{ form_errors(form.batchNumber) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.fournisseur) }}
                    {{ form_widget(form.fournisseur) }}
                    {{ form_errors(form.fournisseur) }}
                </div>
                
                <div class="form-group full-width">
                    {{ form_label(form.notes) }}
                    {{ form_widget(form.notes) }}
                    {{ form_errors(form.notes) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.dateDerniereMiseAJour) }}
                    {{ form_widget(form.dateDerniereMiseAJour) }}
                    {{ form_errors(form.dateDerniereMiseAJour) }}
                </div>
            </div>
            
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-plus-circle"></i> {{ stock is null ? 'Ajouter le stock' : 'Mettre à jour' }}
                </button>
                <a href="{{ path('admin_stocks') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
            </div>
        {{ form_end(form) }}

        {% if stock is not null and stock.qrCodePayload %}
            <div style="margin-top: 2rem; padding: 1rem; border: 1px solid #e5e7eb; border-radius: 12px;">
                <h3 style="margin-top: 0;"><i class="fas fa-qrcode"></i> QR Code du lot</h3>
                <img
                    src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data={{ stock.qrCodePayload|url_encode }}"
                    alt="QR Code stock"
                    style="border: 1px solid #ddd; border-radius: 8px;"
                >
                <p style="margin-top: 0.75rem; font-size: 0.85rem; color: #4b5563; word-break: break-all;">
                    {{ stock.qrCodePayload }}
                </p>
            </div>
        {% endif %}
    </div>
</div>

<style>
.form-container {
    background: white;
    padding: 2rem;
    border-radius: 16px;
    box-shadow: var(--shadow-md);
    max-width: 800px;
    margin: 0 auto;
}

.form-container h1 {
    color: var(--primary-color);
    margin-bottom: 2rem;
    font-size: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.modern-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.full-width {
    grid-column: 1 / -1;
}

.form-group label {
    font-weight: 600;
    color: var(--dark-color);
    margin-bottom: 0.5rem;
}

.form-group input,
.form-group select,
.form-group textarea {
    padding: 0.875rem 1.25rem;
    border: 2px solid var(--border-color);
    border-radius: 12px;
    font-size: 1rem;
    transition: var(--transition);
    background: white;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(22, 86, 63, 0.1);
}

.form-group .invalid-feedback,
.form-group .form-error-message {
    color: var(--danger-color);
    font-size: 0.875rem;
    margin-top: 0.25rem;
    display: block;
}

.form-group .is-invalid,
.form-group input.is-invalid,
.form-group select.is-invalid,
.form-group textarea.is-invalid {
    border-color: var(--danger-color);
    box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.1);
}

.form-group input:focus.is-invalid,
.form-group select:focus.is-invalid,
.form-group textarea:focus.is-invalid {
    border-color: var(--danger-color);
    box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.25);
}

.form-group .required::after {
    content: " *";
    color: var(--danger-color);
}

.form-actions {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    margin-top: 2rem;
}

.btn-secondary {
    background: var(--text-muted);
    color: white;
    padding: 0.875rem 1.75rem;
    text-decoration: none;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: var(--transition);
    font-weight: 600;
    border: none;
    cursor: pointer;
}

.btn-secondary:hover {
    background: #5a6268;
    transform: translateY(-2px);
}

.btn-primary {
    background: var(--primary-color);
    color: white;
    padding: 0.875rem 1.75rem;
    text-decoration: none;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: var(--transition);
    font-weight: 600;
    border: none;
    cursor: pointer;
}

.btn-primary:hover {
    background: #1a5f3f;
    transform: translateY(-2px);
}

@media (max-width: 768px) {
    .form-grid {
        grid-template-columns: 1fr;
    }
    
    .form-actions {
        flex-direction: column;
    }
}
</style>
{% endblock %}
