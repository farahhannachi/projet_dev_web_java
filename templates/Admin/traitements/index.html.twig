{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}Gestion des Traitements{% endblock %}
{% block page_subtitle %}Liste de tous les traitements{% endblock %}

{% block main %}
<div style="padding: 2rem;">
    {% for message in app.flashes('success') %}
        <div class="alert-success">
            <i class="fas fa-check-circle"></i> {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert-error">
            <i class="fas fa-exclamation-circle"></i> {{ message }}
        </div>
    {% endfor %}

    <div style="margin-bottom: 2rem; display: flex; gap: 1rem;">
        <a href="{{ path('admin_traitement_new') }}" class="btn-primary">
            <i class="fas fa-plus"></i> Nouveau Traitement
        </a>
        <button id="statsBtn" class="btn-primary">
            <i class="fas fa-chart-pie"></i> Statistiques
        </button>
    </div>

    <!-- Filtres -->
    <div style="background: white; padding: 1.5rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 2rem;">
        <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 1rem; color: #1f2937;">
            🔍 Filtrer par :
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
            <div>
                <label style="display: block; font-size: 0.875rem; font-weight: 500; color: #6b7280; margin-bottom: 0.5rem;">Date de début</label>
                <input type="date" id="filterDateDebut" value="{{ filterDateDebut }}" class="form-control" style="width: 100%; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 6px;">
            </div>
            <div>
                <label style="display: block; font-size: 0.875rem; font-weight: 500; color: #6b7280; margin-bottom: 0.5rem;">Date de fin</label>
                <input type="date" id="filterDateFin" value="{{ filterDateFin }}" class="form-control" style="width: 100%; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 6px;">
            </div>
            <div>
                <label style="display: block; font-size: 0.875rem; font-weight: 500; color: #6b7280; margin-bottom: 0.5rem;">Client</label>
                <input type="text" id="filterClient" value="{{ filterClient }}" placeholder="Nom, prénom ou email..." class="form-control" style="width: 100%; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 6px;">
            </div>
            <div>
                <label style="display: block; font-size: 0.875rem; font-weight: 500; color: #6b7280; margin-bottom: 0.5rem;">Produit</label>
                <input type="text" id="filterProduit" value="{{ filterProduit }}" placeholder="Nom du produit..." class="form-control" style="width: 100%; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 6px;">
            </div>
            <div>
                <label style="display: block; font-size: 0.875rem; font-weight: 500; color: #6b7280; margin-bottom: 0.5rem;">Statut</label>
                <select id="filterStatut" class="form-control" style="width: 100%; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 6px;">
                    <option value="">Tous les statuts</option>
                    <option value="en attente" {{ filterStatut == 'en attente' ? 'selected' : '' }}>En attente</option>
                    <option value="validé" {{ filterStatut == 'validé' ? 'selected' : '' }}>Validé</option>
                    <option value="rejeté" {{ filterStatut == 'rejeté' ? 'selected' : '' }}>Rejeté</option>
                    <option value="actif" {{ filterStatut == 'actif' ? 'selected' : '' }}>Actif</option>
                    <option value="terminé" {{ filterStatut == 'terminé' ? 'selected' : '' }}>Terminé</option>
                    <option value="suspendu" {{ filterStatut == 'suspendu' ? 'selected' : '' }}>Suspendu</option>
                    <option value="annulé" {{ filterStatut == 'annulé' ? 'selected' : '' }}>Annulé</option>
                </select>
            </div>
            <div>
                <label style="display: block; font-size: 0.875rem; font-weight: 500; color: #6b7280; margin-bottom: 0.5rem;">Trier par</label>
                <select id="sortBy" class="form-control" style="width: 100%; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 6px;">
                    <option value="id_desc" {{ sortBy == 'id_desc' ? 'selected' : '' }}>Plus récent</option>
                    <option value="id_asc" {{ sortBy == 'id_asc' ? 'selected' : '' }}>Plus ancien</option>
                    <option value="date_debut_desc" {{ sortBy == 'date_debut_desc' ? 'selected' : '' }}>Date Début (Plus récent)</option>
                    <option value="date_debut_asc" {{ sortBy == 'date_debut_asc' ? 'selected' : '' }}>Date Début (Plus ancien)</option>
                    <option value="date_fin_desc" {{ sortBy == 'date_fin_desc' ? 'selected' : '' }}>Date Fin (Plus récent)</option>
                    <option value="date_fin_asc" {{ sortBy == 'date_fin_asc' ? 'selected' : '' }}>Date Fin (Plus ancien)</option>
                    <option value="client_asc" {{ sortBy == 'client_asc' ? 'selected' : '' }}>Client (A-Z)</option>
                    <option value="client_desc" {{ sortBy == 'client_desc' ? 'selected' : '' }}>Client (Z-A)</option>
                    <option value="produit_asc" {{ sortBy == 'produit_asc' ? 'selected' : '' }}>Produit (A-Z)</option>
                    <option value="produit_desc" {{ sortBy == 'produit_desc' ? 'selected' : '' }}>Produit (Z-A)</option>
                </select>
            </div>
        </div>
        <div style="display: flex; gap: 0.5rem; align-items: center;">
            <div id="searchSpinner" style="display: none;">
                <div style="width: 20px; height: 20px; border: 3px solid #e5e7eb; border-top-color: #16563f; border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
            </div>
            <div id="searchInfo" style="color: #6b7280; font-size: 0.875rem;"></div>
        </div>
    </div>

    <div class="table-container" id="traitements-table">
        {% include 'Admin/traitements/_table.html.twig' %}
    </div>
</div>

<!-- Modale Statistiques -->
<div id="statsModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center;">
    <div style="background: white; border-radius: 20px; padding: 2rem; max-width: 550px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3); animation: slideIn 0.3s ease-out; max-height: 90vh; overflow-y: auto;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h2 style="font-size: 1.5rem; font-weight: 700; color: #1f2937; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
                <span style="font-size: 2rem;">📊</span> Statistiques des Traitements
            </h2>
            <button id="closeModal" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #9ca3af; transition: color 0.2s;">
                ✕
            </button>
        </div>
        
        <div id="statsContent" style="display: flex; flex-direction: column; gap: 1rem;">
            <div style="text-align: center; padding: 1rem;">
                <div style="width: 40px; height: 40px; border: 4px solid #e5e7eb; border-top-color: #667eea; border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto;"></div>
                <p style="margin-top: 1rem; color: #6b7280;">Chargement des statistiques...</p>
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes spin {
        to { transform: rotate(360deg); }
    }
    
    @keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    #closeModal:hover {
        color: #ef4444;
    }
    
    .stat-card {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 1rem;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: transform 0.2s;
    }
    
    .stat-card:hover {
        transform: translateY(-2px);
    }
    
    .stat-card.primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }
    
    .stat-card.success {
        background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%);
        color: #1f2937;
    }
    
    .stat-card.warning {
        background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
        color: #1f2937;
    }
    
    .stat-card.danger {
        background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
        color: #1f2937;
    }
    
    .stat-card.info {
        background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        color: #1f2937;
    }
</style>

<script>
    let searchTimeout;
    const filterDateDebut = document.getElementById('filterDateDebut');
    const filterDateFin = document.getElementById('filterDateFin');
    const filterClient = document.getElementById('filterClient');
    const filterProduit = document.getElementById('filterProduit');
    const filterStatut = document.getElementById('filterStatut');
    const sortBy = document.getElementById('sortBy');
    const searchSpinner = document.getElementById('searchSpinner');
    const searchInfo = document.getElementById('searchInfo');
    const tableContainer = document.getElementById('traitements-table');

    // Fonction de recherche
    function performSearch() {
        searchSpinner.style.display = 'block';
        searchInfo.textContent = 'Recherche en cours...';

        const params = new URLSearchParams({
            date_debut: filterDateDebut.value,
            date_fin: filterDateFin.value,
            client: filterClient.value,
            produit: filterProduit.value,
            statut: filterStatut.value,
            sort: sortBy.value
        });

        fetch('{{ path('admin_traitements_search') }}?' + params.toString())
            .then(response => response.json())
            .then(data => {
                searchSpinner.style.display = 'none';
                tableContainer.innerHTML = data.html;
                searchInfo.textContent = `${data.count} résultat${data.count > 1 ? 's' : ''} trouvé${data.count > 1 ? 's' : ''}`;
            })
            .catch(error => {
                console.error('Erreur:', error);
                searchSpinner.style.display = 'none';
                searchInfo.textContent = 'Erreur lors de la recherche';
                searchInfo.style.color = '#ef4444';
            });
    }

    // Événements sur les champs
    filterDateDebut.addEventListener('change', () => {
        performSearch();
    });

    filterDateFin.addEventListener('change', () => {
        performSearch();
    });

    filterClient.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            performSearch();
        }, 500);
    });

    filterProduit.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            performSearch();
        }, 500);
    });

    filterStatut.addEventListener('change', () => {
        performSearch();
    });

    sortBy.addEventListener('change', () => {
        performSearch();
    });
    
    // Gestion de la modale statistiques
    const statsBtn = document.getElementById('statsBtn');
    const statsModal = document.getElementById('statsModal');
    const closeModal = document.getElementById('closeModal');
    const statsContent = document.getElementById('statsContent');
    
    statsBtn.addEventListener('click', () => {
        statsModal.style.display = 'flex';
        
        // Charger les statistiques
        fetch('{{ path('admin_traitements_stats') }}')
            .then(response => response.json())
            .then(data => {
                statsContent.innerHTML = `
                    <div class="stat-card primary">
                        <div>
                            <div style="font-size: 0.875rem; opacity: 0.9;">Total Traitements</div>
                            <div style="font-size: 2rem; font-weight: 700;">${data.total}</div>
                        </div>
                        <div style="font-size: 3rem;">💊</div>
                    </div>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                        <div class="stat-card warning">
                            <div>
                                <div style="font-size: 0.7rem; font-weight: 600;">En Attente</div>
                                <div style="font-size: 1.25rem; font-weight: 700;">${data.enAttente}</div>
                            </div>
                            <div style="font-size: 1.5rem;">⏳</div>
                        </div>
                        
                        <div class="stat-card success">
                            <div>
                                <div style="font-size: 0.7rem; font-weight: 600;">Validés</div>
                                <div style="font-size: 1.25rem; font-weight: 700;">${data.valide}</div>
                            </div>
                            <div style="font-size: 1.5rem;">✅</div>
                        </div>
                        
                        <div class="stat-card" style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);">
                            <div>
                                <div style="font-size: 0.7rem; font-weight: 600;">Actifs</div>
                                <div style="font-size: 1.25rem; font-weight: 700;">${data.actif}</div>
                            </div>
                            <div style="font-size: 1.5rem;">🔄</div>
                        </div>
                        
                        <div class="stat-card" style="background: linear-gradient(135deg, #d4fc79 0%, #96e6a1 100%);">
                            <div>
                                <div style="font-size: 0.7rem; font-weight: 600;">Terminés</div>
                                <div style="font-size: 1.25rem; font-weight: 700;">${data.termine}</div>
                            </div>
                            <div style="font-size: 1.5rem;">✔️</div>
                        </div>
                        
                        <div class="stat-card danger">
                            <div>
                                <div style="font-size: 0.7rem; font-weight: 600;">Rejetés</div>
                                <div style="font-size: 1.25rem; font-weight: 700;">${data.rejete}</div>
                            </div>
                            <div style="font-size: 1.5rem;">❌</div>
                        </div>
                        
                        <div class="stat-card" style="background: linear-gradient(135deg, #ffeaa7 0%, #fdcb6e 100%);">
                            <div>
                                <div style="font-size: 0.7rem; font-weight: 600;">Suspendus</div>
                                <div style="font-size: 1.25rem; font-weight: 700;">${data.suspendu}</div>
                            </div>
                            <div style="font-size: 1.5rem;">⏸️</div>
                        </div>
                        
                        <div class="stat-card" style="background: linear-gradient(135deg, #fbc2eb 0%, #a6c1ee 100%);">
                            <div>
                                <div style="font-size: 0.7rem; font-weight: 600;">Annulés</div>
                                <div style="font-size: 1.25rem; font-weight: 700;">${data.annule}</div>
                            </div>
                            <div style="font-size: 1.5rem;">🚫</div>
                        </div>
                        
                        <div class="stat-card info">
                            <div>
                                <div style="font-size: 0.7rem; font-weight: 600;">Durée Moy.</div>
                                <div style="font-size: 1.25rem; font-weight: 700;">${data.dureeMoyenne}j</div>
                            </div>
                            <div style="font-size: 1.5rem;">📅</div>
                        </div>
                    </div>
                    
                    <div style="background: #f9fafb; padding: 1rem; border-radius: 12px; margin-top: 0.5rem;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <span style="font-size: 0.875rem; color: #6b7280;">Taux de traitements actifs</span>
                            <span style="font-size: 0.875rem; font-weight: 600; color: #3b82f6;">${data.pourcentageActif}%</span>
                        </div>
                        <div style="background: #e5e7eb; height: 8px; border-radius: 4px; overflow: hidden;">
                            <div style="background: linear-gradient(90deg, #3b82f6, #60a5fa); height: 100%; width: ${data.pourcentageActif}%; transition: width 0.5s;"></div>
                        </div>
                    </div>
                    
                    <div style="background: #f9fafb; padding: 1rem; border-radius: 12px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <span style="font-size: 0.875rem; color: #6b7280;">Taux de complétion</span>
                            <span style="font-size: 0.875rem; font-weight: 600; color: #10b981;">${data.pourcentageTermine}%</span>
                        </div>
                        <div style="background: #e5e7eb; height: 8px; border-radius: 4px; overflow: hidden;">
                            <div style="background: linear-gradient(90deg, #10b981, #34d399); height: 100%; width: ${data.pourcentageTermine}%; transition: width 0.5s;"></div>
                        </div>
                    </div>
                `;
            })
            .catch(error => {
                console.error('Erreur:', error);
                statsContent.innerHTML = `
                    <div style="text-align: center; padding: 2rem; color: #ef4444;">
                        <div style="font-size: 3rem; margin-bottom: 1rem;">😞</div>
                        <p>Erreur lors du chargement des statistiques</p>
                    </div>
                `;
            });
    });
    
    closeModal.addEventListener('click', () => {
        statsModal.style.display = 'none';
    });
    
    statsModal.addEventListener('click', (e) => {
        if (e.target === statsModal) {
            statsModal.style.display = 'none';
        }
    });
</script>
{% endblock %}
