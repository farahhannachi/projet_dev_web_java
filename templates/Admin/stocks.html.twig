{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}Gestion des Stocks{% endblock %}
{% block page_subtitle %}Liste de tous les stocks{% endblock %}

{% block main %}
<div style="padding: 2rem;">
    <div class="page-header">
        <h1><i class="fas fa-boxes"></i> Gestion des Stocks</h1>
        <a href="{{ path('admin_stock_new') }}" class="btn-primary">
            <i class="fas fa-plus"></i> Ajouter un Stock
        </a>
    </div>

    <div class="table-container">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Produit</th>
                    <th>Dépôt</th>
                    <th>Quantité</th>
                    <th>Date d'entrée</th>
                    <th>Date d'expiration</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for stock in stocks %}
                <tr>
                    <td>{{ stock.idStock }}</td>
                    <td>{{ stock.idProduit ? stock.idProduit.nom : '-' }}</td>
                    <td>{{ stock.idDepot ? stock.idDepot.nom : '-' }}</td>
                    <td>{{ stock.quantite }}</td>
                    <td>{{ stock.dateEntree ? stock.dateEntree|date('d/m/Y') : '-' }}</td>
                    <td>{{ stock.dateExpiration ? stock.dateExpiration|date('d/m/Y') : '-' }}</td>
                    <td>
                        <div class="action-buttons">
                            <a href="{{ path('admin_stock_edit', {'id': stock.idStock}) }}" class="btn-edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="POST" action="{{ path('admin_stock_delete', {'id': stock.idStock}) }}" 
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce stock ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.idStock) }}">
                                <button type="submit" class="btn-delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="empty-state">
                        <div class="empty-content">
                            <i class="fas fa-boxes"></i>
                            <h3>Aucun stock trouvé</h3>
                            <p>Commencez par ajouter votre premier stock.</p>
                            <a href="{{ path('admin_stock_new') }}" class="btn-primary">
                                <i class="fas fa-plus"></i> Ajouter un Stock
                            </a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<style>
.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
}

.page-header h1 {
    color: var(--primary-color);
    font-size: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.table-container {
    background: white;
    border-radius: 16px;
    box-shadow: var(--shadow-md);
    overflow: hidden;
}

.modern-table {
    width: 100%;
    border-collapse: collapse;
}

.modern-table th {
    background: var(--primary-color);
    color: white;
    padding: 1rem;
    text-align: left;
    font-weight: 600;
}

.modern-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--border-color);
}

.modern-table tr:hover {
    background: var(--light-color);
}

.action-buttons {
    display: flex;
    gap: 0.5rem;
}

.btn-edit {
    background: var(--warning-color);
    color: white;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: var(--transition);
}

.btn-edit:hover {
    background: #e67e22;
    transform: translateY(-1px);
}

.btn-delete {
    background: var(--danger-color);
    color: white;
    border: none;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: var(--transition);
}

.btn-delete:hover {
    background: #c0392b;
    transform: translateY(-1px);
}

.empty-state {
    text-align: center;
    padding: 3rem;
}

.empty-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
}

.empty-content i {
    font-size: 3rem;
    color: var(--text-muted);
}

.empty-content h3 {
    color: var(--dark-color);
    margin: 0;
}

.empty-content p {
    color: var(--text-muted);
    margin: 0;
}

@media (max-width: 768px) {
    .page-header {
        flex-direction: column;
        gap: 1rem;
        align-items: stretch;
    }
    
    .modern-table {
        font-size: 0.875rem;
    }
    
    .modern-table th,
    .modern-table td {
        padding: 0.75rem 0.5rem;
    }
    
    .action-buttons {
        flex-direction: column;
    }
}
</style>
{% endblock %}
