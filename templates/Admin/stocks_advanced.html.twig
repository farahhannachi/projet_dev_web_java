                                    Ã¢Å“â€” Rupture
                                </span>
                            {% elseif stock.etatStock == 'perime' %}
                                <span style="background: #f8d7da; color: #721c24; padding: 0.25rem 0.75rem; border-radius: 1rem; font-size: 0.75rem; font-weight: 600;">
