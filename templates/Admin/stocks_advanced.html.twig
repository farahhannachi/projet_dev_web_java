                    <option value="rupture" {{ filters.etat == 'rupture' ? 'selected' }}>Rupture</option>
                    <option value="perime" {{ filters.etat == 'perime' ? 'selected' }}>PÃƒÂ©rimÃƒÂ©</option>
                </select>
            </div>
            <div>
