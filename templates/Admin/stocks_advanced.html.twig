{% extends 'base.html.twig' %}

{% block title %}Gestion des Stocks - Module DÃƒÂ©pÃƒÂ´t & Stock{% endblock %}

{% block content %}
<div style="padding: 2rem;">
    <!-- En-tÃƒÂªte avec statistiques principales -->
    <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 2rem; border-radius: 12px; margin-bottom: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
                <h1 style="margin: 0; font-size: 2rem; font-weight: 600;">
                    <i class="fas fa-warehouse"></i> Module DÃƒÂ©pÃƒÂ´t & Stock
                </h1>
                <p style="margin: 0.5rem 0 0 0; opacity: 0.9;">
                    Gestion des entrÃƒÂ©es/sorties, contrÃƒÂ´le des quantitÃƒÂ©s, surveillance des dates d'expiration
                </p>
            </div>
            <a href="{{ path('admin_stock_new') }}" class="btn-primary" style="background: white; color: #667eea;">
                <i class="fas fa-plus-circle"></i> Nouveau Stock
            </a>
        </div>
    </div>

    <!-- Cartes de statistiques -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
        <div style="background: white; padding: 1.5rem; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border-left: 4px solid #28a745;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div>
                    <h4 style="margin: 0; color: #6c757d; font-size: 0.875rem;">Total Stocks</h4>
                    <p style="margin: 0.5rem 0 0 0; font-size: 1.75rem; font-weight: bold; color: #28a745;">{{ stocks|length }}</p>
                </div>
                <i class="fas fa-boxes" style="font-size: 2rem; color: #28a745; opacity: 0.3;"></i>
            </div>
        </div>

        <div style="background: white; padding: 1.5rem; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border-left: 4px solid #ffc107;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div>
                    <h4 style="margin: 0; color: #6c757d; font-size: 0.875rem;">Stocks en Alerte</h4>
                    <p style="margin: 0.5rem 0 0 0; font-size: 1.75rem; font-weight: bold; color: #ffc107;">{{ stocks|filter(s => s.etatStock == 'alerte')|length }}</p>
                </div>
                <i class="fas fa-exclamation-triangle" style="font-size: 2rem; color: #ffc107; opacity: 0.3;"></i>
            </div>
        </div>

        <div style="background: white; padding: 1.5rem; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border-left: 4px solid #dc3545;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div>
                    <h4 style="margin: 0; color: #6c757d; font-size: 0.875rem;">Rupture de Stock</h4>
                    <p style="margin: 0.5rem 0 0 0; font-size: 1.75rem; font-weight: bold; color: #dc3545;">{{ stocks|filter(s => s.etatStock == 'rupture')|length }}</p>
                </div>
                <i class="fas fa-times-circle" style="font-size: 2rem; color: #dc3545; opacity: 0.3;"></i>
            </div>
        </div>

        <div style="background: white; padding: 1.5rem; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border-left: 4px solid #17a2b8;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div>
                    <h4 style="margin: 0; color: #6c757d; font-size: 0.875rem;">Produits PÃƒÂ©rimÃƒÂ©s</h4>
                    <p style="margin: 0.5rem 0 0 0; font-size: 1.75rem; font-weight: bold; color: #17a2b8;">{{ stocks|filter(s => s.estPerime())|length }}</p>
                </div>
                <i class="fas fa-clock" style="font-size: 2rem; color: #17a2b8; opacity: 0.3;"></i>
            </div>
        </div>
    </div>

    <!-- Alertes intelligentes -->
    {% set alertes = {
        'critique': stocks|filter(s => s.quantite <= s.seuilCritique),
        'alerte': stocks|filter(s => s.quantite > s.seuilCritique and s.quantite <= s.seuilAlerte),
        'peremption': stocks|filter(s => s.estPerime()),
        'proche_peremption': stocks|filter(s => s.estProchePeremption())
    } %}

    {% if alertes.critique|length > 0 or alertes.alerte|length > 0 or alertes.peremption|length > 0 %}
    <div style="margin-bottom: 2rem;">
        <h3 style="margin: 0 0 1rem 0; color: #495057;">
            <i class="fas fa-brain"></i> Prévision intelligente de stock
        </h3>
        
        {% if alertes.critique|length > 0 %}
        <div style="background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
            <h4 style="margin: 0 0 0.5rem 0;"><i class="fas fa-exclamation-circle"></i> Rupture Critique</h4>
            <ul style="margin: 0; padding-left: 1.25rem;">
                {% for stock in alertes.critique %}
                <li>{{ stock.produit.nom }} dans {{ stock.depot.nomDepot }} - Reste: {{ stock.quantite }} unitÃƒÂ©s</li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}

        {% if alertes.alerte|length > 0 %}
        <div style="background: #fff3cd; border: 1px solid #ffeaa7; color: #856404; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
            <h4 style="margin: 0 0 0.5rem 0;"><i class="fas fa-exclamation-triangle"></i> Stock Faible</h4>
            <ul style="margin: 0; padding-left: 1.25rem;">
                {% for stock in alertes.alerte %}
                <li>{{ stock.produit.nom }} dans {{ stock.depot.nomDepot }} - Reste: {{ stock.quantite }} unitÃƒÂ©s</li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}

        {% if alertes.peremption|length > 0 %}
        <div style="background: #d1ecf1; border: 1px solid #bee5eb; color: #0c5460; padding: 1rem; border-radius: 8px;">
            <h4 style="margin: 0 0 0.5rem 0;"><i class="fas fa-clock"></i> Produits PÃƒÂ©rimÃƒÂ©s</h4>
            <ul style="margin: 0; padding-left: 1.25rem;">
                {% for stock in alertes.peremption %}
                <li>{{ stock.produit.nom }} dans {{ stock.depot.nomDepot }} - PÃƒÂ©rimÃƒÂ© depuis {{ stock.joursAvantPeremption|abs }} jours</li>
                {% endfor %}
            </ul>
        </div>
        {% endif %}
    </div>
    {% endif %}

