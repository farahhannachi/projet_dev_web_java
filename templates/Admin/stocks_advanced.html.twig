                        <td style="padding: 1rem;">
                            {% if stock.etatStock == 'disponible' %}
                                <span style="background: #d4edda; color: #155724; padding: 0.25rem 0.75rem; border-radius: 1rem; font-size: 0.75rem; font-weight: 600;">
                                    Ã¢Å“â€œ Disponible
