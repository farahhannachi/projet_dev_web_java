                <tbody>
                    {% for stock in stocks %}
                    <tr style="border-bottom: 1px solid #dee2e6; {% if stock.etatStock == 'rupture' %}background: #fff5f5;{% elseif stock.etatStock == 'alerte' %}background: #fffbf0;{% endif %}">
                        <td style="padding: 1rem;">
