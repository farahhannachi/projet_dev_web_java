                                </span>
                            {% else %}
                                <span style="background: #d1ecf1; color: #0c5460; padding: 0.25rem 0.75rem; border-radius: 1rem; font-size: 0.75rem; font-weight: 600;">
                                    Ã¢ÂÂ³ Expiration proche
                                </span>
                            {% endif %}
                        </td>
                        <td style="padding: 1rem;">
                            {% if stock.dateExpiration %}
                                {% set jours = stock.joursAvantPeremption %}
                                {% if jours < 0 %}
                                    <div style="color: #dc3545; font-weight: 600;">
                                        PÃƒÂ©rimÃƒÂ©
                                        <br><small>Il y a {{ jours|abs }} jours</small>
                                    </div>
                                {% elseif jours <= 30 %}
                                    <div style="color: #ffc107; font-weight: 600;">
                                        {{ stock.dateExpiration|date('d/m/Y') }}
                                        <br><small>Dans {{ jours }} jours</small>
                                    </div>
                                {% else %}
                                    <div style="color: #28a745;">
                                        {{ stock.dateExpiration|date('d/m/Y') }}
                                        <br><small>{{ jours }} jours</small>
                                    </div>
                                {% endif %}
                            {% else %}
                                <span style="color: #6c757d;">-</span>
                            {% endif %}
                        </td>
                        <td style="padding: 1rem;">
                            {% if stock.valeurStock %}
                                <div style="font-weight: 600; color: #28a745;">
                                    {{ stock.valeurStock|number_format(2, ',', ' ') }} Ã¢â€šÂ¬
                                </div>
                                {% if stock.margeBeneficiaire %}
                                <small style="color: #6c757d;">
                                    Marge: {{ stock.margeBeneficiaire|number_format(2, ',', ' ') }} Ã¢â€šÂ¬
                                </small>
                                {% endif %}
                            {% else %}
                                <span style="color: #6c757d;">-</span>
                            {% endif %}
                        </td>
                        <td style="padding: 1rem;">
                            <div style="display: flex; gap: 0.5rem;">
                                <a href="{{ path('admin_stock_edit', {'id': stock.id}) }}" 
                                   style="padding: 0.375rem 0.75rem; background: #007bff; color: white; border-radius: 6px; text-decoration: none; font-size: 0.875rem;"
                                   title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="POST" action="{{ path('admin_stock_delete', {'id': stock.id}) }}" 
                                      onsubmit="return confirm('ÃƒÅ tes-vous sÃƒÂ»r de vouloir supprimer ce stock ?')" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.id) }}">
                                    <button type="submit" 
                                            style="padding: 0.375rem 0.75rem; background: #dc3545; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 0.875rem;"
                                            title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" style="padding: 3rem; text-align: center; background: #f8f9fa;">
                            <div style="color: #6c757d;">
                                <i class="fas fa-boxes" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;"></i>
                                <h4 style="margin: 0 0 0.5rem 0;">Aucun stock trouvÃƒÂ©</h4>
                                <p style="margin: 0;">Commencez par ajouter votre premier stock.</p>
                                <a href="{{ path('admin_stock_new') }}" class="btn-primary" style="margin-top: 1rem; padding: 0.75rem 1.5rem; background: #007bff; color: white; text-decoration: none; border-radius: 6px; display: inline-block;">
                                    <i class="fas fa-plus"></i> Ajouter un Stock
                                </a>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Informations supplÃƒÂ©mentaires -->
    <div style="margin-top: 2rem; padding: 1.5rem; background: #e7f3ff; border-radius: 10px; border-left: 4px solid #007bff;">
        <h4 style="margin: 0 0 0.5rem 0; color: #007bff;">
            <i class="fas fa-info-circle"></i> FonctionnalitÃƒÂ©s du Module DÃƒÂ©pÃƒÂ´t & Stock
        </h4>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; margin-top: 1rem;">
            <div>
                <strong style="color: #495057;">Ã¢Å“â€¦ Gestion des entrÃƒÂ©es/sorties</strong>
                <p style="margin: 0.25rem 0 0 0; color: #6c757d; font-size: 0.875rem;">Suivi prÃƒÂ©cis des mouvements de stock</p>
            </div>
            <div>
                <strong style="color: #495057;">Ã¢Å“â€¦ ContrÃƒÂ´le des quantitÃƒÂ©s</strong>
                <p style="margin: 0.25rem 0 0 0; color: #6c757d; font-size: 0.875rem;">Seuils d'alerte et critiques personnalisables</p>
            </div>
            <div>
                <strong style="color: #495057;">Ã¢Å“â€¦ Surveillance des dates d'expiration</strong>
                <p style="margin: 0.25rem 0 0 0; color: #6c757d; font-size: 0.875rem;">Alertes automatiques de pÃƒÂ©remption</p>
            </div>
            <div>
                <strong style="color: #495057;">Ã¢Å“â€¦ Optimisation du rÃƒÂ©approvisionnement</strong>
                <p style="margin: 0.25rem 0 0 0; color: #6c757d; font-size: 0.875rem;">Suggestions intelligentes de commandes</p>
            </div>
            <div>
                <strong style="color: #495057;">Ã¢Å“â€¦ Statistiques dÃƒÂ©taillÃƒÂ©es</strong>
                <p style="margin: 0.25rem 0 0 0; color: #6c757d; font-size: 0.875rem;">Valeur du stock et marges bÃƒÂ©nÃƒÂ©ficiaires</p>
            </div>
            <div>
                <strong style="color: #495057;">Ã¢Å“â€¦ TraÃƒÂ§abilitÃƒÂ© complÃƒÂ¨te</strong>
                <p style="margin: 0.25rem 0 0 0; color: #6c757d; font-size: 0.875rem;">NumÃƒÂ©ros de lot et fournisseurs</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

