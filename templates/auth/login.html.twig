<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion - CuraVita</title>
    <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
    <style>
        .login-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--bg-page); }
        .login-card { background: white; padding: 2.5rem; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.1); max-width: 400px; width: 100%; }
        .login-card h1 { text-align: center; color: var(--primary-color); margin-bottom: 0.5rem; }
        .login-card .subtitle { text-align: center; color: var(--text-muted); margin-bottom: 2rem; font-size: 0.9rem; }
        .login-card .form-group { margin-bottom: 1.25rem; }
        .login-card label { display: block; font-weight: 600; margin-bottom: 0.5rem; font-size: 0.9rem; }
        .login-card input { width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: 8px; font-size: 1rem; }
        .login-card input:focus { outline: none; border-color: var(--primary-color); box-shadow: 0 0 0 3px rgba(22, 99, 87, 0.15); }
        .login-card button { width: 100%; padding: 0.9rem; background: var(--primary-color); color: white; border: none; border-radius: 50px; font-weight: 600; font-size: 1rem; cursor: pointer; margin-top: 0.5rem; }
        .login-card button:hover { opacity: 0.9; }
        .login-card .logo { text-align: center; margin-bottom: 1.5rem; }
        .login-card .logo img { max-width: 120px; }
    </style>
</head>
<body>
    <div class="login-page">
        <div class="login-card">
            <div class="logo">
                <img src="{{ asset('assets/img/curavita-logo.png') }}" alt="CuraVita">
            </div>
            <h1>CuraVita</h1>
            <p class="subtitle">Connectez-vous pour accéder au site</p>

            {% if error %}
                <div style="background: #fee; color: #c00; padding: 0.75rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.9rem;">{{ error }}</div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required placeholder="votre@email.com" autocomplete="email">
                </div>
                <div class="form-group">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="password" required placeholder="••••••••" autocomplete="current-password">
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit">Se connecter</button>
            </form>
        </div>
    </div>
</body>
</html>
