<!doctype html>
<html><body style="font-family:Arial,sans-serif;background:#f7fbf9;padding:20px;color:#12382d">
<div style="max-width:680px;margin:auto;background:#fff;border:1px solid #dceee6;border-radius:12px;padding:20px">
    <h2 style="margin-top:0;color:#0f5f45">Mise a jour de votre commande #{{ commande.id }}</h2>
    <p>Bonjour {{ commande.nom }},</p>
    <p>Le statut de votre commande a ete modifie.</p>

    <table style="width:100%;border-collapse:collapse;margin:12px 0">
        <tr>
            <td style="padding:8px;border:1px solid #e6efea;background:#f6fbf8"><strong>Ancien statut</strong></td>
            <td style="padding:8px;border:1px solid #e6efea">{{ old_status }}</td>
        </tr>
        <tr>
            <td style="padding:8px;border:1px solid #e6efea;background:#f6fbf8"><strong>Nouveau statut</strong></td>
            <td style="padding:8px;border:1px solid #e6efea">{{ new_status }}</td>
        </tr>
        <tr>
            <td style="padding:8px;border:1px solid #e6efea;background:#f6fbf8"><strong>Total</strong></td>
            <td style="padding:8px;border:1px solid #e6efea">{{ commande.total|number_format(2, ',', ' ') }} DT</td>
        </tr>
    </table>

    <p>Merci pour votre confiance.</p>
    <p style="color:#5f7a70">Equipe CURAVITA</p>
</div>
</body></html>
