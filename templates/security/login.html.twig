{% extends 'base.html.twig' %}

{% block title %}Connexion - CURAVITA{% endblock %}

{% block stylesheets %}
<style>
    .auth-page {
        min-height: 100vh;
        background: linear-gradient(135deg, var(--primary-color) 0%, #1a7a6e 50%, #0f5d52 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        position: relative;
        overflow: hidden;
    }

    .auth-page::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('{{ asset('assets/img/pattern-bg.png') }}') repeat;
        opacity: 0.1;
        animation: float 20s ease-in-out infinite;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
    }

    .auth-container {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 3rem;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        position: relative;
        z-index: 1;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .auth-logo {
        display: block;
        margin: 0 auto 2rem;
        width: 120px;
        height: auto;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
        animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    .auth-title {
        text-align: center;
        color: var(--primary-color);
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        font-family: var(--font-heading);
    }

    .auth-subtitle {
        text-align: center;
        color: var(--text-muted);
        margin-bottom: 2rem;
        font-size: 0.95rem;
    }

    .auth-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-group {
        position: relative;
    }

    .form-input {
        width: 100%;
        padding: 1rem 1.25rem;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: white;
        color: var(--text-main);
    }

    .form-input:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(22, 99, 87, 0.1);
        transform: translateY(-2px);
    }

    .form-input::placeholder {
        color: #9ca3af;
    }

    .auth-btn {
        background: linear-gradient(135deg, var(--primary-color), #1a7a6e);
        color: white;
        border: none;
        padding: 1rem 2rem;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .auth-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.5s ease;
    }

    .auth-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(22, 99, 87, 0.4);
        background: linear-gradient(135deg, #1a7a6e, var(--primary-color));
    }

    .auth-btn:hover::before {
        left: 100%;
    }

    .auth-btn:active {
        transform: translateY(-1px);
    }

    .auth-error {
        background: rgba(239, 68, 68, 0.1);
        color: #dc2626;
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid #dc2626;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
    }

    .auth-switch {
        text-align: center;
        margin-top: 2rem;
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    .auth-switch a {
        color: var(--primary-color);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s ease;
    }

    .auth-switch a:hover {
        color: #1a7a6e;
        text-decoration: underline;
    }

    .auth-forgot {
        text-align: center;
        margin-top: 1rem;
    }

    .auth-forgot a {
        color: var(--primary-color);
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.3s ease;
    }

    .auth-forgot a:hover {
        color: #1a7a6e;
        text-decoration: underline;
    }

    .auth-info {
        background: rgba(34, 197, 94, 0.1);
        color: #16a34a;
        padding: 1rem;
        border-radius: 8px;
        border-left: 4px solid #16a34a;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
        text-align: center;
    }

    @media (max-width: 640px) {
        .auth-container {
            padding: 2rem 1.5rem;
            margin: 1rem;
        }
        
        .auth-title {
            font-size: 1.5rem;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-container">
        <img src="{{ asset('assets/img/curavita-logo.png') }}" class="auth-logo" alt="CURAVITA">
        
        <h1 class="auth-title">Connexion</h1>
        <p class="auth-subtitle">Accédez à votre espace personnel</p>

        {% if error %}
            <div class="auth-error">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <div class="auth-info">
                Vous êtes déjà connecté en tant que {{ app.user.userIdentifier }}.
                <a href="{{ path('app_logout') }}" style="color: var(--primary-color); font-weight: 600;">Déconnexion</a>
            </div>
        {% endif %}

        <form method="post" class="auth-form" novalidate>
            <div class="form-group">
                <input
                    type="email"
                    name="_username"
                    value="{{ last_username }}"
                    placeholder="Adresse email"
                    class="form-input"
                    autocomplete="email"
                    autofocus
                >
            </div>

            <div class="form-group">
                <input
                    type="password"
                    name="_password"
                    placeholder="Mot de passe"
                    class="form-input"
                    autocomplete="current-password"
                >
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group flex justify-center">
                <div class="g-recaptcha" data-sitekey="6Le37XQsAAAAAHyrIeyKGGpoCd88N8aVup0prHeV"></div>
            </div>

            <button type="submit" class="auth-btn">Se connecter</button>
        </form>

        <!-- ID Card Scan Login Section -->
        <div class="id-scan-login-section">
            <div class="divider">
                <span>ou</span>
            </div>
            <button type="button" class="btn-scan-id" onclick="openIdScanModal()">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="16" rx="3"></rect>
                    <circle cx="9" cy="10" r="2"></circle>
                    <path d="M15 8h2"></path>
                    <path d="M15 12h2"></path>
                    <path d="M7 16h10"></path>
                </svg>
                Scan ID Card (Beta)
            </button>
            <span class="beta-label">Camera-based ID verification (Experimental Beta)</span>
        </div>

        <p class="auth-forgot">
            <a href="{{ path('app_forgot_password') }}">Mot de passe oublié ?</a>
        </p>

        <p class="auth-switch">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}">Créer un compte</a>
        </p>
    </div>
</div>

<!-- ID Scan Modal -->
<div id="idScanModal" class="id-scan-modal">
    <div class="id-scan-container">
        <button class="close-scan-btn" id="closeScanModal" onclick="closeIdScanModal()">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        
        <div class="id-scan-header">
            <h3>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="16" rx="3"></rect>
                    <circle cx="9" cy="10" r="2"></circle>
                    <path d="M15 8h2"></path>
                    <path d="M15 12h2"></path>
                    <path d="M7 16h10"></path>
                </svg>
                Scan Your ID Card
                <span class="beta-badge">Beta</span>
            </h3>
            <p>Position your student ID card within the frame</p>
        </div>
        
        <div class="video-container">
            <video id="idScanVideo" autoplay playsinline muted></video>
            <canvas id="idScanCanvas"></canvas>
            
            <div class="scan-overlay" id="scanOverlay">
                <div class="corner-marker top-left"></div>
                <div class="corner-marker top-right"></div>
                <div class="corner-marker bottom-left"></div>
                <div class="corner-marker bottom-right"></div>
                <div class="scan-line"></div>
            </div>
        </div>
        
        <div class="scan-status ready" id="scanStatus">
            Ready to scan
        </div>
        
        <button type="button" class="scan-btn" id="scanNowBtn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
            </svg>
            Scan Now
        </button>
        
        <div class="security-note">
            <p>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                Your ID data is processed locally and securely
            </p>
        </div>
    </div>
</div>

<!-- ID Scan CSS -->
<link rel="stylesheet" href="{{ asset('assets/css/id-scan.css') }}">

<!-- Tesseract.js for OCR -->
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>

<!-- ID Scan JavaScript -->
<script src="{{ asset('js/id-scan.js') }}"></script>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<script>
    // Modal control functions
    function openIdScanModal() {
        if (window.idScanLogin) {
            window.idScanLogin.openModal();
        }
    }
    
    function closeIdScanModal() {
        if (window.idScanLogin) {
            window.idScanLogin.closeModal();
        }
    }
</script>
{% endblock %}
