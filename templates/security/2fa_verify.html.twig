{% extends 'base.html.twig' %}

{% block title %}Vérification 2FA - CURAVITA{% endblock %}

{% block body %}
<style>
    body {
        background: linear-gradient(135deg, #16563f 0%, #1e6b47 50%, #0d9488 100%);
        background-size: 400% 400%;
        animation: gradientBG 15s ease infinite;
        min-height: 100vh;
    }
    
    @keyframes gradientBG {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }
    
    .verify-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }
    
    .verify-card {
        background: white;
        border-radius: 32px;
        box-shadow: 
            0 25px 50px -12px rgba(0, 0, 0, 0.3),
            0 0 100px rgba(22, 86, 63, 0.2);
        overflow: hidden;
        max-w-lg mx-auto;
        width: 100%;
        animation: cardFloat 3s ease-in-out infinite;
    }
    
    @keyframes cardFloat {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
    
    .verify-header {
        background: linear-gradient(135deg, #16563f 0%, #1e6b47 100%);
        padding: 3rem 2.5rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    
    .verify-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.08'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    
    .verify-icon {
        width: 120px;
        height: 120px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-blur: 10px;
        border-radius: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        border: 3px solid rgba(255, 255, 255, 0.3);
        animation: iconPulse 2s infinite;
    }
    
    @keyframes iconPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }
    
    .verify-icon svg {
        width: 60px;
        height: 60px;
        color: white;
    }
    
    .verify-header h2 {
        color: white;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        position: relative;
    }
    
    .verify-header p {
        color: rgba(255, 255, 255, 0.9);
        font-size: 1.1rem;
        position: relative;
    }
    
    .logo-brand {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
        position: relative;
    }
    
    .logo-brand span:first-child {
        color: white;
        font-size: 1.8rem;
        font-weight: 800;
    }
    
    .logo-brand span:last-child {
        color: #86efac;
        font-size: 1.8rem;
        font-weight: 800;
    }
    
    .verify-body {
        padding: 3rem 2.5rem;
    }
    
    .verify-input {
        width: 100%;
        padding: 1.5rem;
        border: 3px solid #e5e7eb;
        border-radius: 20px;
        font-size: 3rem;
        text-align: center;
        letter-spacing: 1rem;
        font-weight: bold;
        color: #16563f;
        transition: all 0.3s ease;
        background: #f9fafb;
    }
    
    .verify-input:focus {
        outline: none;
        border-color: #16563f;
        background: white;
        box-shadow: 0 0 0 5px rgba(22, 86, 63, 0.1);
        transform: scale(1.02);
    }
    
    .verify-input::placeholder {
        letter-spacing: 1rem;
        color: #d1d5db;
    }
    
    .verify-label {
        display: block;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 1rem;
        font-size: 1.2rem;
    }
    
    .verify-hint {
        display: block;
        font-size: 0.95rem;
        color: #6b7280;
        margin-top: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .verify-btn {
        width: 100%;
        background: linear-gradient(135deg, #16563f 0%, #1e6b47 100%);
        color: white;
        padding: 1.5rem;
        border: none;
        border-radius: 20px;
        font-size: 1.2rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 1.5rem;
        position: relative;
        overflow: hidden;
    }
    
    .verify-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
        animation: shimmer 2s infinite;
    }
    
    @keyframes shimmer {
        100% { left: 100%; }
    }
    
    .verify-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(22, 86, 63, 0.4);
    }
    
    .verify-footer {
        text-align: center;
        padding: 2rem 2.5rem 2.5rem;
        background: #f9fafb;
    }
    
    .verify-footer a {
        color: #6b7280;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
    }
    
    .verify-footer a:hover {
        color: #16563f;
        background: #e0e7ff;
    }
    
    .error-message {
        background: #fef2f2;
        border: 2px solid #fca5a5;
        padding: 1rem;
        border-radius: 16px;
        margin-bottom: 1.5rem;
    }
    
    .error-message p {
        color: #dc2626;
        font-size: 1rem;
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
    }
</style>

<div class="verify-wrapper">
    <div class="verify-card">
        <div class="verify-header">
            <div class="logo-brand">
                <span>CURA</span><span>VITA</span>
            </div>
            <div class="verify-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="M9 12l2 2 4-4"></path>
                </svg>
            </div>
            <h2>Vérification de Sécurité</h2>
            <p>Entrez le code de votre application Google Authenticator<br><small>{{ email|default('') }}</small></p>
        </div>
        
        <div class="verify-body">
            {% if error %}
            <div class="error-message">
                <p>
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                    {{ error }}
                </p>
            </div>
            {% endif %}

            <form method="post">
                <div>
                    <label for="verification_code" class="verify-label flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2">
                            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
                        </svg>
                        Code à 6 chiffres
                    </label>
                    <input type="text" 
                           name="verification_code" 
                           id="verification_code"
                           required
                           maxlength="6"
                           pattern="[0-9]*"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           class="verify-input"
                           placeholder="000000"
                           autofocus>
                    <span class="verify-hint">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        Le code change toutes les 30 secondes
                    </span>
                </div>

                <button type="submit" class="verify-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="inline mr-2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    Vérifier
                </button>
            </form>
        </div>
        
        <div class="verify-footer">
            <a href="{{ path('app_logout') }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                Se déconnecter
            </a>
        </div>
    </div>
</div>
{% endblock %}
