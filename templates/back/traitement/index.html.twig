{% extends 'back/base.html.twig' %}

{% block title %}Gestion des Traitements - Backoffice{% endblock %}

{% block body %}
<div class="container fade-in">
    <div class="page-header">
        <h1>💊 Gestion des Traitements</h1>
        <div>
            <a href="{{ path('back_traitement_new') }}" class="btn btn-primary">
                ➕ Nouveau Traitement
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">✅ {{ message }}</div>
    {% endfor %}

    <!-- Stats Cards -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="icon">📊</div>
            <div class="value">{{ traitements|length }}</div>
            <div class="label">Total Traitements</div>
        </div>
        <div class="stat-card">
            <div class="icon">✅</div>
            <div class="value">{{ actifs|length }}</div>
            <div class="label">Traitements Actifs</div>
        </div>
        <div class="stat-card">
            <div class="icon">🏁</div>
            <div class="value">{{ completes|length }}</div>
            <div class="label">Traitements Complétés</div>
        </div>
    </div>

    <!-- Traitements Actifs -->
    {% if actifs|length > 0 %}
    <div class="card mb-20">
        <div class="card-header">
            <h2>🔥 Traitements Actifs</h2>
        </div>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Ordonnance</th>
                        <th>Client</th>
                        <th>Dosage</th>
                        <th>Fréquence</th>
                        <th>Durée</th>
                        <th>Dates</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for traitement in actifs %}
                    <tr>
                        <td><strong>#{{ traitement.id }}</strong></td>
                        <td>
                            <a href="{{ path('back_ordonnance_show', {id: traitement.ordonnance.id}) }}" class="btn btn-sm btn-secondary">
                                📋 Ordonnance #{{ traitement.ordonnance.id }}
                            </a>
                        </td>
                        <td>Client #{{ traitement.clientId }}</td>
                        <td><strong>{{ traitement.dosage }}</strong></td>
                        <td>{{ traitement.frequency }}</td>
                        <td>{{ traitement.durationDays }} jours</td>
                        <td>
                            <small>
                                Du {{ traitement.startDate|date('d/m/Y') }}<br>
                                Au {{ traitement.endDate|date('d/m/Y') }}
                            </small>
                        </td>
                        <td>
                            {% if traitement.isActive %}
                                <span class="status status-validated">✅ Actif</span>
                            {% elseif traitement.isCompleted %}
                                <span class="status status-rejected">🏁 Complété</span>
                            {% else %}
                                <span class="status status-pending_validation">⏸️ Inactif</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('back_traitement_show', {id: traitement.id}) }}" class="btn btn-sm btn-primary">
                                👁️ Voir
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    <!-- Tous les Traitements -->
    <div class="card">
        <div class="card-header">
            <h2>📋 Tous les Traitements</h2>
        </div>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Ordonnance</th>
                        <th>Client</th>
                        <th>Dosage</th>
                        <th>Fréquence</th>
                        <th>Durée</th>
                        <th>Dates</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for traitement in traitements %}
                    <tr>
                        <td><strong>#{{ traitement.id }}</strong></td>
                        <td>
                            <a href="{{ path('back_ordonnance_show', {id: traitement.ordonnance.id}) }}" class="btn btn-sm btn-secondary">
                                📋 #{{ traitement.ordonnance.id }}
                            </a>
                        </td>
                        <td>Client #{{ traitement.clientId }}</td>
                        <td><strong>{{ traitement.dosage }}</strong></td>
                        <td>{{ traitement.frequency }}</td>
                        <td>{{ traitement.durationDays }} jours</td>
                        <td>
                            <small>
                                Du {{ traitement.startDate|date('d/m/Y') }}<br>
                                Au {{ traitement.endDate|date('d/m/Y') }}
                            </small>
                        </td>
                        <td>
                            {% if traitement.isActive %}
                                <span class="status status-validated">✅ Actif</span>
                            {% elseif traitement.isCompleted %}
                                <span class="status status-rejected">🏁 Complété</span>
                            {% else %}
                                <span class="status status-pending_validation">⏸️ Inactif</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('back_traitement_show', {id: traitement.id}) }}" class="btn btn-sm btn-primary">
                                👁️ Voir
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
