{% extends 'back/base.html.twig' %}

{% block title %}Nouveau Traitement - Backoffice{% endblock %}

{% block body %}
<div class="container fade-in">
    <div class="page-header">
        <h1>➕ Nouveau Traitement</h1>
        <a href="{{ path('back_traitement_index') }}" class="btn btn-secondary">
            ← Retour à la liste
        </a>
    </div>

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger">❌ {{ message }}</div>
    {% endfor %}

    <div class="card">
        <form method="post" action="{{ path('back_traitement_new') }}">
            <div class="form-group">
                <label for="ordonnanceId">Ordonnance (validée) *</label>
                <select id="ordonnanceId" name="ordonnanceId" class="form-control" required>
                    <option value="">-- Sélectionner une ordonnance --</option>
                    {% for ordonnance in ordonnances %}
                        <option value="{{ ordonnance.id }}">
                            Ordonnance #{{ ordonnance.id }} - Client #{{ ordonnance.clientId }} - {{ ordonnance.fileName }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group">
                <label for="clientId">ID Client *</label>
                <input type="number" id="clientId" name="clientId" class="form-control" required 
                       placeholder="1" min="1">
            </div>

            <div class="form-group">
                <label for="dosage">Dosage *</label>
                <input type="text" id="dosage" name="dosage" class="form-control" required 
                       placeholder="500mg">
            </div>

            <div class="form-group">
                <label for="frequency">Fréquence *</label>
                <input type="text" id="frequency" name="frequency" class="form-control" required 
                       placeholder="3 fois par jour">
            </div>

            <div class="form-group">
                <label for="durationDays">Durée (jours) *</label>
                <input type="number" id="durationDays" name="durationDays" class="form-control" required 
                       placeholder="7" min="1">
            </div>

            <div class="form-group">
                <label for="startDate">Date de début *</label>
                <input type="date" id="startDate" name="startDate" class="form-control" required>
            </div>

            <div class="form-group">
                <label for="endDate">Date de fin *</label>
                <input type="date" id="endDate" name="endDate" class="form-control" required>
            </div>

            <div class="form-group">
                <label for="isActive">Statut *</label>
                <select id="isActive" name="isActive" class="form-control" required>
                    <option value="1">Actif</option>
                    <option value="0">Inactif</option>
                </select>
            </div>

            <div class="form-group">
                <label for="notes">Notes (optionnel)</label>
                <textarea id="notes" name="notes" class="form-control" rows="3" 
                          placeholder="Notes supplémentaires sur le traitement..."></textarea>
            </div>

            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button type="submit" class="btn btn-primary">
                    ✅ Créer le Traitement
                </button>
                <a href="{{ path('back_traitement_index') }}" class="btn btn-secondary">
                    ❌ Annuler
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
