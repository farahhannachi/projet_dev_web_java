{% extends 'back/base.html.twig' %}

{% block title %}Modifier Ordonnance #{{ ordonnance.id }} - Backoffice{% endblock %}

{% block body %}
<div class="container fade-in">
    <div class="page-header">
        <h1>✏️ Modifier Ordonnance #{{ ordonnance.id }}</h1>
        <a href="{{ path('back_ordonnance_show', {id: ordonnance.id}) }}" class="btn btn-secondary">
            ← Retour
        </a>
    </div>

    <div class="card">
        <form method="post" action="{{ path('back_ordonnance_edit', {id: ordonnance.id}) }}">
            <div class="form-group">
                <label for="fileName">Nom du fichier *</label>
                <input type="text" id="fileName" name="fileName" class="form-control" required 
                       value="{{ ordonnance.fileName }}">
            </div>

            <div class="form-group">
                <label for="filePath">Chemin du fichier *</label>
                <input type="text" id="filePath" name="filePath" class="form-control" required 
                       value="{{ ordonnance.filePath }}">
            </div>

            <div class="form-group">
                <label for="clientId">ID Client *</label>
                <input type="number" id="clientId" name="clientId" class="form-control" required 
                       value="{{ ordonnance.clientId }}" min="1">
            </div>

            <div class="form-group">
                <label for="status">Statut *</label>
                <select id="status" name="status" class="form-control" required>
                    <option value="pending_validation" {% if ordonnance.status == 'pending_validation' %}selected{% endif %}>
                        En attente de validation
                    </option>
                    <option value="validated" {% if ordonnance.status == 'validated' %}selected{% endif %}>
                        Validée
                    </option>
                    <option value="rejected" {% if ordonnance.status == 'rejected' %}selected{% endif %}>
                        Rejetée
                    </option>
                </select>
            </div>

            <div class="form-group">
                <label for="rejectionReason">Raison du rejet (optionnel)</label>
                <textarea id="rejectionReason" name="rejectionReason" class="form-control" rows="3">{{ ordonnance.rejectionReason }}</textarea>
            </div>

            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button type="submit" class="btn btn-primary">
                    ✅ Enregistrer les modifications
                </button>
                <a href="{{ path('back_ordonnance_show', {id: ordonnance.id}) }}" class="btn btn-secondary">
                    ❌ Annuler
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
