{#
/**
 * Custom pagination template - Simple horizontal layout
 */
#}

{% if pageCount > 1 %}
<div class="custom-pagination" style="display: flex; justify-content: center; margin-top: 30px;">
    <ul style="
        display: flex !important;
        flex-direction: row !important;
        align-items: center;
        gap: 25px;
        background: white;
        padding: 20px 40px;
        border-radius: 12px;
        list-style: none !important;
        margin: 0;
    ">
        {# Previous button #}
        {% if previous is defined %}
            <li style="list-style: none !important;">
                <a href="{{ path(route, query|merge({(pageParameterName): previous})) }}" style="
                    text-decoration: none !important;
                    color: black !important;
                    font-size: 20px;
                    font-weight: 500;
                    padding: 10px 18px;
                    border-radius: 10px;
                    display: inline-block;
                "><</a>
            </li>
        {% else %}
            <li style="list-style: none !important;">
                <span style="color: #999; font-size: 20px; padding: 10px 18px;"><</span>
            </li>
        {% endif %}

        {# First page #}
        {% if first is defined and first != current %}
            <li style="list-style: none !important;">
                <a href="{{ path(route, query|merge({(pageParameterName): first})) }}" style="
                    text-decoration: none !important;
                    color: black !important;
                    font-size: 20px;
                    font-weight: 500;
                    padding: 10px 18px;
                    border-radius: 10px;
                    display: inline-block;
                ">{{ first }}</a>
            </li>
        {% endif %}

        {# Ellipsis before current range #}
        {% if current - 2 > 2 %}
            <li style="list-style: none !important;">
                <span style="color: #999; font-size: 20px;">...</span>
            </li>
        {% endif %}

        {# Page numbers in range #}
        {% for page in pagesInRange %}
            {% if page != current %}
                <li style="list-style: none !important;">
                    <a href="{{ path(route, query|merge({(pageParameterName): page})) }}" style="
                        text-decoration: none !important;
                        color: black !important;
                        font-size: 20px;
                        font-weight: 500;
                        padding: 10px 18px;
                        border-radius: 10px;
                        display: inline-block;
                    ">{{ page }}</a>
                </li>
            {% else %}
                <li class="active" style="list-style: none !important;">
                    <span style="
                        background-color: #4ade80 !important;
                        font-weight: bold;
                        font-size: 20px;
                        padding: 10px 18px;
                        border-radius: 10px;
                        display: inline-block;
                    ">{{ page }}</span>
                </li>
            {% endif %}
        {% endfor %}

        {# Ellipsis after current range #}
        {% if current + 2 < last - 1 %}
            <li style="list-style: none !important;">
                <span style="color: #999; font-size: 20px;">...</span>
            </li>
        {% endif %}

        {# Last page #}
        {% if last is defined and last != current and last != pagesInRange|last %}
            <li style="list-style: none !important;">
                <a href="{{ path(route, query|merge({(pageParameterName): last})) }}" style="
                    text-decoration: none !important;
                    color: black !important;
                    font-size: 20px;
                    font-weight: 500;
                    padding: 10px 18px;
                    border-radius: 10px;
                    display: inline-block;
                ">{{ last }}</a>
            </li>
        {% endif %}

        {# Next button #}
        {% if next is defined %}
            <li style="list-style: none !important;">
                <a href="{{ path(route, query|merge({(pageParameterName): next})) }}" style="
                    text-decoration: none !important;
                    color: black !important;
                    font-size: 20px;
                    font-weight: 500;
                    padding: 10px 18px;
                    border-radius: 10px;
                    display: inline-block;
                ">></a>
            </li>
        {% else %}
            <li style="list-style: none !important;">
                <span style="color: #999; font-size: 20px; padding: 10px 18px;">></span>
            </li>
        {% endif %}
    </ul>
</div>
{% endif %}
