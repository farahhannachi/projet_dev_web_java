{% if ordonnances is defined and ordonnances is not empty %}
    <div style="display: grid; gap: 2rem;">
        {% for ordonnance in ordonnances %}
            {% if ordonnance.statut == 'validé' %}
                {% set borderColor = '#10b981' %}
                {% set bgColor = '#f0fdf4' %}
                {% set badgeBg = '#d1fae5' %}
                {% set badgeColor = '#065f46' %}
                {% set badgeText = '✓ Validée' %}
            {% elseif ordonnance.statut == 'en attente' %}
                {% set borderColor = '#f59e0b' %}
                {% set bgColor = '#fffbeb' %}
                {% set badgeBg = '#fef3c7' %}
                {% set badgeColor = '#92400e' %}
                {% set badgeText = '⏳ En attente' %}
            {% elseif ordonnance.statut == 'rejeté' %}
                {% set borderColor = '#ef4444' %}
                {% set bgColor = '#fef2f2' %}
                {% set badgeBg = '#fee2e2' %}
                {% set badgeColor = '#991b1b' %}
                {% set badgeText = '✗ Rejetée' %}
            {% else %}
                {% set borderColor = '#6b7280' %}
                {% set bgColor = '#f9fafb' %}
                {% set badgeBg = '#e5e7eb' %}
                {% set badgeColor = '#374151' %}
                {% set badgeText = ordonnance.statut|capitalize %}
            {% endif %}

            <div style="border: 2px solid {{ borderColor }}; border-radius: 16px; padding: 2rem; background: {{ bgColor }};">
                <!-- En-tête Ordonnance -->
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 2px solid {{ badgeBg }};">
                    <div>
                        <h3 style="font-size: 1.5rem; font-weight: 700; color: #1f2937; margin-bottom: 0.5rem;">
                            📋 {{ ordonnance.numeroOrdonnance }}
                        </h3>
                        <span style="background: {{ badgeBg }}; color: {{ badgeColor }}; padding: 0.375rem 0.875rem; border-radius: 20px; font-size: 0.875rem; font-weight: 600;">
                            {{ badgeText }}
                        </span>
                    </div>
                    {% if ordonnance.statut == 'validé' %}
                        <div style="display: flex; gap: 0.75rem;">
                            <a href="{{ path('app_ordonnance_complete_pdf', {id: ordonnance.id}) }}" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; background: var(--primary-color); color: white; text-decoration: none; border-radius: 10px; font-size: 0.875rem; font-weight: 600; transition: all 0.2s;" onmouseover="this.style.background='#145239'" onmouseout="this.style.background='var(--primary-color)'">
                                📥 Télécharger PDF
                            </a>
                            <form method="post" action="{{ path('app_ordonnance_send_email', {id: ordonnance.id}) }}" style="display: inline;">
                                <button type="submit" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; background: #f59e0b; color: white; border: none; border-radius: 10px; font-size: 0.875rem; font-weight: 600; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='#d97706'" onmouseout="this.style.background='#f59e0b'">
                                    📧 Envoyer par Email
                                </button>
                            </form>
                        </div>
                    {% endif %}
                </div>
                
                <!-- Informations Ordonnance -->
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                    <div>
                        <div style="font-size: 0.75rem; color: #6b7280; font-weight: 600; margin-bottom: 0.25rem;">📅 Date ordonnance</div>
                        <div style="font-size: 0.95rem; color: #1f2937; font-weight: 600;">
                            {{ ordonnance.dateOrdonnance|date('d/m/Y') }}
                        </div>
                    </div>
                    <div>
                        <div style="font-size: 0.75rem; color: #6b7280; font-weight: 600; margin-bottom: 0.25rem;">⏰ Date expiration</div>
                        <div style="font-size: 0.95rem; color: #1f2937; font-weight: 600;">
                            {{ ordonnance.dateExpiration|date('d/m/Y') }}
                        </div>
                    </div>
                </div>

                {% if ordonnance.noteMedical %}
                    <div style="margin-bottom: 1.5rem; padding: 1rem; background: white; border-radius: 8px; max-height: 200px; overflow-y: auto; word-break: break-word;">
                        <div style="font-size: 0.75rem; color: #6b7280; font-weight: 600; margin-bottom: 0.5rem;">💬 Note médicale</div>
                        <div style="font-size: 0.875rem; color: #374151; line-height: 1.6;">
                            {{ ordonnance.noteMedical ? ordonnance.noteMedicalFixed : '' }}
                        </div>
                    </div>
                {% endif %}

                <!-- Traitements associés à cette ordonnance -->
                {% set traitements_ordonnance = [] %}
                {% if traitements is defined %}
                    {% for traitement in traitements %}
                        {% if traitement.ordonnance.id == ordonnance.id %}
                            {% set traitements_ordonnance = traitements_ordonnance|merge([traitement]) %}
                        {% endif %}
                    {% endfor %}
                {% endif %}

                {% if traitements_ordonnance is not empty %}
                    <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 2px solid #d1fae5;">
                        <h4 style="font-size: 1.125rem; font-weight: 700; color: #1f2937; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                            💊 Traitement(s) Associé(s) ({{ traitements_ordonnance|length }})
                        </h4>
                        
                        <div style="display: grid; gap: 1rem;">
                            {% for traitement in traitements_ordonnance %}
                                <div style="background: white; border: 2px solid #e5e7eb; border-radius: 12px; padding: 1.5rem; position: relative;">
                                    <!-- Badge Statut -->
                                    <div style="position: absolute; top: 1rem; right: 1rem; display: flex; gap: 0.5rem; align-items: center;">
                                        {% if traitement.status == 'actif' %}
                                            <span style="background: #d1fae5; color: #065f46; padding: 0.375rem 0.875rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600;">
                                                ✓ Actif
                                            </span>
                                        {% elseif traitement.status == 'validé' %}
                                            <span style="background: #d1fae5; color: #065f46; padding: 0.375rem 0.875rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600;">
                                                ✓ Validé
                                            </span>
                                        {% elseif traitement.status == 'en attente' %}
                                            <span style="background: #fef3c7; color: #92400e; padding: 0.375rem 0.875rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600;">
                                                ⏳ En attente
                                            </span>
                                        {% elseif traitement.status == 'terminé' %}
                                            <span style="background: #e5e7eb; color: #374151; padding: 0.375rem 0.875rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600;">
                                                ✓ Terminé
                                            </span>
                                        {% else %}
                                            <span style="background: #fee2e2; color: #991b1b; padding: 0.375rem 0.875rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600;">
                                                ✗ {{ traitement.status|capitalize }}
                                            </span>
                                        {% endif %}
                                    </div>

                                    <!-- Produit associé -->
                                    {% if traitement.produit %}
                                        <div style="margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #e5e7eb;">
                                            <div style="font-size: 0.75rem; color: #6b7280; font-weight: 600; margin-bottom: 0.25rem;">💊 PRODUIT</div>
                                            <div style="font-size: 1.125rem; color: var(--primary-color); font-weight: 700;">
                                                {{ traitement.produit.nom }}
                                            </div>
                                            <div style="font-size: 0.875rem; color: #6b7280; margin-top: 0.25rem;">
                                                {{ traitement.produit.description }}
                                            </div>
                                        </div>
                                    {% endif %}

                                    <!-- Informations du traitement -->
                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
                                        <div>
                                            <div style="font-size: 0.75rem; color: #9ca3af; text-transform: uppercase; font-weight: 600; margin-bottom: 0.25rem;">Dosage</div>
                                            <div style="font-size: 0.875rem; color: #1f2937; font-weight: 500;">
                                                {{ traitement.dosage ?? 'À définir' }}
                                            </div>
                                        </div>
                                        <div>
                                            <div style="font-size: 0.75rem; color: #9ca3af; text-transform: uppercase; font-weight: 600; margin-bottom: 0.25rem;">Fréquence</div>
                                            <div style="font-size: 0.875rem; color: #1f2937; font-weight: 500;">
                                                {{ traitement.frequence ?? 'À définir' }}
                                            </div>
                                        </div>
                                        <div>
                                            <div style="font-size: 0.75rem; color: #9ca3af; text-transform: uppercase; font-weight: 600; margin-bottom: 0.25rem;">Durée</div>
                                            <div style="font-size: 0.875rem; color: #1f2937; font-weight: 500;">
                                                {{ traitement.dureeJours ? traitement.dureeJours ~ ' jours' : 'À définir' }}
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Dates -->
                                    {% if traitement.dateDebut and traitement.dateFin %}
                                        <div style="display: flex; gap: 1.5rem; margin-bottom: 1rem; padding: 0.75rem; background: #f9fafb; border-radius: 8px;">
                                            <div>
                                                <span style="font-size: 0.75rem; color: #6b7280;">Début :</span>
                                                <span style="font-size: 0.875rem; color: #1f2937; font-weight: 500; margin-left: 0.25rem;">
                                                    {{ traitement.dateDebut|date('d/m/Y') }}
                                                </span>
                                            </div>
                                            <div>
                                                <span style="font-size: 0.75rem; color: #6b7280;">Fin :</span>
                                                <span style="font-size: 0.875rem; color: #1f2937; font-weight: 500; margin-left: 0.25rem;">
                                                    {{ traitement.dateFin|date('d/m/Y') }}
                                                </span>
                                            </div>
                                        </div>
                                    {% endif %}

                                    <!-- Notes -->
                                    {% if traitement.notes %}
                                        <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #e5e7eb;">
                                            <div style="font-size: 0.75rem; color: #9ca3af; text-transform: uppercase; font-weight: 600; margin-bottom: 0.5rem;">Notes</div>
                                            <div style="font-size: 0.875rem; color: #6b7280; line-height: 1.6;">
                                                {{ traitement.notes }}
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% else %}
                    <div style="margin-top: 1.5rem; padding: 1rem; background: white; border-radius: 8px; text-align: center; color: #6b7280; font-size: 0.875rem;">
                        Aucun traitement associé à cette ordonnance
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% else %}
    <div style="text-align: center; padding: 2rem 1rem;">
        <div style="font-size: 3rem; margin-bottom: 1rem;">📋</div>
        <h3 style="font-size: 1.125rem; font-weight: 600; color: #6b7280; margin-bottom: 0.5rem;">Aucune ordonnance trouvée</h3>
        <p style="color: #9ca3af; font-size: 0.875rem; margin-bottom: 1.5rem;">
            {% if searchTerm is defined and searchTerm %}
                Aucun résultat pour "{{ searchTerm }}"
            {% else %}
                Vos ordonnances apparaîtront ici.
            {% endif %}
        </p>
        <a href="{{ path('app_demande_traitement') }}" style="display: inline-block; padding: 0.875rem 1.5rem; background: var(--primary-color); color: white; text-decoration: none; border-radius: 10px; font-weight: 600; transition: all 0.2s;">
            Faire une demande de traitement
        </a>
    </div>
{% endif %}
