{% extends "front/_base.html.twig" %}

{% block title %}Modifier Mon Profil - CuraVita{% endblock %}

{% block main %}
<div class="profile-edit-container">
    <div class="profile-edit-header">
        <h1>Modifier Mon Profil</h1>
        <p>Mettez à jour vos informations personnelles</p>
    </div>

    <!-- Flash Messages -->
    {% if app.flashes %}
        <div class="flash-messages-container">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }}">
                        <button class="alert-close" onclick="this.parentElement.style.display='none';">&times;</button>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            {% if type == 'success' %}
                                <polyline points="20 6 9 17 4 12"></polyline>
                            {% else %}
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            {% endif %}
                        </svg>
                        <span>{{ message }}</span>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    {% endif %}

    <div class="profile-edit-content">
        <div class="profile-edit-card">
            <div class="edit-form-wrapper">
                <form method="POST" class="profile-edit-form">
                    <div class="form-section">
                        <h2>Informations Personnelles</h2>
                        
                        <div class="form-group {% if errors is defined and errors.nom is defined and errors.nom %}has-error{% endif %}">
                            <label for="nom" class="form-label">Nom *</label>
                            <input 
                                type="text" 
                                id="nom" 
                                name="nom" 
                                value="{{ user.nom }}" 
                                class="form-input"
                            >
                            {% if errors is defined and errors.nom is defined and errors.nom %}
                                <span class="form-error">{{ errors.nom|default('') }}</span>
                            {% else %}
                                <span class="form-text">Votre nom de famille</span>
                            {% endif %}
                        </div>

                        <div class="form-group {% if errors is defined and errors.prenom is defined and errors.prenom %}has-error{% endif %}">
                            <label for="prenom" class="form-label">Prénom *</label>
                            <input 
                                type="text" 
                                id="prenom" 
                                name="prenom" 
                                value="{{ user.prenom }}" 
                                class="form-input"
                            >
                            {% if errors is defined and errors.prenom is defined and errors.prenom %}
                                <span class="form-error">{{ errors.prenom|default('') }}</span>
                            {% else %}
                                <span class="form-text">Votre prénom</span>
                            {% endif %}
                        </div>

                        <div class="form-group {% if errors is defined and errors.email is defined and errors.email %}has-error{% endif %}">
                            <label for="email" class="form-label">Email *</label>
                            <input 
                                type="text" 
                                id="email" 
                                name="email" 
                                value="{{ user.email }}" 
                                class="form-input"
                            >
                            {% if errors is defined and errors.email is defined and errors.email %}
                                <span class="form-error">{{ errors.email|default('') }}</span>
                            {% else %}
                                <span class="form-text">Votre adresse e-mail (utilisée pour la connexion)</span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="form-section">
                        <h2>Informations du Compte</h2>
                        
                        <div class="form-group-readonly">
                            <label class="form-label">Compte créé le</label>
                            <div class="readonly-value">
                                {{ user.dateCreation|format_date('long') }}
                            </div>
                        </div>

                        <div class="form-group-readonly">
                            <label class="form-label">Statut du Compte</label>
                            <div class="readonly-value">
                                <span class="status-badge status-{{ user.etatCompte }}">
                                    {% if user.etatCompte == 'actif' %}
                                        Compte Actif
                                    {% elseif user.etatCompte == 'suspendu' %}
                                        Compte Suspendu
                                    {% else %}
                                        Compte Désactivé
                                    {% endif %}
                                </span>
                            </div>
                        </div>

                        <div class="form-group-readonly">
                            <label class="form-label">Rôle</label>
                            <div class="readonly-value">
                                {% if is_granted('ROLE_ADMIN') %}
                                    <span class="role-badge admin">Administrateur</span>
                                {% else %}
                                    <span class="role-badge user">Client</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h2>Programme de Fidélité</h2>
                        
                        <div class="form-row">
                            <div class="form-group-readonly">
                                <label class="form-label">Niveau de Fidélité</label>
                                <div class="readonly-value">{{ user.loyaltyLevel }}</div>
                            </div>
                            <div class="form-group-readonly">
                                <label class="form-label">Points Accumulés</label>
                                <div class="readonly-value">{{ user.loyaltyPoints }} pts</div>
                            </div>
                            <div class="form-group-readonly">
                                <label class="form-label">Segment Client</label>
                                <div class="readonly-value">{{ user.segment }}</div>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-save">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                <polyline points="7 3 7 8 15 8"></polyline>
                            </svg>
                            Enregistrer les Modifications
                        </button>
                        <a href="{{ path('app_profile') }}" class="btn-cancel">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="12 18 12 6 7 11"></polyline>
                                <polyline points="12 6 17 11"></polyline>
                            </svg>
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="profile-edit-sidebar">
            <div class="sidebar-card tips">
                <h3>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    Conseils
                </h3>
                <ul>
                    <li>Gardez votre email à jour pour recevoir les notifications importantes</li>
                    <li>Votre mot de passe ne peut être modifié que via la page de sécurité</li>
                    <li>Tous les champs marqués avec * sont obligatoires</li>
                </ul>
            </div>

            <div class="sidebar-card security">
                <h3>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    Sécurité
                </h3>
                <p>Pour changer votre mot de passe, veuillez accéder à vos paramètres de sécurité.</p>
                <a href="#" class="btn-security">Paramètres de Sécurité</a>
            </div>
        </div>
    </div>
</div>

<style>
    /* Flash Messages */
    .flash-messages-container {
        max-width: 1200px;
        margin: -1rem auto 2rem;
        padding: 0 2rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .alert {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        border-radius: 8px;
        animation: slideDown 0.3s ease;
        position: relative;
        border-left: 4px solid;
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .alert-success {
        background: #d4edda;
        color: #155724;
        border-left-color: #28a745;
    }

    .alert-error {
        background: #f8d7da;
        color: #721c24;
        border-left-color: #dc3545;
    }

    .alert svg {
        flex-shrink: 0;
    }

    .alert-close {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        opacity: 0.7;
        transition: opacity 0.3s ease;
        padding: 0;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .alert-close:hover {
        opacity: 1;
    }

    /* Form Error Styles */
    .form-group.has-error .form-input {
        border-color: #dc3545;
        background: #fff5f5;
    }

    .form-group.has-error .form-input:focus {
        border-color: #dc3545;
        box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.1);
    }

    .form-error {
        font-size: 0.85rem;
        color: #dc3545;
        font-weight: 600;
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-error::before {
        content: '⚠';
        font-size: 0.9rem;
    }

    .profile-edit-container {
        background: #f8f9fa;
        min-height: 100vh;
        padding: 2rem;
        padding-bottom: 4rem;
    }

    .profile-edit-header {
        text-align: center;
        margin-bottom: 3rem;
        max-width: 1200px;
        margin-left: auto;
        margin-right: auto;
    }

    .profile-edit-header h1 {
        font-size: 2.5rem;
        font-weight: 700;
        color: #16563f;
        margin-bottom: 0.5rem;
    }

    .profile-edit-header p {
        font-size: 1.1rem;
        color: #6c757d;
    }

    .profile-edit-content {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .profile-edit-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .edit-form-wrapper {
        padding: 2.5rem;
    }

    .profile-edit-form {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .form-section {
        border-bottom: 2px solid #f0f2f5;
        padding-bottom: 2.5rem;
    }

    .form-section:last-of-type {
        border-bottom: none;
        padding-bottom: 0;
    }

    .form-section h2 {
        font-size: 1.3rem;
        font-weight: 700;
        color: #16563f;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
    }

    .form-group:last-child {
        margin-bottom: 0;
    }

    .form-label {
        font-size: 0.95rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .form-input {
        padding: 0.8rem 1rem;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        font-size: 1rem;
        font-family: inherit;
        transition: all 0.3s ease;
        background: white;
    }

    .form-input:focus {
        outline: none;
        border-color: #16563f;
        box-shadow: 0 0 0 3px rgba(22, 86, 63, 0.1);
    }

    .form-input:hover:not(:focus) {
        border-color: #d0d0d0;
    }

    .form-text {
        font-size: 0.85rem;
        color: #6c757d;
        margin-top: 0.25rem;
    }

    .form-group-readonly {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
    }

    .readonly-value {
        padding: 0.8rem 1rem;
        background: #f8f9fa;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        color: #2c3e50;
        font-weight: 500;
        font-size: 1rem;
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .form-row .form-group-readonly {
        margin-bottom: 0;
    }

    .status-badge {
        display: inline-block;
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        width: fit-content;
    }

    .status-badge.status-actif {
        background: #d4edda;
        color: #155724;
    }

    .status-badge.status-suspendu {
        background: #f8d7da;
        color: #721c24;
    }

    .status-badge.status-desactif {
        background: #e2e3e5;
        color: #383d41;
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        width: fit-content;
    }

    .role-badge.admin {
        background: #cfe2ff;
        color: #084298;
    }

    .role-badge.user {
        background: #f0f8f5;
        color: #16563f;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2.5rem;
        padding-top: 2.5rem;
        border-top: 2px solid #f0f2f5;
    }

    .btn-save,
    .btn-cancel {
        padding: 0.8rem 2rem;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        justify-content: center;
        flex: 1;
    }

    .btn-save {
        background: linear-gradient(135deg, #16563f, #1e6b47);
        color: white;
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(22, 86, 63, 0.3);
    }

    .btn-save:active {
        transform: translateY(0);
    }

    .btn-cancel {
        background: #e9ecef;
        color: #2c3e50;
        border: 2px solid #dee2e6;
    }

    .btn-cancel:hover {
        background: #dee2e6;
        border-color: #adb5bd;
    }

    .profile-edit-sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .sidebar-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .sidebar-card h3 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.1rem;
        font-weight: 700;
        color: #16563f;
        margin-bottom: 1rem;
    }

    .sidebar-card.tips ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .sidebar-card.tips li {
        font-size: 0.9rem;
        color: #6c757d;
        padding-left: 1.5rem;
        position: relative;
    }

    .sidebar-card.tips li::before {
        content: '✓';
        position: absolute;
        left: 0;
        color: #28a745;
        font-weight: 700;
    }

    .sidebar-card.security p {
        font-size: 0.95rem;
        color: #6c757d;
        margin-bottom: 1rem;
        line-height: 1.6;
    }

    .btn-security {
        display: inline-block;
        padding: 0.6rem 1.2rem;
        background: #f0f8f5;
        color: #16563f;
        border: 2px solid #16563f;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .btn-security:hover {
        background: #16563f;
        color: white;
    }

    @media (max-width: 1024px) {
        .profile-edit-content {
            grid-template-columns: 1fr;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-save,
        .btn-cancel {
            flex: unset;
        }
    }

    @media (max-width: 768px) {
        .profile-edit-container {
            padding: 1rem;
        }

        .edit-form-wrapper {
            padding: 1.5rem;
        }

        .profile-edit-header h1 {
            font-size: 1.8rem;
        }

        .form-section {
            padding-bottom: 1.5rem;
        }

        .form-row {
            gap: 1rem;
        }
    }
</style>
{% endblock %}
