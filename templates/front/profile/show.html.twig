<script>
    // Air Mouse Modal initialization with auto-minimize feature
    document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('airMouseModal');
        const openBtn = document.getElementById('airMouseBtn');
        const closeBtn = document.getElementById('airMouseClose');
        const minimizeBtn = document.getElementById('airMouseMinimize');
        const miniPreview = document.getElementById('airMouseMiniPreview');
        const miniPreviewExpand = document.getElementById('miniPreviewExpand');
        const miniPreviewStop = document.getElementById('miniPreviewStop');
        
        // Video and canvas elements from modal
        const videoInputModal = document.getElementById('videoInputModal');
        const canvasOutputModal = document.getElementById('canvasOutputModal');
        
        // Mini preview video wrap
        const miniVideoWrap = document.querySelector('.mini-preview-video-wrap');
        
        let isAirMouseActive = false;
        
        // Save state to sessionStorage
        function saveAirMouseState(active) {
            try {
                sessionStorage.setItem('airMouseActive', active ? 'true' : 'false');
            } catch(e) {}
        }
        
        // Check if we should auto-start Air Mouse from previous page
        function checkAutoStart() {
            try {
                const wasActive = sessionStorage.getItem('airMouseActive');
                if (wasActive === 'true' && modal && !window.airMouseStarted) {
                    // Auto-start Air Mouse
                    window.airMouseStarted = true;
                    setTimeout(() => {
                        if (window.airMouse && !window.airMouse.isActive) {
                            modal.classList.add('active');
                            setTimeout(() => {
                                window.airMouse.toggle();
                            }, 500);
                        }
                    }, 1000);
                }
            } catch(e) {}
        }
        
        // Wait for airmouse.js to be ready
        const initModal = setInterval(() => {
            if (typeof window.airMouse !== 'undefined') {
                clearInterval(initModal);
                
                // Check for auto-start from previous page
                checkAutoStart();
                
                // Override the toggle to detect when ON is clicked
                const originalToggle = window.airMouse.toggle.bind(window.airMouse);
                window.airMouse.toggle = async function() {
                    await originalToggle();
                    isAirMouseActive = this.isActive;
                    saveAirMouseState(isAirMouseActive);
                    
                    if (isAirMouseActive) {
                        // Air mouse just turned ON - auto minimize after short delay
                        setTimeout(() => {
                            minimizeModalToPreview();
                        }, 800);
                    }
                };
                
                if (openBtn) {
                    openBtn.addEventListener('click', function() {
                        modal.classList.add('active');
                    });
                }
                
                // Close button behavior - minimize instead of stop when active
                if (closeBtn) {
                    closeBtn.addEventListener('click', function() {
                        if (isAirMouseActive) {
                            // Just minimize to preview, don't stop camera
                            minimizeModalToPreview();
                        } else {
                            // Not active, close completely
                            window.airMouse.stop(true);
                            modal.classList.remove('active');
                        }
                    });
                }
                
                // Minimize button - always minimize to preview
                if (minimizeBtn) {
                    minimizeBtn.addEventListener('click', function() {
                        if (isAirMouseActive) {
                            minimizeModalToPreview();
                        } else {
                            modal.classList.remove('active');
                        }
                    });
                }
                
                // Close modal when clicking outside
                modal.addEventListener('click', function(e) {
                    if (e.target === modal && isAirMouseActive) {
                        minimizeModalToPreview();
                    } else if (e.target === modal) {
                        window.airMouse.stop(true);
                        modal.classList.remove('active');
                    }
                });
            }
        }, 100);
        
        // Function to minimize modal to floating preview
        function minimizeModalToPreview() {
            if (!isAirMouseActive) return;
            
            // Hide modal
            modal.classList.remove('active');
            
            // Move video/canvas to mini preview
            if (miniVideoWrap && videoInputModal && canvasOutputModal) {
                miniVideoWrap.appendChild(videoInputModal);
                miniVideoWrap.appendChild(canvasOutputModal);
            }
            
            // Show mini preview
            miniPreview.style.display = 'block';
        }
        
        // Expand mini preview back to modal
        if (miniPreviewExpand) {
            miniPreviewExpand.addEventListener('click', function() {
                // Move video/canvas back to modal
                const wrapper = document.querySelector('.video-canvas-wrapper-modal');
                if (wrapper && videoInputModal && canvasOutputModal) {
                    wrapper.appendChild(videoInputModal);
                    wrapper.appendChild(canvasOutputModal);
                }
                
                // Hide mini preview
                miniPreview.style.display = 'none';
                
                // Show modal
                modal.classList.add('active');
            });
        }
        
        // Stop button in mini preview - stops everything
        if (miniPreviewStop) {
            miniPreviewStop.addEventListener('click', function() {
                if (window.airMouse) {
                    window.airMouse.stop(true);
                }
                isAirMouseActive = false;
                saveAirMouseState(false);
                
                // Hide mini preview
                miniPreview.style.display = 'none';
                
                // Update toggle button state
                const toggleBtn = document.getElementById('toggleButtonModal');
                const switchLabel = document.getElementById('switchLabelModal');
                if (toggleBtn) toggleBtn.classList.remove('active');
                if (switchLabel) switchLabel.textContent = 'OFF';
            });
        }
    });
    
    // ID Card delete function
    async function deleteIdCard() {
        if (!confirm('Are you sure you want to remove your ID card? This will also remove your student ID.')) {
            return;
        }
        
        try {
            const response = await fetch('{{ path("profile_id_card_delete") }}', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            const data = await response.json();
            
            if (data.status === 'success') {
                // Reload page to show updated state
                window.location.reload();
            } else {
                alert(data.message || 'Failed to remove ID card.');
            }
        } catch (error) {
            console.error('Delete error:', error);
            alert('Failed to remove ID card. Please try again.');
        }
    }
    
    // Edit Student ID functions
    function editStudentId() {
        document.getElementById('studentIdDisplay').style.display = 'none';
        document.getElementById('editStudentIdForm').style.display = 'block';
        document.getElementById('editStudentIdInput').focus();
    }
    
    function cancelStudentIdEdit() {
        document.getElementById('studentIdDisplay').style.display = 'block';
        document.getElementById('editStudentIdForm').style.display = 'none';
    }
    
    async function saveStudentIdEdit() {
        const newStudentId = document.getElementById('editStudentIdInput').value.trim().toUpperCase();
        
        if (!newStudentId) {
            alert('Please enter a valid Student ID.');
            return;
        }
        
        // Validate format: 3 digits + 3 letters + 4 digits
        const validFormat = /^\d{3}[A-Z]{3}\d{4}$/;
        if (!validFormat.test(newStudentId)) {
            alert('Invalid format. Student ID should be: 3 digits + 3 letters + 4 digits (e.g., 231JMT0405)');
            return;
        }
        
        try {
            const response = await fetch('{{ path("profile_student_id_save") }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ student_id: newStudentId })
            });
            
            const data = await response.json();
            
            if (data.status === 'success') {
                // Update the display
                document.getElementById('currentStudentId').textContent = newStudentId;
                document.getElementById('studentIdDisplay').style.display = 'block';
                document.getElementById('editStudentIdForm').style.display = 'none';
                
                // Show success message
                alert('Student ID updated successfully!');
            } else {
                alert(data.message || 'Failed to update Student ID.');
            }
        } catch (error) {
            console.error('Save error:', error);
            alert('Failed to update Student ID. Please try again.');
        }
    }
    
    // Profile Page ID Camera Scan Functions
    let profileIdScanModal = null;
    let profileIdScanVideo = null;
    let profileIdScanCanvas = null;
    let profileIdScanStream = null;
    let profileIdTesseractWorker = null;
    
    async function openProfileIdScanModal() {
        // Create modal if not exists
        if (!document.getElementById('profileIdScanModal')) {
            createProfileIdScanModal();
        }
        
        profileIdScanModal = document.getElementById('profileIdScanModal');
        profileIdScanModal.classList.add('active');
        document.body.style.overflow = 'hidden';
        
        // Initialize Tesseract
        if (!profileIdTesseractWorker && typeof Tesseract !== 'undefined') {
            try {
                profileIdTesseractWorker = await Tesseract.createWorker('eng');
            } catch (e) {
                console.error('Tesseract init failed:', e);
            }
        }
        
        // Start camera
        await startProfileIdCamera();
    }
    
    function createProfileIdScanModal() {
        const modalHTML = `
            <div id="profileIdScanModal" class="id-scan-modal">
                <div class="id-scan-container" style="max-width: 500px;">
                    <button type="button" class="close-scan-btn" onclick="closeProfileIdScanModal()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                    
                    <div class="id-scan-header">
                        <h3>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="16" rx="3"></rect>
                                <circle cx="9" cy="10" r="2"></circle>
                                <path d="M15 8h2"></path>
                                <path d="M15 12h2"></path>
                                <path d="M7 16h10"></path>
                            </svg>
                            Scan Your ID Card
                        </h3>
                        <p>Position your student ID card within the frame</p>
                    </div>
                    
                    <div class="video-container" style="aspect-ratio: 4/3;">
                        <video id="profileIdScanVideo" autoplay playsinline muted style="width: 100%; height: 100%; object-fit: cover;"></video>
                        <canvas id="profileIdScanCanvas" style="display: none;"></canvas>
                        
                        <div class="scan-overlay" id="profileScanOverlay">
                            <div class="corner-marker top-left"></div>
                            <div class="corner-marker top-right"></div>
                            <div class="corner-marker bottom-left"></div>
                            <div class="corner-marker bottom-right"></div>
                            <div class="scan-line"></div>
                        </div>
                    </div>
                    
                    <div class="scan-status ready" id="profileScanStatus">
                        Ready to scan
                    </div>
                    
                    <button type="button" class="scan-btn" onclick="performProfileIdScan()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                        </svg>
                        Scan Now
                    </button>
                    
                    <div class="security-note">
                        <p>
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            </svg>
                            Your ID data is processed locally
                        </p>
                    </div>
                </div>
            </div>
        `;
        document.body.insertAdjacentHTML('beforeend', modalHTML);
    }
    
    async function startProfileIdCamera() {
        profileIdScanVideo = document.getElementById('profileIdScanVideo');
        profileIdScanCanvas = document.getElementById('profileIdScanCanvas');
        
        try {
            updateProfileScanStatus('Accessing camera...', 'loading');
            
            profileIdScanStream = await navigator.mediaDevices.getUserMedia({
                video: { facingMode: 'environment', width: { ideal: 1920 }, height: { ideal: 1080 } },
                audio: false
            });
            
            profileIdScanVideo.srcObject = profileIdScanStream;
            await profileIdScanVideo.play();
            
            profileIdScanCanvas.width = profileIdScanVideo.videoWidth || 640;
            profileIdScanCanvas.height = profileIdScanVideo.videoHeight || 480;
            
            updateProfileScanStatus('Position your ID card in the frame', 'ready');
        } catch (error) {
            console.error('Camera error:', error);
            updateProfileScanStatus('Camera access denied', 'error');
        }
    }
    
    function closeProfileIdScanModal() {
        if (profileIdScanStream) {
            profileIdScanStream.getTracks().forEach(track => track.stop());
            profileIdScanStream = null;
        }
        if (profileIdScanModal) {
            profileIdScanModal.classList.remove('active');
            document.body.style.overflow = '';
        }
    }
    
    async function performProfileIdScan() {
        if (!profileIdScanVideo || !profileIdTesseractWorker) return;
        
        updateProfileScanStatus('Scanning...', 'scanning');
        
        try {
            // Capture frame
            const ctx = profileIdScanCanvas.getContext('2d');
            ctx.drawImage(profileIdScanVideo, 0, 0, profileIdScanCanvas.width, profileIdScanCanvas.height);
            
            const imageData = profileIdScanCanvas.toDataURL('image/jpeg', 0.9);
            
            // Run OCR
            const result = await profileIdTesseractWorker.recognize(imageData);
            const text = result.data.text;
            
            console.log('OCR Result:', text);
            
            // Extract student ID
            const studentId = extractStudentIdFromText(text);
            
            if (studentId) {
                updateProfileScanStatus('ID found! Saving...', 'success');
                await saveProfileStudentId(studentId);
            } else {
                updateProfileScanStatus('No ID detected. Try again.', 'error');
            }
        } catch (error) {
            console.error('Scan error:', error);
            updateProfileScanStatus('Scan failed. Try again.', 'error');
        }
    }
    
    function extractStudentIdFromText(text) {
        const patterns = [
            /(?:^|\s)(\d{3}[A-Z]{3}\d{4})(?:\s|$)/,
            /identifiant\s*:?\s*([a-zA-Z0-9]+)/i,
            /student\s*id\s*:?\s*([a-zA-Z0-9_-]+)/i,
            /(?:^|\s)([A-Z]{2,4}\d{6,10})(?:\s|$)/,
            /(?:^|\s)(\d{8,12})(?:\s|$)/,
        ];
        
        for (const pattern of patterns) {
            const match = text.match(pattern);
            if (match && match[1]) {
                return match[1].trim().toUpperCase();
            }
        }
        
        const fallbackMatch = text.match(/\d{3}[A-Z]{3}\d{4}/);
        if (fallbackMatch) {
            return fallbackMatch[0].toUpperCase();
        }
        
        const lastResort = text.match(/[A-Z0-9]{10,11}/);
        if (lastResort) {
            return lastResort[0].toUpperCase();
        }
        
        return null;
    }
    
    async function saveProfileStudentId(studentId) {
        try {
            // First upload the image
            const blob = await new Promise(resolve => profileIdScanCanvas.toBlob(resolve, 'image/jpeg', 0.9));
            const formData = new FormData();
            formData.append('id_card', blob, 'id-card-scan.jpg');
            
            const uploadResponse = await fetch('{{ path("profile_id_card_upload") }}', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            
            const uploadData = await uploadResponse.json();
            
            if (uploadData.status !== 'success') {
                updateProfileScanStatus('Failed to save image', 'error');
                return;
            }
            
            // Then save the student ID
            const saveResponse = await fetch('{{ path("profile_student_id_save") }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ student_id: studentId })
            });
            
            const saveData = await saveResponse.json();
            
            if (saveData.status === 'success') {
                updateProfileScanStatus('Success! Redirecting...', 'success');
                setTimeout(() => window.location.reload(), 1500);
            } else {
                updateProfileScanStatus(saveData.message || 'Failed to save', 'error');
            }
        } catch (error) {
            console.error('Save error:', error);
            updateProfileScanStatus('Failed to save. Try again.', 'error');
        }
    }
    
    function updateProfileScanStatus(message, type) {
        const statusEl = document.getElementById('profileScanStatus');
        if (statusEl) {
            statusEl.textContent = message;
            statusEl.className = 'scan-status ' + type;
        }
    }
</script>

