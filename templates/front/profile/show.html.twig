    /* ========================= PERFECT 3D CINEMATIC HEART ========================= */
    .heart-overlay-center {
        position: fixed;
        top: 0; left: 0;
        width: 100vw; height: 100vh;
        z-index: 100000;
        pointer-events: none; /* Let background be interactive */
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.5s ease;
    }

    .heart-overlay-center.active {
        opacity: 1;
        visibility: visible;
    }

    .heart-scale-wrapper {
        width: 450px;
        height: 450px;
        transform: scale(0);
        transition: transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .heart-overlay-center.active .heart-scale-wrapper {
        transform: scale(1);
    }

    .heart-center-container {
        width: 100%;
        height: 100%;
    }

    .heart-svg-3d {
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 20px 30px rgba(0,0,0,0.2));
        overflow: visible;
    }

    /* SVG Structure Defaults */
    .heart-holes path { opacity: 0; }
    .heart-fragments path { transform-box: fill-box; transform-origin: center; }
    .heart-cracks path { 
        stroke: #2a0000; 
        stroke-width: 2.5; 
        fill: none; 
        stroke-linecap: round; 
        stroke-linejoin: round;
        opacity: 0;
        stroke-dasharray: 250;
        stroke-dashoffset: 250;
    }

    /* ==================== BON (Perfect) ==================== */
    .heart-state-bon .heart-center-container {
        animation: h3d-pulse-bon 1.2s infinite ease-in-out;
    }
    @keyframes h3d-pulse-bon {
        0% { transform: scale(1); filter: drop-shadow(0 0 10px rgba(0,0,0,0)); }
        15% { transform: scale(1.05); filter: drop-shadow(0 0 20px rgba(220,38,38,0.4)); }
        30% { transform: scale(1); filter: drop-shadow(0 0 10px rgba(0,0,0,0)); }
        45% { transform: scale(1.08); filter: drop-shadow(0 0 30px rgba(220,38,38,0.6)); }
        100% { transform: scale(1); filter: drop-shadow(0 0 10px rgba(0,0,0,0)); }
    }

    /* ==================== MOYEN (Slightly Damaged) ==================== */
    .heart-state-moyen .heart-center-container {
        animation: h3d-pulse-moyen 1.5s infinite;
    }
    .heart-state-moyen .heart-cracks path {
        opacity: 0.5; /* Show slight fractures statically */
        stroke-dashoffset: 150; 
    }
    @keyframes h3d-pulse-moyen {
        0% { transform: scale(1) translate(0, 0); }
        50% { transform: scale(1.02) translate(-1px, 1px); }
        100% { transform: scale(1) translate(0, 0); }
    }

    /* ==================== MAUVAIS (Progressive Destruction) ==================== */
    .heart-state-bad .heart-center-container {
        animation: h3d-pulse-bad 0.3s infinite;
    }
    @keyframes h3d-pulse-bad {
        0% { transform: translate(0, 0); }
        25% { transform: translate(-2px, 2px); }
        50% { transform: translate(2px, -1px); }
        75% { transform: translate(-1px, -2px); }
        100% { transform: translate(0, 0); }
    }

    /* Progressive Damage Timeline */
    .heart-state-bad .heart-cracks path {
        opacity: 1;
        animation: h3d-draw-cracks 2s forwards ease-in-out 0.5s;
    }
    @keyframes h3d-draw-cracks {
