<script>
// Restore saved values from localStorage
document.addEventListener('DOMContentLoaded', function() {
    const savedAge = localStorage.getItem('curavita_age');
    const savedTaille = localStorage.getItem('curavita_taille');
    if (savedAge) document.getElementById('input-age').value = savedAge;
    if (savedTaille) document.getElementById('input-taille').value = savedTaille;
});

function showCenterHeartTextless(verdict) {
    const overlay = document.getElementById('heart-overlay-center');
    const container = document.getElementById('heart-center-container');

    // Reset classes
    container.className = 'heart-center-container';
    
    // Force a browser reflow so CSS animations restart properly
    void container.offsetWidth;

    // Apply strict cinematic state based on verdict
    if (verdict === 'bon') {
        container.classList.add('heart-state-bon');
    } else if (verdict === 'moyen') {
        container.classList.add('heart-state-moyen');
    } else {
        container.classList.add('heart-state-bad');
    }

    // Show the overlay (scales in)
    overlay.classList.add('active');

    // Auto-hide after exactly 5 seconds
    setTimeout(() => {
        overlay.classList.remove('active');
    }, 5000);
}

async function generateHealthSummary() {
    const btn = document.getElementById('btn-generate-ai');
    const btnText = document.getElementById('btn-text');
    const btnIcon = document.getElementById('btn-icon');
    const loading = document.getElementById('ai-loading');
    const error = document.getElementById('ai-error');
    const insights = document.getElementById('ai-insights');
    const placeholder = document.getElementById('ai-placeholder');
    const errorMsg = document.getElementById('ai-error-msg');

    // Read and persist age/height
    const age = document.getElementById('input-age').value;
    const taille = document.getElementById('input-taille').value;
    if (age) localStorage.setItem('curavita_age', age);
    if (taille) localStorage.setItem('curavita_taille', taille);

    // Set loading state
    btn.disabled = true;
    btnIcon.textContent = '⏳';
    btnText.textContent = 'Analyse en cours...';
    placeholder.style.display = 'none';
    insights.style.display = 'none';
    error.style.display = 'none';
    loading.style.display = 'flex';

    try {
        const response = await fetch('{{ path('app_profile_ai_summary') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ age: age || null, taille: taille || null })
        });

        const rawText = await response.text();
        let data;
        try {
            data = JSON.parse(rawText.trim());
        } catch (e) {
            // Try to find the LAST valid JSON-looking block (our response)
            const firstBrace = rawText.indexOf('{');
            const lastBrace = rawText.lastIndexOf('}');
            
            if (firstBrace !== -1 && lastBrace !== -1 && lastBrace > firstBrace) {
                const potentialJson = rawText.substring(firstBrace, lastBrace + 1);
                try {
                    data = JSON.parse(potentialJson);
                } catch (e2) {
                    // One last attempt: find the largest block that is valid JSON
                    console.error("JSON split attempt failed, raw text:", rawText);
                    throw new Error("Erreur de format JSON: " + e.message);
                }
            } else {
                throw new Error("Réponse serveur invalide (pas de JSON trouvé).");
            }
        }

        if (data.success && data.insights) {
            loading.style.display = 'none';
            insights.style.display = 'grid';
            insights.innerHTML = '';

            data.insights.forEach(insight => {
                const priorityClass = 'priority-' + (insight.priorite || 'basse').toLowerCase().replace('é', 'e');
                const card = document.createElement('div');
                card.className = 'ai-insight-card ' + priorityClass;
                card.innerHTML = `
                    <h4 class="ai-insight-title">${insight.titre || ''}</h4>
                    <p class="ai-insight-text">${insight.conseil || ''}</p>
                    <span class="ai-insight-priority">${insight.priorite || 'info'}</span>
                `;
                insights.appendChild(card);
            });

            // Trigger the cinematic 3D center heart
            showCenterHeartTextless(data.verdict || 'moyen');

            btnIcon.textContent = '✅';
            btnText.textContent = 'Régénérer l\'analyse';
        } else {
            throw new Error(data.error || 'Réponse inattendue');
        }
    } catch (err) {
        loading.style.display = 'none';
        error.style.display = 'flex';
        errorMsg.textContent = err.message;
    } finally {
        btn.disabled = false;
    }
}
</script>

