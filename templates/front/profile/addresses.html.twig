{% extends 'front/_base_modern.html.twig' %}

{% block title %}Mes Adresses - CuraVita{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-bold text-gray-800">Mes Adresses</h1>
        <a href="{{ path('app_address_new') }}" class="bg-green-500 hover:bg-green-600 text-white font-semibold py-2 px-4 rounded-lg transition-colors">
            + Ajouter une adresse
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            {{ message }}
        </div>
    {% endfor %}

    {% if addresses is empty %}
        <div class="bg-white rounded-lg shadow p-8 text-center">
            <p class="text-gray-600 mb-4">Vous n'avez pas encore d'adresses enregistrées.</p>
            <a href="{{ path('app_address_new') }}" class="text-green-600 hover:text-green-700 font-semibold">
                Ajouter votre première adresse
            </a>
        </div>
    {% else %}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {% for address in addresses %}
                <div class="bg-white rounded-lg shadow p-6">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800">{{ address.fullName }}</h3>
                            <p class="text-gray-600">{{ address.phone }}</p>
                        </div>
                    </div>
                    
                    <div class="text-gray-700 mb-4">
                        <p>{{ address.line1 }}</p>
                        {% if address.line2 %}<p>{{ address.line2 }}</p>{% endif %}
                        <p>{{ address.city }}, {{ address.region }} {{ address.postalCode }}</p>
                        <p>{{ address.country }}</p>
                    </div>
                    
                    <div class="flex gap-3">
                        <a href="{{ path('app_address_edit', {id: address.id}) }}" class="text-blue-600 hover:text-blue-700 font-medium">
                            Modifier
                        </a>
                        <form method="post" action="{{ path('app_address_delete', {id: address.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette adresse ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ address.id) }}">
                            <button type="submit" class="text-red-600 hover:text-red-700 font-medium">
                                Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
    
    <div class="mt-8">
        <a href="{{ path('app_profile') }}" class="text-gray-600 hover:text-gray-800 font-medium">
            ← Retour au profil
        </a>
    </div>
</div>
{% endblock %}
