{% extends 'front/_base.html.twig' %}

{% block title %}Nos Dépôts - CuraVita{% endblock %}

{% block main %}
<div class="container depot-page" style="padding: 4rem 1rem;">
    <h1 class="text-center mb-12 text-primary fade-in-up delay-1">Nos Dépôts</h1>

    <!-- Section Filtres -->
    <div class="filters-section mb-8 fade-in-up delay-2">
        <div class="filters-container">
            <form method="GET" action="{{ path('front_depots') }}" class="filters-form">
                <div class="filters-grid">
                    <!-- Recherche -->
                    <div class="filter-group">
                        <input type="text" 
                               name="search" 
                               placeholder="Rechercher un dépôt..." 
                               value="{{ filters.search }}"
                               class="filter-input">
                    </div>
                    
                    <!-- Ville -->
                    <div class="filter-group">
                        <select name="ville" class="filter-select">
                            <option value="all" {{ filters.ville == 'all' or not filters.ville ? 'selected' : '' }}>
                                Toutes les villes
                            </option>
                            {% for ville in villes %}
                                <option value="{{ ville }}" 
                                        {{ filters.ville == ville ? 'selected' : '' }}>
                                    {{ ville }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <!-- Capacité Minimum -->
                    <div class="filter-group">
                        <input type="number" 
                               name="capacite_min" 
                               placeholder="Capacité min" 
                               value="{{ filters.capacite_min }}"
                               min="0"
                               class="filter-input">
                    </div>
                    
                    <!-- Capacité Maximum -->
                    <div class="filter-group">
                        <input type="number" 
                               name="capacite_max" 
                               placeholder="Capacité max" 
                               value="{{ filters.capacite_max }}"
                               min="0"
                               class="filter-input">
                    </div>
                    
                    <!-- Tri -->
                    <div class="filter-group">
                        <select name="sort" class="filter-select">
                            <option value="name" {{ filters.sort == 'name' ? 'selected' : '' }}>
                                Nom (A-Z)
                            </option>
                            <option value="capacity_desc" {{ filters.sort == 'capacity_desc' ? 'selected' : '' }}>
                                Capacité décroissante
                            </option>
                            <option value="capacity_asc" {{ filters.sort == 'capacity_asc' ? 'selected' : '' }}>
                                Capacité croissante
                            </option>
                            <option value="date_desc" {{ filters.sort == 'date_desc' ? 'selected' : '' }}>
                                Date récente
                            </option>
                            <option value="date_asc" {{ filters.sort == 'date_asc' ? 'selected' : '' }}>
                                Date ancienne
                            </option>
                        </select>
                    </div>
                    
                    <!-- Boutons -->
                    <div class="filter-actions">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-filter"></i> Filtrer
                        </button>
                        <a href="{{ path('front_depots') }}" class="btn btn-secondary btn-sm">
                            <i class="fas fa-times"></i> Réinitialiser
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {% if depots|length > 0 %}
        <div class="cards-grid">
            {% for depot in depots %}
                <div class="info-card fade-in-up delay-{{ (loop.index0 % 6) + 1 }}">
                    <div class="card-header">
                        <div class="card-icon">
                            <i class="fas fa-warehouse"></i>
                        </div>
                        <div>
                            <div class="card-title">{{ depot.nomDepot }}</div>
                            <div class="card-subtitle">Dépôt #{{ depot.id }}</div>
                        </div>
                    </div>
                    
                    <div class="card-content">
                        <ul class="info-list">
                            <li>
                                <i class="fas fa-map-marker-alt"></i>
                                <span>{{ depot.adresseDepot }}</span>
                            </li>
                            <li>
                                <i class="fas fa-boxes"></i>
                                <span>Capacité: {{ depot.capaciteDepot }} unités</span>
                            </li>
                            <li>
                                <i class="fas fa-user-tie"></i>
                                <span>Responsable: {{ depot.responsableDepot }}</span>
                            </li>
                            {% if depot.responsableTelephone %}
                            <li>
                                <i class="fas fa-phone"></i>
                                <span>Telephone: {{ depot.responsableTelephone }}</span>
                            </li>
                            {% endif %}
                            <li>
                                <i class="fas fa-calendar"></i>
                                <span>Créé le: {{ depot.dateCreation ? depot.dateCreation|date('d/m/Y') : 'N/A' }}</span>
                            </li>
                        </ul>

                        <div class="health-section">
                            <div class="health-card" data-health-url="{{ path('api_depot_health', { id: depot.id }) }}">
                                <div class="health-gauge" style="--score: 0; --gauge-color: #6b7280;">
                                    <div class="health-center">
                                        <div class="health-score-value">--%</div>
                                        <div class="health-score-label">Score</div>
                                    </div>
                                </div>
                                <div class="health-meta">
                                    <div class="health-status">Chargement...</div>
                                    <button type="button" class="health-toggle" aria-expanded="false">Details</button>
                                </div>
                                <div class="health-details" aria-hidden="true">
                                    <div class="health-detail" data-crit="rupture">
                                        <span class="health-label">Rupture</span>
                                        <span class="health-value">--</span>
                                    </div>
                                    <div class="health-detail" data-crit="expiration">
                                        <span class="health-label">Expiration</span>
                                        <span class="health-value">--</span>
                                    </div>
                                    <div class="health-detail" data-crit="rotation">
                                        <span class="health-label">Rotation</span>
                                        <span class="health-value">--</span>
                                    </div>
                                    <div class="health-detail" data-crit="seuils">
                                        <span class="health-label">Seuils</span>
                                        <span class="health-value">--</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div style="margin-top: 1.5rem; display: flex; gap: 1rem; align-items: center;">
                            <span class="badge badge-success">
                                <i class="fas fa-check-circle"></i> Opérationnel
                            </span>
                            <span style="color: var(--text-muted); font-size: 0.875rem;">
                                <i class="fas fa-info-circle"></i> Disponible 24/7
                            </span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state fade-in-up">
            <i class="fas fa-warehouse" style="font-size: 4rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
            <h3 style="color: var(--text-muted); margin-bottom: 1rem;">Aucun dépôt trouvé</h3>
            <p style="color: var(--text-muted);">Aucun dépôt ne correspond à vos critères de recherche.</p>
        </div>
    {% endif %}
</div>

<style>
/* Hero style (Guide Sante feel) */
.depot-page {
    position: relative;
    overflow: hidden;
    padding-top: 5rem;
}
.depot-page::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 320px;
    background-image:
        radial-gradient(circle at 30% 20%, rgba(0, 180, 216, 0.35) 0%, transparent 40%),
        radial-gradient(circle at 70% 80%, rgba(40, 167, 69, 0.35) 0%, transparent 40%),
        linear-gradient(135deg, #0a1628 0%, #16563f 50%, #00b4d8 100%);
    background-repeat: no-repeat;
    background-size: auto, auto, cover;
    animation: pulse-bg 8s ease-in-out infinite;
}
@keyframes pulse-bg {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.85; transform: scale(1.03); }
}
.depot-page > * { position: relative; z-index: 1; }
.depot-page > h1 {
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 800;
    color: #ffffff;
    text-shadow: 2px 2px 20px rgba(0,0,0,0.3);
    margin-bottom: 2rem;
    background: linear-gradient(90deg, #ffffff, #ffd166, #ff6b9d, #ffffff);
    background-size: 300% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: rainbow 6s linear infinite;
}
.depot-page > h1::before {
    content: '\f494';
    font-family: "Font Awesome 5 Free";
    font-weight: 900;
    width: 120px;
    height: 120px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    display: grid;
    place-items: center;
    margin: 0 auto 1.75rem;
    font-size: 3.25rem;
    color: #ff6b9d;
    border: 3px solid rgba(255,255,255,0.3);
    backdrop-filter: blur(10px);
    animation: pulse-heart 1.5s ease-in-out infinite;
}
@keyframes pulse-heart {
    0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255,255,255,0.4); }
    50% { transform: scale(1.08); box-shadow: 0 0 0 18px rgba(255,255,255,0); }
}
@keyframes rainbow {
    0% { background-position: 0% center; }
    100% { background-position: 300% center; }
}

/* Styles pour les filtres */
.filters-section {
    background: rgba(255,255,255,0.95);
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    margin-bottom: 2rem;
    backdrop-filter: blur(8px);
}

.filters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    align-items: end;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.filter-input, .filter-select {
    padding: 0.75rem;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    background: white;
}

.filter-input:focus, .filter-select:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

.filter-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.btn-sm {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-primary {
    background: var(--primary-color);
    color: white;
}

.btn-primary:hover {
    background: #2563eb;
    transform: translateY(-1px);
}

.btn-secondary {
    background: #6b7280;
    color: white;
}

.btn-secondary:hover {
    background: #4b5563;
    transform: translateY(-1px);
}

.empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

/* Styles existants conservés */
.cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 2rem; }
.info-card { background: white; border-radius: 16px; padding: 1.5rem; box-shadow: 0 0.25rem 0.5rem rgba(0,0,0,0.1); border: 1px solid #e9ecef; transition: all 0.3s ease; }
.info-card:hover { transform: translateY(-3px); box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15); }
.card-header { display: flex; align-items: center; margin-bottom: 1rem; }
.card-icon { width: 50px; height: 50px; background: linear-gradient(135deg, #16563f, #28a745); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 1rem; }
.card-icon i { font-size: 1.25rem; color: white; }
.card-title { font-size: 1.1rem; font-weight: 600; color: #16563f; }
.card-subtitle { color: #6c757d; font-size: 0.8rem; }
.info-list { list-style: none; padding: 0; margin: 0; }
.info-list li { padding: 0.5rem 0; border-bottom: 1px solid #e9ecef; display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; }
.info-list li:last-child { border-bottom: none; }
.info-list i { color: #16563f; width: 18px; text-align: center; }
.badge { display: inline-block; padding: 0.35rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
.badge-success { background: #28a745; color: white; }
.badge-warning { background: #ffc107; color: #212529; }
.health-section { margin-top: 1.5rem; }
.health-card {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
    border-radius: 14px;
    border: 1px solid #e5e7eb;
    background: linear-gradient(135deg, #f8fafc, #ffffff);
    position: relative;
    overflow: hidden;
}
.health-gauge {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: conic-gradient(var(--gauge-color) calc(var(--score) * 1%), #e5e7eb 0);
    display: grid;
    place-items: center;
    position: relative;
}
.health-center {
    position: absolute;
    inset: 12px;
    border-radius: 50%;
    background: white;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 0 1px #e5e7eb;
}
.health-score-value { font-size: 1.3rem; font-weight: 700; color: #0f172a; }
.health-score-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: #94a3b8; }
.health-meta { display: flex; flex-direction: column; gap: 0.5rem; }
.health-status { font-size: 1rem; font-weight: 600; color: #0f172a; }
.health-toggle {
    align-self: flex-start;
    border: none;
    background: #0f172a;
    color: white;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.health-toggle:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(15, 23, 42, 0.15); }
.health-details {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px dashed #e5e7eb;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: all 0.25s ease;
}
.health-detail {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: #475569;
}
.health-label { font-weight: 600; color: #0f172a; }
.health-value { font-weight: 500; color: #1f2937; }
.health-card:hover .health-details,
.health-card.is-open .health-details {
    opacity: 1;
    max-height: 200px;
}

/* Animations (Guide Sante style) */
.fade-in-up { opacity: 1; transform: translateY(0); }
body.reveal-ready .fade-in-up { opacity: 0; transform: translateY(30px); }
body.reveal-ready .fade-in-up.is-visible { animation: fadeInUp 0.8s ease forwards; }
@keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }
.delay-1 { animation-delay: 0.1s; }
.delay-2 { animation-delay: 0.2s; }
.delay-3 { animation-delay: 0.3s; }
.delay-4 { animation-delay: 0.4s; }
.delay-5 { animation-delay: 0.5s; }
.delay-6 { animation-delay: 0.6s; }

.info-card,
.health-card,
.filters-section {
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}
.info-card:hover,
.health-card:hover,
.filters-section:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
}

@media (prefers-reduced-motion: reduce) {
    body.reveal-ready .fade-in-up,
    body.reveal-ready .fade-in-up.is-visible {
        animation: none;
        opacity: 1;
        transform: none;
    }
    .depot-page::before {
        animation: none;
    }
    .depot-page > h1 {
        animation: none;
        background-position: 0% center;
    }
    .depot-page > h1::before {
        animation: none;
    }
    .info-card,
    .health-card,
    .filters-section {
        transition: none;
    }
}

/* Responsive */
@media (max-width: 768px) {
    .filters-grid {
        grid-template-columns: 1fr;
    }
    
    .filter-actions {
        justify-content: center;
    }
    
    .cards-grid {
        grid-template-columns: 1fr;
    }

    .health-card {
        grid-template-columns: 1fr;
        text-align: center;
    }
    .health-gauge {
        margin: 0 auto;
    }
    .health-meta {
        align-items: center;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const revealItems = document.querySelectorAll('.fade-in-up');
    if (revealItems.length) {
        document.body.classList.add('reveal-ready');
        if (!('IntersectionObserver' in window)) {
            revealItems.forEach((el) => el.classList.add('is-visible'));
        } else {
            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        obs.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
            revealItems.forEach((el) => observer.observe(el));
        }
    }

    const statusLabels = {
        sain: 'Depot sain',
        surveiller: 'Depot a surveiller',
        risque: 'Depot a risque',
        indisponible: 'Indisponible'
    };

    document.querySelectorAll('.health-card').forEach((card) => {
        const toggle = card.querySelector('.health-toggle');
        const details = card.querySelector('.health-details');
        if (toggle && details) {
            toggle.addEventListener('click', () => {
                const isOpen = card.classList.toggle('is-open');
                toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                details.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
            });
        }

        const url = card.getAttribute('data-health-url');
        const gauge = card.querySelector('.health-gauge');
        const scoreValue = card.querySelector('.health-score-value');
        const statusEl = card.querySelector('.health-status');

        if (!url || !gauge || !scoreValue || !statusEl) {
            return;
        }

        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then((response) => response.ok ? response.json() : Promise.reject(response))
            .then((data) => {
                if (!data || data.ok !== true) {
                    throw new Error('Invalid response');
                }

                const score = typeof data.score === 'number' ? data.score : 0;
                const color = data.color || '#6b7280';
                const statusKey = (data.status || 'indisponible').toString();
                const statusText = statusLabels[statusKey] || statusKey;

                gauge.style.setProperty('--score', Math.max(0, Math.min(100, score)));
                gauge.style.setProperty('--gauge-color', color);
                scoreValue.textContent = `${Math.round(score)}%`;
                statusEl.textContent = statusText;
                statusEl.style.color = color;

                const criteria = data.criteria || {};
                const weights = data.weights || {};

                const setDetail = (key, text, weight) => {
                    const detail = card.querySelector(`.health-detail[data-crit="${key}"]`);
                    if (!detail) {
                        return;
                    }
                    const label = detail.querySelector('.health-label');
                    const value = detail.querySelector('.health-value');
                    if (label) {
                        const baseLabel = label.textContent.split(' (')[0];
                        label.textContent = weight !== undefined
                            ? `${baseLabel} (${Math.round(weight * 100)}%)`
                            : baseLabel;
                    }
                    if (value) {
                        value.textContent = text;
                    }
                };

                if (criteria.rupture) {
                    setDetail('rupture', `${criteria.rupture.count} | ${criteria.rupture.rate}% | score ${criteria.rupture.score}`, weights.rupture);
                }
                if (criteria.expiration) {
                    setDetail('expiration', `${criteria.expiration.count} | ${criteria.expiration.rate}% | score ${criteria.expiration.score}`, weights.expiration);
                }
                if (criteria.rotation) {
                    setDetail('rotation', `${criteria.rotation.ratio}% | score ${criteria.rotation.score}`, weights.rotation);
                }
                if (criteria.seuils) {
                    setDetail('seuils', `${criteria.seuils.count} | ${criteria.seuils.rate}% | score ${criteria.seuils.score}`, weights.seuils);
                }
            })
            .catch(() => {
                gauge.style.setProperty('--score', 0);
                gauge.style.setProperty('--gauge-color', '#6b7280');
                scoreValue.textContent = '--%';
                statusEl.textContent = statusLabels.indisponible;
                statusEl.style.color = '#6b7280';
            });
    });
});
</script>
{% endblock %}
