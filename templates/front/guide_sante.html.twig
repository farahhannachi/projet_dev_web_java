<script>
function calculateBMI() {
    const height = parseFloat(document.getElementById('height').value) / 100;
    const weight = parseFloat(document.getElementById('weight').value);
    
    if (!height || !weight || height <= 0 || weight <= 0) {
        alert('Veuillez entrer des valeurs valides');
        return;
    }
    
    const bmi = weight / (height * height);
    const bmiRounded = bmi.toFixed(1);
    
    document.getElementById('bmi-value').textContent = bmiRounded;
    
    // Animate gauge
    const gauge = document.getElementById('bmi-gauge');
    const maxBMI = 40;
    const percentage = Math.min(bmi / maxBMI, 1);
    const dashOffset = 440 - (440 * percentage);
    gauge.style.strokeDashoffset = dashOffset;
    
    // Update status
    const statusEl = document.getElementById('bmi-status');
    statusEl.style.display = 'inline-block';
    statusEl.className = 'bmi-status';
    
    if (bmi < 18.5) {
        statusEl.textContent = 'Insuffisance pondérale';
        statusEl.classList.add('bmi-underweight');
        gauge.style.stroke = '#17a2b8';
    } else if (bmi < 25) {
        statusEl.textContent = 'Poids normal 👍';
        statusEl.classList.add('bmi-normal');
        gauge.style.stroke = '#28a745';
    } else if (bmi < 30) {
        statusEl.textContent = 'Surpoids';
        statusEl.classList.add('bmi-overweight');
        gauge.style.stroke = '#ffc107';
    } else {
        statusEl.textContent = 'Obésité';
        statusEl.classList.add('bmi-obese');
        gauge.style.stroke = '#dc3545';
    }
}

function showGuide(guideId) {
    // Hide all guides
    document.querySelectorAll('.guide-detail').forEach(g => g.style.display = 'none');
    // Show selected guide
    document.getElementById('guide-' + guideId).style.display = 'block';
    // Show modal
    document.getElementById('guideModal').classList.add('active');
    document.body.style.overflow = 'hidden';
}

function closeGuide() {
    document.getElementById('guideModal').classList.remove('active');
    document.body.style.overflow = 'auto';
}

// Close modal on outside click
document.getElementById('guideModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeGuide();
    }
});

// Close on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeGuide();
    }
});
</script>
