            </p>
            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="hero-stat-number">150+</span>
                    <span class="hero-stat-label">Articles</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-number">12</span>
                    <span class="hero-stat-label">Catégories</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-number">50K+</span>
                    <span class="hero-stat-label">Lecteurs</span>
                </div>
            </div>
        </div>
    </section>

    <!-- CATEGORIES SECTION -->
    <section class="categories-section">
        <div class="container-guide">
            <div class="section-header-guide">
                <span class="section-tag-guide">📚 Explorez</span>
                <h2 class="section-title-guide">Nos Thématiques Santé</h2>
                <p class="section-subtitle-guide">
                    Des informations fiables rédigées par nos pharmaciens et experts en santé
                </p>
            </div>

            <div class="categories-grid">
                <div class="category-card category-immunity fade-in-up delay-1" onclick="showGuide('immunity')">
