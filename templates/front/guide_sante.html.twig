{% extends 'front/_base.html.twig' %}

{% block title %}Guide Santé - CURAVITA{% endblock %}

{% block stylesheets %}
<style>
    /* ========== VARIABLES ========== */
    .guide-page {
        --primary: #16563f;
        --primary-dark: #0f3d2a;
        --accent: #28a745;
        --health-blue: #00b4d8;
        --health-pink: #ff6b9d;
        --health-yellow: #ffd166;
        --health-purple: #9d4edd;
        --health-orange: #ff6d00;
        --danger: #dc3545;
        overflow-x: hidden;
    }

    /* ========== HERO SECTION ========== */
    .hero-guide {
        min-height: 80vh;
        background: linear-gradient(135deg, #0a1628 0%, #16563f 50%, #00b4d8 100%);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .hero-guide::before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: 
            radial-gradient(circle at 30% 20%, rgba(0, 180, 216, 0.3) 0%, transparent 40%),
            radial-gradient(circle at 70% 80%, rgba(40, 167, 69, 0.3) 0%, transparent 40%),
            radial-gradient(circle at 50% 50%, rgba(255, 107, 157, 0.1) 0%, transparent 50%);
        animation: pulse-bg 8s ease-in-out infinite;
    }

    @keyframes pulse-bg {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.8; transform: scale(1.05); }
    }

    /* DNA Helix Animation */
    .dna-container {
        position: absolute;
        left: 5%;
        top: 0;
        height: 100%;
        width: 100px;
        opacity: 0.15;
    }

    .dna-strand {
        position: absolute;
        width: 4px;
        height: 20px;
        background: white;
        border-radius: 2px;
        animation: dna-rotate 4s linear infinite;
    }

    @keyframes dna-rotate {
        0% { transform: rotateY(0deg) translateX(0); }
        50% { transform: rotateY(180deg) translateX(40px); }
        100% { transform: rotateY(360deg) translateX(0); }
    }

    /* Heartbeat Line */
    .heartbeat-line {
        position: absolute;
        bottom: 15%;
        left: 0;
        width: 100%;
        height: 100px;
        overflow: hidden;
    }

    .heartbeat-svg {
        width: 200%;
        height: 100%;
        animation: heartbeat-move 3s linear infinite;
    }

    @keyframes heartbeat-move {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    .hero-content-guide {
        position: relative;
        z-index: 10;
        text-align: center;
        padding: 2rem;
        max-width: 900px;
    }

    .hero-icon-pulse {
        width: 120px;
        height: 120px;
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(10px);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
        font-size: 4rem;
        animation: pulse-heart 1.5s ease-in-out infinite;
        border: 3px solid rgba(255,255,255,0.3);
    }

    @keyframes pulse-heart {
        0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255,255,255,0.4); }
        50% { transform: scale(1.1); box-shadow: 0 0 0 20px rgba(255,255,255,0); }
    }

    .hero-title-guide {
        font-size: clamp(2.5rem, 7vw, 4.5rem);
        font-weight: 800;
        color: white;
        margin-bottom: 1rem;
        text-shadow: 2px 2px 20px rgba(0,0,0,0.3);
    }

    .hero-title-guide span {
        background: linear-gradient(90deg, #00b4d8, #ff6b9d, #ffd166, #00b4d8);
        background-size: 300% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: rainbow 5s linear infinite;
    }

    @keyframes rainbow {
        0% { background-position: 0% center; }
        100% { background-position: 300% center; }
    }

    .hero-subtitle-guide {
        font-size: 1.25rem;
        color: rgba(255,255,255,0.9);
        max-width: 600px;
        margin: 0 auto 2rem;
        line-height: 1.8;
    }

    .hero-stats {
        display: flex;
        justify-content: center;
        gap: 3rem;
        flex-wrap: wrap;
        margin-top: 2rem;
    }

    .hero-stat {
        text-align: center;
    }

    .hero-stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        color: white;
        display: block;
    }

    .hero-stat-label {
        font-size: 0.9rem;
        color: rgba(255,255,255,0.7);
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    /* ========== CATEGORIES SECTION ========== */
    .categories-section {
        padding: 6rem 0;
        background: linear-gradient(180deg, #f8faf9 0%, white 100%);
        position: relative;
    }

    .categories-section::before {
        content: '';
        position: absolute;
        top: -80px;
        left: 0;
        right: 0;
        height: 80px;
        background: linear-gradient(to bottom right, transparent 49%, #f8faf9 50%);
    }

    .container-guide {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .section-header-guide {
        text-align: center;
        margin-bottom: 4rem;
    }

    .section-tag-guide {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        color: white;
        padding: 0.5rem 1.5rem;
        border-radius: 50px;
        font-size: 0.875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 1.5rem;
    }

    .section-title-guide {
        font-size: 2.75rem;
        font-weight: 800;
        color: var(--primary);
        margin-bottom: 1rem;
    }

    .section-subtitle-guide {
        font-size: 1.125rem;
        color: #666;
        max-width: 600px;
        margin: 0 auto;
    }

    .categories-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    @media (max-width: 992px) {
        .categories-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 576px) {
        .categories-grid { grid-template-columns: 1fr; }
    }

    .category-card {
        background: white;
        border-radius: 24px;
        padding: 2rem;
        position: relative;
        overflow: hidden;
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        box-shadow: 0 10px 40px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.05);
    }

    .category-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--card-gradient);
        opacity: 0;
        transition: opacity 0.5s ease;
    }

    .category-card:hover::before {
        opacity: 1;
    }

    .category-card:hover {
        transform: translateY(-10px) scale(1.02);
        box-shadow: 0 30px 60px rgba(0,0,0,0.15);
    }

    .category-card:hover .category-icon {
        transform: scale(1.15) rotate(10deg);
    }

    .category-card:hover .category-title,
    .category-card:hover .category-desc,
    .category-card:hover .category-link {
        color: white;
    }

    .category-card > * {
        position: relative;
        z-index: 1;
    }

    .category-icon {
        width: 80px;
        height: 80px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
        transition: all 0.5s ease;
    }

    .category-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 0.75rem;
        transition: color 0.5s ease;
    }

    .category-desc {
        color: #666;
        line-height: 1.7;
        margin-bottom: 1.5rem;
        transition: color 0.5s ease;
    }

    .category-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--primary);
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .category-link:hover {
        gap: 1rem;
    }

    /* Category Colors */
    .category-immunity .category-icon { background: linear-gradient(135deg, #00b4d8, #0096c7); }
    .category-immunity { --card-gradient: linear-gradient(135deg, #00b4d8, #0096c7); }

    .category-nutrition .category-icon { background: linear-gradient(135deg, #28a745, #20c997); }
    .category-nutrition { --card-gradient: linear-gradient(135deg, #28a745, #20c997); }

    .category-mental .category-icon { background: linear-gradient(135deg, #9d4edd, #7b2cbf); }
    .category-mental { --card-gradient: linear-gradient(135deg, #9d4edd, #7b2cbf); }

    .category-fitness .category-icon { background: linear-gradient(135deg, #ff6d00, #ff8f00); }
    .category-fitness { --card-gradient: linear-gradient(135deg, #ff6d00, #ff8f00); }

    .category-sleep .category-icon { background: linear-gradient(135deg, #1a237e, #3949ab); }
    .category-sleep { --card-gradient: linear-gradient(135deg, #1a237e, #3949ab); }

    .category-prevention .category-icon { background: linear-gradient(135deg, #ff6b9d, #ff8a65); }
    .category-prevention { --card-gradient: linear-gradient(135deg, #ff6b9d, #ff8a65); }

    /* ========== HEALTH TIPS SECTION ========== */
    .tips-section {
        padding: 6rem 0;
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        position: relative;
        overflow: hidden;
    }

    .tips-section::before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    .tips-header {
        text-align: center;
        margin-bottom: 4rem;
        position: relative;
        z-index: 1;
    }

    .tips-header .section-tag-guide {
        background: rgba(255,255,255,0.2);
        color: white;
    }

    .tips-header .section-title-guide {
        color: white;
    }

    .tips-header .section-subtitle-guide {
        color: rgba(255,255,255,0.8);
    }

    .tips-carousel {
        display: flex;
        gap: 2rem;
        overflow-x: auto;
        padding: 1rem 2rem 2rem;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }

    .tips-carousel::-webkit-scrollbar {
        display: none;
    }

    .tip-card {
        flex: 0 0 350px;
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(10px);
        border-radius: 24px;
        padding: 2rem;
        border: 1px solid rgba(255,255,255,0.2);
        scroll-snap-align: start;
        transition: all 0.4s ease;
    }

    .tip-card:hover {
        background: rgba(255,255,255,0.2);
        transform: translateY(-5px);
    }

    .tip-number {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #ffd166, #ff8c42);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 800;
        color: white;
        margin-bottom: 1.5rem;
    }

    .tip-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: white;
        margin-bottom: 1rem;
    }

    .tip-content {
        color: rgba(255,255,255,0.85);
        line-height: 1.7;
    }

    /* ========== BMI CALCULATOR ========== */
    .bmi-section {
        padding: 6rem 0;
        background: white;
    }

    .bmi-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .bmi-card {
        background: linear-gradient(135deg, #f8faf9 0%, #e8f5e9 100%);
        border-radius: 32px;
        padding: 3rem;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: center;
        box-shadow: 0 20px 60px rgba(22, 86, 63, 0.1);
    }

    @media (max-width: 768px) {
        .bmi-card { grid-template-columns: 1fr; }
    }

    .bmi-form h3 {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 0.5rem;
    }

    .bmi-form p {
        color: #666;
        margin-bottom: 2rem;
    }

    .bmi-input-group {
        margin-bottom: 1.5rem;
    }

    .bmi-input-group label {
        display: block;
        font-weight: 600;
        color: #333;
        margin-bottom: 0.5rem;
    }

    .bmi-input-group input {
        width: 100%;
        padding: 1rem;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .bmi-input-group input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(22, 86, 63, 0.1);
    }

    .bmi-btn {
        width: 100%;
        padding: 1rem;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .bmi-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(22, 86, 63, 0.3);
    }

    .bmi-result {
        text-align: center;
    }

    .bmi-gauge {
        width: 200px;
        height: 200px;
        margin: 0 auto 1.5rem;
        position: relative;
    }

    .bmi-gauge-circle {
        fill: none;
        stroke: #e0e0e0;
        stroke-width: 15;
    }

    .bmi-gauge-value {
        fill: none;
        stroke: var(--primary);
        stroke-width: 15;
        stroke-linecap: round;
        stroke-dasharray: 440;
        stroke-dashoffset: 440;
        transform: rotate(-90deg);
        transform-origin: center;
        transition: stroke-dashoffset 1s ease;
    }

    .bmi-value-display {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
    }

    .bmi-value-number {
        font-size: 3rem;
        font-weight: 800;
        color: var(--primary);
        line-height: 1;
    }

    .bmi-value-label {
        font-size: 0.9rem;
        color: #666;
    }

    .bmi-status {
        font-size: 1.25rem;
        font-weight: 700;
        padding: 0.75rem 2rem;
        border-radius: 50px;
        display: inline-block;
    }

    .bmi-normal { background: #d4edda; color: #155724; }
    .bmi-overweight { background: #fff3cd; color: #856404; }
    .bmi-obese { background: #f8d7da; color: #721c24; }
    .bmi-underweight { background: #cce5ff; color: #004085; }

    /* ========== EMERGENCY SECTION ========== */
    .emergency-section {
        padding: 4rem 0;
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        position: relative;
        overflow: hidden;
    }

    .emergency-section::before {
        content: '';
        position: absolute;
        width: 200px;
        height: 200px;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        top: -100px;
        right: -100px;
        animation: pulse-emergency 2s ease-in-out infinite;
    }

    @keyframes pulse-emergency {
        0%, 100% { transform: scale(1); opacity: 0.5; }
        50% { transform: scale(1.5); opacity: 0.2; }
    }

    .emergency-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 3rem;
        flex-wrap: wrap;
    }

    .emergency-content {
        flex: 1;
        min-width: 300px;
    }

    .emergency-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        animation: shake 0.5s ease-in-out infinite;
    }

    @keyframes shake {
        0%, 100% { transform: rotate(-5deg); }
        50% { transform: rotate(5deg); }
    }

    .emergency-title {
        font-size: 2rem;
        font-weight: 800;
        color: white;
        margin-bottom: 1rem;
    }

    .emergency-text {
        color: rgba(255,255,255,0.9);
        font-size: 1.1rem;
        line-height: 1.7;
    }

    .emergency-numbers {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .emergency-number {
        background: white;
        padding: 1.5rem 2.5rem;
        border-radius: 16px;
        text-align: center;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .emergency-number:hover {
        transform: scale(1.05);
        box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    }

    .emergency-number-value {
        font-size: 2.5rem;
        font-weight: 800;
        color: #dc3545;
        display: block;
    }

    .emergency-number-label {
        font-size: 0.9rem;
        color: #666;
        font-weight: 600;
    }

    /* ========== NEWSLETTER SECTION ========== */
    .newsletter-section {
        padding: 6rem 0;
        background: linear-gradient(180deg, white 0%, #f8faf9 100%);
    }

    .newsletter-card {
        max-width: 700px;
        margin: 0 auto;
        background: white;
        border-radius: 32px;
        padding: 3rem;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.1);
        position: relative;
        overflow: hidden;
    }

    .newsletter-card::before {
        content: '💌';
        position: absolute;
        font-size: 8rem;
        opacity: 0.05;
        top: -20px;
        right: -20px;
    }

    .newsletter-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 1rem;
    }

    .newsletter-text {
        color: #666;
        margin-bottom: 2rem;
    }

    .newsletter-form {
        display: flex;
        gap: 1rem;
        max-width: 500px;
        margin: 0 auto;
    }

    @media (max-width: 576px) {
        .newsletter-form { flex-direction: column; }
    }

    .newsletter-input {
        flex: 1;
        padding: 1rem 1.5rem;
        border: 2px solid #e0e0e0;
        border-radius: 50px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .newsletter-input:focus {
        outline: none;
        border-color: var(--primary);
    }

    .newsletter-btn {
        padding: 1rem 2rem;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        color: white;
        border: none;
        border-radius: 50px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .newsletter-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(22, 86, 63, 0.3);
    }

    /* ========== ANIMATIONS ========== */
    .fade-in-up {
        opacity: 0;
        transform: translateY(30px);
        animation: fadeInUp 0.8s ease forwards;
    }

    @keyframes fadeInUp {
        to { opacity: 1; transform: translateY(0); }
    }

    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.3s; }
    .delay-4 { animation-delay: 0.4s; }
    .delay-5 { animation-delay: 0.5s; }
    .delay-6 { animation-delay: 0.6s; }

    /* ========== GUIDE MODAL ========== */
    .guide-modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(10px);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        transition: all 0.4s ease;
    }

    .guide-modal.active {
        opacity: 1;
        visibility: visible;
    }

    .guide-modal-content {
        width: 90%;
        max-width: 900px;
        max-height: 90vh;
        background: white;
        border-radius: 24px;
        overflow: hidden;
        transform: scale(0.9) translateY(30px);
        transition: transform 0.4s ease;
        position: relative;
    }

    .guide-modal.active .guide-modal-content {
        transform: scale(1) translateY(0);
    }

    .guide-modal-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 40px;
        height: 40px;
        background: rgba(255,255,255,0.9);
        border: none;
        border-radius: 50%;
        font-size: 1.5rem;
        cursor: pointer;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }

    .guide-modal-close:hover {
        transform: rotate(90deg);
        background: #dc3545;
        color: white;
    }

    .guide-detail {
        max-height: 90vh;
        overflow-y: auto;
    }

    .guide-header {
        padding: 3rem 2rem;
        text-align: center;
        color: white;
    }

    .guide-header.immunity-bg { background: linear-gradient(135deg, #16563f, #28a745); }
    .guide-header.nutrition-bg { background: linear-gradient(135deg, #28a745, #85c46c); }
    .guide-header.mental-bg { background: linear-gradient(135deg, #9d4edd, #e040fb); }
    .guide-header.fitness-bg { background: linear-gradient(135deg, #ff6d00, #ff9e40); }
    .guide-header.sleep-bg { background: linear-gradient(135deg, #1e3a5f, #4a6fa5); }
    .guide-header.prevention-bg { background: linear-gradient(135deg, #00b4d8, #48cae4); }

    .guide-icon {
        font-size: 4rem;
        display: block;
        margin-bottom: 1rem;
    }

    .guide-header h2 {
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
    }

    .guide-body {
        padding: 2rem;
    }

    .guide-body h3 {
        color: var(--primary);
        font-size: 1.4rem;
        font-weight: 700;
        margin: 2rem 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 3px solid var(--accent);
        display: inline-block;
    }

    .guide-body h3:first-child {
        margin-top: 0;
    }

    .guide-body p {
        color: #555;
        line-height: 1.8;
        margin-bottom: 1rem;
    }

    .guide-info-box {
        background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
        padding: 1.5rem;
        border-radius: 16px;
        margin: 1.5rem 0;
        border-left: 5px solid var(--accent);
    }

    .guide-info-box strong {
        color: var(--primary);
        display: block;
        margin-bottom: 0.5rem;
        font-size: 1.1rem;
    }

    .guide-info-box p {
        margin: 0;
        color: #333;
    }

    .guide-warning {
        background: linear-gradient(135deg, #fff3cd, #ffe69c);
        padding: 1.5rem;
        border-radius: 16px;
        margin: 1.5rem 0;
        border-left: 5px solid #ffc107;
    }

    .guide-warning strong {
        color: #856404;
        display: block;
        margin-bottom: 0.5rem;
        font-size: 1.1rem;
    }

    .guide-warning p, .guide-warning ul {
        color: #664d03;
        margin: 0;
    }

    .guide-warning ul {
        padding-left: 1.5rem;
        margin-top: 0.5rem;
    }

    .guide-warning li {
        margin-bottom: 0.25rem;
    }

    .guide-list {
        display: grid;
        gap: 1rem;
        margin: 1.5rem 0;
    }

    .guide-list-item {
        background: #f8f9fa;
        padding: 1.25rem;
        border-radius: 12px;
        border-left: 4px solid var(--accent);
    }

    .guide-list-item strong {
        color: var(--primary);
        display: block;
        margin-bottom: 0.25rem;
    }

    .guide-list-item p {
        margin: 0;
        font-size: 0.95rem;
        color: #666;
    }

    .guide-steps {
        counter-reset: step;
        list-style: none;
        padding: 0;
        margin: 1.5rem 0;
    }

    .guide-steps li {
        position: relative;
        padding: 1rem 1rem 1rem 3.5rem;
        background: #f8f9fa;
        border-radius: 12px;
        margin-bottom: 0.75rem;
        transition: all 0.3s ease;
    }

    .guide-steps li:hover {
        background: #e8f5e9;
        transform: translateX(5px);
    }

    .guide-steps li::before {
        counter-increment: step;
        content: counter(step);
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        width: 28px;
        height: 28px;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
    }

    /* Nutrition specific */
    .nutrition-plate {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin: 1.5rem 0;
    }

    .plate-section {
        padding: 1.5rem;
        border-radius: 16px;
        text-align: center;
    }

    .plate-section.vegetables { background: linear-gradient(135deg, #c8e6c9, #a5d6a7); }
    .plate-section.proteins { background: linear-gradient(135deg, #ffccbc, #ffab91); }
    .plate-section.carbs { background: linear-gradient(135deg, #ffe0b2, #ffcc80); }

    .plate-section strong {
        display: block;
        font-size: 1.1rem;
        color: #333;
        margin-bottom: 0.5rem;
    }

    .plate-section p {
        margin: 0;
        font-size: 0.9rem;
        color: #555;
    }

    .menu-example {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin: 1.5rem 0;
    }

    @media (max-width: 768px) {
        .menu-example, .nutrition-plate { grid-template-columns: 1fr; }
    }

    .menu-meal {
        background: #f8f9fa;
        padding: 1.25rem;
        border-radius: 12px;
    }

    .menu-meal strong {
        color: var(--primary);
        display: block;
        margin-bottom: 0.5rem;
    }

    .menu-meal p {
        margin: 0;
        font-size: 0.95rem;
        color: #666;
    }

    /* Mental health specific */
    .stress-techniques {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin: 1.5rem 0;
    }

    @media (max-width: 768px) {
        .stress-techniques { grid-template-columns: 1fr; }
    }

    .technique-card {
        background: linear-gradient(135deg, #f3e5f5, #e1bee7);
        padding: 1.5rem;
        border-radius: 16px;
        text-align: center;
    }

    .technique-icon {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 0.75rem;
    }

    .technique-card h4 {
        color: #7b1fa2;
        margin: 0 0 0.5rem;
    }

    .technique-card p {
        margin: 0;
        font-size: 0.9rem;
        color: #555;
    }

    /* Fitness specific */
    .fitness-program {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
        margin: 1.5rem 0;
    }

    @media (max-width: 768px) {
        .fitness-program { grid-template-columns: 1fr; }
    }

    .week-plan {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 16px;
        border-top: 4px solid var(--health-orange);
    }

    .week-plan strong {
        color: var(--health-orange);
        display: block;
        margin-bottom: 1rem;
        font-size: 1.1rem;
    }

    .week-plan ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .week-plan li {
        padding: 0.5rem 0;
        padding-left: 1.5rem;
        position: relative;
        color: #555;
    }

    .week-plan li::before {
        content: '✓';
        position: absolute;
        left: 0;
        color: var(--accent);
        font-weight: bold;
    }

    .exercise-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin: 1.5rem 0;
    }

    @media (max-width: 768px) {
        .exercise-grid { grid-template-columns: repeat(2, 1fr); }
    }

    .exercise-card {
        background: linear-gradient(135deg, #fff3e0, #ffe0b2);
        padding: 1.25rem;
        border-radius: 16px;
        text-align: center;
    }

    .exercise-emoji {
        font-size: 2rem;
        display: block;
        margin-bottom: 0.5rem;
    }

    .exercise-card h4 {
        color: var(--health-orange);
        margin: 0 0 0.25rem;
    }

    .exercise-card p {
        margin: 0;
        font-size: 0.85rem;
        color: #666;
    }

    /* Sleep specific */
    .sleep-cycles {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin: 1.5rem 0;
    }

    @media (max-width: 768px) {
        .sleep-cycles { grid-template-columns: 1fr; }
    }

    .cycle {
        background: linear-gradient(135deg, #e3f2fd, #bbdefb);
        padding: 1.5rem;
        border-radius: 16px;
        text-align: center;
    }

    .cycle-phase {
        display: inline-block;
        background: #1e3a5f;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .cycle strong {
        display: block;
        color: #1e3a5f;
        margin-bottom: 0.5rem;
    }

    .cycle p {
        margin: 0;
        font-size: 0.9rem;
        color: #555;
    }

    .sleep-routine {
        margin: 1.5rem 0;
    }

    .routine-step {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1rem;
        background: #f8f9fa;
        border-radius: 12px;
        margin-bottom: 0.5rem;
        transition: all 0.3s ease;
    }

    .routine-step:hover {
        background: #e3f2fd;
        transform: translateX(5px);
    }

    .routine-time {
        min-width: 60px;
        padding: 0.5rem;
        background: #1e3a5f;
        color: white;
        border-radius: 8px;
        text-align: center;
        font-weight: 700;
    }

    .routine-action {
        color: #555;
    }

    /* Prevention specific */
    .screening-table {
        margin: 1.5rem 0;
    }

    .screening-row {
        display: flex;
        gap: 1.5rem;
        padding: 1.5rem;
        background: #f8f9fa;
        border-radius: 16px;
        margin-bottom: 1rem;
        align-items: flex-start;
    }

    @media (max-width: 768px) {
        .screening-row { flex-direction: column; gap: 1rem; }
    }

    .age-range {
        min-width: 100px;
        padding: 0.75rem 1rem;
        background: linear-gradient(135deg, var(--health-blue), #48cae4);
        color: white;
        border-radius: 8px;
        font-weight: 700;
        text-align: center;
    }

    .screenings {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .screening {
        background: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        border: 1px solid #e0e0e0;
    }

    .pharmacy-kit {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin: 1.5rem 0;
    }

    @media (max-width: 768px) {
        .pharmacy-kit { grid-template-columns: 1fr; }
    }

    .kit-category {
        background: #f8f9fa;
        padding: 1.25rem;
        border-radius: 12px;
    }

    .kit-category strong {
        color: var(--primary);
        display: block;
        margin-bottom: 0.5rem;
    }

    .kit-category span {
        color: #666;
        font-size: 0.95rem;
    }

    /* Make category cards clickable */
    .category-card {
        cursor: pointer;
    }
</style>
{% endblock %}

{% block main %}
<div class="guide-page">

    <!-- HERO SECTION -->
    <section class="hero-guide">
        <div class="heartbeat-line">
            <svg class="heartbeat-svg" viewBox="0 0 1200 100" preserveAspectRatio="none">
                <path d="M0,50 L100,50 L120,50 L140,20 L160,80 L180,50 L200,50 L220,50 L240,30 L260,70 L280,50 L300,50 L400,50 L420,50 L440,15 L460,85 L480,50 L500,50 L600,50" 
