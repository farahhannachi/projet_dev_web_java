{% extends 'front/_base.html.twig' %}

{% block title %}Air Mouse - CURAVITA{% endblock %}

{% block stylesheets %}
<style>
    /* ===========================
       AIR MOUSE OVERLAY UI
       =========================== */

    /* Floating Video Preview - Small corner camera */
    .air-mouse-video-preview {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 160px;
        height: 120px;
        background: #000;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 15px rgba(34, 197, 94, 0.3), 0 0 0 1px rgba(34, 197, 94, 0.2);
        z-index: 10001;
        transition: all 0.3s ease;
        opacity: 0.85;
    }

    .air-mouse-video-preview:hover {
        opacity: 1;
        box-shadow: 0 4px 25px rgba(34, 197, 94, 0.5), 0 0 0 2px rgba(34, 197, 94, 0.4);
    }

    .air-mouse-video-preview.expanded {
        width: 280px;
        height: 210px;
        border-radius: 16px;
        opacity: 1;
        box-shadow: 0 4px 30px rgba(34, 197, 94, 0.4), 0 0 0 2px rgba(34, 197, 94, 0.3);
    }

    .air-mouse-video-preview.minimized {
        width: 60px;
        height: 45px;
        opacity: 0.6;
        cursor: pointer;
        border-radius: 8px;
    }

    .air-mouse-video-preview.minimized:hover {
        opacity: 0.9;
    }

    .air-mouse-video-preview.minimized .video-preview-label,
    .air-mouse-video-preview.minimized .video-minimize-btn,
    .air-mouse-video-preview.minimized .video-expand-btn {
        display: none;
    }

    .air-mouse-video-preview #videoInput {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scaleX(-1); /* Mirror video for natural feel */
    }

    .air-mouse-video-preview #canvasOutput {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .video-preview-label {
        position: absolute;
        top: 5px;
        left: 5px;
        background: rgba(0, 0, 0, 0.7);
        color: #22c55e;
        padding: 2px 7px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: bold;
        letter-spacing: 1px;
        z-index: 2;
    }

    .air-mouse-video-preview.expanded .video-preview-label {
        top: 8px;
        left: 8px;
        padding: 3px 10px;
        font-size: 11px;
    }

    .video-minimize-btn,
    .video-expand-btn {
        position: absolute;
        top: 6px;
        right: 6px;
        background: rgba(0, 0, 0, 0.6);
        color: white;
        border: none;
        border-radius: 50%;
        width: 22px;
        height: 22px;
        cursor: pointer;
        font-size: 11px;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
    }

    .video-minimize-btn:hover,
    .video-expand-btn:hover {
        background: rgba(0, 0, 0, 0.8);
    }

    .video-expand-btn {
        right: 32px;
    }

    /* Custom Cursor */
    .air-mouse-cursor {
        position: fixed;
        width: 40px;
        height: 40px;
        pointer-events: none;
        z-index: 100000;
        display: none;
        transition: transform 0.1s ease;
    }

    .cursor-ring {
        width: 100%;
        height: 100%;
        border: 3px solid #22c55e;
        border-radius: 50%;
        box-shadow: 0 0 20px rgba(34, 197, 94, 0.8),
                    inset 0 0 10px rgba(34, 197, 94, 0.4);
        animation: cursorGlow 1.5s infinite;
        position: relative;
    }

    .cursor-dot {
        position: absolute;
        width: 10px;
        height: 10px;
        background: #22c55e;
        border-radius: 50%;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        box-shadow: 0 0 10px rgba(34, 197, 94, 0.9);
    }

    @keyframes cursorGlow {
        0%, 100% {
            box-shadow: 0 0 20px rgba(34, 197, 94, 0.8),
                        inset 0 0 10px rgba(34, 197, 94, 0.4);
        }
        50% {
            box-shadow: 0 0 30px rgba(34, 197, 94, 1),
                        inset 0 0 15px rgba(34, 197, 94, 0.6);
        }
    }

    /* Floating Control Panel */
    .air-mouse-panel {
        position: fixed;
        bottom: 20px;
        left: 20px;
        background: rgba(15, 15, 30, 0.95);
        padding: 20px;
        border-radius: 16px;
        border: 2px solid rgba(34, 197, 94, 0.3);
        z-index: 10001;
        min-width: 260px;
        backdrop-filter: blur(15px);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .panel-title {
        color: #22c55e;
        font-size: 16px;
        font-weight: bold;
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 2px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .toggle-switch {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 15px;
    }

    .switch-button {
        width: 60px;
        height: 32px;
        background: #444;
        border: none;
        border-radius: 20px;
        cursor: pointer;
        position: relative;
        transition: background 0.3s;
        padding: 0;
    }

    .switch-button.active {
        background: #22c55e;
        box-shadow: 0 0 15px rgba(34, 197, 94, 0.5);
    }

    .switch-slider {
        position: absolute;
        width: 28px;
        height: 28px;
        background: white;
        border-radius: 50%;
        top: 2px;
        left: 2px;
        transition: left 0.3s;
    }

    .switch-button.active .switch-slider {
        left: 30px;
    }

    .switch-label {
        color: #fff;
        font-size: 14px;
        font-weight: bold;
    }

    /* Stats Panel */
    .stats-panel {
        color: #22c55e;
        font-size: 12px;
        font-family: 'Courier New', monospace;
        line-height: 1.5;
    }

    .stat-item {
        display: flex;
        justify-content: space-between;
        padding: 4px 0;
        border-bottom: 1px solid rgba(34, 197, 94, 0.1);
    }

    .stat-label {
        color: #888;
    }

    .stat-value {
        color: #22c55e;
        font-weight: bold;
    }

    /* Status Indicator */
    .status-indicator {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #666;
        box-shadow: 0 0 5px rgba(100, 100, 100, 0.5);
    }

    .status-indicator.active {
        background: #22c55e;
        box-shadow: 0 0 10px rgba(34, 197, 94, 0.8),
                    0 0 20px rgba(34, 197, 94, 0.4);
        animation: statusPulse 1.5s infinite;
    }

    @keyframes statusPulse {
        0%, 100% {
            box-shadow: 0 0 10px rgba(34, 197, 94, 0.8),
                        0 0 20px rgba(34, 197, 94, 0.4);
        }
        50% {
            box-shadow: 0 0 15px rgba(34, 197, 94, 1),
                        0 0 30px rgba(34, 197, 94, 0.6);
        }
    }

    /* Gesture Guide - Floating */
    .gesture-guide {
        position: fixed;
        top: 20px;
        right: 20px;
        background: rgba(15, 15, 30, 0.95);
        padding: 15px 20px;
        border-radius: 16px;
        border: 2px solid rgba(34, 197, 94, 0.2);
        z-index: 10001;
        backdrop-filter: blur(15px);
        color: #ccc;
        font-size: 13px;
        max-width: 280px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .gesture-guide-title {
        color: #22c55e;
        font-weight: bold;
        margin-bottom: 10px;
        font-size: 14px;
    }

    .gesture-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 5px 0;
    }

    .gesture-icon {
        font-size: 20px;
        width: 30px;
        text-align: center;
    }

    .gesture-desc {
        flex: 1;
        line-height: 1.3;
    }

    .gesture-desc strong {
        color: #22c55e;
    }

    /* Page content area - hero section for demo */
    .air-mouse-demo-content {
        padding: 40px 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .demo-hero {
        text-align: center;
        padding: 60px 20px;
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.1) 0%, rgba(34, 197, 94, 0.02) 100%);
        border-radius: 20px;
        margin-bottom: 40px;
        border: 1px solid rgba(34, 197, 94, 0.15);
    }

    .demo-hero h1 {
        font-size: 2.5rem;
        color: #22c55e;
        margin-bottom: 15px;
    }

    .demo-hero p {
        font-size: 1.1rem;
        color: #888;
        max-width: 600px;
        margin: 0 auto;
    }

    /* Demo interactive elements */
    .demo-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        justify-content: center;
        margin: 40px 0;
    }

    .demo-btn {
        padding: 15px 30px;
        border-radius: 12px;
        border: 2px solid rgba(34, 197, 94, 0.3);
        background: rgba(34, 197, 94, 0.1);
        color: #22c55e;
        font-size: 16px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .demo-btn:hover {
        background: rgba(34, 197, 94, 0.2);
        border-color: rgba(34, 197, 94, 0.6);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(34, 197, 94, 0.3);
        color: #22c55e;
    }

    .demo-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin: 40px 0;
    }

    .demo-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 25px;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .demo-card:hover {
        border-color: rgba(34, 197, 94, 0.4);
        background: rgba(34, 197, 94, 0.05);
        transform: translateY(-3px);
    }

    .demo-card-icon {
        font-size: 40px;
        margin-bottom: 15px;
    }

    .demo-card h3 {
        color: #22c55e;
        margin-bottom: 8px;
    }

    .demo-card p {
        color: #888;
        font-size: 14px;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .air-mouse-panel {
            bottom: auto;
            top: 10px;
            left: 10px;
            min-width: 200px;
            padding: 12px;
        }

        .air-mouse-video-preview {
            width: 120px;
            height: 90px;
            bottom: 10px;
            right: 10px;
        }

        .air-mouse-video-preview.expanded {
            width: 200px;
            height: 150px;
        }

        .gesture-guide {
            display: none;
        }
    }
</style>
{% endblock %}

{% block main %}
<!-- ===========================
     PAGE CONTENT (navigable with Air Mouse)
     =========================== -->
<div class="air-mouse-demo-content">
    <div class="demo-hero">
        <h1>🖱️ Air Mouse</h1>
        <p>Contrôlez votre navigateur avec votre main ! Activez la caméra, pointez avec l'index pour déplacer le curseur, et pincez pour cliquer.</p>
    </div>

    <!-- Demo buttons to test clicking -->
    <div class="demo-buttons">
        <a href="{{ path('app_home') }}" class="demo-btn">🏠 Accueil</a>
        <a href="{{ path('app_products') }}" class="demo-btn">💊 Produits</a>
        <a href="{{ path('app_about') }}" class="demo-btn">ℹ️ À propos</a>
        <a href="{{ path('app_contact') }}" class="demo-btn">📧 Contact</a>
        <button class="demo-btn" onclick="alert('🎉 Bravo! Vous avez cliqué avec Air Mouse!')">🎯 Test Click</button>
    </div>

    <!-- Demo cards to test hover + click -->
    <div class="demo-cards">
        <div class="demo-card" onclick="this.style.borderColor='#22c55e'; this.querySelector('h3').textContent='✅ Cliqué!'">
            <div class="demo-card-icon">👆</div>
            <h3>Pointer</h3>
            <p>Levez votre index pour déplacer le curseur sur l'écran</p>
        </div>
        <div class="demo-card" onclick="this.style.borderColor='#22c55e'; this.querySelector('h3').textContent='✅ Cliqué!'">
            <div class="demo-card-icon">🤏</div>
            <h3>Pincer</h3>
            <p>Rapprochez pouce et index pour cliquer sur les éléments</p>
        </div>
        <div class="demo-card" onclick="this.style.borderColor='#22c55e'; this.querySelector('h3').textContent='✅ Cliqué!'">
            <div class="demo-card-icon">🖐️</div>
            <h3>Scroller</h3>
            <p>Ouvrez la main (3+ doigts) et bougez haut/bas pour scroller</p>
        </div>
        <div class="demo-card" onclick="this.style.borderColor='#22c55e'; this.querySelector('h3').textContent='✅ Cliqué!'">
            <div class="demo-card-icon">🎯</div>
            <h3>Naviguer</h3>
            <p>Cliquez sur les liens pour naviguer entre les pages</p>
        </div>
    </div>

    <!-- More content for scroll testing -->
    <div style="text-align: center; padding: 40px 0; color: #666;">
        <h2 style="color: #22c55e; margin-bottom: 15px;">⬇️ Scrollez avec la main ouverte ⬇️</h2>
        <p>Ouvrez votre main (3 doigts minimum) et déplacez-la vers le haut ou le bas pour scroller la page.</p>
    </div>

    <div class="demo-cards">
        <div class="demo-card" onclick="this.style.borderColor='#fbbf24'; this.querySelector('h3').textContent='✅ Trouvé!'">
            <div class="demo-card-icon">🔍</div>
            <h3>Carte cachée 1</h3>
            <p>Scrollez pour trouver cette carte et cliquez dessus!</p>
        </div>
        <div class="demo-card" onclick="this.style.borderColor='#fbbf24'; this.querySelector('h3').textContent='✅ Trouvé!'">
            <div class="demo-card-icon">🏆</div>
            <h3>Carte cachée 2</h3>
            <p>Bravo si vous avez scrollé jusqu'ici avec Air Mouse!</p>
        </div>
        <div class="demo-card" onclick="this.style.borderColor='#fbbf24'; this.querySelector('h3').textContent='✅ Trouvé!'">
            <div class="demo-card-icon">⭐</div>
            <h3>Carte cachée 3</h3>
            <p>Vous maîtrisez le scroll gestuel!</p>
        </div>
    </div>
</div>

<!-- ===========================
     FLOATING CONTROL PANEL
     =========================== -->
<div class="air-mouse-panel">
    <div class="panel-title">
        <span class="status-indicator"></span> Air Mouse
    </div>

    <div class="toggle-switch">
        <button class="switch-button" id="toggleButton">
            <div class="switch-slider"></div>
        </button>
        <span class="switch-label" id="switchLabel">OFF</span>
    </div>

    <div class="stats-panel">
        <div class="stat-item">
            <span class="stat-label">Status:</span>
            <span class="stat-value" id="statusValue">Inactif</span>
        </div>
        <div class="stat-item">
            <span class="stat-label">Position X:</span>
            <span class="stat-value" id="posX">--</span>
        </div>
        <div class="stat-item">
            <span class="stat-label">Position Y:</span>
            <span class="stat-value" id="posY">--</span>
        </div>
        <div class="stat-item">
            <span class="stat-label">Distance:</span>
            <span class="stat-value" id="distance">--</span>
        </div>
        <div class="stat-item">
            <span class="stat-label">FPS:</span>
            <span class="stat-value" id="fps">0</span>
        </div>
        <div class="stat-item">
            <span class="stat-label">Main détectée:</span>
            <span class="stat-value" id="handDetected">Non</span>
        </div>
    </div>
</div>

<!-- ===========================
     GESTURE GUIDE
     =========================== -->
<div class="gesture-guide" id="gestureGuide">
    <div class="gesture-guide-title">📋 Gestes</div>
    <div class="gesture-item">
        <span class="gesture-icon">👆</span>
        <span class="gesture-desc"><strong>Index levé</strong> → Déplacer le curseur</span>
    </div>
    <div class="gesture-item">
        <span class="gesture-icon">🤏</span>
        <span class="gesture-desc"><strong>Pincer pouce+index</strong> → Cliquer</span>
    </div>
    <div class="gesture-item">
        <span class="gesture-icon">🖐️</span>
        <span class="gesture-desc"><strong>3+ doigts ouverts + bouger</strong> → Scroller</span>
    </div>
    <div class="gesture-item">
        <span class="gesture-icon">🟢</span>
        <span class="gesture-desc"><strong>Contour vert</strong> → Élément cliquable</span>
    </div>
</div>

<!-- ===========================
     FLOATING VIDEO PREVIEW
     =========================== -->
<div class="air-mouse-video-preview" id="videoPreview">
    <span class="video-preview-label">📹 LIVE</span>
    <button class="video-expand-btn" id="expandBtn" title="Agrandir">⤢</button>
    <button class="video-minimize-btn" id="minimizeBtn" title="Minimiser">−</button>
    <video id="videoInput" autoplay muted playsinline></video>
    <canvas id="canvasOutput"></canvas>
</div>

<!-- Custom Cursor -->
<div class="air-mouse-cursor">
    <div class="cursor-ring">
        <div class="cursor-dot"></div>
    </div>
</div>

<!-- MediaPipe Scripts -->
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js"></script>

<script>
    // Video preview size controls (3 states: default small, expanded, minimized)
    // IMPORTANT: These only change the preview size - they NEVER stop the camera
    const preview = document.getElementById('videoPreview');
    const minimizeBtn = document.getElementById('minimizeBtn');
    const expandBtn = document.getElementById('expandBtn');

    // Minimize: make it tiny (still shows video, camera keeps running)
    minimizeBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        preview.classList.remove('expanded');
        preview.classList.add('minimized');
    });

    // Expand: make it larger for better hand visibility
    expandBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        preview.classList.remove('minimized');
        preview.classList.toggle('expanded');
    });

    // Click on minimized preview to restore to default small size
    preview.addEventListener('click', function() {
        if (this.classList.contains('minimized')) {
            this.classList.remove('minimized');
        }
    });
</script>
{% endblock %}
