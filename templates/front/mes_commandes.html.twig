{% extends 'front/_base.html.twig' %}

{% block title %}Mes Commandes - CURAVITA{% endblock %}

{% block main %}
<div class="container" style="padding: 4rem 1rem;">
    <h1 class="text-center mb-12 text-primary">Mes Commandes</h1>

    <!-- Section Filtres -->
    <div class="filters-section mb-8">
        <div class="filters-container">
            <form method="GET" action="{{ path('app_mes_commandes') }}" class="filters-form">
                <div class="filters-grid">
                    <!-- Recherche -->
                    <div class="filter-group">
                        <input type="text" 
                               name="search" 
                               placeholder="Rechercher une commande..." 
                               value="{{ filters.search }}"
                               class="filter-input">
                    </div>
                    
                    <!-- Statut -->
                    <div class="filter-group">
                        <select name="statut" class="filter-select">
                            <option value="all" {{ filters.statut == 'all' or not filters.statut ? 'selected' : '' }}>
                                Tous les statuts
                            </option>
                            <option value="en attente" {{ filters.statut == 'en attente' ? 'selected' : '' }}>
                                En attente
                            </option>
                            <option value="confirmée" {{ filters.statut == 'confirmée' ? 'selected' : '' }}>
                                Confirmée
                            </option>
                            <option value="en préparation" {{ filters.statut == 'en préparation' ? 'selected' : '' }}>
                                En préparation
                            </option>
                            <option value="expédiée" {{ filters.statut == 'expédiée' ? 'selected' : '' }}>
                                Expédiée
                            </option>
                            <option value="livrée" {{ filters.statut == 'livrée' ? 'selected' : '' }}>
                                Livrée
                            </option>
                            <option value="annulée" {{ filters.statut == 'annulée' ? 'selected' : '' }}>
                                Annulée
                            </option>
                        </select>
                    </div>
                    
                    <!-- Date Minimum -->
                    <div class="filter-group">
                        <input type="date" 
                               name="date_min" 
                               value="{{ filters.date_min }}"
                               class="filter-input">
                    </div>
                    
                    <!-- Date Maximum -->
                    <div class="filter-group">
                        <input type="date" 
                               name="date_max" 
                               value="{{ filters.date_max }}"
                               class="filter-input">
                    </div>
                    
                    <!-- Montant Minimum -->
                    <div class="filter-group">
                        <input type="number" 
                               name="montant_min" 
                               placeholder="Montant min" 
                               value="{{ filters.montant_min }}"
                               min="0"
                               step="0.01"
                               class="filter-input">
                    </div>
                    
                    <!-- Montant Maximum -->
                    <div class="filter-group">
                        <input type="number" 
                               name="montant_max" 
                               placeholder="Montant max" 
                               value="{{ filters.montant_max }}"
                               min="0"
                               step="0.01"
                               class="filter-input">
                    </div>
                    
                    <!-- Tri -->
                    <div class="filter-group">
                        <select name="sort" class="filter-select">
                            <option value="date_desc" {{ filters.sort == 'date_desc' ? 'selected' : '' }}>
                                Date récente
                            </option>
                            <option value="date_asc" {{ filters.sort == 'date_asc' ? 'selected' : '' }}>
                                Date ancienne
                            </option>
                            <option value="montant_desc" {{ filters.sort == 'montant_desc' ? 'selected' : '' }}>
                                Montant décroissant
                            </option>
                            <option value="montant_asc" {{ filters.sort == 'montant_asc' ? 'selected' : '' }}>
                                Montant croissant
                            </option>
                        </select>
                    </div>
                    
                    <!-- Boutons -->
                    <div class="filter-actions">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-filter"></i> Filtrer
                        </button>
                        <a href="{{ path('app_mes_commandes') }}" class="btn btn-secondary btn-sm">
                            <i class="fas fa-times"></i> Réinitialiser
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {% if commandes|length > 0 %}
        <div class="commandes-list">
            {% for commande in commandes %}
                <div class="commande-card">
                    <div class="commande-header">
                        <div class="commande-info">
                            <h3>Commande #{{ commande.idCommande }}</h3>
                            <p class="commande-date">Date: {{ commande.dateCommande|date('d/m/Y H:i') }}</p>
                        </div>
                        <div class="commande-status">
                            <span class="status-badge {{ commande.statut|replace({' ': '-', 'é': 'e'}) }}">
                                {{ commande.statut|title }}
                            </span>
                        </div>
                    </div>
                    
                    <div class="commande-details">
                        <div class="commande-client">
                            <p><strong>Nom:</strong> {{ commande.nom }}</p>
                            <p><strong>Téléphone:</strong> {{ commande.telephone }}</p>
                            <p><strong>Email:</strong> {{ commande.email }}</p>
                        </div>
                        
                        <div class="commande-amount">
                            <p class="amount">Total: {{ commande.total|number_format(2, ',', ' ') }} €</p>
                            <p class="payment">Paiement: {{ commande.modePaiement|default('Non spécifié') }}</p>
                        </div>
                        
                        <div class="commande-address">
                            <p><strong>Adresse:</strong> {{ commande.adresseLivraison }}</p>
                        </div>
                    </div>
                    
                    {% if commande.message %}
                        <div class="commande-message">
                            <p><strong>Message:</strong> {{ commande.message }}</p>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state">
            <i class="fas fa-shopping-cart" style="font-size: 4rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
            <h3 style="color: var(--text-muted); margin-bottom: 1rem;">Aucune commande trouvée</h3>
            <p style="color: var(--text-muted);">Vous n'avez pas encore passé de commande ou aucun résultat ne correspond à vos filtres.</p>
            <a href="{{ path('app_commande') }}" class="btn btn-primary mt-4">
                <i class="fas fa-plus"></i> Passer une commande
            </a>
        </div>
    {% endif %}
</div>

<style>
.commandes-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.commande-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    padding: 1.5rem;
    transition: all 0.3s ease;
}

.commande-card:hover {
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    transform: translateY(-2px);
}

.commande-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
}

.commande-info h3 {
    color: var(--primary-color);
    margin-bottom: 0.25rem;
    font-size: 1.25rem;
}

.commande-date {
    color: var(--text-muted);
    font-size: 0.9rem;
}

.status-badge {
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
}

.status-badge.en-attente {
    background: #fef3c7;
    color: #92400e;
}

.status-badge.confirmee {
    background: #dbeafe;
    color: #1e40af;
}

.status-badge.en-preparation {
    background: #e0e7ff;
    color: #3730a3;
}

.status-badge.expediee {
    background: #ccfbf1;
    color: #065f46;
}

.status-badge.livree {
    background: #d1fae5;
    color: #065f46;
}

.status-badge.annulee {
    background: #fee2e2;
    color: #991b1b;
}

.commande-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1rem;
}

.commande-client p,
.commande-address p {
    margin-bottom: 0.5rem;
    color: var(--text-main);
}

.commande-amount {
    text-align: right;
}

.amount {
    font-size: 1.25rem;
    font-weight: bold;
    color: var(--primary-color);
    margin-bottom: 0.25rem;
}

.payment {
    color: var(--text-muted);
    font-size: 0.9rem;
}

.commande-message {
    padding: 1rem;
    background: #f8f9fa;
    border-radius: 8px;
    border-left: 4px solid var(--primary-color);
}

.commande-message p {
    margin: 0;
    color: var(--text-main);
}

/* Styles pour les filtres (réutilisés) */
.filters-section {
    background: white;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    margin-bottom: 2rem;
}

.filters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    align-items: end;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.filter-input, .filter-select {
    padding: 0.75rem;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    background: white;
}

.filter-input:focus, .filter-select:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

.filter-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.btn-sm {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-primary {
    background: var(--primary-color);
    color: white;
}

.btn-primary:hover {
    background: #2563eb;
    transform: translateY(-1px);
}

.btn-secondary {
    background: #6b7280;
    color: white;
}

.btn-secondary:hover {
    background: #4b5563;
    transform: translateY(-1px);
}

.empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

/* Responsive */
@media (max-width: 768px) {
    .filters-grid {
        grid-template-columns: 1fr;
    }
    
    .filter-actions {
        justify-content: center;
    }
    
    .commande-header {
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
    }
    
    .commande-details {
        grid-template-columns: 1fr;
    }
    
    .commande-amount {
        text-align: left;
    }
}
</style>
{% endblock %}
