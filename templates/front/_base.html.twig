    {# AFK (Away From Keyboard) Detection - Only for authenticated users #}
    {% if is_granted('ROLE_USER') or is_granted('ROLE_ADMIN') %}
    <script>
        (function() {
            // Configuration
            const INACTIVE_TIMEOUT = 10 * 60 * 1000; // 10 minutes in milliseconds
            const WARNING_COUNTDOWN = 60; // seconds before auto-logout
            const WARNING_CHECK_INTERVAL = 1000; // check every second
            
            let inactivityTimer = null;
            let warningTimer = null;
            let countdownInterval = null;
            let warningShown = false;
            let lastActivity = Date.now();
            
            const modal = document.getElementById('afk-modal');
            const countdownEl = document.getElementById('afk-countdown');
            const stayConnectedBtn = document.getElementById('afk-stay-connected');
            
            // Reset the inactivity timer
            function resetInactivityTimer() {
                lastActivity = Date.now();
                
                if (warningShown) {
                    hideWarning();
                }
                
                // Clear existing timers
                if (inactivityTimer) {
                    clearTimeout(inactivityTimer);
                }
                if (warningTimer) {
                    clearTimeout(warningTimer);
                }
                if (countdownInterval) {
                    clearInterval(countdownInterval);
                }
                
                // Set new timer
                inactivityTimer = setTimeout(showWarning, INACTIVE_TIMEOUT);
            }
            
            // Show the AFK warning
            function showWarning() {
                warningShown = true;
                
                if (modal) {
                    modal.style.display = 'flex';
                    
                    // Start countdown
                    let remaining = WARNING_COUNTDOWN;
                    if (countdownEl) {
                        countdownEl.textContent = remaining;
                    }
                    
                    countdownInterval = setInterval(function() {
                        remaining--;
                        if (countdownEl) {
                            countdownEl.textContent = remaining;
                        }
                        
                        if (remaining <= 0) {
                            clearInterval(countdownInterval);
                            performLogout();
                        }
                    }, WARNING_CHECK_INTERVAL);
                }
            }
            
            // Hide the AFK warning
            function hideWarning() {
                warningShown = false;
                
                if (countdownInterval) {
                    clearInterval(countdownInterval);
                    countdownInterval = null;
                }
                
                if (modal) {
                    modal.style.display = 'none';
                }
                
                // Reset the main timer
                resetInactivityTimer();
            }
            
            // Perform logout
            function performLogout() {
                window.location.href = '{{ path("app_logout") }}';
            }
            
            // Event listeners for user activity
            const activityEvents = ['mousemove', 'mousedown', 'keypress', 'scroll', 'touchstart', 'touchmove'];
            
            activityEvents.forEach(function(event) {
                document.addEventListener(event, resetInactivityTimer, { passive: true });
            });
            
            // Handle "Stay Connected" button
            if (stayConnectedBtn) {
                stayConnectedBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    hideWarning();
                });
            }
            
            // Start the inactivity timer when page loads
            resetInactivityTimer();
            
        })();
    </script>
