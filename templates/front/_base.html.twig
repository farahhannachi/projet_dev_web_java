    <!-- User Dropdown JavaScript -->
    <script>
        function toggleUserDropdown() {
            const dropdown = document.getElementById('userDropdown');
            const notifPanel = document.getElementById('notifPanel');
            // Fermer le panel de notifications si ouvert
            if (notifPanel) notifPanel.classList.remove('show');
            dropdown.classList.toggle('show');
        }

        // ===== Notification Panel Toggle =====
        function toggleNotifPanel(event) {
            event.stopPropagation();
            const panel = document.getElementById('notifPanel');
            const dropdown = document.getElementById('userDropdown');
            // Fermer le dropdown user si ouvert
            if (dropdown) dropdown.classList.remove('show');
            panel.classList.toggle('show');
        }
        
        // Close dropdowns when clicking outside
        document.addEventListener('click', function(event) {
            const dropdown = document.getElementById('userDropdown');
            const dropdownBtn = document.querySelector('.user-dropdown-btn');
            const notifPanel = document.getElementById('notifPanel');
            const notifWrapper = document.querySelector('.notification-wrapper');
            
            // Close user dropdown
            if (dropdownBtn && dropdown && !dropdownBtn.contains(event.target) && !dropdown.contains(event.target)) {
                dropdown.classList.remove('show');
            }
            
            // Close notification panel
            if (notifPanel && notifWrapper && !notifWrapper.contains(event.target)) {
                notifPanel.classList.remove('show');
            }
        });
    </script>

