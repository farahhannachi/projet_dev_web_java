    <script>
        // ===== Open Notification Detail Modal =====
        function openNotifDetail(el) {
            const overlay = document.getElementById('notifModalOverlay');
            const actionLabels = {
                'aucune': 'Aucune action',
                'remboursement': '💰 Remboursement',
                'remplacement': '🔄 Remplacement',
                'retour_accepte': '✅ Retour accepté',
                'retour_refuse': '❌ Retour refusé',
                'escalade': '⬆️ Escalade'
            };

            // Fill modal content from data attributes
            document.getElementById('nm-ticket-id').textContent = 'Ticket #' + el.dataset.ticketId;
            document.getElementById('nm-subject').textContent = el.dataset.ticketObjet;
            document.getElementById('nm-agent-avatar').textContent = el.dataset.agentInitials;
            document.getElementById('nm-agent-name').textContent = el.dataset.agentNom + (el.dataset.agentPrenom ? ' ' + el.dataset.agentPrenom : '');
            document.getElementById('nm-message').textContent = el.dataset.message;
            document.getElementById('nm-date').textContent = el.dataset.date;
            document.getElementById('nm-ticket-link').href = el.dataset.showUrl;

            // Action
            const action = el.dataset.action;
            const actionSection = document.getElementById('nm-action-section');
            if (action && action !== 'aucune') {
                actionSection.style.display = 'block';
                const actionEl = document.getElementById('nm-action');
                actionEl.textContent = actionLabels[action] || action.replace(/_/g, ' ');
                actionEl.className = 'notif-modal-action ' + action;
            } else {
                actionSection.style.display = 'none';
            }

            // File attachment
            const fileName = el.dataset.fileName;
            const filePath = el.dataset.filePath;
            const fileSection = document.getElementById('nm-file-section');
            if (fileName && fileName.length > 0) {
                fileSection.style.display = 'block';
                document.getElementById('nm-file-name').textContent = fileName;
                document.getElementById('nm-file-link').href = filePath;
            } else {
                fileSection.style.display = 'none';
            }

            // Close notification panel and show modal
            const notifPanel = document.getElementById('notifPanel');
            if (notifPanel) notifPanel.classList.remove('show');

            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        // ===== Close Notification Detail Modal =====
        function closeNotifDetail(event) {
            if (event && event.target !== event.currentTarget) return;
            const overlay = document.getElementById('notifModalOverlay');
            overlay.classList.remove('active');
            document.body.style.overflow = '';
        }

        // Close modal with Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeNotifDetail();
            }
        });
    </script>
    
