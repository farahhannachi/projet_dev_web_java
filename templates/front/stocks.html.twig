{% extends 'front/_base.html.twig' %}

{% block title %}Nos Stocks - CuraVita{% endblock %}

{% block stylesheets %}
<style>
    .hero-section {
        min-height: 70vh;
        background: linear-gradient(135deg, #0a1628 0%, #16563f 50%, #00b4d8 100%);
        color: white;
        padding: 4rem 0 3rem;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
    }
    .hero-section::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background-image:
            radial-gradient(circle at 30% 20%, rgba(0, 180, 216, 0.35) 0%, transparent 40%),
            radial-gradient(circle at 70% 80%, rgba(40, 167, 69, 0.35) 0%, transparent 40%),
            url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%23ffffff" fill-opacity="0.1" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,133.3C960,128,1056,96,1152,90.7C1248,85,1344,107,1392,117.3L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>');
        background-repeat: no-repeat;
        background-position: center, center, bottom;
        background-size: auto, auto, cover;
        animation: pulse-bg 8s ease-in-out infinite;
    }
    @keyframes pulse-bg {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.85; transform: scale(1.03); }
    }
    .hero-content {
        text-align: center;
        position: relative;
        z-index: 1;
        padding: 2rem;
        max-width: 900px;
        margin: 0 auto;
    }
    .hero-content::before {
        content: '\f004';
        font-family: "Font Awesome 5 Free";
        font-weight: 900;
        width: 120px;
        height: 120px;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        display: grid;
        place-items: center;
        margin: 0 auto 1.75rem;
        font-size: 3.5rem;
        color: #ff6b9d;
        border: 3px solid rgba(255,255,255,0.3);
        backdrop-filter: blur(10px);
        animation: pulse-heart 1.5s ease-in-out infinite;
    }
    @keyframes pulse-heart {
        0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255,255,255,0.4); }
        50% { transform: scale(1.08); box-shadow: 0 0 0 18px rgba(255,255,255,0); }
    }
    .hero-content h1 {
        font-size: clamp(2.5rem, 7vw, 4rem);
        font-weight: 800;
        margin-bottom: 1rem;
        text-shadow: 2px 2px 20px rgba(0,0,0,0.3);
        background: linear-gradient(90deg, #ffffff, #ffd166, #ff6b9d, #ffffff);
        background-size: 300% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: rainbow 6s linear infinite;
    }
    .hero-content h1 i {
        color: #ffffff;
        -webkit-text-fill-color: #ffffff;
        margin-right: 0.35rem;
    }
    @keyframes rainbow {
        0% { background-position: 0% center; }
        100% { background-position: 300% center; }
    }
    .hero-content p {
        font-size: 1.125rem;
        opacity: 0.92;
        max-width: 640px;
        margin: 0 auto;
        line-height: 1.8;
    }
    .content-section {
        background: linear-gradient(180deg, #f8faf9 0%, #ffffff 100%);
        padding: 4rem 0;
        position: relative;
    }
    .content-section::before {
        content: '';
        position: absolute;
        top: -80px;
        left: 0;
        right: 0;
        height: 80px;
        background: linear-gradient(to bottom right, transparent 49%, #f8faf9 50%);
    }
    .content-section .container { position: relative; z-index: 1; }
    .section-header { text-align: center; margin-bottom: 3rem; }
    .section-header h2 { font-size: 2rem; font-weight: 700; color: #16563f; margin-bottom: 1rem; }
    .section-header p { font-size: 1rem; color: #6c757d; max-width: 600px; margin: 0 auto; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; margin: 3rem 0; }
    .stat-card { background: white; padding: 2rem; border-radius: 16px; box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1); text-align: center; position: relative; overflow: hidden; transition: all 0.3s ease; }
    .stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #16563f, #28a745); }
    .stat-card:hover { transform: translateY(-5px); box-shadow: 0 1rem 2rem rgba(0,0,0,0.15); }
    .stat-icon { width: 60px; height: 60px; background: linear-gradient(135deg, #16563f, #28a745); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; }
    .stat-icon i { font-size: 1.5rem; color: white; }
    .stat-number { font-size: 2rem; font-weight: 700; color: #16563f; margin-bottom: 0.25rem; }
    .stat-label { font-size: 0.9rem; color: #6c757d; font-weight: 600; }
    .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 2rem; }
    .info-card { background: white; border-radius: 16px; padding: 1.5rem; box-shadow: 0 0.25rem 0.5rem rgba(0,0,0,0.1); border: 1px solid #e9ecef; transition: all 0.3s ease; }
    .info-card:hover { transform: translateY(-3px); box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15); }
    .card-header { display: flex; align-items: center; margin-bottom: 1rem; }
    .card-icon { width: 50px; height: 50px; background: linear-gradient(135deg, #16563f, #28a745); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 1rem; }
    .card-icon i { font-size: 1.25rem; color: white; }
    .card-title { font-size: 1.1rem; font-weight: 600; color: #16563f; }
    .card-subtitle { color: #6c757d; font-size: 0.8rem; }
    .info-list { list-style: none; padding: 0; margin: 0; }
    .info-list li { padding: 0.5rem 0; border-bottom: 1px solid #e9ecef; display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; }
    .info-list li:last-child { border-bottom: none; }
    .info-list i { color: #16563f; width: 18px; text-align: center; }
    .badge { display: inline-block; padding: 0.35rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
    .badge-success { background: #28a745; color: white; }
    .badge-warning { background: #ffc107; color: #212529; }
    .btn-primary { background: linear-gradient(135deg, #16563f, #28a745); color: white; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; transition: all 0.3s ease; }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.2); }
    .btn-outline { background: transparent; color: #16563f; border: 2px solid #16563f; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; transition: all 0.3s ease; }
    .btn-outline:hover { background: #16563f; color: white; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
    .assistant-panel { background: #ffffff; border-radius: 16px; padding: 1.5rem; box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.08); border: 1px solid #e9ecef; margin: 2rem 0; }
    .assistant-panel h3 { margin: 0 0 0.5rem 0; color: #16563f; font-size: 1.25rem; }
    .assistant-panel p { margin: 0 0 1rem 0; color: #6c757d; }
    .assistant-form { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .assistant-input { flex: 1; min-width: 240px; padding: 0.75rem 1rem; border: 2px solid #e5e7eb; border-radius: 10px; }
    .assistant-input:focus { outline: none; border-color: #16563f; box-shadow: 0 0 0 3px rgba(22,86,63,0.1); }
    .assistant-btn { background: linear-gradient(135deg, #16563f, #28a745); color: #fff; border: none; padding: 0.75rem 1.5rem; border-radius: 10px; font-weight: 600; cursor: pointer; }
    .assistant-result { margin-top: 1rem; padding: 1rem; border-radius: 12px; background: #f8fafc; border: 1px solid #e2e8f0; display: none; }
    .assistant-result h4 { margin: 0 0 0.5rem 0; color: #16563f; }
    .assistant-list { margin: 0.5rem 0 0 0; padding-left: 1.25rem; }

    /* ========== ANIMATIONS (Guide Sante style) ========== */
    .fade-in-up { opacity: 1; transform: translateY(0); }
    body.reveal-ready .fade-in-up { opacity: 0; transform: translateY(30px); }
    body.reveal-ready .fade-in-up.is-visible { animation: fadeInUp 0.8s ease forwards; }
    @keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }
    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.3s; }
    .delay-4 { animation-delay: 0.4s; }
    .delay-5 { animation-delay: 0.5s; }
    .delay-6 { animation-delay: 0.6s; }

    .stat-card,
    .info-card,
    .assistant-panel {
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .stat-card:hover,
    .info-card:hover,
    .assistant-panel:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
    }

    @media (prefers-reduced-motion: reduce) {
        body.reveal-ready .fade-in-up,
        body.reveal-ready .fade-in-up.is-visible {
            animation: none;
            opacity: 1;
            transform: none;
        }
        .hero-section::before {
            animation: none;
        }
        .hero-content::before {
            animation: none;
        }
        .hero-content h1 {
            animation: none;
            background-position: 0% center;
        }
        .stat-card,
        .info-card,
        .assistant-panel {
            transition: none;
        }
    }
</style>
{% endblock %}

{% block main %}
{% if app.user and 'ROLE_ADMIN' in app.user.roles %}
<section class="hero-section">
    <div class="container">
        <div class="hero-content fade-in-up">
            <h1><i class="fas fa-boxes"></i> Gestion des Stocks</h1>
            <p>Suivez en temps réel l'état de nos stocks et la disponibilité de nos produits pharmaceutiques</p>
        </div>
    </div>
</section>

<section class="content-section">
    <div class="container">
        <div class="section-header fade-in-up">
            <h2>État des Stocks</h2>
            <p>Consultez l'état actuel de nos stocks et les dates d'expiration pour garantir la qualité de nos produits</p>
        </div>

        <div class="assistant-panel fade-in-up delay-1">
            <h3><i class="fas fa-brain"></i> Assistant décisionnel</h3>
            <p>Posez une question sur les ruptures, la performance des dépôts ou les quantités à commander.</p>
            <form id="stockAssistantForm" class="assistant-form">
                <input id="stockAssistantInput" class="assistant-input" placeholder="Ex: Quels produits vont tomber en rupture cette semaine ?">
                <button type="submit" class="assistant-btn">Analyser</button>
            </form>
            <div id="stockAssistantResult" class="assistant-result"></div>
        </div>

        <div class="stats-grid">
            <div class="stat-card fade-in-up delay-1">
                <div class="stat-icon">
                    <i class="fas fa-boxes"></i>
                </div>
                <div class="stat-number">{{ stocks|length }}</div>
                <div class="stat-label">Références</div>
            </div>
            
            <div class="stat-card fade-in-up delay-2">
                <div class="stat-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-number">{{ stocks|filter(stock => stock.etatStock == 'disponible')|length }}</div>
                <div class="stat-label">Disponibles</div>
            </div>
            
            <div class="stat-card fade-in-up delay-3">
                <div class="stat-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="stat-number">{{ stocks|filter(stock => stock.etatStock == 'rupture')|length }}</div>
                <div class="stat-label">En Rupture</div>
            </div>
        </div>

        {% if stocks|length > 0 %}
            <div class="cards-grid">
                {% for stock in stocks %}
                <div class="info-card fade-in-up delay-{{ (loop.index0 % 6) + 1 }}">
                    <div class="card-header">
                        <div class="card-icon" style="background: {% if stock.etatStock == 'disponible' %}linear-gradient(135deg, var(--secondary-color), #218838){% else %}linear-gradient(135deg, var(--warning-color), #e0a800){% endif %};">
                            <i class="fas fa-boxes"></i>
                        </div>
                        <div>
                            <div class="card-title">Stock #{{ stock.id }}</div>
                            <div class="card-subtitle">Référence: STK-{{ "%04d"|format(stock.id) }}</div>
                        </div>
                    </div>
                    
                    <div class="card-content">
                        <ul class="info-list">
                            <li>
                                <i class="fas fa-exclamation-triangle"></i>
                                <span>Seuil d'alerte: {{ stock.seuilAlerte }} unités</span>
                            </li>
                            <li>
                                <i class="fas fa-calendar-alt"></i>
                                <span>Expiration: {% if stock.dateExpiration %}{{ stock.dateExpiration|date('d/m/Y') }}{% else %}Non spécifiée{% endif %}</span>
                            </li>
                            <li>
                                <i class="fas fa-clock"></i>
                                <span>Mise à jour: {% if stock.dateDerniereMiseAJour %}{{ stock.dateDerniereMiseAJour|date('d/m/Y H:i') }}{% else %}Jamais{% endif %}</span>
                            </li>
                        </ul>
                        
                        <div style="margin-top: 1.5rem; display: flex; gap: 1rem; align-items: center;">
                            {% if stock.etatStock == 'disponible' %}
                                <span class="badge badge-success">
                                    <i class="fas fa-check-circle"></i> Disponible
                                </span>
                                <span style="color: var(--text-muted); font-size: 0.875rem;">
                                    <i class="fas fa-info-circle"></i> En stock
                                </span>
                            {% else %}
                                <span class="badge badge-warning">
                                    <i class="fas fa-exclamation-circle"></i> {{ stock.etatStock }}
                                </span>
                                <span style="color: var(--warning-color); font-size: 0.875rem; font-weight: 600;">
                                    <i class="fas fa-exclamation-triangle"></i> Attention
                                </span>
                            {% endif %}
                        </div>

                        {% if stock.dateExpiration and stock.dateExpiration < date('+30 days') %}
                        <div style="margin-top: 1rem; padding: 0.75rem; background: linear-gradient(135deg, #fff3cd, #ffeaa7); border-radius: 8px; border-left: 3px solid var(--warning-color);">
                            <div style="display: flex; align-items: center; gap: 0.5rem; color: #856404; font-size: 0.875rem; font-weight: 600;">
                                <i class="fas fa-clock"></i>
                                Expire bientôt ({{ stock.dateExpiration|date('d/m/Y') }})
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="fade-in-up" style="text-align: center; padding: 4rem 2rem; background: var(--light-color); border-radius: 20px; margin: 2rem 0;">
                <div style="width: 100px; height: 100px; background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 2rem;">
                    <i class="fas fa-boxes" style="font-size: 3rem; color: white;"></i>
                </div>
                <h3 style="color: var(--primary-color); margin-bottom: 1rem; font-size: 1.5rem;">Stocks en Cours de Mise à Jour</h3>
                <p style="color: var(--text-muted); margin-bottom: 2rem; font-size: 1.125rem;">
                    Nos stocks sont actuellement en cours de mise à jour pour garantir la fraîcheur et la qualité de nos produits.
                </p>
                <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                    <a href="{{ path('app_home') }}" class="btn-primary">
                        <i class="fas fa-home"></i> Retour à l'Accueil
                    </a>
                    <a href="{{ path('front_depots') }}" class="btn-outline">
                        <i class="fas fa-warehouse"></i> Voir les Dépôts
                    </a>
                </div>
            </div>
        {% endif %}

        <div class="fade-in-up" style="margin-top: 4rem; text-align: center;">
            <div style="background: linear-gradient(135deg, var(--info-color), #138496); color: white; padding: 3rem; border-radius: 20px; position: relative; overflow: hidden;">
                <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%23ffffff" fill-opacity="0.05" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,133.3C960,128,1056,96,1152,90.7C1248,85,1344,107,1392,117.3L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>') no-repeat bottom; background-size: cover;"></div>
                <div style="position: relative; z-index: 1;">
                    <h2 style="font-size: 2rem; margin-bottom: 1rem;">
                        <i class="fas fa-bell"></i> Alertes et Notifications
                    </h2>
                    <p style="font-size: 1.125rem; margin-bottom: 2rem; opacity: 0.9;">
                        Recevez des alertes automatiques lorsque les stocks atteignent les seuils critiques ou approchent de la date d'expiration
                    </p>
                    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                        <a href="{{ path('front_depots') }}" class="btn" style="background: white; color: var(--info-color);">
                            <i class="fas fa-warehouse"></i> Voir les Dépôts
                        </a>
                        <a href="#" class="btn-outline" style="border-color: white; color: white;">
                            <i class="fas fa-bell"></i> Configurer les Alertes
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
(() => {
  const items = document.querySelectorAll('.fade-in-up');
  if (!items.length) return;
  document.body.classList.add('reveal-ready');
  if (!('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-visible'));
    return;
  }
  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        obs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
  items.forEach((el) => observer.observe(el));
})();

(() => {
  const form = document.getElementById('stockAssistantForm');
  if (!form) return;
  const input = document.getElementById('stockAssistantInput');
  const result = document.getElementById('stockAssistantResult');

  const render = (data) => {
    const items = (data && data.prevision && data.prevision.items) ? data.prevision.items : [];
    let listHtml = '';
    if (items.length) {
      listHtml = '<ul class="assistant-list">' + items.map((item) => {
        if (data.intent === 'performance_depot') {
          return `<li><strong>${item.depot}</strong> | rotation ${item.rotation}% | rupture ${item.taux_rupture}% | volume ${item.volume_stock}</li>`;
        }
        if (data.intent === 'recommandation_commande') {
          return `<li><strong>${item.produit}</strong> (${item.depot}) - qte ${item.quantite} | recommander ${item.recommandation_commande}</li>`;
        }
        return `<li><strong>${item.produit}</strong> (${item.depot}) - rupture estimée ${item.date_rupture} (${item.jours_restants} j)</li>`;
      }).join('') + '</ul>';
    }

    result.innerHTML = `
      <h4>Analyse</h4>
      <div>${data.analysis || ''}</div>
      ${listHtml}
      <h4 style="margin-top:1rem">Recommandation</h4>
      <div>${data.recommendation || ''}</div>
    `;
    result.style.display = 'block';
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const question = (input.value || '').trim();
    if (!question) return;
    result.style.display = 'block';
    result.innerHTML = 'Analyse en cours...';

    try {
      const res = await fetch('{{ path('api_stock_assistant') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ question })
      });
      const data = await res.json();
      if (!data.ok) {
        result.innerHTML = data.message || 'Erreur de traitement.';
        return;
      }
      render(data);
    } catch (err) {
      result.innerHTML = 'Erreur reseau.';
    }
  });
})();
</script>
{% else %}
<div class="text-center py-5">
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i>
        <h4>Accès restreint</h4>
        <p>Vous devez être connecté en tant qu'administrateur pour accéder à cette page.</p>
    </div>
    <a href="{{ path('app_login') }}" class="btn btn-primary">
        <i class="fas fa-sign-in-alt"></i> Se connecter
    </a>
</div>
{% endif %}
{% endblock %}
