<!-- Indicateur de statut vocal -->
<div class="voice-status" id="voice-status">
    <div class="pulse-dot"></div>
    <span style="color: #10b981; font-weight: 600;">🎤 Écoute en cours... Parlez maintenant</span>
</div>

<script>
// ========================================
// 🎤 RECONNAISSANCE VOCALE WEB SPEECH API
// ========================================
(function() {
    console.log('=== INITIALISATION RECONNAISSANCE VOCALE ===');

    // Vérifier la compatibilité du navigateur
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

    if (!SpeechRecognition) {
        console.warn('⚠️ La reconnaissance vocale n\'est pas supportée par ce navigateur');
        // Masquer les boutons vocaux si non supporté
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.btn-voice').forEach(btn => {
                btn.style.display = 'none';
            });
        });
        return;
    }
    
    console.log('✓ Reconnaissance vocale supportée');
    
    // Créer une instance de reconnaissance vocale
    const recognition = new SpeechRecognition();
    recognition.lang = 'fr-FR'; // Langue française
    recognition.continuous = false; // Arrêt automatique après une phrase
    recognition.interimResults = false; // Pas de résultats intermédiaires
    recognition.maxAlternatives = 1;

    let currentInput = null;
    let currentButton = null;
    let isRecognizing = false; // Flag pour éviter les démarrages multiples

    // Fonction pour démarrer la reconnaissance
    function startVoiceRecognition(inputElement, buttonElement) {
        console.log('🎤 Tentative de démarrage de la reconnaissance vocale');
        
        // Vérifier si déjà en cours
        if (isRecognizing) {
            console.warn('⚠️ Reconnaissance déjà en cours, arrêt puis redémarrage');
            recognition.stop();
            setTimeout(() => {
                startVoiceRecognition(inputElement, buttonElement);
            }, 300);
            return;
        }
        
        currentInput = inputElement;
        currentButton = buttonElement;

        try {
            isRecognizing = true;
            recognition.start();
            buttonElement.classList.add('listening');
            const statusElement = document.getElementById('voice-status');
            if (statusElement) {
                statusElement.classList.add('active');
            }
            console.log('✓ Reconnaissance démarrée');
        } catch (error) {
            console.error('❌ Erreur lors du démarrage:', error);
            isRecognizing = false;
            buttonElement.classList.remove('listening');
            alert('Erreur: ' + error.message);
        }
    }

    // Événement: Résultat de la reconnaissance
    recognition.onresult = function(event) {
        console.log('✓ Résultat reçu');
        const transcript = event.results[0][0].transcript;
        console.log('Texte reconnu:', transcript);
        console.log('currentInput:', currentInput);
        console.log('currentInput existe?', !!currentInput);

        if (currentInput) {
            console.log('✓ currentInput trouvé, valeur actuelle:', currentInput.value);
            
            // Ajouter le texte au champ (ou remplacer si vide)
            if (currentInput.value.trim() === '') {
                currentInput.value = transcript;
                console.log('✓ Texte ajouté (champ vide)');
            } else {
                currentInput.value += ' ' + transcript;
                console.log('✓ Texte ajouté (champ non vide)');
            }
            
            console.log('✓ Nouvelle valeur:', currentInput.value);
            
            // Déclencher l'événement input pour la validation
            currentInput.dispatchEvent(new Event('input', { bubbles: true }));
            
            // Animation de succès
            currentInput.style.border = '3px solid #10b981';
            currentInput.style.background = '#d1fae5';
            setTimeout(() => {
                currentInput.style.border = '';
                currentInput.style.background = '';
            }, 1500);
        } else {
            console.error('❌ currentInput est null ou undefined!');
        }
    };

    // Événement: Fin de la reconnaissance
    recognition.onend = function() {
        console.log('🛑 Reconnaissance terminée');
        isRecognizing = false;
        if (currentButton) {
            currentButton.classList.remove('listening');
        }
        const statusElement = document.getElementById('voice-status');
        if (statusElement) {
            statusElement.classList.remove('active');
        }
    };

    // Événement: Erreur
    recognition.onerror = function(event) {
        console.error('❌ Erreur de reconnaissance:', event.error);
        isRecognizing = false;
        if (currentButton) {
            currentButton.classList.remove('listening');
        }
        const statusElement = document.getElementById('voice-status');
        if (statusElement) {
            statusElement.classList.remove('active');
        }

        let errorMessage = 'Erreur de reconnaissance vocale';
        switch(event.error) {
            case 'no-speech':
                errorMessage = 'Aucune parole détectée. Veuillez réessayer.';
                break;
            case 'audio-capture':
                errorMessage = 'Microphone non détecté. Vérifiez vos paramètres.';
                break;
            case 'not-allowed':
                errorMessage = 'Permission microphone refusée. Autorisez l\'accès au microphone.';
                break;
            case 'network':
                errorMessage = 'Erreur réseau. Vérifiez votre connexion internet.';
                break;
        }
        alert(errorMessage);
    };

    // Attacher les événements aux boutons
    document.addEventListener('DOMContentLoaded', function() {
        console.log('🎤 DOM chargé - Configuration des boutons vocaux');
        
        const btnVoiceAntecedents = document.getElementById('btn-voice-antecedents');
        const btnVoiceSymptomes = document.getElementById('btn-voice-symptomes');
        
        // Chercher les inputs par leur attribut name (généré par Symfony)
        const antecedentsInput = document.querySelector('textarea[name="demande_traitement[antecedentsMedicaux]"]');
        const symptomesInput = document.querySelector('textarea[name="demande_traitement[symptomes]"]');

        console.log('Éléments trouvés:', {
            btnVoiceAntecedents: !!btnVoiceAntecedents,
            btnVoiceSymptomes: !!btnVoiceSymptomes,
            antecedentsInput: !!antecedentsInput,
            symptomesInput: !!symptomesInput
        });

        if (antecedentsInput) {
            console.log('ID réel antecedents:', antecedentsInput.id);
        }
        if (symptomesInput) {
            console.log('ID réel symptomes:', symptomesInput.id);
        }

        if (btnVoiceAntecedents && antecedentsInput) {
            btnVoiceAntecedents.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('🎤 Clic sur bouton antécédents');
                startVoiceRecognition(antecedentsInput, btnVoiceAntecedents);
            });
            console.log('✓ Bouton vocal antécédents configuré');
        } else {
            console.error('❌ Bouton ou input antécédents non trouvé');
            if (!btnVoiceAntecedents) console.error('  - Bouton manquant');
            if (!antecedentsInput) console.error('  - Input manquant');
        }

        if (btnVoiceSymptomes && symptomesInput) {
            btnVoiceSymptomes.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('🎤 Clic sur bouton symptômes');
                startVoiceRecognition(symptomesInput, btnVoiceSymptomes);
            });
            console.log('✓ Bouton vocal symptômes configuré');
        } else {
            console.error('❌ Bouton ou input symptômes non trouvé');
            if (!btnVoiceSymptomes) console.error('  - Bouton manquant');
            if (!symptomesInput) console.error('  - Input manquant');
        }
    });

    console.log('=== FIN INITIALISATION RECONNAISSANCE VOCALE ===');
})();
</script>

<!-- ========================================
     🔍 DÉTECTION INTERACTIONS MÉDICAMENTEUSES
     ======================================== -->
<script>
(function() {
    console.log('=== INITIALISATION DÉTECTION INTERACTIONS ===');

    document.addEventListener('DOMContentLoaded', function() {
        const formDemande = document.querySelector('form[name="demande_traitement"]');
        const submitBtn = document.getElementById('submitBtnDemande');
        
        if (!formDemande || !submitBtn) {
            console.error('❌ Formulaire ou bouton submit introuvable');
            return;
        }

        console.log('✓ Formulaire trouvé, interception de la soumission');

        // Intercepter la soumission du formulaire
        formDemande.addEventListener('submit', async function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            console.log('🔍 Soumission interceptée - Vérification des interactions...');

            // Récupérer les données du formulaire
            const produitSelect = document.querySelector('select[name="demande_traitement[produit]"]');
            const symptomesInput = document.querySelector('textarea[name="demande_traitement[symptomes]"]');
            const antecedentsInput = document.querySelector('textarea[name="demande_traitement[antecedentsMedicaux]"]');

            if (!produitSelect || !symptomesInput || !antecedentsInput) {
                console.error('❌ Champs manquants');
                formDemande.submit();
                return;
            }

            const produitId = produitSelect.value;
            const symptomes = symptomesInput.value.trim();
            const antecedents = antecedentsInput.value.trim();

            if (!produitId || !symptomes || !antecedents) {
                console.log('⚠️ Données incomplètes, soumission directe');
                formDemande.submit();
                return;
            }

            // Désactiver le bouton pendant la vérification
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Vérification des interactions...';

            try {
                console.log('📡 Envoi requête API vérification interactions');
                
                const response = await fetch('{{ path('app_verifier_interactions') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        produit_id: produitId,
                        symptomes: symptomes,
                        antecedents: antecedents
                    })
                });

                const data = await response.json();
                console.log('📥 Réponse reçue:', data);

                if (data.success && data.analyse) {
                    const analyse = data.analyse;
                    
                    // Si dangereux ou risque élevé/critique
                    if (analyse.dangereux || analyse.niveau_risque === 'élevé' || analyse.niveau_risque === 'critique') {
                        console.warn('⚠️ ALERTE: Interaction dangereuse détectée!');
                        
                        // Construire le message d'alerte
                        let alertMessage = '⚠️ ALERTE MÉDICAMENTEUSE\n\n';
                        alertMessage += `Niveau de risque: ${analyse.niveau_risque.toUpperCase()}\n\n`;
                        
                        if (analyse.raisons && analyse.raisons.length > 0) {
                            alertMessage += 'Problèmes détectés:\n';
                            analyse.raisons.forEach((raison, index) => {
                                alertMessage += `${index + 1}. ${raison}\n`;
                            });
                            alertMessage += '\n';
                        }
                        
                        alertMessage += `Recommandation: ${analyse.recommandation}\n\n`;
                        
                        if (analyse.peut_continuer) {
                            alertMessage += 'Voulez-vous continuer malgré cet avertissement?';
                        } else {
                            alertMessage += '❌ VOUS NE POUVEZ PAS CONTINUER.\nVeuillez consulter un médecin avant de prendre ce médicament.';
                        }

                        // Afficher l'alerte
                        const continuer = analyse.peut_continuer ? confirm(alertMessage) : (alert(alertMessage), false);
                        
                        if (continuer) {
                            console.log('✓ Utilisateur a accepté de continuer malgré l\'alerte');
                            formDemande.submit();
                        } else {
                            console.log('🛑 Utilisateur a annulé la soumission');
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> Envoyer la demande';
                        }
                    } else {
                        // Pas de danger détecté
                        console.log('✓ Aucune interaction dangereuse détectée');
                        
                        if (analyse.niveau_risque === 'moyen') {
                            const message = `ℹ️ Information:\n\n${analyse.recommandation}\n\nVoulez-vous continuer?`;
                            if (confirm(message)) {
                                formDemande.submit();
                            } else {
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> Envoyer la demande';
                            }
                        } else {
                            formDemande.submit();
                        }
                    }
                } else {
                    console.warn('⚠️ Erreur analyse, soumission directe');
                    formDemande.submit();
                }

            } catch (error) {
                console.error('❌ Erreur lors de la vérification:', error);
                alert('Erreur lors de la vérification des interactions. La demande sera soumise sans vérification.');
                formDemande.submit();
            }
        });

        console.log('✓ Détection des interactions configurée');
    });

    console.log('=== FIN INITIALISATION DÉTECTION INTERACTIONS ===');
})();
</script>

