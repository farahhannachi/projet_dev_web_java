{% extends 'front/_base.html.twig' %}

{% block title %}Nos Dépôts - CuraVita{% endblock %}

{% block main %}
<div class="container" style="padding: 4rem 1rem;">
    <h1 class="text-center mb-12 text-primary">Nos Dépôts</h1>

    <!-- Section Filtres -->
    <div class="filters-section mb-8">
        <div class="filters-container">
            <form method="GET" action="{{ path('front_depots') }}" class="filters-form">
                <div class="filters-grid">
                    <!-- Recherche -->
                    <div class="filter-group">
                        <input type="text" 
                               name="search" 
                               placeholder="Rechercher un dépôt..." 
                               value="{{ filters.search }}"
                               class="filter-input">
                    </div>
                    
                    <!-- Ville -->
                    <div class="filter-group">
                        <select name="ville" class="filter-select">
                            <option value="all" {{ filters.ville == 'all' or not filters.ville ? 'selected' : '' }}>
                                Toutes les villes
                            </option>
                            {% for ville in villes %}
                                <option value="{{ ville }}" 
                                        {{ filters.ville == ville ? 'selected' : '' }}>
                                    {{ ville }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <!-- Capacité Minimum -->
                    <div class="filter-group">
                        <input type="number" 
                               name="capacite_min" 
                               placeholder="Capacité min" 
                               value="{{ filters.capacite_min }}"
                               min="0"
                               class="filter-input">
                    </div>
                    
                    <!-- Capacité Maximum -->
                    <div class="filter-group">
                        <input type="number" 
                               name="capacite_max" 
                               placeholder="Capacité max" 
                               value="{{ filters.capacite_max }}"
                               min="0"
                               class="filter-input">
                    </div>
                    
                    <!-- Tri -->
                    <div class="filter-group">
                        <select name="sort" class="filter-select">
                            <option value="name" {{ filters.sort == 'name' ? 'selected' : '' }}>
                                Nom (A-Z)
                            </option>
                            <option value="capacity_desc" {{ filters.sort == 'capacity_desc' ? 'selected' : '' }}>
                                Capacité décroissante
                            </option>
                            <option value="capacity_asc" {{ filters.sort == 'capacity_asc' ? 'selected' : '' }}>
                                Capacité croissante
                            </option>
                            <option value="date_desc" {{ filters.sort == 'date_desc' ? 'selected' : '' }}>
                                Date récente
                            </option>
                            <option value="date_asc" {{ filters.sort == 'date_asc' ? 'selected' : '' }}>
                                Date ancienne
                            </option>
                        </select>
                    </div>
                    
                    <!-- Boutons -->
                    <div class="filter-actions">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-filter"></i> Filtrer
                        </button>
                        <a href="{{ path('front_depots') }}" class="btn btn-secondary btn-sm">
                            <i class="fas fa-times"></i> Réinitialiser
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {% if depots|length > 0 %}
<style>
    .hero-section {
        background: linear-gradient(135deg, #16563f 0%, #0f3d2a 100%);
        color: white;
        padding: 4rem 0 3rem;
        position: relative;
        overflow: hidden;
    }
    .hero-section::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%23ffffff" fill-opacity="0.1" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,133.3C960,128,1056,96,1152,90.7C1248,85,1344,107,1392,117.3L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>') no-repeat bottom;
        background-size: cover;
    }
    .hero-content { text-align: center; position: relative; z-index: 1; }
    .hero-content h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; }
    .hero-content p { font-size: 1.125rem; opacity: 0.9; }
    .content-section { background: white; padding: 4rem 0; }
    .section-header { text-align: center; margin-bottom: 3rem; }
    .section-header h2 { font-size: 2rem; font-weight: 700; color: #16563f; margin-bottom: 1rem; }
    .section-header p { font-size: 1rem; color: #6c757d; max-width: 600px; margin: 0 auto; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; margin: 3rem 0; }
    .stat-card { background: white; padding: 2rem; border-radius: 16px; box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1); text-align: center; position: relative; overflow: hidden; transition: all 0.3s ease; }
    .stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #16563f, #28a745); }
    .stat-card:hover { transform: translateY(-5px); box-shadow: 0 1rem 2rem rgba(0,0,0,0.15); }
    .stat-icon { width: 60px; height: 60px; background: linear-gradient(135deg, #16563f, #28a745); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; }
    .stat-icon i { font-size: 1.5rem; color: white; }
    .stat-number { font-size: 2rem; font-weight: 700; color: #16563f; margin-bottom: 0.25rem; }
    .stat-label { font-size: 0.9rem; color: #6c757d; font-weight: 600; }
    .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 2rem; }
    .info-card { background: white; border-radius: 16px; padding: 1.5rem; box-shadow: 0 0.25rem 0.5rem rgba(0,0,0,0.1); border: 1px solid #e9ecef; transition: all 0.3s ease; }
    .info-card:hover { transform: translateY(-3px); box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15); }
    .card-header { display: flex; align-items: center; margin-bottom: 1rem; }
    .card-icon { width: 50px; height: 50px; background: linear-gradient(135deg, #16563f, #28a745); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 1rem; }
    .card-icon i { font-size: 1.25rem; color: white; }
    .card-title { font-size: 1.1rem; font-weight: 600; color: #16563f; }
    .card-subtitle { color: #6c757d; font-size: 0.8rem; }
    .info-list { list-style: none; padding: 0; margin: 0; }
    .info-list li { padding: 0.5rem 0; border-bottom: 1px solid #e9ecef; display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; }
    .info-list li:last-child { border-bottom: none; }
    .info-list i { color: #16563f; width: 18px; text-align: center; }
    .badge { display: inline-block; padding: 0.35rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
    .badge-success { background: #28a745; color: white; }
    .badge-warning { background: #ffc107; color: #212529; }
    .btn-primary { background: linear-gradient(135deg, #16563f, #28a745); color: white; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; transition: all 0.3s ease; }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.2); }
    .btn-outline { background: transparent; color: #16563f; border: 2px solid #16563f; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; transition: all 0.3s ease; }
    .btn-outline:hover { background: #16563f; color: white; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
</style>
{% endblock %}

{% block main %}
{% if app.user and 'ROLE_ADMIN' in app.user.roles %}
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <h1><i class="fas fa-warehouse"></i> Nos Dépôts Pharmaceutiques</h1>
            <p>Découvrez notre réseau de dépôts modernes et sécurisés pour une gestion optimale de vos médicaments</p>
        </div>
    </div>
</section>

<section class="content-section">
    <div class="container">
        <div class="section-header">
            <h2>Infrastructure de Stockage</h2>
            <p>Des dépôts stratégiquement positionnés pour garantir la disponibilité et la qualité de nos produits</p>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-warehouse"></i>
                </div>
                <div class="stat-number">{{ depots|length }}</div>
                <div class="stat-label">Dépôts Actifs</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-boxes"></i>
                </div>
                <div class="stat-number">{{ depots|reduce((carry, depot) => carry + depot.capaciteDepot, 0) }}</div>
                <div class="stat-label">Capacité Totale</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <div class="stat-number">100%</div>
                <div class="stat-label">Sécurité</div>
            </div>
        </div>

        {% if depots|length > 0 %}
            <div class="cards-grid">
                {% for depot in depots %}
                <div class="info-card">
                    <div class="card-header">
                        <div class="card-icon">
                            <i class="fas fa-warehouse"></i>
                        </div>
                        <div>
                            <div class="card-title">{{ depot.nomDepot }}</div>
                            <div class="card-subtitle">Dépôt #{{ depot.id }}</div>
                        </div>
                    </div>
                    
                    <div class="card-content">
                        <ul class="info-list">
                            <li>
                                <i class="fas fa-map-marker-alt"></i>
                                <span>{{ depot.adresseDepot }}</span>
                            </li>
                            <li>
                                <i class="fas fa-boxes"></i>
                                <span>Capacité: {{ depot.capaciteDepot }} unités</span>
                            </li>
                            <li>
                                <i class="fas fa-user-tie"></i>
                                <span>Responsable: {{ depot.responsableDepot }}</span>
                            </li>
                            <li>
                                <i class="fas fa-calendar"></i>
                                <span>Créé le: {{ depot.dateCreation ? depot.dateCreation|date('d/m/Y') : 'N/A' }}</span>
                            </li>
                        </ul>
                        
                        <div style="margin-top: 1.5rem; display: flex; gap: 1rem; align-items: center;">
                            <span class="badge badge-success">
                                <i class="fas fa-check-circle"></i> Opérationnel
                            </span>
                            <span style="color: var(--text-muted); font-size: 0.875rem;">
                                <i class="fas fa-info-circle"></i> Disponible 24/7
                            </span>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% else %}
            <div style="text-align: center; padding: 4rem 2rem; background: var(--light-color); border-radius: 20px; margin: 2rem 0;">
                <div style="width: 100px; height: 100px; background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 2rem;">
                    <i class="fas fa-warehouse" style="font-size: 3rem; color: white;"></i>
                </div>
                <h3 style="color: var(--primary-color); margin-bottom: 1rem; font-size: 1.5rem;">Dépôts en Cours de Configuration</h3>
                <p style="color: var(--text-muted); margin-bottom: 2rem; font-size: 1.125rem;">
                    Nos dépôts sont actuellement en cours de configuration pour vous offrir le meilleur service possible.
                </p>
                <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                    <a href="{{ path('app_home') }}" class="btn-primary">
                        <i class="fas fa-home"></i> Retour à l'Accueil
                    </a>
                    <a href="{{ path('app_products') }}" class="btn-outline">
                        <i class="fas fa-boxes"></i> Voir les Stocks
                    </a>
                </div>
            </div>
        {% endif %}

        <div style="margin-top: 4rem; text-align: center;">
            <div style="background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); color: white; padding: 3rem; border-radius: 20px; position: relative; overflow: hidden;">
                <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%23ffffff" fill-opacity="0.05" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,133.3C960,128,1056,96,1152,90.7C1248,85,1344,107,1392,117.3L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>') no-repeat bottom; background-size: cover;"></div>
                <div style="position: relative; z-index: 1;">
                    <h2 style="font-size: 2rem; margin-bottom: 1rem;">
                        <i class="fas fa-truck"></i> Livraison Rapide et Sécurisée
                    </h2>
                    <p style="font-size: 1.125rem; margin-bottom: 2rem; opacity: 0.9;">
                        Notre réseau de dépôts garantit une livraison rapide de vos commandes dans toute la France
                    </p>
                    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                        <a href="{{ path('app_products') }}" class="btn" style="background: white; color: var(--primary-color);">
                            <i class="fas fa-boxes"></i> Consulter les Stocks
                        </a>
                        <a href="#" class="btn-outline" style="border-color: white; color: white;">
                            <i class="fas fa-phone"></i> Nous Contacter
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% else %}
<div class="text-center py-5">
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i>
        <h4>Accès restreint</h4>
        <p>Vous devez être connecté en tant qu'administrateur pour accéder à cette page.</p>
    </div>
    <a href="{{ path('app_login') }}" class="btn btn-primary">
        <i class="fas fa-sign-in-alt"></i> Se connecter
    </a>
</div>
{% endif %}
{% endblock %}
