{% extends 'front/_base.html.twig' %}

{% block title %}Commande - CURAVITA{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<style>
.checkout-wrap{max-width:1200px;margin:2rem auto;padding:0 1rem;display:grid;grid-template-columns:1.2fr .8fr;gap:1rem}
@media(max-width:960px){.checkout-wrap{grid-template-columns:1fr}}
.block{background:#fff;border:1px solid #d9ece3;border-radius:16px;box-shadow:0 12px 30px rgba(12,53,41,.08)}
.block h2{margin:0;padding:1rem 1rem .2rem;color:#114a39}
.form{padding:0 1rem 1rem;display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
.form .full{grid-column:1/-1}
.input,.textarea,select{width:100%;padding:.78rem .85rem;border:1px solid #cce2d8;border-radius:10px}
.textarea{min-height:90px;resize:vertical}
.radio{display:flex;gap:1rem;flex-wrap:wrap;background:#f3faf6;border:1px solid #d5ecdf;padding:.7rem .8rem;border-radius:10px}
.btn{border:0;border-radius:10px;padding:.8rem .9rem;font-weight:700;cursor:pointer}
.btn-primary{background:linear-gradient(135deg,#0f5e43,#1ca16f);color:#fff}
.coupon-box{background:#f5fbf7;border:1px solid #d5ecdf;border-radius:12px;padding:.75rem}
.coupon-title{font-weight:800;color:#13513e;margin:0 0 .4rem}
.coupon-help{font-size:.82rem;color:#4c7163;margin-top:.35rem}
.coupon-error{display:inline-block;margin-top:.45rem;padding:.32rem .55rem;border-radius:999px;background:#fee2e2;color:#9f1d1d;font-size:.78rem;font-weight:700}
.field-error{display:block;margin-top:.3rem;color:#9f1d1d;font-size:.82rem}
.map-tools{grid-column:1/-1;background:#f5fbf7;border:1px solid #d5ecdf;border-radius:12px;padding:.8rem}
.map-head{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center}
.map-search-wrap{position:relative;flex:1;min-width:260px}
.map-search-icon{position:absolute;left:.75rem;top:50%;transform:translateY(-50%);font-size:.95rem;opacity:.62;pointer-events:none}
.map-search{
  width:100%;
  padding:.73rem .85rem .73rem 2.05rem;
  border:1.5px solid #b8dacc;
  border-radius:11px;
  background:linear-gradient(180deg,#ffffff 0%,#f8fcfa 100%);
  box-shadow:0 5px 14px rgba(14,88,62,.06);
  transition:.2s ease;
}
.map-search:focus{
  outline:none;
  border-color:#159a69;
  box-shadow:0 0 0 3px rgba(21,154,105,.14), 0 10px 20px rgba(21,154,105,.08);
}
.map-btn{background:#0f5f45;color:#fff;border:0;border-radius:10px;padding:.68rem .9rem;font-weight:700;cursor:pointer}
.suggestions{margin-top:.5rem;max-height:170px;overflow:auto;border:1px solid #cfe2d9;border-radius:10px;background:#fff}
.suggestion{padding:.55rem .7rem;cursor:pointer;border-bottom:1px solid #edf4f0}
.suggestion:last-child{border-bottom:0}
.suggestion:hover{background:#f1faf5}
#checkoutMap{height:260px;margin-top:.7rem;border:1px solid #cfe2d9;border-radius:12px}
.address-field{position:relative}
.address-field .pin{position:absolute;left:.8rem;top:50%;transform:translateY(-50%);font-size:1rem;opacity:.65;pointer-events:none}
.address-field .input{
  padding-left:2.15rem;
  border:1.5px solid #b7d9ca;
  background:linear-gradient(180deg,#ffffff 0%,#f8fcfa 100%);
  box-shadow:0 4px 12px rgba(14,88,62,.06);
}
.address-field .input:focus{
  border-color:#159a69;
  box-shadow:0 0 0 3px rgba(21,154,105,.15), 0 10px 22px rgba(21,154,105,.09);
}
.summary{padding:1rem}
.line{display:flex;justify-content:space-between;padding:.55rem 0;border-bottom:1px dashed #e2eee8}
.total{font-weight:800;color:#0f4334}
.item{display:grid;grid-template-columns:52px 1fr auto;gap:.55rem;align-items:center;padding:.55rem 0;border-bottom:1px solid #ecf3ef}
.item img{width:52px;height:52px;border-radius:8px;object-fit:cover}
.flash{max-width:1200px;margin:1rem auto 0;padding:0 1rem}
.flash .m{padding:.8rem 1rem;border-radius:10px;margin:.5rem 0}.s{background:#dbfaea;color:#0b6640}.e{background:#fee2e2;color:#9f1d1d}

</style>
{% endblock %}

{% block main %}
<div class="flash">
{% for message in app.flashes('success') %}<div class="m s">{{ message }}</div>{% endfor %}
{% for message in app.flashes('error') %}<div class="m e">{{ message }}</div>{% endfor %}
</div>

<div class="checkout-wrap">
    <section class="block">
        <h2>Coordonnees de livraison</h2>
        <form method="post" class="form" id="checkoutForm" novalidate>
            <div class="field-error" data-form-error style="display:none"></div>
            <div><label>Nom complet</label><input class="input" name="nom" required value="{{ prefill.nom }}"></div>
            <div><label>Email</label><input class="input" type="email" name="email" required value="{{ prefill.email }}"></div>
            <div><label>Telephone</label><input class="input" name="telephone" required value="{{ prefill.telephone }}"></div>
            <div>
                <label>Adresse enregistree (optionnel)</label>
                <select class="input" name="address_id">
                    <option value="">Selectionner...</option>
                    {% for address in addresses %}
                        <option value="{{ address.id }}" {% if prefill.address_id|default('') == address.id %}selected{% endif %}>
                            {{ address.fullName }} - {{ address.toSingleLine }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="map-tools">
                <div class="map-head">
                    <div class="map-search-wrap">
                        <span class="map-search-icon">🔎</span>
                        <input type="text" id="checkoutGeoSearch" class="map-search" placeholder="Rechercher votre adresse...">
                    </div>
                    <button type="button" class="map-btn" id="checkoutUseMyLocation">Utiliser ma localisation</button>
                </div>
                <div id="checkoutGeoSuggestions" class="suggestions" style="display:none"></div>
                <div id="checkoutMap"></div>
            </div>
            <div class="address-field">
                <label>Adresse de livraison</label>
                <span class="pin">📍</span>
                <input class="input" name="adresse_livraison" required value="{{ prefill.adresse_livraison }}" placeholder="Rue, ville, code postal, pays">
            </div>
            <div class="full"><label>Message</label><textarea class="textarea" name="message">{{ prefill.message }}</textarea></div>
            <div class="full coupon-box">
                <p class="coupon-title">Code promo</p>
                <input class="input" name="coupon_code" value="{{ prefill.coupon_code|default('') }}" placeholder="EX: CURA10">
                <div class="coupon-help">Ajoute ton coupon puis clique sur continuer pour l'appliquer.</div>
                {% if pricing.couponMessage is defined and pricing.couponCode and not pricing.couponValid %}
                    <span class="coupon-error">{{ pricing.couponMessage }}</span>
                {% endif %}
            </div>
            <div class="full">
                <label>Methode de paiement</label>
                <div class="radio">
                    <label><input type="radio" name="mode_paiement" value="livraison" {% if prefill.mode_paiement != 'en_ligne' %}checked{% endif %}> Paiement a la livraison</label>
                    <label><input type="radio" name="mode_paiement" value="en_ligne" {% if prefill.mode_paiement == 'en_ligne' %}checked{% endif %}> Paiement en ligne</label>
                </div>
            </div>
            <div class="full"><button class="btn btn-primary" type="submit">Continuer</button></div>
        </form>
    </section>

    <aside class="block summary">
        <h2 style="padding:0 0 .7rem 0">Recapitulatif panier</h2>
        {% for item in panier.items %}
            {% set imageSrc = item.image ? ((item.image starts with 'http://') or (item.image starts with 'https://') ? item.image : asset('uploads/produits/' ~ item.image)) : asset('assets/img/default-product.png') %}
            <div class="item">
                <img src="{{ imageSrc }}" alt="{{ item.name }}">
                <div><strong>{{ item.name }}</strong><div>{{ item.quantity }} x {{ item.price|number_format(2, ',', ' ') }} DT</div></div>
                <strong>{{ item.lineTotal|number_format(2, ',', ' ') }} DT</strong>
            </div>
        {% else %}
            <p>Panier vide</p>
        {% endfor %}
        <div class="line"><span>Articles</span><strong>{{ panier.count }}</strong></div>
        <div class="line"><span>Sous-total</span><span>{{ pricing.subTotal|default(panier.total)|number_format(2, ',', ' ') }} DT</span></div>
        {% if pricing.loyaltyDiscount|default(0) > 0 %}
            <div class="line"><span>Remise fidelite ({{ pricing.loyaltyLevel }})</span><strong>-{{ pricing.loyaltyDiscount|number_format(2, ',', ' ') }} DT</strong></div>
        {% endif %}
        {% if pricing.couponDiscount|default(0) > 0 %}
            <div class="line"><span>Coupon {{ pricing.couponCode }}</span><strong>-{{ pricing.couponDiscount|number_format(2, ',', ' ') }} DT</strong></div>
        {% endif %}
        <div class="line total"><span>Total</span><span>{{ pricing.grandTotal|default(panier.total)|number_format(2, ',', ' ') }} DT</span></div>
    </aside>
</div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
(() => {
  const form = document.getElementById('checkoutForm');
  if (!form) return;
  const addressInput = form.querySelector('[name="adresse_livraison"]');
  const searchInput = document.getElementById('checkoutGeoSearch');
  const suggestions = document.getElementById('checkoutGeoSuggestions');
  const useMyLocationBtn = document.getElementById('checkoutUseMyLocation');
  const selectedAddress = form.querySelector('[name="address_id"]');

  const map = L.map('checkoutMap').setView([36.8065, 10.1815], 11);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);
  const marker = L.marker([36.8065, 10.1815], { draggable: true }).addTo(map);

  const setAddressFromResult = (item) => {
    if (addressInput) {
      addressInput.value = item.display_name || '';
    }
    if (selectedAddress) {
      selectedAddress.value = '';
    }
  };

  const reverseLookup = async (lat, lon) => {
    const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&addressdetails=1&lat=${lat}&lon=${lon}`);
    const data = await res.json();
    if (data && addressInput) {
      addressInput.value = data.display_name || '';
    }
  };

  marker.on('dragend', async () => {
    const p = marker.getLatLng();
    map.panTo(p);
    await reverseLookup(p.lat, p.lng);
  });

  let geoTimer = null;
  const searchAddress = async (query) => {
    if (!query || query.trim().length < 3) {
      suggestions.style.display = 'none';
      suggestions.innerHTML = '';
      return;
    }
    const res = await fetch(`https://nominatim.openstreetmap.org/search?format=jsonv2&addressdetails=1&limit=6&q=${encodeURIComponent(query)}`);
    const list = await res.json();
    if (!Array.isArray(list) || list.length === 0) {
      suggestions.style.display = 'none';
      suggestions.innerHTML = '';
      return;
    }

    suggestions.innerHTML = list.map((item, idx) => `<div class="suggestion" data-idx="${idx}">${item.display_name}</div>`).join('');
    suggestions.style.display = 'block';

    suggestions.querySelectorAll('.suggestion').forEach(el => {
      el.addEventListener('click', () => {
        const item = list[Number(el.dataset.idx)];
        const lat = Number(item.lat), lon = Number(item.lon);
        map.setView([lat, lon], 16);
        marker.setLatLng([lat, lon]);
        setAddressFromResult(item);
        suggestions.style.display = 'none';
      });
    });
  };

  searchInput?.addEventListener('input', () => {
    clearTimeout(geoTimer);
    geoTimer = setTimeout(() => searchAddress(searchInput.value), 350);
  });

  useMyLocationBtn?.addEventListener('click', () => {
    if (!navigator.geolocation) return;
    navigator.geolocation.getCurrentPosition(async (pos) => {
      const lat = pos.coords.latitude;
      const lon = pos.coords.longitude;
      map.setView([lat, lon], 16);
      marker.setLatLng([lat, lon]);
      await reverseLookup(lat, lon);
      if (selectedAddress) selectedAddress.value = '';
    });
  });

  selectedAddress?.addEventListener('change', async () => {
    const selectedOption = selectedAddress.options[selectedAddress.selectedIndex];
    if (!selectedOption || !selectedOption.value) return;
    const label = selectedOption.textContent || '';
    const parts = label.split(' - ');
    const candidate = parts.length > 1 ? parts.slice(1).join(' - ').trim() : label.trim();
    if (candidate && addressInput) {
      addressInput.value = candidate;
      await searchAddress(candidate);
    }
  });

  const clearErrors = () => {
    form.querySelectorAll('.field-error.js').forEach(el => el.remove());
    form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
    const global = form.querySelector('[data-form-error]');
    if (global) { global.style.display = 'none'; global.textContent = ''; }
  };

  const showErrors = (errors) => {
    const global = form.querySelector('[data-form-error]');
    Object.entries(errors || {}).forEach(([field, messages]) => {
      const msg = Array.isArray(messages) && messages.length ? messages[0] : 'Valeur invalide';
      if (field === '_form') {
        if (global) { global.style.display = 'block'; global.textContent = msg; }
        return;
      }
      const inputName = field === 'adresse' ? 'adresse_livraison' : field;
      const input = form.querySelector(`[name="${inputName}"]`);
      if (!input) return;
      input.classList.add('is-invalid');
      const err = document.createElement('small');
      err.className = 'field-error js';
      err.textContent = msg;
      input.insertAdjacentElement('afterend', err);
    });
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();
    const res = await fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });
    const payload = await res.json().catch(() => ({}));
    if (!res.ok || payload.ok === false) {
      showErrors(payload.errors || { _form: ['Donnees invalides.'] });
      return;
    }
    window.location.href = payload.redirect_url || window.location.href;
  });
})();
</script>
{% endblock %}
