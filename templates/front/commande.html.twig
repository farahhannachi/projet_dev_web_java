{% extends 'front/_base.html.twig' %}

{% block title %}Commande - CURAVITA{% endblock %}

{% block main %}
<section class="py-12">
    <div class="container">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold mb-4" style="color: var(--primary-color);">Passer une Commande</h1>
            <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
                Commandez vos produits pharmaceutiques en toute simplicité et sécurité
            </p>
        </div>

        <div class="max-w-3xl mx-auto">
            {% for message in app.flashes('success') %}
                <div style="padding: 1rem 1.5rem; background: #d1fae5; border: 2px solid #10b981; color: #065f46; border-radius: 12px; margin-bottom: 2rem; text-align: center; font-weight: 500;">
                    <i class="fas fa-check-circle"></i> {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div style="padding: 1rem 1.5rem; background: #fee2e2; border: 2px solid #ef4444; color: #991b1b; border-radius: 12px; margin-bottom: 2rem; text-align: center; font-weight: 500;">
                    <i class="fas fa-exclamation-circle"></i> {{ message }}
                </div>
            {% endfor %}

            <!-- Formulaire de commande -->
            <div class="bg-white rounded-xl shadow-lg p-8">
                <h2 class="text-2xl font-bold mb-6" style="color: var(--primary-color);">Informations de commande</h2>
                
                {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            {{ form_label(form.nom, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                            {{ form_widget(form.nom, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent', 'placeholder': 'Votre nom'}}) }}
                            {% if form.nom.vars.errors|length > 0 %}
                                <div style="color: #dc2626; font-size: 0.875rem; margin-top: 0.5rem;">
                                    <i class="fas fa-exclamation-triangle"></i> {{ form_errors(form.nom) }}
                                </div>
                            {% endif %}
                        </div>
                        <div>
                            {{ form_label(form.telephone, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                            {{ form_widget(form.telephone, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent', 'placeholder': 'Votre téléphone'}}) }}
                            {% if form.telephone.vars.errors|length > 0 %}
                                <div style="color: #dc2626; font-size: 0.875rem; margin-top: 0.5rem;">
                                    <i class="fas fa-exclamation-triangle"></i> {{ form_errors(form.telephone) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    
                    <div>
                        {{ form_label(form.adresseLivraison, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                        {{ form_widget(form.adresseLivraison, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent', 'placeholder': 'Votre adresse complète'}}) }}
                        {% if form.adresseLivraison.vars.errors|length > 0 %}
                            <div style="color: #dc2626; font-size: 0.875rem; margin-top: 0.5rem;">
                                <i class="fas fa-exclamation-triangle"></i> {{ form_errors(form.adresseLivraison) }}
                            </div>
                        {% endif %}
                    </div>
                    
                    <div>
                        {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                        {{ form_widget(form.email, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent', 'placeholder': 'votre@email.com'}}) }}
                        {% if form.email.vars.errors|length > 0 %}
                            <div style="color: #dc2626; font-size: 0.875rem; margin-top: 0.5rem;">
                                <i class="fas fa-exclamation-triangle"></i> {{ form_errors(form.email) }}
                            </div>
                        {% endif %}
                    </div>
                    
                    <div>
                        {{ form_label(form.modePaiement, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                        {{ form_widget(form.modePaiement, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent'}}) }}
                        {% if form.modePaiement.vars.errors|length > 0 %}
                            <div style="color: #dc2626; font-size: 0.875rem; margin-top: 0.5rem;">
                                <i class="fas fa-exclamation-triangle"></i> {{ form_errors(form.modePaiement) }}
                            </div>
                        {% endif %}
                    </div>
                    
                    <div>
                        {{ form_label(form.message, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                        {{ form_widget(form.message, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent', 'placeholder': 'Instructions spéciales ou commentaires...'}}) }}
                        {% if form.message.vars.errors|length > 0 %}
                            <div style="color: #dc2626; font-size: 0.875rem; margin-top: 0.5rem;">
                                <i class="fas fa-exclamation-triangle"></i> {{ form_errors(form.message) }}
                            </div>
                        {% endif %}
                    </div>
                    
                    <button type="submit" class="w-full btn btn-primary">
                        <i class="fas fa-shopping-cart mr-2"></i> Valider la commande
                    </button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</section>
{% endblock %}
