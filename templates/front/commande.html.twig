{% extends 'front/_base.html.twig' %}

{% block title %}Commande - CURAVITA{% endblock %}

{% block main %}
<section class="py-12">
    <div class="container">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold mb-4" style="color: var(--primary-color);">Passer une Commande</h1>
            <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
                Commandez vos produits pharmaceutiques en toute simplicité et sécurité
            </p>
        </div>

        <div class="grid md:grid-cols-2 gap-12 max-w-6xl mx-auto">
            <!-- Formulaire de commande -->
            <div class="bg-white rounded-xl shadow-lg p-8">
                <h2 class="text-2xl font-bold mb-6" style="color: var(--primary-color);">Informations de commande</h2>
                
                <form class="space-y-6" novalidate>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium mb-2">Nom complet *</label>
                            <input type="text" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="Votre nom">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Téléphone *</label>
                            <input type="tel" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="Votre téléphone">
                        </div>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium mb-2">Adresse de livraison *</label>
                        <input type="text" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="Votre adresse complète">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium mb-2">Email *</label>
                        <input type="email" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="votre@email.com">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium mb-2">Mode de paiement *</label>
                        <select class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                            <option value="">Choisir un mode de paiement</option>
                            <option value="carte">Carte bancaire</option>
                            <option value="espece">Espèces à la livraison</option>
                            <option value="cheque">Chèque</option>
                        </select>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium mb-2">Message (optionnel)</label>
                        <textarea class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" rows="4" placeholder="Instructions spéciales ou commentaires..."></textarea>
                    </div>
                    
                    <button type="submit" class="w-full btn btn-primary">
                        <i class="fas fa-shopping-cart mr-2"></i> Valider la commande
                    </button>
                </form>
            </div>
            
            <!-- Informations complémentaires -->
            <div class="space-y-8">
                <div class="bg-secondary rounded-xl p-6" style="background-color: var(--secondary-color);">
                    <h3 class="text-xl font-bold mb-4" style="color: var(--primary-color);">
                        <i class="fas fa-truck mr-2"></i> Livraison
                    </h3>
                    <ul class="space-y-2 text-sm">
                        <li><i class="fas fa-check text-green-500 mr-2"></i> Livraison gratuite dès 22,90€ d'achat</li>
                        <li><i class="fas fa-clock text-blue-500 mr-2"></i> Livraison sous 24-48h</li>
                        <li><i class="fas fa-shield-alt text-purple-500 mr-2"></i> Emballage sécurisé</li>
                        <li><i class="fas fa-map-marker-alt text-red-500 mr-2"></i> Suivi en temps réel</li>
                    </ul>
                </div>
                
                <div class="bg-secondary rounded-xl p-6" style="background-color: var(--secondary-color);">
                    <h3 class="text-xl font-bold mb-4" style="color: var(--primary-color);">
                        <i class="fas fa-credit-card mr-2"></i> Paiement Sécurisé
                    </h3>
                    <ul class="space-y-2 text-sm">
                        <li><i class="fas fa-lock text-green-500 mr-2"></i> Paiement 100% sécurisé</li>
                        <li><i class="fas fa-credit-card text-blue-500 mr-2"></i> CB, Visa, Mastercard</li>
                        <li><i class="fas fa-money-bill text-green-500 mr-2"></i> Espèces acceptées</li>
                        <li><i class="fas fa-file-invoice text-purple-500 mr-2"></i> Facture détaillée</li>
                    </ul>
                </div>
                
                <div class="bg-secondary rounded-xl p-6" style="background-color: var(--secondary-color);">
                    <h3 class="text-xl font-bold mb-4" style="color: var(--primary-color);">
                        <i class="fas fa-phone-alt mr-2"></i> Besoin d'aide ?
                    </h3>
                    <p class="text-sm mb-4">Notre équipe est à votre disposition pour vous aider dans votre commande.</p>
                    <div class="space-y-2">
                        <a href="tel:0123456789" class="btn btn-outline btn-sm w-full">
                            <i class="fas fa-phone mr-2"></i> 01 23 45 67 89
                        </a>
                        <a href="{{ path('app_contact') }}" class="btn btn-outline btn-sm w-full">
                            <i class="fas fa-envelope mr-2"></i> Nous contacter
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section produits populaires -->
<section class="py-12 bg-secondary" style="background-color: var(--secondary-color);">
    <div class="container">
        <h2 class="text-2xl font-bold text-center mb-8" style="color: var(--primary-color);">Produits Populaires</h2>
        <div class="grid md:grid-cols-4 gap-6">
            <div class="bg-white rounded-lg p-4 text-center">
                <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-pills text-white text-xl"></i>
                </div>
                <h4 class="font-semibold mb-1">Vitamine C</h4>
                <p class="text-sm text-muted-foreground">12,90€</p>
            </div>
            <div class="bg-white rounded-lg p-4 text-center">
                <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-heartbeat text-white text-xl"></i>
                </div>
                <h4 class="font-semibold mb-1">Oméga 3</h4>
                <p class="text-sm text-muted-foreground">18,50€</p>
            </div>
            <div class="bg-white rounded-lg p-4 text-center">
                <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-lungs text-white text-xl"></i>
                </div>
                <h4 class="font-semibold mb-1">Décongestionnant</h4>
                <p class="text-sm text-muted-foreground">8,90€</p>
            </div>
            <div class="bg-white rounded-lg p-4 text-center">
                <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-brain text-white text-xl"></i>
                </div>
                <h4 class="font-semibold mb-1">Magnésium</h4>
                <p class="text-sm text-muted-foreground">15,20€</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}
