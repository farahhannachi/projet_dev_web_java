<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.ConsommationController" spacing="10" style="-fx-padding: 20;">
    <Label text="Consommation de Stock" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
    <HBox spacing="10">
        <Label text="Service:"/>
        <ComboBox fx:id="serviceCombo" prefWidth="150"/>
        <Label text="Stock:"/>
        <ComboBox fx:id="stockCombo" prefWidth="150"/>
        <Label text="Quantité:"/>
        <Spinner fx:id="quantiteSpinner" prefWidth="80"/>
        <Button text="Valider" onAction="#handleConsommer"/>
    </HBox>
    <Label fx:id="avertissementLabel" style="-fx-text-fill: #F39C12;"/>
    <TableView fx:id="historiqueTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
            <TableColumn fx:id="colService" text="Service" prefWidth="120"/>
            <TableColumn fx:id="colProduit" text="Produit" prefWidth="120"/>
            <TableColumn fx:id="colQuantite" text="Quantité" prefWidth="80"/>
            <TableColumn fx:id="colMotif" text="Motif" prefWidth="120"/>
            <TableColumn fx:id="colDepot" text="Dépôt" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>

