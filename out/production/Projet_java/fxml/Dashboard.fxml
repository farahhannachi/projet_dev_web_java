<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:id="mainPane" fx:controller="org.example.controller.DashboardController" styleClass="root">
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" spacing="15">
            <Label text="CuraVita" styleClass="sidebar-logo"/>
            <VBox spacing="10">
                <Button text="Clients" onAction="#showClients" styleClass="sidebar-item"/>
                <Button text="Produits" onAction="#showProduits" styleClass="sidebar-item"/>
                <Button text="Commandes" onAction="#showCommandes" styleClass="sidebar-item"/>
                <Button text="Promotions" onAction="#showPromotions" styleClass="sidebar-item"/>
                <Button text="Coupons" onAction="#showCoupons" styleClass="sidebar-item"/>
                <Button text="Dépôts" onAction="#showDepots" styleClass="sidebar-item"/>
                <Button text="Stocks" onAction="#showStocks" styleClass="sidebar-item"/>
                <Button text="Services" onAction="#showServices" styleClass="sidebar-item"/>
                <Button text="Consommation" onAction="#showConsommation" styleClass="sidebar-item"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="frontOfficeBtn" text="← Back" onAction="#goToFrontOffice" styleClass="sidebar-button-bottom"/>
            <Button text="Logout" onAction="#logout" styleClass="sidebar-button-bottom"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <VBox spacing="30" styleClass="main-content">
                <Label text="Dashboard" styleClass="main-title"/>
                <VBox styleClass="card" spacing="20">
                    <Label text="Statistiques" styleClass="section-title"/>
                    <GridPane hgap="20" vgap="20" alignment="CENTER">
                        <VBox styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Total Clients" styleClass="stat-label"/>
                            <Label fx:id="totalClientsLabel" text="0" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Produits" styleClass="stat-label"/>
                            <Label fx:id="totalProduitsLabel" text="0" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="stat-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label text="Commandes" styleClass="stat-label"/>
                            <Label fx:id="totalCommandesLabel" text="0" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="stat-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <Label text="Alertes Stock" styleClass="stat-label"/>
                            <Label fx:id="alertesStockLabel" text="0" styleClass="stat-value"/>
                        </VBox>
                    </GridPane>
                </VBox>
                <VBox styleClass="card" spacing="20">
                    <Label text="Actions Rapides" styleClass="section-title"/>
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <Button fx:id="nouveauClientBtn" text="Nouveau Client" onAction="#handleNouveauClient" styleClass="button-primary"/>
                        <Button fx:id="ajouterProduitBtn" text="Ajouter Produit" onAction="#handleAjouterProduit" styleClass="button-primary"/>
                        <Button fx:id="nouvelleCommandeBtn" text="Nouvelle Commande" onAction="#handleNouvelleCommande" styleClass="button-primary"/>
                    </HBox>
                </VBox>
                <VBox styleClass="card" spacing="20">
                    <Label text="Activité Récente" styleClass="section-title"/>
                    <Label text="Aucune activité récente" styleClass="activity-item"/>
                </VBox>
                <VBox styleClass="card" spacing="20">
                    <Label text="Statistiques Avancées" styleClass="section-title"/>
                    <GridPane hgap="20" vgap="20" alignment="CENTER">
                        <VBox styleClass="chart-container" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Stocks" styleClass="chart-title"/>
                            <Pane fx:id="stocksChart" styleClass="chart"/>
                        </VBox>
                        <VBox styleClass="chart-container" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Dépôts" styleClass="chart-title"/>
                            <Pane fx:id="depotsChart" styleClass="chart"/>
                        </VBox>
                        <VBox styleClass="chart-container" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label text="Services" styleClass="chart-title"/>
                            <Pane fx:id="servicesChart" styleClass="chart"/>
                        </VBox>
                        <VBox styleClass="chart-container" GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <Label text="Mouvements" styleClass="chart-title"/>
                            <Pane fx:id="movementsChart" styleClass="chart"/>
                        </VBox>
                    </GridPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
