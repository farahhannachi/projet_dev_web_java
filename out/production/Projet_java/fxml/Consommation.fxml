<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.ConsommationController" spacing="15" style="-fx-padding: 20;">
    <Label text="Consommation de Stock" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
    <HBox spacing="20">
        <VBox spacing="10">
            <Label text="Service :"/>
            <ComboBox fx:id="serviceCombo" prefWidth="200"/>
        </VBox>
        <VBox spacing="10">
            <Label text="Stock :"/>
            <ComboBox fx:id="stockCombo" prefWidth="200"/>
        </VBox>
        <VBox spacing="10">
            <Label text="Quantité :"/>
            <Spinner fx:id="quantiteSpinner" prefWidth="100"/>
        </VBox>
        <VBox spacing="10" alignment="BOTTOM_CENTER">
            <Button fx:id="validerButton" text="Valider" onAction="#handleConsommer" style="-fx-font-size: 14; -fx-padding: 8 20;"/>
        </VBox>
    </HBox>
    <Label fx:id="avertissementLabel" style="-fx-text-fill: #E74C3C;"/>
    <Separator/>
    <Label text="Historique des mouvements" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
    <TableView fx:id="historiqueTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="colDate" text="Date" prefWidth="150"/>
            <TableColumn fx:id="colService" text="Service" prefWidth="120"/>
            <TableColumn fx:id="colProduit" text="Produit" prefWidth="120"/>
            <TableColumn fx:id="colQuantite" text="Quantité" prefWidth="80"/>
            <TableColumn fx:id="colMotif" text="Motif" prefWidth="120"/>
            <TableColumn fx:id="colDepot" text="Dépôt" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>
