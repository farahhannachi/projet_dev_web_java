<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.web.WebView?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.MapModalController"
      spacing="0" style="-fx-background-color: #f5f5f5;">

    <!-- Titre + Bouton Fermer -->
    <HBox spacing="10" style="-fx-padding: 15; -fx-background-color: #2d5016; -fx-text-fill: white;">
        <Label text="Sélectionnez une location sur la carte"
               style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"
               HBox.hgrow="ALWAYS"/>
        <Button text="✕ Fermer" onAction="#handleClose"
                style="-fx-padding: 8; -fx-font-size: 12; -fx-background-color: #E74C3C; -fx-text-fill: white;"/>
    </HBox>

    <!-- Carte en plein écran -->
    <WebView fx:id="mapView" VBox.vgrow="ALWAYS" style="-fx-padding: 0;"/>

    <!-- Bouton Enregistrer en bas -->
    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 15; -fx-background-color: white; -fx-border-width: 1 0 0 0; -fx-border-color: #ddd;">
        <Label fx:id="locationLabel" text="Aucune location sélectionnée"
               style="-fx-text-fill: #666;" HBox.hgrow="ALWAYS"/>
        <Button text="Enregistrer" onAction="#handleSaveLocation"
                style="-fx-padding: 10 20; -fx-font-size: 13; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
</VBox>

