{% extends 'front/_base.html.twig' %}

{% block title %}Nos Produits - CURAVITA{% endblock %}

{% block main %}
<div class="container" style="padding: 4rem 1rem;">
    <h1 class="text-center mb-12 text-primary">Nos Produits</h1>

    <!-- Section Filtres -->
    <div class="filters-section mb-8">
        <div class="filters-container">
            <form method="GET" action="{{ path('app_products') }}" class="filters-form">
                <div class="filters-grid">
                    <!-- Recherche -->
                    <div class="filter-group">
                        <input type="text" 
                               name="search" 
                               placeholder="Rechercher un produit..." 
                               value="{{ filters.search }}"
                               class="filter-input">
                    </div>
                    
                    <!-- Catégorie -->
                    <div class="filter-group">
                        <select name="categorie" class="filter-select">
                            <option value="all" {{ filters.categorie == 'all' or not filters.categorie ? 'selected' : '' }}>
                                Toutes les catégories
                            </option>
                            {% for categorie in categories %}
                                <option value="{{ categorie }}" 
                                        {{ filters.categorie == categorie ? 'selected' : '' }}>
                                    {{ categorie|title }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <!-- Prix Minimum -->
                    <div class="filter-group">
                        <input type="number" 
                               name="prix_min" 
                               placeholder="Prix min" 
                               value="{{ filters.prix_min }}"
                               min="0"
                               step="0.01"
                               class="filter-input">
                    </div>
                    
                    <!-- Prix Maximum -->
                    <div class="filter-group">
                        <input type="number" 
                               name="prix_max" 
                               placeholder="Prix max" 
                               value="{{ filters.prix_max }}"
                               min="0"
                               step="0.01"
                               class="filter-input">
                    </div>
                    
                    <!-- Tri -->
                    <div class="filter-group">
                        <select name="sort" class="filter-select">
                            <option value="name" {{ filters.sort == 'name' ? 'selected' : '' }}>
                                Nom (A-Z)
                            </option>
                            <option value="price_asc" {{ filters.sort == 'price_asc' ? 'selected' : '' }}>
                                Prix croissant
                            </option>
                            <option value="price_desc" {{ filters.sort == 'price_desc' ? 'selected' : '' }}>
                                Prix décroissant
                            </option>
                        </select>
                    </div>
                    
                    <!-- Boutons -->
                    <div class="filter-actions">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-filter"></i> Filtrer
                        </button>
                        <a href="{{ path('app_products') }}" class="btn btn-secondary btn-sm">
                            <i class="fas fa-times"></i> Réinitialiser
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {% if produits|length > 0 %}
        <div class="grid-products">
            {% for produit in produits %}
                <div class="product-card">
                    {% if produit.image %}
                        {% set imageSrc = (produit.image starts with 'http://') or (produit.image starts with 'https://') or (produit.image starts with '//')
                            ? produit.image
                            : asset(produit.image)
                        %}
                        <img src="{{ imageSrc }}" alt="{{ produit.nom }}" class="product-img">
                    {% else %}
                        <div class="product-img-placeholder"></div>
                    {% endif %}
                    <h3>{{ produit.nom }}</h3>
                    <p class="product-description">{{ produit.description|slice(0, 100) }}{% if produit.description|length > 100 %}...{% endif %}</p>
                    
                    {% set activePromotion = produit.getActivePromotion() %}
                    {% if activePromotion %}
                        <div class="promotion-badge">
                            <span class="promo-tag">-{{ activePromotion.valeurReduction ~ '%' }}</span>
                        </div>
                        <div class="price-container">
                            <p class="original-price">{{ produit.prix|number_format(2, ',', ' ') }} €</p>
                            <p class="price">{{ produit.getPromotionalPrice()|number_format(2, ',', ' ') }} €</p>
                        </div>
                    {% else %}
                        <p class="price">{{ produit.prix|number_format(2, ',', ' ') }} €</p>
                    {% endif %}
                    {% if produit.quantiteStock > 0 %}
                        <p class="stock-info">En stock: {{ produit.quantiteStock }}</p>
                        <button class="btn btn-sm btn-primary">Ajouter au panier</button>
                    {% else %}
                        <p class="stock-out">Rupture de stock</p>
                        <button class="btn btn-sm btn-secondary" disabled>Indisponible</button>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state" style="text-align: center; padding: 4rem 2rem;">
            <i class="fas fa-box-open" style="font-size: 4rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
            <h3 style="color: var(--text-muted); margin-bottom: 1rem;">Aucun produit disponible</h3>
            <p style="color: var(--text-muted);">Les produits seront bientôt disponibles. Revenez nous visiter ultérieurement!</p>
        </div>
    {% endif %}
</div>

<style>
    .grid-products { 
        display: grid; 
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); 
        gap: 2rem; 
    }
    .product-card { 
        border: 1px solid var(--border-color); 
        border-radius: var(--radius); 
        padding: 1.5rem; 
        transition: all 0.3s ease; 
        background: white; 
        text-align: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
    .product-card:hover { 
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15); 
        transform: translateY(-5px);
    }
    .product-img, .product-img-placeholder { 
        width: 100%; 
        height: 200px; 
        background-color: #f8f9fa; 
        margin-bottom: 1rem; 
        border-radius: 0.5rem;
        object-fit: cover;
    }
    .product-img-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
        font-size: 3rem;
    }
    .product-card h3 {
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
        color: var(--text-main);
        font-weight: 600;
    }
    .product-description {
        color: var(--text-muted);
        font-size: 0.9rem;
        margin-bottom: 1rem;
        line-height: 1.4;
    }
    .price {
        font-size: 1.5rem;
        font-weight: bold;
        color: var(--primary-color);
        margin-bottom: 0.5rem;
    }
    .promotion-badge {
        margin-bottom: 0.5rem;
        text-align: center;
    }
    .promo-tag {
        background: linear-gradient(135deg, #ff6b6b, #ee5a24);
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 1rem;
        font-size: 0.8rem;
        font-weight: bold;
        text-transform: uppercase;
        animation: pulse 2s infinite;
    }
    .price-container {
        margin-bottom: 0.5rem;
    }
    .original-price {
        font-size: 1rem;
        color: #999;
        text-decoration: line-through;
        margin-bottom: 0.25rem;
    }
    .price-container .price {
        color: #e74c3c;
        font-size: 1.75rem;
    }
    @keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }
    .stock-info {
        font-size: 0.85rem;
        color: #28a745;
        margin-bottom: 1rem;
    }
    .stock-out {
        font-size: 0.85rem;
        color: #dc3545;
        margin-bottom: 1rem;
    }
    .btn-sm { 
        padding: 0.75rem 1.5rem; 
        font-size: 0.875rem; 
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .btn-primary {
        background-color: var(--primary-color);
        color: white;
        border: none;
    }
    .btn-primary:hover {
        background-color: var(--primary-color-dark);
        transform: scale(1.05);
    }
    .btn-secondary {
        background-color: #6c757d;
        color: white;
        border: none;
        cursor: not-allowed;
    }
    .empty-state {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        border-radius: 1rem;
        border: 2px dashed var(--border-color);
    }
    
    /* Styles pour les filtres */
    .filters-section {
        background: white;
        padding: 2rem;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin-bottom: 2rem;
    }
    
    .filters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        align-items: end;
    }
    
    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    
    .filter-input, .filter-select {
        padding: 0.75rem;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        background: white;
    }
    
    .filter-input:focus, .filter-select:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }
    
    .filter-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    
    .btn-sm {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .btn-primary {
        background: var(--primary-color);
        color: white;
    }
    
    .btn-primary:hover {
        background: #2563eb;
        transform: translateY(-1px);
    }
    
    .btn-secondary {
        background: #6b7280;
        color: white;
    }
    
    .btn-secondary:hover {
        background: #4b5563;
        transform: translateY(-1px);
    }
    
    /* Responsive pour les filtres */
    @media (max-width: 768px) {
        .filters-grid {
            grid-template-columns: 1fr;
        }
        
        .filter-actions {
            justify-content: center;
        }
    }
</style>
{% endblock %}
