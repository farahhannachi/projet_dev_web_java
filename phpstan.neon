parameters:
    level: 8
    paths:
        - src
    
    treatPhpDocTypesAsCertain: false
    
    reportUnmatchedIgnoredErrors: false
    
    ignoreErrors:
        # Property type issues - nullable types that are always set
        - '#^Property .* is never assigned#'
        
        # PHPDoc @var native type issues
        - '#^PHPDoc tag @var with type#'
        
        # Missing iterable value type
        - '#has parameter .* with no value type specified in iterable type#'
        - '#Method .* has parameter .* with no value type specified in iterable type#'
        - '#return type has no value type specified in iterable type#'
        - '#Property .* type has no value type specified in iterable type#'
        
        # Doctrine generic types
        - '#extends generic class Doctrine#'
        - '#has generic class Doctrine#'
        
        # PHPDoc parsing errors
        - '#PHPDoc tag .* has invalid#'
        
        # Method not found on object
        - '#Call to an undefined method object::#'
        
        # Method not found - various
        - '#Call to an undefined method .*::#'
        
        # Class not found
        - '#Class .* not found#'
        
        # Property type assignment
        - '#does not accept#'
        
        # Return type mismatch
        - '#should return#'
        
        # Method call on nullable
        - '#Cannot call method .* on#'
        
        # Property access on nullable
        - '#Cannot access property .* on#'
        
        # Null coalesce issues
        - '#on left side of \?\?#'
        
        # Always true/false comparisons
        - '#will always evaluate to true#'
        - '#will always evaluate to false#'
        - '#Comparison.*is always true#'
        - '#If condition is always#'
        
        # Argument type issues - various patterns
        - '#expects string#'
        - '#expects int#'
        - '#expects float#'
        - '#expects array#'
        - '#expects class-string#'
        
        # Missing parameter/return type
        - '#has no return type specified#'
        - '#has parameter .* with no type specified#'
        
        # Generic issues
        - '#does not specify its types#'
        
        # Property only written
        - '#is never read, only written#'
        
        # PHPDoc tag @method issues
        - '#has PHPDoc tag @method for method#'
        
        # TimeoutException class not found (optional dependency)
        - '#TimeoutException not found#'
        - '#Call to method .* on an unknown class#'
