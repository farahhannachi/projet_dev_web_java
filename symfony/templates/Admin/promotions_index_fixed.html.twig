{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}Gestion des promotions{% endblock %}
{% block page_subtitle %}Selectionnez un produit pour creer ou modifier une promotion{% endblock %}

{% block main %}
<div style="padding:2rem;">
    {% for message in app.flashes('success') %}
        <div class="alert-success"><i class="fas fa-check-circle"></i> {{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert-danger"><i class="fas fa-exclamation-circle"></i> {{ message }}</div>
    {% endfor %}

    <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.2rem;">
        <h2 style="margin:0;color:var(--primary-color);font-size:1.55rem;">Produits pour promotions</h2>
        <form method="get" style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;">
            <input class="search-input" type="text" name="search" value="{{ search }}" placeholder="Rechercher produit...">
            <select class="filter-select" name="category">
                <option value="">Toutes categories</option>
                {% set categories = [] %}
                {% for produit in all_products %}
                    {% if produit.categorie not in categories %}
                        {% set categories = categories|merge([produit.categorie]) %}
                    {% endif %}
                {% endfor %}
                {% for cat in categories|sort %}
                    <option value="{{ cat }}" {% if category == cat %}selected{% endif %}>{{ cat }}</option>
                {% endfor %}
            </select>
            <select class="filter-select" name="promotion_status">
                <option value="">Tous</option>
                <option value="with_promo" {% if promotion_status == 'with_promo' %}selected{% endif %}>Avec promotion</option>
                <option value="without_promo" {% if promotion_status == 'without_promo' %}selected{% endif %}>Sans promotion</option>
            </select>
            <input class="price-input" type="number" step="0.01" min="0" name="price_min" value="{{ price_min }}" placeholder="Prix min">
            <input class="price-input" type="number" step="0.01" min="0" name="price_max" value="{{ price_max }}" placeholder="Prix max">
            <button class="btn btn-primary" type="submit"><i class="fas fa-search"></i> Filtrer</button>
            <a class="btn btn-outline" href="{{ path('admin_promotions') }}">Reset</a>
        </form>
    </div>

    {% if produits|length > 0 %}
        <div class="grid-cards">
            {% for produit in produits %}
                {% set activePromotion = produit.getActivePromotion() %}
                <article class="promo-card {{ activePromotion ? 'with-promo' : '' }}">
                    <div class="card-body">
                        <div class="card-head">
                            <div>
                                <h3>{{ produit.nom }}</h3>
                                <p>{{ produit.categorie }}</p>
                            </div>
                            {% if activePromotion %}<span class="status-badge status-success">Active</span>{% endif %}
                        </div>

                        {% if produit.image %}
                            {% set imageSrc = (produit.image starts with 'http://') or (produit.image starts with 'https://') or (produit.image starts with '//') ? produit.image : asset('uploads/produits/' ~ produit.image) %}
                            <img class="thumb" src="{{ imageSrc }}" alt="{{ produit.nom }}">
                        {% else %}
                            <div class="thumb empty"><i class="fas fa-box"></i></div>
                        {% endif %}

                        <p class="desc">{{ produit.description|slice(0, 110) }}{% if produit.description|length > 110 %}...{% endif %}</p>

                        <div class="prices">
                            {% if activePromotion %}
                                <span class="old">{{ produit.prix|number_format(2, ',', ' ') }} DT</span>
                                <span class="new">{{ produit.getPromotionalPrice()|number_format(2, ',', ' ') }} DT</span>
                                <small>Du {{ activePromotion.dateDebut|date('d/m/Y') }} au {{ activePromotion.dateFin|date('d/m/Y') }}</small>
                            {% else %}
                                <span class="new">{{ produit.prix|number_format(2, ',', ' ') }} DT</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="{{ path('admin_promotion_create', {id: produit.id}) }}" class="btn btn-primary full">
                            <i class="fas {{ activePromotion ? 'fa-edit' : 'fa-plus' }}"></i>
                            {{ activePromotion ? 'Modifier la promotion' : 'Creer une promotion' }}
                        </a>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state">
            <i class="fas fa-box-open"></i>
            <h3>Aucun produit trouve</h3>
            <p>Verifiez les filtres ou ajoutez des produits disponibles.</p>
        </div>
    {% endif %}
</div>

<style>
.grid-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:1rem}
.promo-card{background:#fff;border:2px solid var(--border-color);border-radius:12px;overflow:hidden;box-shadow:var(--shadow-md)}
.promo-card.with-promo{border-color:var(--secondary-color)}
.card-body{padding:1rem}
.card-head{display:flex;justify-content:space-between;gap:.5rem;align-items:flex-start}
.card-head h3{margin:0;color:var(--dark-color);font-size:1.15rem}
.card-head p{margin:.35rem 0 0;color:var(--text-muted);font-size:.82rem}
.thumb{width:100%;height:150px;object-fit:cover;border-radius:8px;margin-top:.8rem}
.thumb.empty{display:flex;align-items:center;justify-content:center;background:var(--light-color);color:var(--text-muted)}
.desc{color:var(--text-muted);font-size:.85rem;line-height:1.45;margin:.8rem 0}
.prices{display:flex;flex-direction:column;gap:.2rem}
.old{text-decoration:line-through;color:var(--text-muted);font-size:.82rem}
.new{color:var(--primary-color);font-weight:700;font-size:1.15rem}
.prices small{color:var(--secondary-color);font-size:.75rem}
.card-footer{padding:.9rem 1rem;border-top:1px solid var(--border-color);background:var(--light-color)}
.full{width:100%;justify-content:center}
.status-badge{padding:.2rem .6rem;border-radius:999px;font-size:.72rem;font-weight:700}
.status-success{background:var(--secondary-color);color:#fff}
.btn{display:inline-flex;align-items:center;gap:.45rem;padding:.65rem .95rem;border-radius:8px;border:1px solid transparent;text-decoration:none;cursor:pointer}
.btn-primary{background:var(--primary-color);color:#fff;border-color:var(--primary-color)}
.btn-outline{background:#fff;color:var(--primary-color);border-color:var(--primary-color)}
.search-input,.filter-select,.price-input{padding:.65rem .7rem;border:1px solid var(--border-color);border-radius:8px;background:#fff}
.search-input{min-width:220px}
.price-input{width:110px}
.alert-success,.alert-danger{padding:.8rem 1rem;border-radius:8px;margin-bottom:.8rem;display:flex;gap:.5rem;align-items:center}
.alert-success{background:var(--secondary-color);color:#fff}
.alert-danger{background:#f8d7da;color:#842029}
.empty-state{text-align:center;padding:3rem 1rem;background:#fff;border-radius:12px;box-shadow:var(--shadow-md)}
.empty-state i{font-size:3rem;color:var(--text-muted)}
.empty-state h3{margin:.8rem 0 .4rem;color:var(--dark-color)}
.empty-state p{margin:0;color:var(--text-muted)}
</style>
{% endblock %}

