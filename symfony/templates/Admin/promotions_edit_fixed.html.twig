{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}Modifier promotion{% endblock %}
{% block page_subtitle %}Mettre a jour la promotion{% endblock %}

{% block main %}
<div style="padding:2rem;">
    {% for message in app.flashes('error') %}
        <div class="alert-danger"><i class="fas fa-exclamation-circle"></i> {{ message }}</div>
    {% endfor %}
    <div class="card-wrap">
        <form method="post" class="form-grid" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('promotion' ~ promotion.idPromotion) }}">
            <div><label>Titre</label><input type="text" name="titre" value="{{ promotion.titre }}" required></div>
            <div><label>Reduction (%)</label><input type="number" name="valeur_reduction" step="0.01" min="0" max="100" value="{{ promotion.valeurReduction }}" required></div>
            <div class="full"><label>Description</label><textarea name="description" rows="3" required>{{ promotion.description }}</textarea></div>
            <div><label>Date debut</label><input type="date" name="date_debut" value="{{ promotion.dateDebut ? promotion.dateDebut|date('Y-m-d') : '' }}" required></div>
            <div><label>Date fin</label><input type="date" name="date_fin" value="{{ promotion.dateFin ? promotion.dateFin|date('Y-m-d') : '' }}" required></div>
            <div><label>Statut</label><select name="statut"><option value="active" {{ promotion.statut == 'active' ? 'selected' : '' }}>Active</option><option value="inactive" {{ promotion.statut == 'inactive' ? 'selected' : '' }}>Inactive</option></select></div>
            <div><label>Produit</label><select name="id_produit"><option value="">Aucun</option>{% for produit in produits %}<option value="{{ produit.id }}" {{ promotion.produit and promotion.produit.id == produit.id ? 'selected' : '' }}>{{ produit.nom }}</option>{% endfor %}</select></div>
            <div class="actions full">
                <a href="{{ path('admin_promotions') }}" class="btn btn-outline">Retour</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Mettre a jour</button>
            </div>
        </form>
    </div>
</div>
<style>
.card-wrap{background:#fff;border-radius:12px;padding:1.4rem;box-shadow:var(--shadow-md);max-width:820px;margin:0 auto}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.form-grid .full{grid-column:1/-1}
label{display:block;font-weight:600;margin-bottom:.35rem;color:var(--dark-color)}
input,select,textarea{width:100%;padding:.7rem;border:1px solid var(--border-color);border-radius:8px;font-size:.9rem}
.actions{display:flex;gap:.6rem;justify-content:flex-end;align-items:center}
.btn{display:inline-flex;align-items:center;gap:.45rem;padding:.65rem .95rem;border-radius:8px;border:1px solid transparent;text-decoration:none;cursor:pointer}
.btn-primary{background:var(--primary-color);color:#fff;border-color:var(--primary-color)}
.btn-outline{background:#fff;color:var(--primary-color);border-color:var(--primary-color)}
.alert-danger{background:#f8d7da;color:#842029;padding:.8rem 1rem;border-radius:8px;margin-bottom:.8rem;display:flex;gap:.5rem;align-items:center}
@media(max-width:860px){.form-grid{grid-template-columns:1fr}}
</style>
{% endblock %}

