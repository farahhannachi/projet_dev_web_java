{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}{{ produit is null ? 'Ajouter' : 'Modifier' }} un Produit{% endblock %}
{% block page_subtitle %}{{ produit is null ? 'Créer un nouveau produit' : 'Modifier les informations du produit' }}{% endblock %}

{% block main %}
<div style="padding: 2rem;">
    <div class="form-container">
        <h1><i class="fas fa-pills"></i> {{ produit is null ? 'Ajouter' : 'Modifier' }} un Produit</h1>
        
        {{ form_start(form, { attr: { novalidate: 'novalidate', class: 'modern-form js-ajax-form', id: 'produitForm' } }) }}
            <div class="form-error-message" data-form-error style="display:none"></div>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.nom) }}
                    {{ form_widget(form.nom) }}
                    {{ form_errors(form.nom) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.categorie) }}
                    {{ form_widget(form.categorie) }}
                    {{ form_errors(form.categorie) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.prix) }}
                    {{ form_widget(form.prix) }}
                    {{ form_errors(form.prix) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.quantiteStock) }}
                    {{ form_widget(form.quantiteStock) }}
                    {{ form_errors(form.quantiteStock) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.dateExpiration) }}
                    {{ form_widget(form.dateExpiration) }}
                    {{ form_errors(form.dateExpiration) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.statut) }}
                    {{ form_widget(form.statut) }}
                    {{ form_errors(form.statut) }}
                </div>
                
                <div class="form-group full-width">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </div>
                
                <div class="form-group full-width">
                    {{ form_label(form.image) }}
                    {{ form_widget(form.image) }}
                    {{ form_errors(form.image) }}
                    
                    {% if produit and produit.image %}
                        <div style="margin-top: 10px;">
                            <p style="font-size: 0.9rem; color: #666; margin-bottom: 5px;">Image actuelle :</p>
                            <img src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="{{ produit.nom }}" style="max-width: 200px; max-height: 150px; border-radius: 8px; border: 1px solid #ddd;">
                        </div>
                    {% endif %}
                </div>
            </div>
            
            <div class="form-actions">
                <a href="{{ path('admin_produits') }}" class="btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
                <button type="submit" class="btn-primary">
                    <i class="fas fa-save"></i> {{ produit is null ? 'Ajouter' : 'Modifier' }}
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>

<style>
.form-container {
    background: white;
    padding: 2rem;
    border-radius: 16px;
    box-shadow: var(--shadow-md);
    max-width: 800px;
    margin: 0 auto;
}

.form-container h1 {
    color: var(--primary-color);
    margin-bottom: 2rem;
    font-size: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.modern-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.full-width {
    grid-column: 1 / -1;
}

.form-group label {
    font-weight: 600;
    color: var(--dark-color);
    margin-bottom: 0.5rem;
}

.form-group input,
.form-group select,
.form-group textarea {
    padding: 0.875rem 1.25rem;
    border: 2px solid var(--border-color);
    border-radius: 12px;
    font-size: 1rem;
    transition: var(--transition);
    background: white;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(22, 86, 63, 0.1);
}

.form-group .invalid-feedback,
.form-group .form-error-message {
    color: var(--danger-color);
    font-size: 0.875rem;
    margin-top: 0.25rem;
    display: block;
}

.form-group .is-invalid,
.form-group input.is-invalid,
.form-group select.is-invalid,
.form-group textarea.is-invalid {
    border-color: var(--danger-color);
    box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.1);
}

.form-group input:focus.is-invalid,
.form-group select:focus.is-invalid,
.form-group textarea:focus.is-invalid {
    border-color: var(--danger-color);
    box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.25);
}

.form-group .required::after {
    content: " *";
    color: var(--danger-color);
}

.form-actions {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    margin-top: 2rem;
}

.btn-secondary {
    background: var(--text-muted);
    color: white;
    padding: 0.875rem 1.75rem;
    text-decoration: none;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: var(--transition);
    font-weight: 600;
}

.btn-secondary:hover {
    background: #5a6268;
    transform: translateY(-2px);
}

@media (max-width: 768px) {
    .form-grid {
        grid-template-columns: 1fr;
    }
    
    .form-actions {
        flex-direction: column;
    }
}
</style>
<script>
(() => {
  const form = document.getElementById('produitForm');
  if (!form) return;

  const clearErrors = () => {
    form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
    form.querySelectorAll('.ajax-field-error').forEach(el => el.remove());
    const global = form.querySelector('[data-form-error]');
    if (global) { global.style.display = 'none'; global.textContent = ''; }
  };

  const showErrors = (errors) => {
    const global = form.querySelector('[data-form-error]');
    Object.entries(errors || {}).forEach(([field, messages]) => {
      const msg = Array.isArray(messages) && messages.length ? messages[0] : 'Valeur invalide';
      if (field === '_form') {
        if (global) { global.style.display = 'block'; global.textContent = msg; }
        return;
      }
      const input = form.querySelector(`[name$="[${field}]"]`);
      if (!input) return;
      input.classList.add('is-invalid');
      const err = document.createElement('div');
      err.className = 'form-error-message ajax-field-error';
      err.textContent = msg;
      input.insertAdjacentElement('afterend', err);
    });
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();
    const data = new FormData(form);
    const res = await fetch(form.action, {
      method: form.method || 'POST',
      body: data,
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });
    const payload = await res.json().catch(() => ({}));
    if (!res.ok || payload.ok === false) {
      showErrors(payload.errors || { _form: ['Donnees invalides.'] });
      return;
    }
    window.location.href = payload.redirect_url || window.location.href;
  });
})();
</script>
{% endblock %}
