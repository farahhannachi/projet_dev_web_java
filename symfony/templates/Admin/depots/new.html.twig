{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}Nouveau Dépôt{% endblock %}
{% block page_subtitle %}Ajouter un nouveau dépôt{% endblock %}

{% block main %}
<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-plus"></i> Formulaire de Création</h3>
    </div>
    <div class="card-body">
        <form method="post" class="admin-form" novalidate>
            <div class="form-row">
                <div class="form-group">
                    <label for="nom_depot" class="form-label">
                        <i class="fas fa-warehouse"></i> Nom du Dépôt *
                    </label>
                    <input type="text" 
                           id="nom_depot" 
                           name="nom_depot" 
                           required
                           class="form-control"
                           placeholder="Entrez le nom du dépôt">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="adresse_depot" class="form-label">
                        <i class="fas fa-map-marker-alt"></i> Adresse du Dépôt *
                    </label>
                    <textarea id="adresse_depot" 
                              name="adresse_depot" 
                              required
                              class="form-control"
                              rows="3"
                              placeholder="Entrez l'adresse complète du dépôt"></textarea>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="capacite_depot" class="form-label">
                        <i class="fas fa-boxes"></i> Capacité du Dépôt *
                    </label>
                    <input type="number" 
                           id="capacite_depot" 
                           name="capacite_depot" 
                           required
                           min="1"
                           class="form-control"
                           placeholder="Entrez la capacité de stockage">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="responsable_depot" class="form-label">
                        <i class="fas fa-user-tie"></i> Responsable du Dépôt *
                    </label>
                    <input type="text" 
                           id="responsable_depot" 
                           name="responsable_depot" 
                           required
                           class="form-control"
                           placeholder="Entrez le nom du responsable">
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Enregistrer le Dépôt
                </button>
                <a href="{{ path('admin_depots') }}" class="btn btn-outline">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
