{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}{{ depot is null ? 'Ajouter' : 'Modifier' }} un Dépôt{% endblock %}
{% block page_subtitle %}{{ depot is null ? 'Créer un nouveau dépôt' : 'Modifier les informations du dépôt' }}{% endblock %}

{% block main %}
<div style="padding: 2rem;">
    <div class="form-container">
        <h1><i class="fas fa-warehouse"></i> {{ depot is null ? 'Ajouter' : 'Modifier' }} un Dépôt</h1>
        
        {{ form_start(form, { attr: { novalidate: 'novalidate', class: 'modern-form' } }) }}
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.nomDepot) }}
                    {{ form_widget(form.nomDepot) }}
                    {{ form_errors(form.nomDepot) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.responsableDepot) }}
                    {{ form_widget(form.responsableDepot) }}
                    {{ form_errors(form.responsableDepot) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.capaciteDepot) }}
                    {{ form_widget(form.capaciteDepot) }}
                    {{ form_errors(form.capaciteDepot) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.dateCreation) }}
                    {{ form_widget(form.dateCreation) }}
                    {{ form_errors(form.dateCreation) }}
                </div>
                
                <div class="form-group full-width">
                    {{ form_label(form.adresseDepot) }}
                    {{ form_widget(form.adresseDepot) }}
                    {{ form_errors(form.adresseDepot) }}
                </div>
                
                <div class="form-group">
                    {{ form_label(form.ville) }}
                    {{ form_widget(form.ville) }}
                    {{ form_errors(form.ville) }}
                </div>
            </div>
            
            <div class="form-actions">
                <a href="{{ path('admin_depots') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-plus-circle"></i> {{ depot is null ? 'Ajouter le dépôt' : 'Mettre à jour' }}
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>

<style>
.form-container {
    background: white;
    padding: 2rem;
    border-radius: 16px;
    box-shadow: var(--shadow-md);
    max-width: 800px;
    margin: 0 auto;
}

.form-container h1 {
    color: var(--primary-color);
    margin-bottom: 2rem;
    font-size: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.modern-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.full-width {
    grid-column: 1 / -1;
}

.form-group label {
    font-weight: 600;
    color: var(--dark-color);
    margin-bottom: 0.5rem;
}

.form-group input,
.form-group select,
.form-group textarea {
    padding: 0.875rem 1.25rem;
    border: 2px solid var(--border-color);
    border-radius: 12px;
    font-size: 1rem;
    transition: var(--transition);
    background: white;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(22, 86, 63, 0.1);
}

.form-group .invalid-feedback,
.form-group .form-error-message {
    color: var(--danger-color);
    font-size: 0.875rem;
    margin-top: 0.25rem;
    display: block;
}

.form-group .is-invalid,
.form-group input.is-invalid,
.form-group select.is-invalid,
.form-group textarea.is-invalid {
    border-color: var(--danger-color);
    box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.1);
}

.form-group input:focus.is-invalid,
.form-group select:focus.is-invalid,
.form-group textarea:focus.is-invalid {
    border-color: var(--danger-color);
    box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.25);
}

.form-group .required::after {
    content: " *";
    color: var(--danger-color);
}

.form-actions {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    margin-top: 2rem;
}

.btn-secondary {
    background: var(--text-muted);
    color: white;
    padding: 0.875rem 1.75rem;
    text-decoration: none;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: var(--transition);
    font-weight: 600;
    border: none;
    cursor: pointer;
}

.btn-secondary:hover {
    background: #5a6268;
    transform: translateY(-2px);
}

.btn-primary {
    background: var(--primary-color);
    color: white;
    padding: 0.875rem 1.75rem;
    text-decoration: none;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: var(--transition);
    font-weight: 600;
    border: none;
    cursor: pointer;
}

.btn-primary:hover {
    background: #1a5f3f;
    transform: translateY(-2px);
}

@media (max-width: 768px) {
    .form-grid {
        grid-template-columns: 1fr;
    }
    
    .form-actions {
        flex-direction: column;
    }
}
</style>
{% endblock %}
