<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Liste des Clients - CURAVITA</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            color: #333;
        }
        
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #165c57;
            padding-bottom: 20px;
        }
        
        .title {
            color: #165c57;
            font-size: 28px;
            font-weight: bold;
            margin: 10px 0;
        }
        
        .subtitle {
            color: #666;
            font-size: 14px;
            margin: 5px 0;
        }
        
        .company-name {
            font-size: 20px;
            font-weight: bold;
            color: #165c57;
            margin-bottom: 5px;
        }
        
        .tagline {
            font-style: italic;
            color: #666;
            margin-bottom: 20px;
        }
        
        .info {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
            border-left: 4px solid #165c57;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        
        th {
            background-color: #165c57;
            color: white;
            text-align: left;
            padding: 12px;
            font-weight: bold;
            border: 1px solid #ddd;
        }
        
        td {
            padding: 10px 12px;
            border: 1px solid #ddd;
        }
        
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        
        .footer {
            margin-top: 30px;
            text-align: center;
            color: #666;
            font-size: 12px;
            border-top: 1px solid #ddd;
            padding-top: 15px;
        }
        
        .no-clients {
            text-align: center;
            padding: 40px;
            color: #666;
            font-style: italic;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="company-name">CURAVITA</div>
        <div class="tagline">Votre pharmacie en ligne de confiance</div>
        <div class="title">Liste des Clients</div>
        <div class="subtitle">Rapport généré le {{ date|date('d/m/Y à H:i') }}</div>
    </div>
    
    <div class="info">
        <strong>Nombre total de clients :</strong> {{ clients|length }}
        {% if clients|length > 0 %}
            <br><strong>Période :</strong> Tous les clients enregistrés
        {% endif %}
    </div>
    
    {% if clients|length > 0 %}
        <table>
            <thead>
                <tr>
                    <th style="width: 10%;">ID</th>
                    <th style="width: 35%;">Nom & Prénom</th>
                    <th style="width: 55%;">Email</th>
                </tr>
            </thead>
            <tbody>
                {% for client in clients %}
                <tr>
                    <td>{{ client.id }}</td>
                    <td>{{ client.nom }} {{ client.prenom }}</td>
                    <td>{{ client.email }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="no-clients">
            Aucun client trouvé dans la base de données.
        </div>
    {% endif %}
    
    <div class="footer">
        <p>Ce document a été généré automatiquement par le système CURAVITA</p>
        <p>© {{ date|date('Y') }} CURAVITA - Votre pharmacie en ligne de confiance</p>
        <p>Contact : contact@curavita.fr | Téléphone : 01 23 45 67 89</p>
    </div>
</body>
</html>
