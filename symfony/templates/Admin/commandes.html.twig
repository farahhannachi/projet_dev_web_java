{% extends 'admin/_base_modern.html.twig' %}

{% block page_title %}Commandes{% endblock %}
{% block page_subtitle %}Suivi et operations commandes{% endblock %}

{% block main %}
<div style="padding:1rem 1rem 2rem">
    {% for message in app.flashes('success') %}<div class="alert-success">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="alert-danger">{{ message }}</div>{% endfor %}

    <div class="stats-grid" style="margin-bottom:1rem">
        <div class="stat-card"><h3>Total commandes</h3><div class="number">{{ stats.total }}</div></div>
        <div class="stat-card"><h3>En attente</h3><div class="number">{{ stats.en_attente }}</div></div>
        <div class="stat-card"><h3>Confirmees</h3><div class="number">{{ stats.confirmee }}</div></div>
        <div class="stat-card"><h3>Livrees</h3><div class="number">{{ stats.livree }}</div></div>
        <div class="stat-card"><h3>Review</h3><div class="number">{{ stats.review }}</div></div>
        <div class="stat-card"><h3>Suspectes</h3><div class="number">{{ stats.suspectes }}</div></div>
        <div class="stat-card"><h3>Montant</h3><div class="number">{{ stats.montant_total|number_format(2, ',', ' ') }} DT</div></div>
    </div>

    <div class="page-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;gap:.8rem;flex-wrap:wrap">
        <h2 style="margin:0">Liste commandes</h2>
        <div style="display:flex;gap:.5rem;flex-wrap:wrap">
            <a href="{{ path('admin_commandes_export_csv') }}" class="btn-outline"><i class="fas fa-file-csv"></i> CSV</a>
            <a href="{{ path('admin_commandes_export_pdf') }}" class="btn-outline"><i class="fas fa-file-pdf"></i> PDF</a>
        </div>
    </div>

    <form method="get" id="ordersFilterForm" style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:.6rem;margin-bottom:1rem">
        <input class="form-control" name="search" value="{{ filters.search }}" placeholder="Recherche client...">
        <select class="form-control" name="statut">
            <option value="all" {% if filters.statut == 'all' or not filters.statut %}selected{% endif %}>Tous statuts</option>
            <option value="en_attente" {% if filters.statut == 'en_attente' %}selected{% endif %}>En attente</option>
            <option value="confirmee" {% if filters.statut == 'confirmee' %}selected{% endif %}>Confirmee</option>
            <option value="annulee" {% if filters.statut == 'annulee' %}selected{% endif %}>Annulee</option>
            <option value="livree" {% if filters.statut == 'livree' %}selected{% endif %}>Livree</option>
            <option value="review" {% if filters.statut == 'review' %}selected{% endif %}>Review</option>
            <option value="bloquee" {% if filters.statut == 'bloquee' %}selected{% endif %}>Bloquee</option>
        </select>
        <select class="form-control" name="sort">
            <option value="date_desc" {% if filters.sort == 'date_desc' %}selected{% endif %}>Date recente</option>
            <option value="date_asc" {% if filters.sort == 'date_asc' %}selected{% endif %}>Date ancienne</option>
            <option value="montant_desc" {% if filters.sort == 'montant_desc' %}selected{% endif %}>Montant -</option>
            <option value="montant_asc" {% if filters.sort == 'montant_asc' %}selected{% endif %}>Montant +</option>
            <option value="name_asc" {% if filters.sort == 'name_asc' %}selected{% endif %}>Nom A-Z</option>
        </select>
        <select class="form-control" name="fraud_only">
            <option value="0" {% if filters.fraud_only != '1' %}selected{% endif %}>Toutes commandes</option>
            <option value="1" {% if filters.fraud_only == '1' %}selected{% endif %}>Suspectes seulement</option>
        </select>
    </form>

    <div class="table-container">
        <table class="data-table">
            <thead><tr><th>ID</th><th>Date</th><th>Client</th><th>Total</th><th>Paiement</th><th>Fraude</th><th>Statut</th><th>Actions</th></tr></thead>
            <tbody>
            {% for commande in commandes %}
                <tr>
                    <td>#{{ commande.id }}</td>
                    <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
                    <td>{{ commande.nom }}<br><small>{{ commande.email }}</small></td>
                    <td>{{ commande.total|number_format(2, ',', ' ') }} DT</td>
                    <td>{{ commande.modePaiement }}</td>
                    <td>{{ commande.fraudScore }}/100</td>
                    <td>
                        <form method="post" action="{{ path('admin_commande_status', {id: commande.id}) }}" class="inline-status">
                            <select name="status" class="form-control" style="min-width:140px">
                                <option value="en_attente" {% if commande.statut == 'en_attente' %}selected{% endif %}>En attente</option>
                                <option value="confirmee" {% if commande.statut == 'confirmee' %}selected{% endif %}>Confirmee</option>
                                <option value="annulee" {% if commande.statut == 'annulee' %}selected{% endif %}>Annulee</option>
                                <option value="livree" {% if commande.statut == 'livree' %}selected{% endif %}>Livree</option>
                                <option value="review" {% if commande.statut == 'review' %}selected{% endif %}>Review</option>
                                <option value="bloquee" {% if commande.statut == 'bloquee' %}selected{% endif %}>Bloquee</option>
                            </select>
                        </form>
                    </td>
                    <td>
                        <div class="actions-container">
                            <a class="btn-outline" href="{{ path('admin_commande_edit', {id: commande.id}) }}"><i class="fas fa-edit"></i></a>
                            <form action="{{ path('admin_commande_delete', {id: commande.id}) }}" method="post" onsubmit="return confirm('Supprimer cette commande ?')"><button class="btn-danger" type="submit"><i class="fas fa-trash"></i></button></form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" style="text-align:center">Aucune commande</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(() => {
  const filterForm = document.getElementById('ordersFilterForm');
  if (filterForm) {
    let timer;
    filterForm.querySelectorAll('input,select').forEach(el => {
      el.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(() => filterForm.submit(), 280);
      });
      el.addEventListener('change', () => filterForm.submit());
    });
  }

  document.querySelectorAll('form.inline-status select').forEach(sel => {
    sel.addEventListener('change', () => sel.form.submit());
  });
})();
</script>
{% endblock %}
