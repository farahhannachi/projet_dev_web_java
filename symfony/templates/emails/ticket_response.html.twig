<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouvelle réponse - CURAVITA</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7fa;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f7fa; padding: 40px 20px;">
        <tr>
            <td align="center">
                <table width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.1);">
                    
                    <!-- Header -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #16563f 0%, #28a745 100%); padding: 40px 30px; text-align: center;">
                            <h1 style="color: #ffffff; margin: 0; font-size: 28px; font-weight: 700;">
                                🏥 CURAVITA
                            </h1>
                            <p style="color: rgba(255,255,255,0.9); margin: 10px 0 0; font-size: 14px;">
                                Votre pharmacie en ligne de confiance
                            </p>
                        </td>
                    </tr>

                    <!-- Message Icon -->
                    <tr>
                        <td style="padding: 40px 30px 20px; text-align: center;">
                            <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); border-radius: 50%; margin: 0 auto; display: flex; align-items: center; justify-content: center;">
                                <span style="font-size: 40px;">💬</span>
                            </div>
                        </td>
                    </tr>

                    <!-- Main Content -->
                    <tr>
                        <td style="padding: 0 30px 30px;">
                            <h2 style="color: #16563f; text-align: center; margin: 0 0 20px; font-size: 24px;">
                                Nouvelle réponse à votre ticket
                            </h2>
                            
                            <p style="color: #4b5563; font-size: 16px; line-height: 1.6; margin: 0 0 25px;">
                                Bonjour <strong>{{ user.prenom }} {{ user.nom }}</strong>,
                            </p>
                            
                            <p style="color: #4b5563; font-size: 16px; line-height: 1.6; margin: 0 0 25px;">
                                L'équipe CURAVITA a répondu à votre ticket <strong>#{{ question.id }}</strong> concernant "<em>{{ question.objet }}</em>".
                            </p>

                            <!-- Response Box -->
                            <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f0f9ff; border-left: 4px solid #16563f; border-radius: 0 12px 12px 0; margin-bottom: 25px;">
                                <tr>
                                    <td style="padding: 20px;">
                                        <p style="color: #16563f; font-size: 12px; margin: 0 0 10px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">
                                            📩 Réponse de l'équipe support :
                                        </p>
                                        <p style="color: #1f2937; font-size: 15px; line-height: 1.7; margin: 0; white-space: pre-wrap;">{{ response.reponseText }}</p>
                                        <p style="color: #9ca3af; font-size: 12px; margin: 15px 0 0; text-align: right;">
                                            {{ response.createdAt|date('d/m/Y à H:i') }}
                                        </p>
                                    </td>
                                </tr>
                            </table>

                            <!-- Original Question Reminder -->
                            <div style="background-color: #f9fafb; border-radius: 8px; padding: 15px; margin-bottom: 25px;">
                                <p style="color: #6b7280; font-size: 12px; margin: 0 0 8px; text-transform: uppercase; letter-spacing: 0.5px;">Votre question initiale :</p>
                                <p style="color: #6b7280; font-size: 13px; line-height: 1.5; margin: 0; font-style: italic;">{{ question.description|slice(0, 200) }}{% if question.description|length > 200 %}...{% endif %}</p>
                            </div>

                            <!-- CTA Button -->
                            <table width="100%" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td align="center">
                                        <a href="http://127.0.0.1:8000{{ ticketUrl }}" style="display: inline-block; background: linear-gradient(135deg, #16563f 0%, #28a745 100%); color: #ffffff; text-decoration: none; padding: 14px 35px; border-radius: 8px; font-weight: 600; font-size: 16px;">
                                            📋 Voir la conversation complète
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <!-- Reply Notice -->
                            <p style="color: #6b7280; font-size: 14px; line-height: 1.6; margin: 25px 0 0; text-align: center;">
                                Vous pouvez répondre directement depuis votre espace client.
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="background-color: #f9fafb; padding: 25px 30px; text-align: center; border-top: 1px solid #e5e7eb;">
                            <p style="color: #6b7280; font-size: 14px; margin: 0 0 10px;">
                                L'équipe CURAVITA reste à votre disposition.
                            </p>
                            <p style="color: #9ca3af; font-size: 12px; margin: 0;">
                                © 2026 CURAVITA - Votre santé, notre priorité
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
