{% extends 'front/_base.html.twig' %}

{% block title %}Mon Panier - CURAVITA{% endblock %}

{% block stylesheets %}
<style>
.cart-page{max-width:980px;margin:2rem auto;padding:0 1rem}
.card{background:#fff;border:1px solid #dbece4;border-radius:14px;box-shadow:0 12px 30px rgba(12,52,40,.08)}
.head{padding:1rem 1rem .6rem;font-weight:800;color:#124a38}
.body{padding:0 1rem 1rem}
.item{display:grid;grid-template-columns:64px 1fr auto;gap:.7rem;align-items:center;padding:.65rem 0;border-bottom:1px solid #eaf3ef}
.item img{width:64px;height:64px;object-fit:cover;border-radius:9px}
.total{display:flex;justify-content:space-between;padding:.9rem 0;font-weight:800;color:#0f4534}
.actions{display:flex;gap:.6rem;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;border:0;border-radius:10px;padding:.78rem .95rem;cursor:pointer;font-weight:700}
.btn-main{background:linear-gradient(135deg,#0f5f45,#1ca16f);color:#fff}
.btn-soft{background:#eef5f1;color:#33594b}
.input{padding:.7rem .8rem;border:1px solid #cfe2d9;border-radius:10px}
.coupon-form{display:flex;gap:.45rem;align-items:center;flex-wrap:wrap;background:#f5fbf7;border:1px solid #d5ecdf;border-radius:12px;padding:.42rem}
.coupon-form .input{min-width:210px;background:#fff}
.btn-coupon{background:linear-gradient(135deg,#0f5f45,#1ca16f);color:#fff;padding:.7rem .85rem}
.empty{padding:1rem;text-align:center;color:#678277}
</style>
{% endblock %}

{% block main %}
<div class="cart-page">
    <div class="card">
        <div class="head">Mon panier</div>
        <div class="body">
            {% if panier.items|length == 0 %}
                <div class="empty">Votre panier est vide.</div>
            {% else %}
                {% for item in panier.items %}
                    {% set imageSrc = item.image ? ((item.image starts with 'http://') or (item.image starts with 'https://') ? item.image : asset('uploads/produits/' ~ item.image)) : asset('assets/img/default-product.png') %}
                    <div class="item">
                        <img src="{{ imageSrc }}" alt="{{ item.name }}">
                        <div>
                            <strong>{{ item.name }}</strong>
                            <div>{{ item.quantity }} x {{ item.price|number_format(2, ',', ' ') }} DT</div>
                        </div>
                        <strong>{{ item.lineTotal|number_format(2, ',', ' ') }} DT</strong>
                    </div>
                {% endfor %}
                <div class="total"><span>Total</span><span>{{ panier.total|number_format(2, ',', ' ') }} DT</span></div>
            {% endif %}

            <div class="actions">
                <a class="btn btn-soft" href="{{ path('app_products', {'open_panier': 1}) }}">Voir produits</a>
                {% if panier.items|length > 0 %}
                    <form method="get" action="{{ path('app_commande') }}" class="coupon-form">
                        <input class="input" name="coupon_code" placeholder="Code promo">
                        <button class="btn btn-coupon" type="submit">Appliquer</button>
                    </form>
                    <a class="btn btn-main" href="{{ path('app_commande') }}">Passer la commande</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
