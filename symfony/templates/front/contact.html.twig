{% extends 'front/_base.html.twig' %}

{% block title %}Support Client - CURAVITA{% endblock %}

{% block stylesheets %}
<style>
    /* ========== VARIABLES ========== */
    .support-page {
        --primary: #16563f;
        --primary-dark: #0f3d2a;
        --primary-light: #1e7a52;
        --accent: #28a745;
        --gold: #f4c430;
        --glass: rgba(255, 255, 255, 0.1);
        --gradient-1: linear-gradient(135deg, #16563f 0%, #28a745 100%);
        --gradient-2: linear-gradient(135deg, #0f3d2a 0%, #16563f 100%);
        overflow-x: hidden;
    }

    /* ========== HERO SECTION ========== */
    .hero-support {
        min-height: 60vh;
        background: linear-gradient(135deg, #0a1628 0%, #16563f 50%, #0f3d2a 100%);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .hero-support::before {
        content: '';
        position: absolute;
        width: 200%;
        height: 200%;
        background: 
            radial-gradient(circle at 20% 80%, rgba(40, 167, 69, 0.3) 0%, transparent 50%),
            radial-gradient(circle at 80% 20%, rgba(22, 86, 63, 0.4) 0%, transparent 50%),
            radial-gradient(circle at 40% 40%, rgba(244, 196, 48, 0.1) 0%, transparent 30%);
        animation: nebula 20s ease-in-out infinite;
    }

    @keyframes nebula {
        0%, 100% { transform: translate(-10%, -10%) rotate(0deg); }
        50% { transform: translate(10%, 10%) rotate(180deg); }
    }

    /* Floating particles */
    .particles {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: rgba(255, 255, 255, 0.6);
        border-radius: 50%;
        animation: float-particle 15s infinite;
    }

    .particle:nth-child(1) { left: 10%; animation-delay: 0s; }
    .particle:nth-child(2) { left: 20%; animation-delay: 2s; }
    .particle:nth-child(3) { left: 30%; animation-delay: 4s; }
    .particle:nth-child(4) { left: 40%; animation-delay: 1s; }
    .particle:nth-child(5) { left: 50%; animation-delay: 3s; }
    .particle:nth-child(6) { left: 60%; animation-delay: 5s; }
    .particle:nth-child(7) { left: 70%; animation-delay: 2.5s; }
    .particle:nth-child(8) { left: 80%; animation-delay: 4.5s; }

    @keyframes float-particle {
        0% { transform: translateY(100vh) scale(0); opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { transform: translateY(-100vh) scale(1); opacity: 0; }
    }

    /* Hero Decorative Illustrations */
    .hero-illustration {
        position: absolute;
        opacity: 0.12;
        z-index: 1;
        pointer-events: none;
    }

    .hero-illustration.left {
        left: 5%;
        bottom: 10%;
        width: 180px;
        animation: float-illustration 6s ease-in-out infinite;
    }

    .hero-illustration.right {
        right: 5%;
        top: 15%;
        width: 160px;
        animation: float-illustration 6s ease-in-out infinite reverse;
    }

    @keyframes float-illustration {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(3deg); }
    }

    .hero-content-support {
        position: relative;
        z-index: 10;
        text-align: center;
        padding: 2rem;
        max-width: 900px;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--glass);
        backdrop-filter: blur(10px);
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        border: 1px solid rgba(255,255,255,0.2);
        color: var(--gold);
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 2rem;
        animation: slideDown 1s ease;
    }

    .hero-badge::before {
        content: 'ðŸ’¬';
    }

    .hero-title-support {
        font-size: clamp(2.5rem, 8vw, 4rem);
        font-weight: 800;
        color: white;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        animation: slideUp 1s ease 0.2s both;
    }

    .hero-title-support span {
        background: linear-gradient(135deg, var(--gold) 0%, #ffd700 50%, var(--gold) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        background-size: 200% auto;
        animation: shimmer 3s linear infinite;
    }

    @keyframes shimmer {
        0% { background-position: 0% center; }
        100% { background-position: 200% center; }
    }

    .hero-subtitle-support {
        font-size: 1.25rem;
        color: rgba(255,255,255,0.8);
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.8;
        animation: slideUp 1s ease 0.4s both;
    }

    @keyframes slideUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes slideDown {
        from { opacity: 0; transform: translateY(-40px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ========== MAIN SECTION ========== */
    .support-section {
        padding: 5rem 0;
        background: linear-gradient(180deg, #f8faf9 0%, white 100%);
        position: relative;
    }

    .support-section::before {
        content: '';
        position: absolute;
        top: -80px;
        left: 0;
        right: 0;
        height: 80px;
        background: linear-gradient(to bottom right, transparent 49%, #f8faf9 50%);
    }

    .support-container {
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 2rem;
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 3rem;
    }

    @media (max-width: 992px) {
        .support-container { 
            grid-template-columns: 1fr; 
        }
    }

    /* ========== FORM CARD ========== */
    .form-card {
        background: white;
        border-radius: 24px;
        padding: 2.5rem;
        box-shadow: 0 20px 60px rgba(22, 86, 63, 0.1);
        border: 1px solid #eee;
        position: relative;
        overflow: hidden;
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .form-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: var(--gradient-1);
        transform: scaleX(0);
        transition: transform 0.5s ease;
    }

    .form-card:hover::before {
        transform: scaleX(1);
    }

    .form-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 30px 80px rgba(22, 86, 63, 0.15);
    }

    .form-header {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .form-icon {
        width: 70px;
        height: 70px;
        background: var(--gradient-1);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: white;
        transition: transform 0.5s ease;
    }

    .form-card:hover .form-icon {
        transform: scale(1.1) rotate(5deg);
    }

    .form-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--primary);
        margin: 0 0 0.25rem;
    }

    .form-subtitle {
        color: #666;
        margin: 0;
    }

    /* FORM FIELDS */
    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        font-weight: 600;
        color: var(--primary);
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    /* Speech-to-Text Input Wrapper */
    .input-with-speech {
        position: relative;
    }

    .input-with-speech input,
    .input-with-speech textarea {
        width: 100%;
        padding-right: 50px;
    }

    .speech-btn {
        position: absolute;
        right: 8px;
        top: 8px;
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 8px;
        background: transparent;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .speech-btn:hover {
        background: #f0fdf4;
    }

    .speech-btn svg {
        width: 20px;
        height: 20px;
        color: #9ca3af;
        transition: all 0.3s;
    }

    .speech-btn:hover svg {
        color: var(--primary);
    }

    .speech-btn.recording {
        background: #fef2f2;
        animation: pulse-recording 1.5s ease-in-out infinite;
    }

    .speech-btn.recording svg {
        color: #ef4444;
    }

    @keyframes pulse-recording {
        0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
        50% { box-shadow: 0 0 0 8px rgba(239, 68, 68, 0); }
    }

    .speech-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Speech status indicator */
    .speech-status {
        font-size: 0.75rem;
        color: #ef4444;
        margin-top: 0.25rem;
        display: none;
        align-items: center;
        gap: 0.25rem;
    }

    .speech-status.active {
        display: flex;
    }

    .speech-status::before {
        content: '';
        width: 8px;
        height: 8px;
        background: #ef4444;
        border-radius: 50%;
        animation: blink 1s infinite;
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 1rem 1.25rem;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        font-size: 1rem;
        font-family: inherit;
        background: #f9fafb;
        transition: all 0.3s ease;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        outline: none;
        border-color: var(--primary);
        background: white;
        box-shadow: 0 0 0 4px rgba(22, 86, 63, 0.1);
    }

    .form-group textarea {
        min-height: 140px;
        resize: vertical;
    }

    /* UPLOAD ZONE */
    .upload-zone {
        border: 2px dashed #d1d5db;
        border-radius: 16px;
        padding: 2rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        background: #fafafa;
    }

    .upload-zone:hover {
        border-color: var(--primary);
        background: #f0fdf4;
    }

    .upload-zone input { display: none; }

    .upload-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #dcfce7, #bbf7d0);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 1.5rem;
        color: var(--primary);
    }

    .upload-text {
        font-weight: 600;
        color: var(--primary);
        margin-bottom: 0.25rem;
    }

    .upload-hint {
        color: #9ca3af;
        font-size: 0.875rem;
    }

    #fileDisplay {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        background: #dcfce7;
        border-radius: 8px;
        color: #166534;
        font-weight: 600;
        display: none;
    }

    #fileDisplay.show { display: block; }

    /* SUBMIT BUTTON */
    .btn-submit {
        width: 100%;
        padding: 1.25rem 2rem;
        background: var(--gradient-1);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(22, 86, 63, 0.3);
    }

    .btn-submit:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(22, 86, 63, 0.4);
    }

    /* ========== TICKETS CARD ========== */
    .tickets-card {
        background: white;
        border-radius: 24px;
        padding: 2rem;
        box-shadow: 0 20px 60px rgba(22, 86, 63, 0.1);
        border: 1px solid #eee;
    }

    .tickets-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #f3f4f6;
    }

    .tickets-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--primary);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .tickets-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        height: 36px;
        background: var(--gradient-1);
        color: white;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 800;
    }

    /* FLASH MESSAGES */
    .flash-msg {
        padding: 1rem 1.25rem;
        border-radius: 12px;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
    }

    .flash-msg.success {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #86efac;
    }

    .flash-msg.error {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fca5a5;
    }

    /* TICKETS LIST */
    .tickets-list {
        max-height: 650px;
        overflow-y: auto;
    }

    .tickets-list::-webkit-scrollbar { width: 6px; }
    .tickets-list::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 3px; }
    .tickets-list::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 3px; }

    /* TICKET ITEM */
    .ticket-item {
        background: #fafafa;
        border: 2px solid #e5e7eb;
        border-radius: 16px;
        padding: 1.25rem;
        padding-bottom: 3rem;
        margin-bottom: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

    .ticket-item:hover {
        border-color: var(--primary);
        background: white;
        transform: translateX(8px);
        box-shadow: 0 10px 30px rgba(22, 86, 63, 0.1);
    }

    .ticket-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
    }

    .ticket-id {
        background: var(--gradient-1);
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .ticket-date {
        color: #9ca3af;
        font-size: 0.85rem;
    }

    .ticket-subject {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1f2937;
        margin: 0 0 0.5rem;
    }

    .ticket-desc {
        color: #6b7280;
        font-size: 0.9rem;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .ticket-file {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.75rem;
        padding: 0.4rem 0.75rem;
        background: #ecfdf5;
        color: #059669;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
    }

    .ticket-file:hover {
        background: var(--primary);
        color: white;
    }

    .ticket-bottom {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #e5e7eb;
    }

    /* STATUS BADGES */
    .status-badge {
        padding: 0.35rem 0.9rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-badge.ouvert { background: #dcfce7; color: #166534; }
    .status-badge.en_cours { background: #fef3c7; color: #92400e; }
    .status-badge.ferme { background: #f3f4f6; color: #4b5563; }
    .status-badge.resolu { background: #d1fae5; color: #065f46; }

    /* ACTION BUTTONS - COMPACT & ALIGNED */
    .actions-btns {
        display: flex;
        align-items: center;
        gap: 6px;
        position: absolute;
        bottom: 10px;
        right: 10px;
    }

    .actions-btns form {
        display: flex;
        margin: 0;
        padding: 0;
    }

    .action-btn {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid;
        padding: 0;
        margin: 0;
    }

    .action-btn svg {
        width: 12px;
        height: 12px;
    }

    .action-btn.edit {
        background: #f0fdf4;
        color: #16563f;
        border-color: #a7f3d0;
    }

    .action-btn.edit:hover {
        background: #16563f;
        color: white;
        border-color: #16563f;
        transform: scale(1.08);
    }

    .action-btn.delete {
        background: #fef2f2;
        color: #ef4444;
        border-color: #fecaca;
    }

    .action-btn.delete:hover {
        background: #ef4444;
        color: white;
        border-color: #ef4444;
        transform: scale(1.08);
    }

    /* EMPTY STATE */
    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
    }

    .empty-icon {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #f0fdf4, #dcfce7);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        font-size: 2.5rem;
        color: var(--accent);
    }

    .empty-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 0.5rem;
    }

    .empty-text {
        color: #9ca3af;
    }

    /* ========== FAQ SECTION ========== */
    .faq-section {
        padding: 5rem 0;
        background: linear-gradient(180deg, white 0%, #f8faf9 100%);
    }

    .faq-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .faq-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .faq-illustration {
        display: block;
        width: 120px;
        height: 120px;
        margin: 0 auto 1.5rem;
    }

    .faq-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--gradient-1);
        color: white;
        padding: 0.5rem 1.25rem;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 1rem;
    }

    .faq-title {
        font-size: 2.25rem;
        font-weight: 800;
        color: var(--primary);
        margin: 0 0 0.75rem;
    }

    .faq-subtitle {
        color: #6b7280;
        font-size: 1.1rem;
        margin: 0;
    }

    .faq-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .faq-item {
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .faq-item:hover {
        border-color: var(--primary);
        box-shadow: 0 10px 30px rgba(22, 86, 63, 0.1);
    }

    .faq-item.active {
        border-color: var(--primary);
        box-shadow: 0 10px 40px rgba(22, 86, 63, 0.15);
    }

    .faq-question {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1.5rem;
        cursor: pointer;
        background: white;
        transition: background 0.3s;
    }

    .faq-item.active .faq-question {
        background: #f0fdf4;
    }

    .faq-question-text {
        font-size: 1.05rem;
        font-weight: 600;
        color: #1f2937;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .faq-question-icon {
        width: 32px;
        height: 32px;
        background: var(--gradient-1);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .faq-toggle {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
        flex-shrink: 0;
    }

    .faq-toggle svg {
        width: 14px;
        height: 14px;
        color: #6b7280;
        transition: transform 0.3s;
    }

    .faq-item.active .faq-toggle {
        background: var(--primary);
    }

    .faq-item.active .faq-toggle svg {
        color: white;
        transform: rotate(180deg);
    }

    .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s ease, padding 0.3s ease;
    }

    .faq-item.active .faq-answer {
        max-height: 300px;
    }

    .faq-answer-content {
        padding: 0 1.5rem 1.5rem;
        padding-left: 4rem;
        color: #4b5563;
        line-height: 1.7;
        font-size: 0.95rem;
    }

    /* ========== PROFANITY FILTER NOTIFICATION ========== */
    .profanity-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

    .profanity-overlay.show {
        opacity: 1;
        visibility: visible;
    }

    .profanity-modal {
        background: white;
        border-radius: 20px;
        padding: 2rem;
        max-width: 450px;
        width: 90%;
        text-align: center;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.25);
