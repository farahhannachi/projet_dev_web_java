<script>
// ========== SPEECH-TO-TEXT FUNCTIONALITY ==========
let currentRecognition = null;
let currentButton = null;
let silenceTimer = null;
const SILENCE_TIMEOUT = 2000; // 2 seconds of silence to stop

const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

function toggleSpeech(targetId, button) {
    // Check browser support
    if (!SpeechRecognition) {
        alert('DÃ©solÃ©, votre navigateur ne supporte pas la reconnaissance vocale. Utilisez Chrome, Edge ou Safari.');
        return;
    }

    // If already recording, stop it
    if (currentRecognition && currentButton === button) {
        stopSpeech();
        return;
    }

    // Stop any previous recording
    if (currentRecognition) {
        stopSpeech();
    }

    // Start new recording
    startSpeech(targetId, button);
}

function startSpeech(targetId, button) {
    const recognition = new SpeechRecognition();
    recognition.lang = 'fr-FR';
    recognition.continuous = true;
    recognition.interimResults = true;

    const targetField = document.getElementById(targetId);
    const statusEl = document.getElementById('speech-status-' + targetId);
    let finalTranscript = '';
    const existingText = targetField.value;

    // Visual feedback
    button.classList.add('recording');
    statusEl.classList.add('active');
    currentButton = button;
    currentRecognition = recognition;

    // Reset silence timer
    function resetSilenceTimer() {
        if (silenceTimer) clearTimeout(silenceTimer);
        silenceTimer = setTimeout(() => {
            console.log('Silence detected, stopping...');
            stopSpeech();
        }, SILENCE_TIMEOUT);
    }

    recognition.onresult = (event) => {
        resetSilenceTimer();
        
        let interimTranscript = '';
        for (let i = event.resultIndex; i < event.results.length; i++) {
            const transcript = event.results[i][0].transcript;
            if (event.results[i].isFinal) {
                finalTranscript += transcript + ' ';
            } else {
                interimTranscript += transcript;
            }
        }

        // Update field with existing text + new text
        const separator = existingText && !existingText.endsWith(' ') ? ' ' : '';
        targetField.value = existingText + separator + finalTranscript + interimTranscript;
    };

    recognition.onerror = (event) => {
        console.error('Speech recognition error:', event.error);
        if (event.error === 'not-allowed') {
            alert('Veuillez autoriser l\'accÃ¨s au microphone pour utiliser cette fonctionnalitÃ©.');
        }
        stopSpeech();
    };

    recognition.onend = () => {
        // Clean up
        if (currentButton === button) {
            stopSpeech();
        }
    };

    recognition.start();
    resetSilenceTimer();
}

function stopSpeech() {
    if (silenceTimer) {
        clearTimeout(silenceTimer);
        silenceTimer = null;
    }

    if (currentRecognition) {
        currentRecognition.stop();
        currentRecognition = null;
    }

    if (currentButton) {
        currentButton.classList.remove('recording');
        const targetId = currentButton.onclick.toString().match(/'([^']+)'/)[1];
        const statusEl = document.getElementById('speech-status-' + targetId);
        if (statusEl) statusEl.classList.remove('active');
        currentButton = null;
    }
}

function displayFileName(input) {
    const display = document.getElementById('fileDisplay');
    if (input.files && input.files[0]) {
        display.textContent = 'âœ… ' + input.files[0].name;
        display.classList.add('show');
    } else {
        display.classList.remove('show');
    }
}

function toggleFaq(element) {
    const faqItem = element.parentElement;
    const isActive = faqItem.classList.contains('active');
    
    // Close all FAQ items
    document.querySelectorAll('.faq-item').forEach(item => {
        item.classList.remove('active');
    });
    
    // Open clicked item if it wasn't active
    if (!isActive) {
        faqItem.classList.add('active');
    }
}

// ========== PROFANITY FILTER FUNCTIONALITY ==========
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('ticketForm');
    if (!form) return;

    // Add loading overlay to form
    const formCard = form.closest('.form-card');
    formCard.style.position = 'relative';
    
    const loadingOverlay = document.createElement('div');
    loadingOverlay.className = 'form-loading';
    loadingOverlay.innerHTML = `
        <div class="loading-spinner"></div>
        <div class="loading-text">VÃ©rification du contenu...</div>
    `;
    formCard.appendChild(loadingOverlay);

    // Create profanity modal
    const profanityModal = document.createElement('div');
    profanityModal.className = 'profanity-overlay';
    profanityModal.id = 'profanityModal';
    profanityModal.innerHTML = `
        <div class="profanity-modal">
            <div class="profanity-icon">ðŸš«</div>
            <h3 class="profanity-title">Contenu inappropriÃ© dÃ©tectÃ©</h3>
            <p class="profanity-message">Votre message contient des termes inappropriÃ©s. Veuillez reformuler votre texte avant de soumettre.</p>
            <div class="profanity-field" id="profanityFieldInfo">
                <div class="profanity-field-label">Champ concernÃ©</div>
                <div class="profanity-field-text" id="profanityFieldText"></div>
            </div>
            <button class="profanity-btn" onclick="closeProfanityModal()">Compris, je corrige</button>
        </div>
    `;
    document.body.appendChild(profanityModal);

    // Intercept form submission
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const objetField = document.getElementById('question_objet');
        const descriptionField = document.getElementById('question_description');
        
        const objetValue = objetField ? objetField.value.trim() : '';
        const descriptionValue = descriptionField ? descriptionField.value.trim() : '';

        // Show loading
        loadingOverlay.classList.add('show');

        try {
            // Check objet field
            if (objetValue) {
                const objetResult = await checkProfanity(objetValue);
                if (objetResult.has_profanity) {
                    loadingOverlay.classList.remove('show');
                    showProfanityError('Objet', objetResult.censored || objetValue, 'question_objet');
                    return;
                }
            }

            // Check description field
            if (descriptionValue) {
                const descResult = await checkProfanity(descriptionValue);
                if (descResult.has_profanity) {
                    loadingOverlay.classList.remove('show');
                    showProfanityError('Description', descResult.censored || descriptionValue, 'question_description');
                    return;
                }
            }

            // All clear - submit the form
            loadingOverlay.classList.remove('show');
            form.submit();

        } catch (error) {
            console.error('Profanity check error:', error);
            // On error, allow submission (graceful fallback)
            loadingOverlay.classList.remove('show');
            form.submit();
        }
    });
});

async function checkProfanity(text) {
    const response = await fetch('/api/check-profanity', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({ text: text })
    });

    if (!response.ok) {
        throw new Error('API error');
    }

    return await response.json();
}

function showProfanityError(fieldName, censoredText, fieldId) {
    const modal = document.getElementById('profanityModal');
    const fieldText = document.getElementById('profanityFieldText');
    const fieldLabel = modal.querySelector('.profanity-field-label');
    
    fieldLabel.textContent = fieldName;
    fieldText.textContent = censoredText;
    
    // Highlight the problematic field
    const fieldWrapper = document.getElementById(fieldId).closest('.form-group');
    if (fieldWrapper) {
        fieldWrapper.classList.add('field-error');
        setTimeout(() => fieldWrapper.classList.remove('field-error'), 1000);
    }
    
    modal.classList.add('show');
    modal.dataset.focusField = fieldId;
}

function closeProfanityModal() {
    const modal = document.getElementById('profanityModal');
    modal.classList.remove('show');
    
    // Focus on the problematic field
    const fieldId = modal.dataset.focusField;
    if (fieldId) {
        const field = document.getElementById(fieldId);
        if (field) {
            field.focus();
            field.select();
        }
    }
}
</script>
