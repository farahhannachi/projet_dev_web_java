    .profanity-field-label {
        font-size: 0.8rem;
        color: #991b1b;
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .profanity-field-text {
        color: #dc2626;
        font-weight: 500;
    }

    .profanity-btn {
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
