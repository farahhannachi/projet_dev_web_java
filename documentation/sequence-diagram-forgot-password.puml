@startuml Forgot Password Sequence Diagram
!theme plain
title Diagramme de Séquence - Mot de Passe Oublié (CURAVITA)

actor "Utilisateur" as User
participant "ResetPasswordController" as Controller
participant "ResetPasswordRequestType" as RequestForm
participant "ResetPasswordType" as ResetForm
participant "UtilisateurRepository" as Repository
participant "Utilisateur (Entity)" as Entity
participant "EntityManager" as EntityManager
participant "Mailer" as Mailer
participant "UserPasswordHasher" as Hasher

== Phase 1: Demande de réinitialisation ==

User -> Controller: POST /forgot-password (email)
Controller -> RequestForm: createForm(ResetPasswordRequestType)
RequestForm --> Controller: Form instance

alt Formulaire invalide
    Controller -> User: Affiche forgot_password.html.twig (avec erreurs)
else Formulaire valide
    Controller -> Repository: findOneBy(['email' => email])
    
    alt Utilisateur non trouvé
        Repository --> Controller: null
        Controller -> User: Message générique (pour éviter énumération)
        Controller -> User: Redirige vers forgot_password
    else Utilisateur trouvé
        Repository --> Controller: Utilisateur object
        
        activate Controller
        Controller -> Controller: bin2hex(random_bytes(32))
        Controller -> Controller: new DateTime('+1 hour')
        deactivate Controller
        
        Controller -> Entity: setResetToken(token)
        Controller -> Entity: setResetTokenExpiresAt(expiresAt)
        Controller -> EntityManager: flush()
        EntityManager --> Entity: Token enregistré
        
        Controller -> Controller: generateUrl('app_reset_password', {token})
        
        Controller -> Mailer: send(email avec resetUrl)
        Mailer --> Controller: Email envoyé
        
        Controller -> User: Message flash succès
        Controller -> User: Redirige vers forgot_password
    end
end

== Phase 2: Réinitialisation du mot de passe ==

User -> Controller: GET /reset-password/{token}
Controller -> Repository: findOneBy(['resetToken' => token])

alt Token invalide
    Repository --> Controller: null
    Controller -> User: Message erreur (token invalide)
    Controller -> User: Redirige vers forgot_password
else Token trouvé
    Repository --> Controller: Utilisateur object
    
    Controller -> Entity: isResetTokenValid()
    
    alt Token expiré
        Entity --> Controller: false
        Controller -> User: Message erreur (expiré)
        Controller -> User: Redirige vers forgot_password
    else Token valide
        Entity --> Controller: true
        
        Controller -> ResetForm: createForm(ResetPasswordType)
        ResetForm --> Controller: Form instance
        Controller -> User: Affiche reset_password.html.twig
        
        User -> Controller: POST /reset-password/{token} (newPassword)
        Controller -> ResetForm: handleRequest(request)
        
        alt Formulaire invalide
            Controller -> User: Affiche reset_password.html.twig (avec erreurs)
        else Formulaire valide
            Controller -> Hasher: hashPassword(user, newPassword)
            Hasher --> Controller: hashedPassword
            
            Controller -> Entity: setMotDePasse(hashedPassword)
            Controller -> Entity: setResetToken(null)
            Controller -> Entity: setResetTokenExpiresAt(null)
            Controller -> EntityManager: flush()
            EntityManager --> Entity: Mot de passe mis à jour
            
            Controller -> User: Message flash succès
            Controller -> User: Redirige vers login
        end
    end
end

@enduml
