<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.NewPasswordController" styleClass="lol-root">

    <!-- Floating Background Shapes -->
    <StackPane fx:id="backgroundPane" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" styleClass="floating-bg">
        <StackPane styleClass="floating-circle" translateX="-100" translateY="50"/>
        <StackPane styleClass="floating-circle" translateX="100" translateY="-80"/>
        <StackPane styleClass="floating-circle" translateX="-50" translateY="150"/>
        <StackPane styleClass="floating-circle" translateX="150" translateY="100"/>
    </StackPane>

    <!-- Main Container Card -->
    <StackPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <StackPane styleClass="lol-card" maxWidth="900" maxHeight="550">

            <!-- New Password Form Panel -->
            <StackPane styleClass="form-panel-left">
                <VBox spacing="20" alignment="CENTER" prefWidth="380">
                    <!-- Header -->
                    <Text text="Create New Password" styleClass="lol-title"/>
                    <Text text="Enter your new password" styleClass="lol-subtitle"/>

                    <!-- Password Inputs -->
                    <VBox spacing="15" prefWidth="300">
                        <!-- New Password Field -->
                        <VBox spacing="5">
                            <PasswordField fx:id="newPasswordInput" promptText="New Password"
                                         styleClass="lol-input" onKeyReleased="#validatePasswordStrength"/>

                            <!-- Password Requirements -->
                            <VBox spacing="4" styleClass="password-requirements">
                                <Label fx:id="reqLength" text="✗ At least 8 characters" styleClass="req-unchecked"/>
                                <Label fx:id="reqUppercase" text="✗ Uppercase letter (A-Z)" styleClass="req-unchecked"/>
                                <Label fx:id="reqNumber" text="✗ Number (0-9)" styleClass="req-unchecked"/>
                            </VBox>

                            <Label fx:id="passwordError" text="" styleClass="validation-error-small"/>
                        </VBox>

                        <!-- Confirm Password Field -->
                        <VBox spacing="5">
                            <PasswordField fx:id="confirmPasswordInput" promptText="Confirm Password"
                                         styleClass="lol-input" onKeyReleased="#validateConfirmPassword"/>
                            <Label fx:id="confirmError" text="" styleClass="validation-error-small"/>
                        </VBox>
                    </VBox>

                    <!-- Error Messages -->
                    <Label fx:id="errorLabel" text="" styleClass="lol-error"/>

                    <!-- Success Message (Hidden by default) -->
                    <VBox fx:id="successBox" visible="false" managed="false" spacing="10" alignment="CENTER"
                           styleClass="success-box">
                        <Label text="✓ Password Reset Successfully!" styleClass="success-box-text"/>
                        <Label text="Redirecting to Sign In..." styleClass="success-box-subtext"/>
                    </VBox>

                    <!-- Reset Button -->
                    <Button fx:id="resetButton" text="RESET PASSWORD" onAction="#handleResetPassword"
                            styleClass="lol-button-primary" maxWidth="280" prefHeight="45"/>

                    <!-- Back to Sign In Link -->
                    <HBox spacing="5" alignment="CENTER">
                        <Text text="Back to" styleClass="lol-text-small"/>
                        <Button text="Sign In" onAction="#handleBackToSignIn" styleClass="lol-link-button"/>
                    </HBox>
                </VBox>
            </StackPane>
        </StackPane>
    </StackPane>

</AnchorPane>

