<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.ResetPasswordController" styleClass="lol-root">

    <!-- Floating Background Shapes -->
    <StackPane fx:id="backgroundPane" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" styleClass="floating-bg">
        <StackPane styleClass="floating-circle" translateX="-100" translateY="50"/>
        <StackPane styleClass="floating-circle" translateX="100" translateY="-80"/>
        <StackPane styleClass="floating-circle" translateX="-50" translateY="150"/>
        <StackPane styleClass="floating-circle" translateX="150" translateY="100"/>
    </StackPane>

    <!-- Main Container Card -->
    <StackPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <StackPane styleClass="lol-card" maxWidth="900" maxHeight="550">

            <!-- Reset Password Form Panel -->
            <StackPane styleClass="form-panel-left">
                <VBox spacing="20" alignment="CENTER" prefWidth="380">
                    <!-- Header -->
                    <Text text="Reset Password" styleClass="lol-title"/>
                    <Text text="Enter your email to receive a reset link" styleClass="lol-subtitle" fx:id="headerSubtitle"/>

                    <!-- Email Input Section -->
                    <VBox spacing="15" prefWidth="300" fx:id="emailSection">
                        <TextField fx:id="emailInput" promptText="Email" styleClass="lol-input"/>
                    </VBox>

                    <!-- Token Input Section (Hidden by default) -->
                    <VBox spacing="15" prefWidth="300" fx:id="tokenSection" visible="false" managed="false">
                        <TextField fx:id="tokenInput" promptText="Enter reset token" styleClass="lol-input"/>
                    </VBox>

                    <!-- Error Messages -->
                    <Label fx:id="errorLabel" text="" styleClass="lol-error"/>

                    <!-- Success Message (Hidden by default) -->
                    <VBox fx:id="successBox" visible="false" managed="false" spacing="10" alignment="CENTER"
                           styleClass="success-box">
                        <Label text="✓ Email Sent Successfully!" styleClass="success-box-text"/>
                        <Label text="Please check your inbox for the reset link" styleClass="success-box-subtext"/>
                    </VBox>

                    <!-- Send / Reset Button -->
                    <Button fx:id="sendButton" text="SEND RESET LINK" onAction="#handleSendReset"
                            styleClass="lol-button-primary" maxWidth="280" prefHeight="45"/>

                    <!-- Back to Sign In Link -->
                    <HBox spacing="5" alignment="CENTER">
                        <Hyperlink fx:id="backToSignInLink" text="Back to Sign In" onAction="#handleBackToSignIn"/>
                    </HBox>
                </VBox>
            </StackPane>
        </StackPane>
    </StackPane>
</AnchorPane>

