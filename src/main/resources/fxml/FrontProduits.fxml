<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.controller.FrontProduitsController"
        fitToWidth="true" fitToHeight="true" pannable="true"
        hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" styleClass="page-scroll">
    <content>
    <BorderPane styleClass="admin-root">
    <top>
        <VBox spacing="12" styleClass="admin-header-wrap">
            <HBox styleClass="navbar-pill" alignment="CENTER">
                <Label text="CuraVita" styleClass="logo-text"/>
                <Region HBox.hgrow="SOMETIMES"/>
                <HBox styleClass="menu-container" alignment="CENTER">
                    <Button text="Accueil" styleClass="menu-item" onAction="#goHome"/>
                    <Button text="Produits" styleClass="menu-item" onAction="#showFrontProduits"/>
                    <Button text="Panier" styleClass="menu-item" onAction="#showFrontPanier"/>
                    <Button text="Commandes" styleClass="menu-item" onAction="#showFrontTracking"/>
                    <Button text="Ordonnance" styleClass="menu-item"/>
                    <Button text="Traitement" styleClass="menu-item"/>
                    <Button text="Guide Sant&#233;" styleClass="menu-item"/>
                    <Button text="Contact" styleClass="menu-item"/>
                    <Button text="&#192; propos" styleClass="menu-item"/>
                </HBox>
                <Region HBox.hgrow="SOMETIMES"/>

                <StackPane>
                    <HBox styleClass="icon-container" alignment="CENTER">
                        <Button text="&#128269;" styleClass="icon-button" onAction="#handleSearch"/>
                        <Button fx:id="profileButton" text="&#128100;" styleClass="icon-button" onAction="#toggleProfileDropdown"/>
                    </HBox>

                    <VBox fx:id="profileDropdown" styleClass="profile-dropdown" visible="false" managed="false">
                        <VBox.margin>
                            <Insets top="45" right="0" bottom="0" left="0"/>
                        </VBox.margin>
                        <Button text="Profil" styleClass="dropdown-item" onAction="#showProfile"/>
                        <Button fx:id="dashboardMenuItem" text="Dashboard" styleClass="dropdown-item" onAction="#goToDashboard"/>
                        <Button text="Logout" styleClass="dropdown-item" onAction="#logout"/>
                    </VBox>
                </StackPane>
            </HBox>

            <HBox spacing="10" styleClass="filters-row">
                <TextField fx:id="searchField" promptText="Recherche produit..." HBox.hgrow="ALWAYS" styleClass="filter-field"/>
                <ComboBox fx:id="categorieFilter" promptText="Categorie" styleClass="filter-field"/>
                <ComboBox fx:id="stockFilter" promptText="Stock" styleClass="filter-field"/>
                <ComboBox fx:id="sortFilter" promptText="Tri" styleClass="filter-field"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="14" style="-fx-padding: 14;">
            <VBox HBox.hgrow="ALWAYS" styleClass="table-card">
                <ScrollPane fitToWidth="true" styleClass="admin-table" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="productsFlow" hgap="12" vgap="12" prefWrapLength="920" style="-fx-padding: 12;"/>
                    </content>
                </ScrollPane>
            </VBox>

            <VBox prefWidth="340" spacing="10" styleClass="admin-modal">
                <Label text="Panier" styleClass="admin-modal-title"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Articles:" styleClass="field-label"/>
                    <Label fx:id="cartCountLabel" text="0" styleClass="admin-meta-badge"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="cartTotalLabel" text="0.00 DT" styleClass="stat-value"/>
                </HBox>

                <Separator/>
                <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="inner-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="cartItemsBox" spacing="6"/>
                    </content>
                </ScrollPane>

                <HBox spacing="8">
                    <Button text="Vider" onAction="#handleClearCart" styleClass="btn-admin-danger"/>
                    <Button text="Passer commande" onAction="#goToCommande" styleClass="btn-admin-primary" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
        </BorderPane>
    </content>
</ScrollPane>
