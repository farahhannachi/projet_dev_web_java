<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Circle?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.LoginController" styleClass="lol-root">

    <!-- Floating Background Shapes -->
    <StackPane fx:id="backgroundPane" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" 
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" styleClass="floating-bg">
        <StackPane styleClass="floating-circle" translateX="-100" translateY="50"/>
        <StackPane styleClass="floating-circle" translateX="100" translateY="-80"/>
        <StackPane styleClass="floating-circle" translateX="-50" translateY="150"/>
        <StackPane styleClass="floating-circle" translateX="150" translateY="100"/>
    </StackPane>
    
    <!-- Main Container Card -->
    <StackPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" 
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        
        <StackPane styleClass="lol-card" maxWidth="900" maxHeight="550">
            
            <!-- Content Container with Clip -->
            <StackPane fx:id="cardContent" styleClass="card-content-container">
                
                <!-- Sign In Form Panel (LEFT) -->
                <StackPane fx:id="signInPanel" styleClass="form-panel-left">
                    <VBox spacing="20" alignment="CENTER" prefWidth="380">
                        <Text text="Welcome Back" styleClass="lol-title"/>
                        <Text text="Sign in to continue" styleClass="lol-subtitle"/>
                        
                        <VBox spacing="15" prefWidth="300">
                            <TextField fx:id="loginEmail" promptText="Email" styleClass="lol-input"/>
                            <PasswordField fx:id="loginPassword" promptText="Password" styleClass="lol-input"/>
                        </VBox>
                        
                        <Label fx:id="loginError" text="" styleClass="lol-error"/>
                        
                        <Button text="SIGN IN" onAction="#handleLogin" styleClass="lol-button-primary" 
                                maxWidth="280" prefHeight="45"/>
                        
                        <HBox spacing="5" alignment="CENTER">
                            <Text text="Don't have an account?" styleClass="lol-text-small"/>
                            <Button text="Sign Up" onAction="#showSignUp" styleClass="lol-link-button"/>
                        </HBox>
                    </VBox>
                </StackPane>
                
                <!-- Sign Up Form Panel (RIGHT) -->
                <StackPane fx:id="signUpPanel" styleClass="form-panel-right">
                    <VBox spacing="20" alignment="CENTER" prefWidth="380">
                        <Text text="Create Account" styleClass="lol-title"/>
                        <Text text="Join us today" styleClass="lol-subtitle"/>
                        
                        <VBox spacing="15" prefWidth="300">
                            <!-- Name Field -->
                            <VBox spacing="5">
                                <TextField fx:id="signupName" promptText="Full Name" styleClass="lol-input" onKeyReleased="#validateSignupName"/>
                                <Label fx:id="signupNameError" text="" styleClass="validation-error-small"/>
                            </VBox>

                            <!-- Email Field -->
                            <VBox spacing="5">
                                <TextField fx:id="signupEmail" promptText="Email" styleClass="lol-input" onKeyReleased="#validateSignupEmail"/>
                                <Label fx:id="signupEmailError" text="" styleClass="validation-error-small"/>
                            </VBox>

                            <!-- Password Field with Strength Indicator -->
                            <VBox spacing="8" prefWidth="300">
                                <PasswordField fx:id="signupPassword" promptText="Password" styleClass="lol-input" onKeyReleased="#validatePasswordStrength"/>

                                <!-- Password Strength Progress Indicator -->
                                <VBox spacing="5">
                                    <!-- Strength Label -->
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="Strength:" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                                        <Label fx:id="passwordStrengthLabel" text="" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                                    </HBox>

                                    <!-- 3 Circles Progress Indicator -->
                                    <HBox spacing="8" alignment="CENTER_LEFT" prefWidth="280">
                                        <Circle fx:id="strengthCircle1" radius="8" styleClass="strength-circle-empty"/>
                                        <Circle fx:id="strengthCircle2" radius="8" styleClass="strength-circle-empty"/>
                                        <Circle fx:id="strengthCircle3" radius="8" styleClass="strength-circle-empty"/>
                                    </HBox>
                                </VBox>

                                <!-- Password Requirements -->
                                <VBox spacing="4" styleClass="password-requirements">
                                    <Label fx:id="reqLength" text="✗ Au moins 6 caractères" styleClass="req-unchecked"/>
                                    <Label fx:id="reqUppercase" text="✗ Majuscule (A-Z)" styleClass="req-unchecked"/>
                                    <Label fx:id="reqNumber" text="✗ Chiffre (0-9)" styleClass="req-unchecked"/>
                                    <Label fx:id="reqSpecial" text="○ Spécial (* - + @ #)" styleClass="req-optional"/>
                                </VBox>

                                <Label fx:id="signupPasswordError" text="" styleClass="validation-error-small"/>
                            </VBox>
                        </VBox>
                        
                        <Label fx:id="signupError" text="" styleClass="lol-error"/>
                        
                        <Button text="SIGN UP" onAction="#handleSignup" styleClass="lol-button-primary" 
                                maxWidth="280" prefHeight="45"/>
                        
                        <HBox spacing="5" alignment="CENTER">
                            <Text text="Already have an account?" styleClass="lol-text-small"/>
                            <Button text="Sign In" onAction="#showSignIn" styleClass="lol-link-button"/>
                        </HBox>
                    </VBox>
                </StackPane>
                
            </StackPane>
        </StackPane>
    </StackPane>
    
    <!-- Banned Modal Overlay -->
    <StackPane fx:id="bannedOverlayPane" visible="false" managed="false" style="-fx-background-color: rgba(0,0,0,0.4);" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <VBox fx:id="bannedModal" visible="false" managed="false" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 50; -fx-spacing: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 10); -fx-min-width: 500; -fx-alignment: CENTER;" StackPane.alignment="CENTER">
            <children>
                <Label text="🔒 Accès Refusé" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #dc2626; -fx-alignment: CENTER; -fx-text-alignment: CENTER;"/>
                <Label text="Votre compte est bloqué" style="-fx-font-size: 20; -fx-text-fill: #666; -fx-wrap-text: true; -fx-alignment: CENTER; -fx-text-alignment: CENTER;"/>
                <Label text="Vous ne pouvez pas vous connecter." style="-fx-font-size: 16; -fx-text-fill: #999; -fx-alignment: CENTER; -fx-text-alignment: CENTER;"/>
                <Button text="OK" onAction="#closeBannedModal" style="-fx-padding: 15 60; -fx-font-size: 14; -fx-background-color: #1f6f54; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
            </children>
        </VBox>
    </StackPane>

    <!-- 2FA Modal Overlay -->
    <StackPane fx:id="twoFactorOverlayPane" visible="false" managed="false" styleClass="two-factor-login-overlay" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <VBox fx:id="twoFactorModal" visible="false" managed="false" styleClass="two-factor-login-modal" StackPane.alignment="CENTER">
            <Label text="Two-Factor Authentication" styleClass="two-factor-login-title"/>
            <Label text="Enter the 6-digit code from your authenticator app to finish signing in." styleClass="two-factor-login-subtitle"/>
            <Label fx:id="twoFactorUserLabel" text="" styleClass="two-factor-login-account"/>
            <TextField fx:id="twoFactorCodeField" promptText="123456" styleClass="lol-input two-factor-login-input" maxWidth="220"/>
            <Label fx:id="twoFactorError" text="" styleClass="lol-error"/>
            <HBox alignment="CENTER" spacing="12" styleClass="two-factor-login-actions">
                <Button text="VERIFY" onAction="#handleVerifyTwoFactor" styleClass="two-factor-login-verify" prefWidth="140" prefHeight="42"/>
                <Button text="CANCEL" onAction="#closeTwoFactorModal" styleClass="two-factor-login-cancel" prefWidth="120" prefHeight="42"/>
            </HBox>
        </VBox>
    </StackPane>

</AnchorPane>
