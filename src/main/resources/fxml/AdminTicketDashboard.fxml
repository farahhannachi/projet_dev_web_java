<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="admin-dashboard-root">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox>
            <Label text="Gestion des Tickets" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
            <Label text="Administration > Support > Tickets" style="-fx-text-fill: #6c757d;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="+ Exporter Rapport" styleClass="btn-admin-primary" />
    </HBox>

    <!-- KPI Cards -->
    <HBox spacing="20">
        <!-- Total Tickets -->
        <HBox styleClass="kpi-card, kpi-card-primary" HBox.hgrow="ALWAYS">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="TOTAL TICKETS" styleClass="kpi-title" />
                <Label text="1,204" styleClass="kpi-value" />
            </VBox>
            <!-- Placeholder for Icon -->
            <StackPane>
                <Circle radius="25" fill="#f8f9fa" />
                <Label text="&#128203;" style="-fx-font-size: 24;" />
            </StackPane>
        </HBox>

        <!-- New Tickets -->
        <HBox styleClass="kpi-card, kpi-card-success" HBox.hgrow="ALWAYS">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="NOUVEAUX" styleClass="kpi-title" />
                <Label text="45" styleClass="kpi-value" />
            </VBox>
            <StackPane>
                <Circle radius="25" fill="#f8f9fa" />
                <Label text="&#9989;" style="-fx-font-size: 24;" />
            </StackPane>
        </HBox>

        <!-- In Progress -->
        <HBox styleClass="kpi-card, kpi-card-warning" HBox.hgrow="ALWAYS">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="EN TRAITEMENT" styleClass="kpi-title" />
                <Label text="112" styleClass="kpi-value" />
            </VBox>
            <StackPane>
                <Circle radius="25" fill="#f8f9fa" />
                <Label text="&#8987;" style="-fx-font-size: 24;" />
            </StackPane>
        </HBox>

        <!-- Urgent -->
        <HBox styleClass="kpi-card, kpi-card-danger" HBox.hgrow="ALWAYS">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="URGENTS" styleClass="kpi-title" />
                <Label text="18" styleClass="kpi-value" />
            </VBox>
            <StackPane>
                <Circle radius="25" fill="#f8f9fa" />
                <Label text="&#9888;" style="-fx-font-size: 24;" />
            </StackPane>
        </HBox>
    </HBox>

    <!-- Filters -->
    <HBox styleClass="admin-filter-bar" alignment="CENTER_LEFT">
        <TextField promptText="Rechercher (ID, Client, Sujet...)" styleClass="input-modern" prefWidth="300" />
        <Region HBox.hgrow="ALWAYS" />
        <ComboBox promptText="Statut" styleClass="input-modern" prefWidth="150" />
        <ComboBox promptText="Priorité" styleClass="input-modern" prefWidth="150" />
        <Button text="Filtrer" styleClass="btn-admin-primary" />
    </HBox>

    <!-- Data Table -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8;">
        <!-- TableView Container -->
        <TableView fx:id="ticketsTable" styleClass="table-modern" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="ID" prefWidth="80" />
                <TableColumn text="CLIENT" prefWidth="150" />
                <TableColumn text="SUJET" prefWidth="250" />
                <TableColumn text="STATUT" prefWidth="120" />
                <TableColumn text="PRIORITÉ" prefWidth="120" />
                <TableColumn text="DATE CRÉATION" prefWidth="150" />
                <TableColumn text="ACTIONS" prefWidth="150" sortable="false" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Pagination inside table container bottom -->
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 15;">
            <Label text="Affichage 1 à 10 sur 1,204 résultats" style="-fx-text-fill: #6c757d; -fx-font-size: 13;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Précédent" styleClass="btn-action-icon" />
            <Button text="Suivant" styleClass="btn-action-icon" />
        </HBox>
    </VBox>
</VBox>
