<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="org.example.controller.AccueilController" style="-fx-background-color: white;">
    
    <!-- ============================================
         NAVBAR (TOP)
    ============================================ -->
    <HBox styleClass="navbar-pill" alignment="CENTER">
        <VBox.margin>
            <Insets top="15" left="30" right="30" bottom="0"/>
        </VBox.margin>
        
        <!-- LEFT: Logo -->
        <Label text="CuraVita" styleClass="logo-text"/>
        
        <!-- Spacer -->
        <Region HBox.hgrow="SOMETIMES"/>
        
        <!-- CENTER: Menu Items -->
        <HBox styleClass="menu-container" alignment="CENTER">
            <Button text="Accueil" styleClass="menu-item"/>
            <Button text="Produits" styleClass="menu-item"/>
            <Button text="Commandes" styleClass="menu-item"/>
            <Button text="Traitement" styleClass="menu-item" onAction="#goToTraitement"/>
            <StackPane fx:id="ordonnanceMenuContainer">
                <Button fx:id="ordonnanceMenuButton" text="Ordonnance &#9662;" styleClass="menu-item"/>
                <VBox fx:id="ordonnanceDropdown" styleClass="nav-dropdown" visible="false" managed="false">
                    <StackPane.margin>
                        <Insets top="45"/>
                    </StackPane.margin>
                    <Button text="Cr&#233;er une ordonnance" styleClass="dropdown-item" onAction="#showCreerOrdonnance"/>
                    <Button text="Mes ordonnances" styleClass="dropdown-item" onAction="#showMesOrdonnances"/>
                </VBox>
            </StackPane>
            <Button text="Guide Sant&#233;" styleClass="menu-item"/>
            <Button text="Contact" styleClass="menu-item"/>
            <Button text="&#192; propos" styleClass="menu-item"/>
        </HBox>
        
        <!-- Spacer -->
        <Region HBox.hgrow="SOMETIMES"/>
        
        <!-- RIGHT: Icons -->
        <HBox styleClass="navbar-right-section" alignment="CENTER" spacing="15">
            <Button text="&#128269;" styleClass="navbar-search-btn" onAction="#handleSearch"/>
            <StackPane>
                <HBox fx:id="profileContainer" styleClass="navbar-profile-container"
                      alignment="CENTER" spacing="10" onMouseClicked="#toggleProfileDropdown">
                    <StackPane styleClass="navbar-avatar-container">
                        <Circle fx:id="navbarAvatarCircle" radius="18" styleClass="navbar-avatar-circle"/>
                        <Label fx:id="navbarAvatarLabel" text="&#128100;" styleClass="navbar-avatar-emoji" alignment="CENTER"/>
                        <Circle radius="4" styleClass="online-dot" StackPane.alignment="BOTTOM_RIGHT"/>
                    </StackPane>
                    <Label fx:id="navbarUsername" text="Utilisateur" styleClass="navbar-username"/>
                    <Label text="&#9660;" styleClass="navbar-dropdown-arrow"/>
                </HBox>
                <VBox fx:id="profileDropdown" styleClass="profile-dropdown" visible="false" managed="false" StackPane.alignment="TOP_RIGHT">
                    <VBox.margin>
                        <Insets top="52"/>
                    </VBox.margin>
                    <Button text="Mon Profil" styleClass="dropdown-item" onAction="#showProfile"/>
                    <Button fx:id="dashboardMenuItem" text="Dashboard" styleClass="dropdown-item" onAction="#goToDashboard"/>
                    <Button text="Logout" styleClass="dropdown-item" onAction="#logout"/>
                </VBox>
            </StackPane>
        </HBox>
    </HBox>
    
    <!-- ============================================
         MAIN CONTENT AREA
    ============================================ -->
    <VBox styleClass="main-content" VBox.vgrow="ALWAYS">
        
        <!-- ============================================
             HERO SECTION (GREEN)
        ============================================ -->
        <VBox styleClass="hero-section" alignment="CENTER">
            <Label text="Bienvenue sur CuraVita" styleClass="hero-title"/>
            <Label text="Votre solution moderne pour la gestion de pharmacie" styleClass="hero-subtitle"/>
        </VBox>
        
        <!-- ============================================
             CARDS SECTION
        ============================================ -->
        <HBox styleClass="cards-section" alignment="CENTER">
            <VBox.margin>
                <Insets top="40" left="40" right="40" bottom="40"/>
            </VBox.margin>
            
            <!-- Card 1: Nos Produits -->
            <VBox styleClass="card">
                <VBox styleClass="card-icon-container" alignment="CENTER">
                    <Label text="&#128230;" styleClass="card-icon"/>
                </VBox>
                <Label text="Nos Produits" styleClass="card-title"/>
                <Label text="D&#233;couvrez notre large gamme de produits pharmaceutiques de qualit&#233;" styleClass="card-description"/>
            </VBox>
            
            <!-- Spacer -->
            <Region prefWidth="30"/>
            
            <!-- Card 2: Commandes -->
            <VBox styleClass="card">
                <VBox styleClass="card-icon-container" alignment="CENTER">
                    <Label text="&#128203;" styleClass="card-icon"/>
                </VBox>
                <Label text="Commandes" styleClass="card-title"/>
                <Label text="G&#233;rez vos commandes facilement etSuivez votre historique" styleClass="card-description"/>
            </VBox>
            
            <!-- Spacer -->
            <Region prefWidth="30"/>
            
            <!-- Card 3: Promotions -->
            <VBox styleClass="card">
                <VBox styleClass="card-icon-container" alignment="CENTER">
                    <Label text="&#127881;" styleClass="card-icon"/>
                </VBox>
                <Label text="Promotions" styleClass="card-title"/>
                <Label text="B&#233;n&#233;ficiez de nos offres sp&#233;ciales et r&#233;ductions exclusives" styleClass="card-description"/>
            </VBox>
            
        </HBox>
        
    </VBox>
    
</VBox>
