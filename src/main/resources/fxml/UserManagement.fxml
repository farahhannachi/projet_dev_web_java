<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="mainStack" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.UserManagementController" styleClass="root">

    <!-- MAIN CONTENT -->
    <BorderPane fx:id="mainContent">
        <top>
            <HBox style="-fx-padding: 20; -fx-background-color: #f8f9fa; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;" spacing="15" alignment="CENTER_LEFT">
                <children>
                    <Label text="👥 Liste des Clients" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1f6f54;"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button text="← Retour" onAction="#goBackToDashboard" style="-fx-padding: 10 20; -fx-background-color: #1f6f54; -fx-text-fill: white; -fx-font-size: 12; -fx-cursor: hand; -fx-background-radius: 5;"/>
                </children>
            </HBox>
        </top>

        <center>
            <ScrollPane fitToWidth="true" style="-fx-background-color: #f8f9fa;">
                <VBox spacing="20" style="-fx-padding: 20;">

                    <!-- Statistics - Modern Dashboard Design -->
                    <HBox spacing="20" style="-fx-alignment: CENTER_LEFT;">
                        <children>
                            <!-- Total Clients Card -->
                            <VBox fx:id="statCard1" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20 25; -fx-min-width: 220; -fx-spacing: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3); -fx-border-color: #e5e7eb; -fx-border-width: 1;" onMouseEntered="#onStatCardEnter" onMouseExited="#onStatCardExit">
                                <children>
                                    <HBox spacing="15" style="-fx-alignment: CENTER_LEFT;">
                                        <children>
                                            <VBox style="-fx-background-color: #e0f2fe; -fx-background-radius: 12; -fx-padding: 12; -fx-min-width: 50; -fx-min-height: 50; -fx-alignment: CENTER;">
                                                <children>
                                                    <Label text="👥" style="-fx-font-size: 24;"/>
                                                </children>
                                            </VBox>
                                            <VBox spacing="3">
                                                <children>
                                                    <Label text="Total Clients" style="-fx-font-size: 12; -fx-text-fill: #666; -fx-font-weight: normal;"/>
                                                    <Label fx:id="totalClientsLabel" text="0" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #0284c7;"/>
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Label text="↑ 12% vs mois dernier" style="-fx-font-size: 11; -fx-text-fill: #10b981;"/>
                                </children>
                            </VBox>

                            <!-- Active Clients Card -->
                            <VBox fx:id="statCard2" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20 25; -fx-min-width: 220; -fx-spacing: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3); -fx-border-color: #e5e7eb; -fx-border-width: 1;" onMouseEntered="#onStatCardEnter" onMouseExited="#onStatCardExit">
                                <children>
                                    <HBox spacing="15" style="-fx-alignment: CENTER_LEFT;">
                                        <children>
                                            <VBox style="-fx-background-color: #dcfce7; -fx-background-radius: 12; -fx-padding: 12; -fx-min-width: 50; -fx-min-height: 50; -fx-alignment: CENTER;">
                                                <children>
                                                    <Label text="✅" style="-fx-font-size: 24;"/>
                                                </children>
                                            </VBox>
                                            <VBox spacing="3">
                                                <children>
                                                    <Label text="Clients Actifs" style="-fx-font-size: 12; -fx-text-fill: #666; -fx-font-weight: normal;"/>
                                                    <Label fx:id="activeClientsLabel" text="0" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Label text="Engagement: 85%" style="-fx-font-size: 11; -fx-text-fill: #16a34a;"/>
                                </children>
                            </VBox>

                            <!-- Blocked Clients Card -->
                            <VBox fx:id="statCard3" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20 25; -fx-min-width: 220; -fx-spacing: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3); -fx-border-color: #e5e7eb; -fx-border-width: 1;" onMouseEntered="#onStatCardEnter" onMouseExited="#onStatCardExit">
                                <children>
                                    <HBox spacing="15" style="-fx-alignment: CENTER_LEFT;">
                                        <children>
                                            <VBox style="-fx-background-color: #fee2e2; -fx-background-radius: 12; -fx-padding: 12; -fx-min-width: 50; -fx-min-height: 50; -fx-alignment: CENTER;">
                                                <children>
                                                    <Label text="🔒" style="-fx-font-size: 24;"/>
                                                </children>
                                            </VBox>
                                            <VBox spacing="3">
                                                <children>
                                                    <Label text="Clients Bloqués" style="-fx-font-size: 12; -fx-text-fill: #666; -fx-font-weight: normal;"/>
                                                    <Label fx:id="blockedClientsLabel" text="0" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Label text="À surveiller" style="-fx-font-size: 11; -fx-text-fill: #dc2626;"/>
                                </children>
                            </VBox>
                            <Pane HBox.hgrow="ALWAYS"/>
                        </children>
                    </HBox>

                    <!-- Actions -->
                    <HBox spacing="15">
                        <children>
                            <Button text="👤 Ajouter" onAction="#handleAddClient" style="-fx-padding: 10 20; -fx-font-size: 12; -fx-background-color: #1f6f54; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
                            <Button text="🔄 Trier" onAction="#handleSort" style="-fx-padding: 10 20; -fx-font-size: 12; -fx-background-color: #7c3aed; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
                            <Label text="🔍 Rechercher:" style="-fx-font-size: 12;"/>
                            <TextField fx:id="searchField" promptText="Nom, Email..." style="-fx-padding: 8 12; -fx-font-size: 11; -fx-min-width: 250; -fx-background-radius: 5;"/>
                        </children>
                    </HBox>

                    <!-- Table - Modern Column Design with Full Background -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                        <children>
                            <TableView fx:id="userTable" style="-fx-font-size: 12; -fx-padding: 0; -fx-border-width: 0;">
                                <columns>
                                    <TableColumn fx:id="nameColumn" text="👤 Nom" prefWidth="140" sortable="false" style="-fx-alignment: CENTER_LEFT;"/>
                                    <TableColumn fx:id="emailColumn" text="📧 Email" prefWidth="210" sortable="false" style="-fx-alignment: CENTER_LEFT;"/>
                                    <TableColumn fx:id="roleColumn" text="👥 Rôle" prefWidth="100" sortable="false" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="statusColumn" text="🔄 État" prefWidth="120" sortable="false" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="dateColumn" text="📅 Date" prefWidth="130" sortable="false" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="actionColumn" text="⚙️ Actions" prefWidth="220" sortable="false" style="-fx-alignment: CENTER;"/>
                                </columns>
                            </TableView>
                        </children>
                    </VBox>
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>

    <!-- OVERLAY MODALS -->
    <StackPane fx:id="overlayPane" visible="false" managed="false" style="-fx-background-color: rgba(0,0,0,0.4);">

        <!-- Add Client Modal -->
        <VBox fx:id="addClientModal" visible="false" managed="false" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-spacing: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 10); -fx-min-width: 450;" StackPane.alignment="CENTER">
            <children>
                <HBox spacing="10">
                    <children>
                        <Label text="👤 Ajouter Client" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1f6f54;"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Button text="✕" onAction="#closeModal" style="-fx-background-color: transparent; -fx-text-fill: #999; -fx-cursor: hand;"/>
                    </children>
                </HBox>
                <Separator/>
                <!-- Name Field with Validation -->
                <VBox spacing="5">
                    <children>
                        <Label text="Nom *" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <TextField fx:id="addModalNameField" promptText="Jean Dupont" style="-fx-padding: 10; -fx-background-radius: 8; -fx-background-color: #f3f4f6; -fx-border-color: #d1d5db;" onKeyReleased="#validateAddModalName"/>
                        <Label fx:id="addModalNameError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 10;"/>
                    </children>
                </VBox>
                <!-- Email Field with Validation -->
                <VBox spacing="5">
                    <children>
                        <Label text="Email *" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <TextField fx:id="addModalEmailField" promptText="jean@gmail.com" style="-fx-padding: 10; -fx-background-radius: 8; -fx-background-color: #f3f4f6; -fx-border-color: #d1d5db;" onKeyReleased="#validateAddModalEmail"/>
                        <Label fx:id="addModalEmailError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 10;"/>
                    </children>
                </VBox>
                <!-- Password Field with Strength Indicator -->
                <VBox spacing="8">
                    <children>
                        <Label text="Mot de passe (min 6) *" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <PasswordField fx:id="addModalPasswordField" promptText="••••••" style="-fx-padding: 10; -fx-background-radius: 8; -fx-background-color: #f3f4f6; -fx-border-color: #d1d5db;" onKeyReleased="#validateAddModalPassword"/>

                        <!-- Strength Indicator -->
                        <VBox spacing="4" styleClass="password-requirements">
                            <Label fx:id="addReqLength" text="✗ Au moins 6 caractères" style="-fx-text-fill: #dc2626; -fx-font-size: 10;"/>
                            <Label fx:id="addReqUppercase" text="✗ Majuscule (A-Z)" style="-fx-text-fill: #dc2626; -fx-font-size: 10;"/>
                            <Label fx:id="addReqNumber" text="✗ Chiffre (0-9)" style="-fx-text-fill: #dc2626; -fx-font-size: 10;"/>
                        </VBox>
                        <Label fx:id="addModalPasswordError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 10;"/>
                    </children>
                </VBox>
                <!-- Role -->
                <VBox spacing="5">
                    <children>
                        <Label text="Rôle" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <ComboBox fx:id="addModalRoleCombo" style="-fx-padding: 8; -fx-background-radius: 8; -fx-background-color: #f3f4f6; -fx-border-color: #d1d5db;"/>
                    </children>
                </VBox>
                <Label fx:id="addModalErrorLabel" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 11; -fx-wrap-text: true;"/>
                <HBox spacing="10" style="-fx-alignment: CENTER;">
                    <children>
                        <Button text="✅ Ajouter" onAction="#handleAddClientConfirm" style="-fx-padding: 12 30; -fx-background-color: #1f6f54; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
                        <Button text="❌ Annuler" onAction="#closeModal" style="-fx-padding: 12 30; -fx-background-color: #d1d5db; -fx-text-fill: #333; -fx-cursor: hand; -fx-background-radius: 8;"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Edit Client Modal -->
        <VBox fx:id="editClientModal" visible="false" managed="false" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-spacing: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 10); -fx-min-width: 450;" StackPane.alignment="CENTER">
            <children>
                <HBox spacing="10">
                    <children>
                        <Label text="✏️ Modifier Client" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1f6f54;"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Button text="✕" onAction="#closeModal" style="-fx-background-color: transparent; -fx-text-fill: #999; -fx-cursor: hand;"/>
                    </children>
                </HBox>
                <Separator/>
                <!-- Name Field with Validation -->
                <VBox spacing="5">
                    <children>
                        <Label text="Nom *" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <TextField fx:id="editModalNameField" promptText="Jean Dupont" style="-fx-padding: 10; -fx-background-radius: 8; -fx-background-color: #f3f4f6; -fx-border-color: #d1d5db;" onKeyReleased="#validateEditModalName"/>
                        <Label fx:id="editModalNameError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 10;"/>
                    </children>
                </VBox>
                <!-- Email Field with Validation -->
                <VBox spacing="5">
                    <children>
                        <Label text="Email *" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <TextField fx:id="editModalEmailField" promptText="jean@gmail.com" style="-fx-padding: 10; -fx-background-radius: 8; -fx-background-color: #f3f4f6; -fx-border-color: #d1d5db;" onKeyReleased="#validateEditModalEmail"/>
                        <Label fx:id="editModalEmailError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 10;"/>
                    </children>
                </VBox>
                <!-- Password Field with Strength Indicator -->
                <VBox spacing="8">
                    <children>
                        <Label text="Mot de passe (laisser vide pour garder)" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <PasswordField fx:id="editModalPasswordField" promptText="••••••" style="-fx-padding: 10; -fx-background-radius: 8; -fx-background-color: #f3f4f6; -fx-border-color: #d1d5db;" onKeyReleased="#validateEditModalPassword"/>

                        <!-- Strength Indicator (visible only if password entered) -->
                        <VBox spacing="4" styleClass="password-requirements">
                            <Label fx:id="editReqLength" text="✗ Au moins 6 caractères" style="-fx-text-fill: #dc2626; -fx-font-size: 10;"/>
                            <Label fx:id="editReqUppercase" text="✗ Majuscule (A-Z)" style="-fx-text-fill: #dc2626; -fx-font-size: 10;"/>
                            <Label fx:id="editReqNumber" text="✗ Chiffre (0-9)" style="-fx-text-fill: #dc2626; -fx-font-size: 10;"/>
                        </VBox>
                        <Label fx:id="editModalPasswordError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 10;"/>
                    </children>
                </VBox>
                <!-- Role -->
                <VBox spacing="5">
                    <children>
                        <Label text="Rôle" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                        <ComboBox fx:id="editModalRoleCombo" style="-fx-padding: 8; -fx-background-radius: 8; -fx-background-color: #f3f4f6; -fx-border-color: #d1d5db;"/>
                    </children>
                </VBox>
                <Label fx:id="editModalErrorLabel" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 11; -fx-wrap-text: true;"/>
                <HBox spacing="10" style="-fx-alignment: CENTER;">
                    <children>
                        <Button text="✅ Mettre à jour" onAction="#handleEditClientConfirm" style="-fx-padding: 12 30; -fx-background-color: #1f6f54; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
                        <Button text="❌ Annuler" onAction="#closeModal" style="-fx-padding: 12 30; -fx-background-color: #d1d5db; -fx-text-fill: #333; -fx-cursor: hand; -fx-background-radius: 8;"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Delete Modal -->
        <VBox fx:id="deleteConfirmModal" visible="false" managed="false" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-spacing: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 10); -fx-min-width: 380;" StackPane.alignment="CENTER">
            <children>
                <Label text="⚠️ Confirmation" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                <Label fx:id="deleteConfirmMessage" text="Êtes-vous sûr ?" style="-fx-font-size: 13; -fx-text-fill: #666; -fx-wrap-text: true;"/>
                <HBox spacing="10" style="-fx-alignment: CENTER;">
                    <children>
                        <Button text="✅ Oui" onAction="#handleDeleteConfirm" style="-fx-padding: 10 25; -fx-background-color: #dc2626; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
                        <Button text="❌ Non" onAction="#closeModal" style="-fx-padding: 10 25; -fx-background-color: #d1d5db; -fx-text-fill: #333; -fx-cursor: hand; -fx-background-radius: 8;"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Success Modal -->
        <VBox fx:id="successModal" visible="false" managed="false" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 50; -fx-spacing: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 10); -fx-min-width: 500; -fx-alignment: CENTER;" StackPane.alignment="CENTER">
            <children>
                <Label fx:id="successMessage" text="✅ Succès!" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #10b981; -fx-alignment: CENTER; -fx-text-alignment: CENTER;"/>
                <Button text="OK" onAction="#closeModal" style="-fx-padding: 15 60; -fx-font-size: 14; -fx-background-color: #10b981; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;" HBox.hgrow="ALWAYS"/>
            </children>
        </VBox>

    </StackPane>

</StackPane>

