<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.ServiceController"
            fitToWidth="true" fitToHeight="true" pannable="true"
            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" styleClass="page-scroll">
    <content>
        <StackPane styleClass="admin-root">
            <VBox fx:id="listView" spacing="0" maxWidth="Infinity" maxHeight="Infinity">
                <BorderPane VBox.vgrow="ALWAYS">
                    <top>
                        <VBox spacing="14" styleClass="admin-header-wrap">
                            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="admin-header">
                                <VBox spacing="2">
                                    <Label text="Services" styleClass="admin-title"/>
                                    <Label text="Offres santé et consommation" styleClass="admin-subtitle"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Ajouter un service" onAction="#openAddServiceModal" styleClass="btn-admin-primary"/>
                            </HBox>

                            <HBox spacing="12" styleClass="stats-row">
                                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <Label text="Nombre de services" styleClass="stat-label"/>
                                    <Label fx:id="totalServicesLabel" text="0" styleClass="stat-value"/>
                                </VBox>
                                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <Label text="Consommation totale" styleClass="stat-label"/>
                                    <Label fx:id="consommationTotaleLabel" text="0.0" styleClass="stat-value"/>
                                </VBox>
                                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <Label text="Service le plus actif" styleClass="stat-label"/>
                                    <Label fx:id="servicePlusActifLabel" text="N/A" styleClass="stat-value success"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="10" styleClass="filters-row">
                                <TextField fx:id="searchField" promptText="Recherche nom, email, type..." HBox.hgrow="ALWAYS" styleClass="filter-field"/>
                                <ComboBox fx:id="typeFilter" promptText="Type" styleClass="filter-field"/>
                            </HBox>
                        </VBox>
                    </top>

                    <center>
                        <VBox styleClass="table-card" BorderPane.alignment="CENTER">
                            <TableView fx:id="serviceTable" styleClass="admin-table" minHeight="400" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colNom" text="Nom" minWidth="150"/>
                                    <TableColumn fx:id="colType" text="Type" minWidth="100"/>
                                    <TableColumn fx:id="colSpecialite" text="Spécialité" minWidth="150"/>
                                    <TableColumn fx:id="colTelephone" text="Téléphone" minWidth="120"/>
                                    <TableColumn fx:id="colEmail" text="Email" minWidth="160"/>
                                    <TableColumn fx:id="colActions" text="Actions" minWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </center>

                    <bottom>
                        <HBox alignment="CENTER" styleClass="admin-actions-row">
                            <Pagination fx:id="pagination"/>
                        </HBox>
                    </bottom>
                </BorderPane>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
