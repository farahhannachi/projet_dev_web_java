<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.ImageView?>

<!-- ROOT: VBox - Main Container -->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.ProfilController" styleClass="profil-root">

    <!-- ============================================
         NAVBAR (TOP - Always Visible)
    ============================================ -->
    <HBox styleClass="navbar-pill" alignment="CENTER" minHeight="60">
        <VBox.margin>
            <Insets top="10" left="40" right="40" bottom="10"/>
        </VBox.margin>
        
        <!-- LEFT: Logo -->
        <Label text="CuraVita" styleClass="logo-text"/>
        
        <!-- Spacer -->
        <Region HBox.hgrow="SOMETIMES"/>
        
        <!-- CENTER: Menu Items -->
        <HBox styleClass="menu-container" alignment="CENTER" spacing="5">
            <Button text="Accueil" styleClass="menu-item" onAction="#goToAccueil"/>
            <Button text="Produits" styleClass="menu-item"/>
            <Button text="Commandes" styleClass="menu-item"/>
            <Button text="Ordonnance" styleClass="menu-item"/>
            <Button text="Traitement" styleClass="menu-item"/>
            <Button text="Guide Sant&#233;" styleClass="menu-item"/>
            <Button text="Contact" styleClass="menu-item"/>
            <Button text="&#192; propos" styleClass="menu-item"/>
        </HBox>
        
        <!-- Spacer -->
        <Region HBox.hgrow="SOMETIMES"/>
        
        <!-- RIGHT: Search + Profile Section -->
        <HBox styleClass="navbar-right-section" alignment="CENTER" spacing="15">
            <!-- Search Button -->
            <Button text="&#128269;" styleClass="navbar-search-btn"/>
            
            <!-- Profile Container -->
            <StackPane>
                <HBox fx:id="profileContainer" styleClass="navbar-profile-container" 
                      alignment="CENTER" spacing="10" onMouseClicked="#toggleProfileDropdown">
                    <!-- Circular Avatar -->
                    <StackPane styleClass="navbar-avatar-container">
                        <Circle fx:id="navbarAvatarCircle" radius="18" styleClass="navbar-avatar-circle"/>
                        <Label fx:id="navbarAvatarLabel" text="&#128100;" styleClass="navbar-avatar-emoji" alignment="CENTER"/>
                        <!-- Online Dot -->
                        <Circle radius="4" styleClass="online-dot" StackPane.alignment="BOTTOM_RIGHT"/>
                    </StackPane>
                    
                    <!-- Username -->
                    <Label fx:id="navbarUsername" text="Utilisateur" styleClass="navbar-username"/>
                    
                    <!-- Dropdown Arrow -->
                    <Label text="&#9660;" styleClass="navbar-dropdown-arrow"/>
                </HBox>
                
                <!-- Profile Dropdown Menu -->
                <VBox fx:id="profileDropdown" styleClass="profile-dropdown" visible="false" managed="false" StackPane.alignment="TOP_RIGHT">
                    <VBox.margin>
                        <Insets top="50" right="0" bottom="0" left="0"/>
                    </VBox.margin>
                    <Button text="Mon Profil" styleClass="dropdown-item" onAction="#closeDropdownIfOpen"/>
                    <Button text="Dashboard" styleClass="dropdown-item" onAction="#goToDashboard"/>
                    <Button text="D&#233;connexion" styleClass="dropdown-item" onAction="#logout"/>
                </VBox>
            </StackPane>
        </HBox>
    </HBox>

    <!-- ============================================
          HEADER SECTION (300px) - StackPane with layers - CALVINO STYLE
          Layer 1: Background Image
          Layer 2: Animated Green Gradient
          Layer 3: Profile Content (Avatar LEFT + Text RIGHT - horizontal layout)
     ============================================ -->
    <StackPane fx:id="heroSection" styleClass="hero-section-calvino" minHeight="300" prefHeight="300">

        <!-- LAYER 1: Background Image -->
        <ImageView fx:id="heroBackgroundImage" styleClass="hero-background-image" 
                   preserveRatio="false" StackPane.alignment="CENTER" 
                   fitWidth="${heroSection.width}" fitHeight="300"/>

        <!-- LAYER 2: Animated Green Gradient Overlay (fallback) -->
        <Rectangle styleClass="hero-gradient-overlay-animated" StackPane.alignment="CENTER">
            <width>1920</width>
            <height>300</height>
        </Rectangle>
        
        <!-- LAYER 3: Profile Content - CALVINO HORIZONTAL LAYOUT -->
        <HBox styleClass="hero-content-calvino" alignment="CENTER" spacing="40">
            <padding>
                <Insets left="60" right="60"/>
            </padding>

            <!-- LEFT: Avatar with Edit Button (Circular with white border) -->
            <StackPane alignment="BOTTOM_RIGHT" prefWidth="160" prefHeight="160">
                <!-- Circular Avatar Container with white border -->
                <StackPane styleClass="avatar-container-calvino">
                    <!-- White Border Circle -->
                    <Circle radius="80" styleClass="avatar-border-circle"/>

                    <!-- Avatar Image -->
                    <ImageView fx:id="heroAvatarImage" styleClass="hero-avatar-image-calvino"
                               fitHeight="150" fitWidth="150" preserveRatio="true" StackPane.alignment="CENTER"/>
                </StackPane>
                
                <!-- Edit Avatar Button (overlay bottom-right) -->
                <Button fx:id="editAvatarOverlayBtn" styleClass="avatar-edit-btn-calvino"
                        text="✏" onAction="#handleChangeAvatar">
                    <StackPane.margin>
                        <Insets bottom="5" right="5"/>
                    </StackPane.margin>
                </Button>
            </StackPane>
            
            <!-- RIGHT: Text Information (Calvino style) -->
            <VBox styleClass="hero-text-calvino" spacing="8" alignment="TOP_LEFT" prefWidth="500">
                <!-- Main Title: "My name is [Name]" -->
                <Label fx:id="heroNameLabel" styleClass="hero-name-calvino" text="My name is Nom Complet" wrapText="true"/>

                <!-- Subtitle: Role/Title -->
                <Label fx:id="heroRoleLabel" styleClass="hero-role-calvino" text="Digital Product Designer"/>

                <!-- Description/Email -->
                <Label fx:id="heroEmailLabel" styleClass="hero-email-calvino" text="email@exemple.com" wrapText="true"/>

                <!-- Status Badge -->
                <Label fx:id="heroStatusBadge" styleClass="status-badge-calvino" text="ACTIF"/>
            </VBox>
        </HBox>

        <!-- Change Background Button (top-right) -->
        <Button fx:id="editBackgroundBtn" styleClass="edit-background-btn" 
                text="&#128247; Changer le fond" StackPane.alignment="TOP_RIGHT" onAction="#handleChangeBackground">
            <StackPane.margin>
                <Insets top="15" right="20"/>
            </StackPane.margin>
        </Button>
    </StackPane>

    <!-- ============================================
         CONTENT SECTION (Below Header)
         Simple info cards
    ============================================ -->
    <ScrollPane fitToWidth="true" styleClass="profil-scroll-pane" VBox.vgrow="ALWAYS">
        <VBox styleClass="profil-content-container" spacing="20">
            <padding>
                <Insets top="30" left="40" right="40" bottom="40"/>
            </padding>

            <!-- Quick Actions -->
            <HBox spacing="15" alignment="CENTER">
                <Button text="&#9998; Modifier le profil" styleClass="btn-modify" onAction="#handleEditProfile"/>
            </HBox>

            <!-- Account Info Cards -->
            <VBox styleClass="profil-details-section">
                <Label text="&#128203; Informations du compte" styleClass="profil-section-title"/>
                
                <GridPane styleClass="profil-details-grid" hgap="20" vgap="15">
                    <!-- Name Card -->
                    <VBox styleClass="info-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <HBox spacing="10">
                            <Label text="&#128100;" styleClass="info-card-icon"/>
                            <Label text="Nom complet" styleClass="info-card-label"/>
                        </HBox>
                        <Label fx:id="infoNameLabel" text="N/A" styleClass="info-card-value"/>
                    </VBox>

                    <!-- Email Card -->
                    <VBox styleClass="info-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <HBox spacing="10">
                            <Label text="&#128231;" styleClass="info-card-icon"/>
                            <Label text="Email" styleClass="info-card-label"/>
                        </HBox>
                        <Label fx:id="infoEmailLabel" text="N/A" styleClass="info-card-value"/>
                    </VBox>

                    <!-- Role Card -->
                    <VBox styleClass="info-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <HBox spacing="10">
                            <Label text="&#127917;" styleClass="info-card-icon"/>
                            <Label text="R&#244;le" styleClass="info-card-label"/>
                        </HBox>
                        <Label fx:id="infoRoleLabel" text="N/A" styleClass="info-card-value"/>
                    </VBox>

                    <!-- Status Card -->
                    <VBox styleClass="info-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <HBox spacing="10">
                            <Label text="&#128994;" styleClass="info-card-icon"/>
                            <Label text="Statut" styleClass="info-card-label"/>
                        </HBox>
                        <Label fx:id="infoStatusLabel" text="ACTIF" styleClass="info-card-value"/>
                    </VBox>
                </GridPane>
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- ============================================
         OVERLAY MODALS
    ============================================ -->
    <StackPane fx:id="overlayPane" visible="false" managed="false" styleClass="profil-overlay">

        <!-- AVATAR GENERATOR PANEL - Modern Design -->
        <VBox fx:id="avatarPanel" visible="false" managed="false" styleClass="avatar-generator-panel-modern" StackPane.alignment="CENTER">
            <!-- Header with gradient -->
            <StackPane styleClass="avatar-panel-header">
                <VBox alignment="CENTER" spacing="5">
                    <Label text="&#127912;" styleClass="avatar-panel-emoji"/>
                    <Label text="Cr&#233;ez votre Avatar" styleClass="avatar-panel-title"/>
                    <Label text="Choisissez un style et g&#233;n&#233;rez un avatar unique" styleClass="avatar-panel-subtitle"/>
                </VBox>
                <Button text="&#10005;" onAction="#closeAvatarPanel" styleClass="panel-close-btn-modern" StackPane.alignment="TOP_RIGHT">
                    <StackPane.margin>
                        <Insets top="10" right="15"/>
                    </StackPane.margin>
                </Button>
            </StackPane>
            
            <!-- Avatar Preview Circle -->
            <StackPane styleClass="avatar-preview-circle">
                <Circle radius="75" styleClass="avatar-preview-ring"/>
                <ImageView fx:id="previewImageView" styleClass="avatar-imageview-preview" 
                           preserveRatio="true" StackPane.alignment="CENTER">
                    <fitWidth>140</fitWidth>
                    <fitHeight>140</fitHeight>
                </ImageView>
                <!-- Animated ring -->
                <Circle radius="80" styleClass="avatar-glow-ring" StackPane.alignment="CENTER"/>
            </StackPane>
            
            <!-- Generate Button -->
            <Button text="&#127922; G&#233;n&#233;rer un nouvel avatar" onAction="#generateRandomAvatar" styleClass="generate-btn-modern">
                <VBox.margin>
                    <Insets top="10"/>
                </VBox.margin>
            </Button>
            
            <!-- Action Buttons -->
            <HBox styleClass="panel-buttons-modern" spacing="15">
                <Button text="&#10004; Confirmer" onAction="#handleAcceptAvatar" styleClass="panel-confirm-btn-modern"/>
                <Button text="&#10006; Annuler" onAction="#closeAvatarPanel" styleClass="panel-cancel-btn-modern"/>
            </HBox>
        </VBox>

        <!-- EDIT PROFILE MODAL -->
        <VBox fx:id="editModal" visible="false" managed="false" styleClass="profil-modal" StackPane.alignment="CENTER">
            <HBox styleClass="modal-header">
                <Label text="&#9998; Modifier le Profil" styleClass="modal-title"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="&#10005;" onAction="#closeModal" styleClass="modal-close-btn"/>
            </HBox>
            <Separator styleClass="modal-separator"/>
            
            <VBox styleClass="modal-form" spacing="20">
                <VBox spacing="8">
                    <Label text="Nom complet *" styleClass="modal-label"/>
                    <TextField fx:id="editNameField" promptText="Entrez votre nom" styleClass="modal-input"/>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="Email *" styleClass="modal-label"/>
                    <TextField fx:id="editEmailField" promptText="Entrez votre email" styleClass="modal-input"/>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="Mot de passe (optionnel)" styleClass="modal-label"/>
                    <Label text="Laissez vide pour conserver l'actuel" styleClass="modal-hint"/>
                    <PasswordField fx:id="editPasswordField" promptText="......." styleClass="modal-input"/>
                </VBox>
                
                <Label fx:id="editErrorLabel" text="" styleClass="modal-error"/>
            </VBox>
            
            <HBox styleClass="modal-buttons" spacing="15">
                <Button text="&#10004; Sauvegarder" onAction="#handleSaveProfile" styleClass="modal-save-btn"/>
                <Button text="&#10006; Annuler" onAction="#closeModal" styleClass="modal-cancel-btn"/>
            </HBox>
        </VBox>

        <!-- DELETE CONFIRMATION MODAL -->
        <VBox fx:id="deleteModal" visible="false" managed="false" styleClass="profil-modal profil-modal-danger" StackPane.alignment="CENTER">
            <Label text="&#9888; Confirmation" styleClass="modal-danger-title"/>
            <Label text="&#2020;tes-vous s&#251;r de vouloir supprimer votre compte ?" styleClass="modal-danger-message"/>
            <Label text="Cette action est irr&#233;versible et toutes vos donn&#233;es seront perdues." styleClass="modal-danger-hint"/>
            
            <HBox styleClass="modal-buttons" spacing="15">
                <Button text="&#128465; Oui, supprimer" onAction="#handleConfirmDelete" styleClass="modal-delete-btn"/>
                <Button text="&#10006; Annuler" onAction="#closeModal" styleClass="modal-cancel-btn"/>
            </HBox>
        </VBox>

        <!-- SUCCESS MODAL -->
        <VBox fx:id="successModal" visible="false" managed="false" styleClass="success-modal" StackPane.alignment="CENTER">
            <Label text="&#10004;" styleClass="success-icon-large"/>
            <Label fx:id="successMessage" text="Succ&#232;s!" styleClass="success-message-large"/>
            <Button text="OK" onAction="#closeModal" styleClass="success-button-large"/>
        </VBox>
    </StackPane>

</VBox>
