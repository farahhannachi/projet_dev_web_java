# In all environments, the following files are loaded if they exist,
# in order to allow parameter overrides, after renaming .env.dist to .env
# .env.local for environment variables that depend on the machine
# .env.$APP_ENV for environment variables that depend on the Symfony environment

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=changeme
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/db_name?serverVersion=8.0"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> OpenAI Configuration ###
OPENAI_API_KEY=your-openai-key-here
###< OpenAI Configuration ###
