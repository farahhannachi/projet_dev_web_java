<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.controller.AdminReservationController">

    <VBox fx:id="listView" spacing="10" prefHeight="600" prefWidth="1000">
        <padding>
            <Insets top="15" left="15" right="15" bottom="15"/>
        </padding>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Reservation Management" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&#43; Add Reservation" onAction="#openAddReservationModal" style="-fx-font-size: 12; -fx-padding: 8;"/>
        </HBox>

        <!-- Statistics -->
        <VBox styleClass="card" spacing="10">
            <Label text="Reservation Statistics" styleClass="section-title"/>
            <HBox spacing="20" alignment="CENTER">
                <VBox styleClass="stat-card">
                    <Label text="Total Reservations" styleClass="stat-label"/>
                    <Label fx:id="totalReservationsLabel" text="0" styleClass="stat-value"/>
                </VBox>
            </HBox>
        </VBox>

        <HBox spacing="10">
            <TextField fx:id="searchField" promptText="Search by client name or email..." prefWidth="300"/>
            <ComboBox fx:id="statusFilter" promptText="Filter by status" prefWidth="150"/>
        </HBox>

        <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS" minHeight="400">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colClient" text="Client" prefWidth="150"/>
                <TableColumn fx:id="colService" text="Service" prefWidth="150"/>
                <TableColumn fx:id="colDate" text="Date &amp; Time" prefWidth="150"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="120"/>
            </columns>
        </TableView>

        <Pagination fx:id="pagination"/>
    </VBox>
</StackPane>
