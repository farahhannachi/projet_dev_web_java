<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<StackPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.DepotModalController" fx:id="modalRoot" styleClass="modal-overlay">
    <VBox spacing="18" alignment="CENTER" styleClass="modal-content" maxWidth="420" maxHeight="600">
        <Label fx:id="modalTitle" text="Ajouter un dépôt" styleClass="modal-title" />
        <TextField fx:id="nomField" promptText="Nom du dépôt *" styleClass="modal-input" />
        <TextField fx:id="adresseField" promptText="Adresse *" styleClass="modal-input" />
        <TextField fx:id="villeField" promptText="Ville *" styleClass="modal-input" />
        <TextField fx:id="capaciteField" promptText="Capacité (nombre) *" styleClass="modal-input" />
        <TextField fx:id="responsableField" promptText="Responsable *" styleClass="modal-input" />
        <TextField fx:id="telephoneField" promptText="Téléphone *" styleClass="modal-input" />
        <HBox spacing="10" alignment="CENTER">
            <TextField fx:id="latitudeField" promptText="Latitude" styleClass="modal-input-small" />
            <TextField fx:id="longitudeField" promptText="Longitude" styleClass="modal-input-small" />
        </HBox>
        <Label fx:id="errorLabel" text="" styleClass="modal-error" />
        <HBox spacing="16" alignment="CENTER">
            <Button fx:id="saveBtn" text="Enregistrer" styleClass="btn-primary" onAction="#handleSave" />
            <Button fx:id="closeBtn" text="Annuler" styleClass="btn-secondary" onAction="#handleClose" />
        </HBox>
    </VBox>
</StackPane>

