<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<!--
🎯 EXEMPLE FXML - Affichage QR Code d'un Service
Utilise ServiceQRDisplayController pour afficher les QR codes
-->

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.ServiceQRDisplayController"
      spacing="15"
      style="-fx-padding: 20;">

    <Label text="QR Code Generator for Services"
           style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <!-- Section pour afficher les infos du service -->
    <VBox style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-padding: 10;">
        <Label fx:id="serviceNameLabel"
               text="Service: N/A"
               style="-fx-font-size: 14; -fx-font-weight: bold;"/>
    </VBox>

    <!-- Section pour afficher le QR code -->
    <HBox spacing="10" alignment="CENTER">
        <VBox style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-padding: 10;"
              alignment="CENTER">
            <Label text="QR Code (300x300)"
                   style="-fx-font-size: 12; -fx-font-weight: bold;"/>

            <!-- ImageView pour afficher le QR code -->
            <ImageView fx:id="qrCodeView"
                      fitWidth="300"
                      fitHeight="300"
                      pickOnBounds="true"
                      preserveRatio="true"/>
        </VBox>

        <!-- Informations sur le QR code -->
        <VBox spacing="10" style="-fx-min-width: 250;">
            <Label style="-fx-font-size: 12; -fx-font-weight: bold;" text="Informations:"/>

            <Text wrappingText="true" text="Conteneur:
• ID du service
• Nom du médecin
• Type (Médecin/Infirmier)
• Spécialité"/>

            <Text wrappingText="true" text="Format:
id:123|nom:Dr. X|type:Médecin|specialite:Y"/>

            <Text wrappingText="true" text="Emplacement:
qr_codes/service_{id}.png"/>
        </VBox>
    </HBox>

    <!-- Status label -->
    <Label fx:id="qrStatusLabel"
           text="❌ Aucun service sélectionné"
           style="-fx-text-fill: #ff6600; -fx-font-size: 12;"/>

    <!-- Boutons d'action -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="Générer QR Codes pour Tous"
                onAction="#generateQRCodesForAllServices"
                style="-fx-font-size: 12; -fx-padding: 10;"/>
    </HBox>

</VBox>

