<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.DepotFormController"
      spacing="15" prefHeight="600" prefWidth="800">
    <padding><Insets top="20" left="20" right="20" bottom="20"/></padding>

    <!-- Titre -->
    <Label fx:id="formTitle" text="Ajouter un dépôt"
            style="-fx-font-size: 24; -fx-font-weight: bold;"/>

    <!-- Formulaire -->
    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <!-- Ligne 1 -->
        <Label text="Nom *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nomField" promptText="Nom du dépôt" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <!-- Ligne 2 -->
        <Label text="Adresse *" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="adresseField" promptText="Adresse" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <!-- Ligne 3 -->
        <Label text="Ville *" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="villeField" promptText="Ville" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <!-- Ligne 4 -->
        <Label text="Capacité *" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="capaciteField" promptText="Capacité" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <!-- Ligne 5 -->
        <Label text="Responsable *" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="responsableField" promptText="Responsable" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <!-- Ligne 6 -->
        <Label text="Téléphone *" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextField fx:id="telephoneField" promptText="Téléphone" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <!-- Ligne 7 -->
        <Label text="Latitude" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <TextField fx:id="latitudeField" promptText="Latitude" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

        <!-- Ligne 8 -->
        <Label text="Longitude" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <TextField fx:id="longitudeField" promptText="Longitude" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

        <!-- Ligne 9 -->
        <Label text="Localisation" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="8">
            <TextField fx:id="locationNameField" promptText="Cliquez sur la carte" HBox.hgrow="ALWAYS"/>
            <Button text="📍 Ouvrir la carte" onAction="#handleOpenMap" style="-fx-padding: 8; -fx-font-size: 11;"/>
        </HBox>
    </GridPane>


    <!-- Message d'erreur -->
    <Label fx:id="errorLabel" text="" style="-fx-text-fill: red;"/>

    <!-- Boutons -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Enregistrer" onAction="#handleSave" style="-fx-padding: 8; -fx-font-size: 12;"/>
        <Button text="Annuler" onAction="#handleCancel" style="-fx-padding: 8; -fx-font-size: 12;"/>
    </HBox>
</VBox>

