<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.StockFormController"
      spacing="15" prefHeight="600" prefWidth="800">
    <padding><Insets top="20" left="20" right="20" bottom="20"/></padding>

    <!-- Titre -->
    <Label fx:id="formTitle" text="Ajouter un stock"
            style="-fx-font-size: 24; -fx-font-weight: bold;"/>

    <!-- Formulaire -->
    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <!-- Ligne 1 -->
        <Label text="Produit *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="produitField" promptText="Sélectionner un produit" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <!-- Ligne 2 -->
        <Label text="Quantité *" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="quantiteField" promptText="Quantité" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <!-- Ligne 3 -->
        <Label text="Seuil Minimum *" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="seuilMinimumField" promptText="Seuil minimum" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <!-- Ligne 4 -->
        <Label text="Dépôt *" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="depotField" promptText="Sélectionner un dépôt" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <!-- Message d'erreur -->
    <Label fx:id="errorLabel" text="" style="-fx-text-fill: red;"/>

    <!-- Boutons -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Enregistrer" onAction="#handleSave" style="-fx-padding: 8; -fx-font-size: 12;"/>
        <Button text="Annuler" onAction="#handleCancel" style="-fx-padding: 8; -fx-font-size: 12;"/>
    </HBox>
</VBox>

